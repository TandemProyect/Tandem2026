<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?include $(sys.CURRENTDIR)Variables.wxi ?>

  <Package Name="$(var.ProductName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Language="1033"
           InstallerVersion="200"
           Scope="perUser">

    <SummaryInformation Description="$(var.Description)" Manufacturer="$(var.Manufacturer)" />

    <MajorUpgrade Schedule="afterInstallValidate"
                  AllowDowngrades="no"
                  DowngradeErrorMessage="Ya hay una versión más reciente de $(var.ProductName). El instalador se cerrará." />

    <Property Id="ARPURLINFOABOUT" Value="$(var.ManufacturerUrl)" />
    <MediaTemplate EmbedCab="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="eula.rtf" />

    <Feature Id="ProductFeature" Title="Tandem 2026" Level="1">
      <ComponentGroupRef Id="FolderInstall" />
      <ComponentGroupRef Id="FolderAddin" />
      <ComponentRef Id="RegistryEntry_CU" />
    </Feature>

    <Component Id="RegistryEntry_CU" Guid="3D9A1C72-8E54-4B6F-A012-C7D5E9F83410" Directory="TARGETDIR">
      <RegistryKey Root="HKCU" Key="SOFTWARE\$(var.Manufacturer)\Tandem.Plugin.Revit" ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Name="Version" Value="$(var.ProductVersion)" KeyPath="yes" />
        <RegistryValue Type="string" Name="Name" Value="$(var.ProductName)" />
      </RegistryKey>
    </Component>
  </Package>
</Wix>
