<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OpenCadStudioPluging</RootNamespace>
    <AssemblyName>OpenCadStudioPluging</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>

  <Target Name="CopyWebView2LoaderToOutputRoot" AfterTargets="Build">
    <PropertyGroup>
      <_WebView2LoaderFromOutput>$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll</_WebView2LoaderFromOutput>
      <_WebView2LoaderFromPkg>$(NuGetPackageRoot)microsoft.web.webview2\1.0.2849.39\runtimes\win-x64\native\WebView2Loader.dll</_WebView2LoaderFromPkg>
    </PropertyGroup>
    <Copy SourceFiles="$(_WebView2LoaderFromOutput)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_WebView2LoaderFromOutput)')" />
    <Copy SourceFiles="$(_WebView2LoaderFromPkg)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(_WebView2LoaderFromOutput)') and Exists('$(_WebView2LoaderFromPkg)')" />
  </Target>
</Project>
