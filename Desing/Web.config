<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!-- DESARROLLO LOCAL: descomente el bloque LocalDB y comente el bloque site4now.
         La base DLL2022 (o la que use) debe existir ya, con tablas AspNetUsers, AspNetRoles, etc.
         IdentityConnection y ConexionData deben apuntar a la MISMA base (Initial Catalog idéntico).
         REMOTO (site4now): no se crea la base desde la app; use la cadena activa de abajo. -->
    <!-- LocalDB (desarrollo) -->
    <!--
    <add name="IdentityConnection" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=DLL2022;User Id=DBAppUser;Password=tSamTiSwRkxl#;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
    <add name="ConexionData" connectionString="metadata=res://*/Model.csdl|res://*/Model.ssdl|res://*/Model.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=(localdb)\MSSQLLocalDB;initial catalog=DLL2022;user id=DBAppUser;password=tSamTiSwRkxl#;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
    -->
    <!-- site4now (producción / dev contra BD remota existente) -->
    <add name="IdentityConnection" connectionString="Data Source=SQL5113.site4now.net;Initial Catalog=db_a197cd_desingproducction;User Id=db_a197cd_desingproducction_admin;Password=Tandem2027;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True" providerName="System.Data.SqlClient" />
    <add name="ConexionData" connectionString="metadata=res://*/Model.csdl|res://*/Model.ssdl|res://*/Model.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=SQL5113.site4now.net;initial catalog=db_a197cd_desingproducction;user id=db_a197cd_desingproducction_admin;password=Tandem2027;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="SENDGRID_APIKEY" value="REPLACE_WITH_LOCAL_SECRET" />
    <add key="OPENAI_APIKEY" value="REPLACE_WITH_LOCAL_SECRET" />
    <add key="TELEGRAM_BOT_TOKEN" value="8260418090:AAGTU5DLsAYr28--F3GpZ2-kJ6PxZWlC438" />
    <add key="TELEGRAM_WEBHOOK_SECRET" value="tandem-ws-2026-k9QmZpL7vN4xR2sT8uY0wE3r" />
    <!-- Autodesk Platform Services (visor DWG en Detalles). Crear app en https://aps.autodesk.com/myapps — capa gratuita con límites.
         Client ID y Client Secret son los de la aplicación (pantalla "Client credentials"); el Client ID NO es su correo ni su cuenta Autodesk. -->
    <add key="AutodeskAps:ClientId" value="" />
    <add key="AutodeskAps:ClientSecret" value="" />
    <!-- Bucket OSS global (min 3, max 63, solo minúsculas, números y guiones). Debe ser único en APS. -->
    <add key="AutodeskAps:BucketKey" value="tandem-master-articles-dwg" />
    <!-- ZWCAD Viewer en navegador (ZWSOFT): enlace a la web pública; el usuario descarga el .dwg y lo abre o arrastra en esa página. EmbedIframe suele fallar si el sitio envía X-Frame-Options. -->
    <!-- Vista previa DWG (three-dxf): el servidor debe poder generar un DXF ASCII junto al .dwg con nombre &lt;archivo&gt;.dwg.viewer.dxf
         Opción A — ejecutable: ruta ABSOLUTA a dwg2dxf.exe (LibreDWG u otro). Placeholders en MasterArticles:DwgToDxfArgumentsFormat: {in} = .dwg, {out} = ruta temporal .dxf.
         Opción B — manual: exportar DXF en AutoCAD/ZWCAD y copiar el fichero con ese nombre exacto en la misma carpeta que el .dwg (sin pasar por la app).
         Si el conversor escribe mucho por consola, el proceso ya drena stdout/stderr para evitar bloqueos. -->
    <add key="MasterArticles:DwgToDxfExe" value="" />
    <add key="MasterArticles:DwgToDxfArgumentsFormat" value="-o &quot;{out}&quot; &quot;{in}&quot;" />
    <add key="MasterArticles:DwgToDxfTimeoutMs" value="120000" />
    <add key="ZwcadWebViewer:Enabled" value="false" />
    <add key="ZwcadWebViewer:Url" value="https://web.zwcad.com/" />
    <add key="ZwcadWebViewer:EmbedIframe" value="false" />
    <!-- Google Maps / Places (obras Jobside, ClientV2).
         Clave: APIs y servicios > Credenciales > clave de navegador con "Restricción de referentes HTTP".
         Localhost SÍ funciona; el error "Esta página no puede cargar Google Maps" casi siempre es:
         referentes no autorizados, facturación inactiva o APIs no habilitadas (Maps JavaScript API + Places API).
         IIS Express (Design.csproj): https://localhost:44384/ — añadir referentes en Console (ver TemporalScript/GOOGLE_MAPS_LOCALHOST_REFERRERS.txt). -->
    <add key="GoogleMaps:ApiKey" value="AIzaSyBUL8bY71_QqtslFJwT3HXgplk9H7aJjtI" />
    <add key="GoogleMaps:Language" value="es" />
    <add key="GoogleMaps:Region" value="ES" />
    <!-- GoogleMaps:ShowDiagnostics=true fuerza panel diagnóstico aunque compilation debug=false -->
    <!-- <add key="GoogleMaps:ShowDiagnostics" value="true" /> -->
    <!--<add key="SENDGRID_NewUserTemplateID" value="7954205b-2c20-4992-bcce-97abfc7f573f" />
	  <add key="SENDGRID_ResetPasswordTemplateID" value="ced9f3ef-843f-4142-83c4-3b3d8e666706" />
	  <add key="SENDGRID_From" value="juan.godoy@vscad.com" />
	  <add key="APPINSIGHTS_INSTRUMENTATIONKEY" value="dxxx" />-->
  </appSettings>
  <system.web>
    <customErrors mode="Off" />
    <!--<customErrors mode="RemoteOnly" defaultRedirect="mycustompage.htm"/>-->
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" executionTimeout="360" />
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="es-ES" uiCulture="es-ES" />
  </system.web>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>
    <!-- Error 400 "Request Too Long" / cabeceras: suele ser Cookie de auth demasiado grande. headerLimits sube el tope del header Cookie (IIS 8+). Si 500.19, quite el nodo headerLimits. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600">
          <headerLimits>
            <add header="Cookie" sizeLimit="65534" />
          </headerLimits>
        </requestLimits>
      </requestFiltering>
    </security>
  </system.webServer>
