  <appSettings file="Web.GoogleMaps.config">
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="vs:EnableBrowserLink" value="false"/>
    <add key="TandemStartupTiming" value="true"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
    <add key="SENDGRID_APIKEY" value="REPLACE_WITH_LOCAL_SECRET"/>
    <!-- OpenAI (análisis imagen planos): clave real en Web.GoogleMaps.config o env OPENAI_APIKEY — ver Web.GoogleMaps.config.example -->
    <add key="OPENAI_APIKEY" value="REPLACE_WITH_LOCAL_SECRET"/>
    <add key="TELEGRAM_BOT_TOKEN" value="8260418090:AAGTU5DLsAYr28--F3GpZ2-kJ6PxZWlC438"/>
    <add key="TELEGRAM_WEBHOOK_SECRET" value="tandem-ws-2026-k9QmZpL7vN4xR2sT8uY0wE3r"/>
    <!-- Autodesk Platform Services (visor DWG en Detalles). Crear app en https://aps.autodesk.com/myapps — capa gratuita con límites.
         Client ID y Client Secret son los de la aplicación (pantalla "Client credentials"); el Client ID NO es su correo ni su cuenta Autodesk. -->
    <add key="AutodeskAps:ClientId" value=""/>
    <add key="AutodeskAps:ClientSecret" value=""/>
    <!-- Bucket OSS global (min 3, max 63, solo minúsculas, números y guiones). Debe ser único en APS. -->
    <add key="AutodeskAps:BucketKey" value="tandem-master-articles-dwg"/>
    <!-- ZWCAD Viewer en navegador (ZWSOFT): enlace a la web pública; el usuario descarga el .dwg y lo abre o arrastra en esa página. EmbedIframe suele fallar si el sitio envía X-Frame-Options. -->
    <!-- Vista previa DWG (three-dxf): el servidor debe poder generar un DXF ASCII junto al .dwg con nombre &lt;archivo&gt;.dwg.viewer.dxf
         Opción A — ejecutable: ruta ABSOLUTA a dwg2dxf.exe (LibreDWG u otro). Placeholders en MasterArticles:DwgToDxfArgumentsFormat: {in} = .dwg, {out} = ruta temporal .dxf.
         Opción B — manual: exportar DXF en AutoCAD/ZWCAD y copiar el fichero con ese nombre exacto en la misma carpeta que el .dwg (sin pasar por la app).
         Si el conversor escribe mucho por consola, el proceso ya drena stdout/stderr para evitar bloqueos. -->
    <add key="MasterArticles:DwgToDxfExe" value=""/>
    <add key="MasterArticles:DwgToDxfArgumentsFormat" value="-o &quot;{out}&quot; &quot;{in}&quot;"/>
    <add key="MasterArticles:DwgToDxfTimeoutMs" value="120000"/>
    <add key="ZwcadWebViewer:Enabled" value="false"/>
    <add key="ZwcadWebViewer:Url" value="https://web.zwcad.com/"/>
    <add key="ZwcadWebViewer:EmbedIframe" value="false"/>
    <!-- Google Maps / Places (obras Jobside, ClientV2).
         Clave: NO commitear valores reales. Opciones locales:
           A) Copiar Web.GoogleMaps.config.example → Web.GoogleMaps.config (gitignored) con su clave.
           B) Variable de entorno GOOGLE_MAPS_API_KEY (prioridad sobre Web.config).
         APIs y servicios > Credenciales > clave de navegador con "Restricción de referentes HTTP".
         Localhost SÍ funciona; el error "Esta página no puede cargar Google Maps" casi siempre es:
         referentes no autorizados, facturación inactiva o APIs no habilitadas
         (Maps JavaScript API + Places API (New)).
         IIS Express (Design.csproj): https://localhost:44384/ — añadir referentes en Console (ver TemporalScript/GOOGLE_MAPS_LOCALHOST_REFERRERS.txt).
         GoogleMaps:ApiKey solo en Web.GoogleMaps.config (no duplicar aquí: anula el merge). -->
    <add key="GoogleMaps:Language" value="es"/>
    <add key="GoogleMaps:Region" value="ES"/>
    <!-- Opcional: código o etiqueta para resolver el tipo de documento de adjuntos de oferta (OfferDetails).
         Coincide con TextCode o TextLabel (trim, sin distinguir mayúsculas); si se omite o está vacío, se usa «Oferta». -->
    <!-- <add key="OfferDocumentTypeTextCode" value="Oferta" /> -->
    <!-- GoogleMaps:ShowDiagnostics=true fuerza panel diagnóstico aunque compilation debug=false -->
    <!-- <add key="GoogleMaps:ShowDiagnostics" value="true" /> -->
    <!--<add key="SENDGRID_NewUserTemplateID" value="7954205b-2c20-4992-bcce-97abfc7f573f" />
    <add key="SENDGRID_ResetPasswordTemplateID" value="ced9f3ef-843f-4142-83c4-3b3d8e666706" />
    <add key="SENDGRID_From" value="juan.godoy@vscad.com" />
    <add key="APPINSIGHTS_INSTRUMENTATIONKEY" value="dxxx" />-->
  </appSettings>
  <system.web>
    <!--
      LOCAL DEV: explicit machineKey keeps __RequestVerificationToken valid across IIS Express
      restarts/rebuilds (AutoGenerate rotates keys and stale browser cookies fail decryption).
      Production / web farm: replace with unique keys in the host panel or Web.Release.config;
      never share these dev keys or rely on AutoGenerate across machines.
    -->
    <machineKey validationKey="C6BDBE48F9CD374122D5EFA43D38A2FF51CD8B667EAA9711BCDAF80D62A57C2110BC4E8C38FD3963A276E99034BB442056AF67BECCF244A830E714ABE81CA569" decryptionKey="8D51F80C9B4F82AFE1FE59409ADABD1D1684AA732F35F99FCD7D0C20F965A98C" validation="HMACSHA256" decryption="AES"/>
    <customErrors mode="Off"/>
    <!--<customErrors mode="RemoteOnly" defaultRedirect="mycustompage.htm"/>-->
    <authentication mode="None"/>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" executionTimeout="360"/>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="es-ES" uiCulture="es-ES"/>
  </system.web>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication"/>
    </modules>
    <!-- Error 400 "Bad Request - Request Too Long" (cabeceras):
         - headerLimits: tope por cabecera nombrada (Cookie, Authorization, …).
         - NO sustituye el límite TOTAL del kernel http.sys (~16 KB por defecto): si la suma
           de todas las cabeceras supera MaxRequestBytes, seguirá 400 hasta subir registro:
           HKLM\SYSTEM\CurrentControlSet\Services\HTTP\Parameters
           MaxFieldLength (DWORD 65534), MaxRequestBytes (DWORD 65534), net stop http /y, net start w3svc
           (ver comentario anterior en este bloque).
         - Datatables: estado en localStorage (Scripts/datatables-state.js); limpiar cookies del sitio si hubo acumulación.
         - Si el servidor devuelve 500.19 tras cambiar requestFiltering, el host puede bloquear overrides:
           quitar temporalmente headerLimits o pedir que permitan estos límites en el panel. -->
    <security>
      <requestFiltering>
        <!-- maxUrl / maxQueryString: evitan rechazos por URL/consulta largas (no son Cookie, pero suelen ir en el mismo bloque IIS). -->
        <requestLimits maxAllowedContentLength="104857600" maxUrl="65536" maxQueryString="65536">
          <headerLimits>
            <add header="Cookie" sizeLimit="65534"/>
            <add header="Authorization" sizeLimit="65534"/>
            <add header="Referer" sizeLimit="65534"/>
            <add header="X-Forwarded-For" sizeLimit="65534"/>
            <add header="X-Forwarded-Host" sizeLimit="65534"/>
            <add header="Request-Id" sizeLimit="65534"/>
          </headerLimits>
        </requestLimits>
      </requestFiltering>
    </security>
  </system.webServer>
