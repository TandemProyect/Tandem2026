<?xml version="1.0" encoding="utf-8"?>
<!--
  Copiar este archivo a GoogleMaps.local.config (misma carpeta que Web.config).
  GoogleMaps.local.config está en .gitignore — no commitear claves reales.
  No lo llames Web.*.config: la publicación excluye esos nombres.

  Web.config usa: <appSettings file="GoogleMaps.local.config">
  Las claves aquí sustituyen las de Web.config con el mismo nombre.
-->
<appSettings>
  <add key="GoogleMaps:ApiKey" value="YOUR_BROWSER_API_KEY_HERE" />
  <!-- Análisis de planos (ZWCAD TANDEM_ANALIZAR_IMAGEN, visor Desing_2 boceto imagen) -->
    <add key="OPENAI_APIKEY" value="sk-proj-YOUR_OPENAI_KEY_HERE" />
  <!-- Opcional: modelo de visión del boceto (por defecto gpt-6.2-sol; gpt-4o lee mal la forma del boceto). -->
  <!-- <add key="OPENAI_SKETCH_MODEL" value="gpt-6.2-sol" /> -->
  <!-- Correo (no uses SMTP de SmarterASP). La clave real no se sube a Git. -->
  <add key="SENDGRID_APIKEY" value="SG.YOUR_SENDGRID_KEY_HERE" />
</appSettings>
