<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación sólo sistema de ficheros (sin credenciales FTP).

  Carpeta de salida: Desing\..\artifacts\design_site4now\ (directorio bajo artifacts/, ignorado por Git).

  En Visual Studio: proyecto Web → clic derecho → Publish… → importar/editar perfil usando esta ruta.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <publishUrl>$(MSBuildProjectDirectory)\..\artifacts\design_site4now\</publishUrl>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PrecompileBeforePublish>false</PrecompileBeforePublish>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <ExcludeApp_Data>false</ExcludeApp_Data>
  </PropertyGroup>
</Project>
