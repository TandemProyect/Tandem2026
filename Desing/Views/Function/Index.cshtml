@using Newtonsoft.Json
@using Desing.Resources
@using System.Globalization
@{
    ViewBag.Title = Security.Function_Index_Breadcrumb;
    var ci = CultureInfo.CurrentUICulture?.TwoLetterISOLanguageName ?? "es";
    var secDt = JsonConvert.SerializeObject(new
    {
        culture = ci,
        rowsSuffix = Common.Dt_Rows_N,
        allRows = Common.Dt_Rows_All,
        sectionRecords = Common.Dt_Section_Records,
        sectionExport = Common.Dt_Section_Export,
        sectionCols = Common.Dt_Section_ColumnsVisible,
        confirmDelete = Security.Function_Js_ConfirmDelete,
        ariaMenu = Common.Dt_MenuAria
    });
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">@Security.Common_Home</a> /
            @Security.Common_Security /
        </span> @Security.Function_Index_Breadcrumb
    </h4>
    <a class="btn btn-primary text-white" href="@Url.Action("Create", "Function")" id="btnCreateFunction">
        <i class="icon-base ri ri-add-line me-1"></i> @Security.Function_Index_Create
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListFunctions" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th>@Security.Function_Col_Name</th>
                    <th>@Security.Function_Col_Code</th>
                    <th>@Security.Function_Col_Module</th>
                    <th>@Security.Function_Col_Roles</th>
                    <th>@Security.Col_State</th>
                    <th class="text-end text-nowrap" style="width:1%;"></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="createModalFunction" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content"></div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var secDt = @Html.Raw(secDt);
        var secExportOpts = TandemDataTablesList.exportOptsPlainVisible;

        $(document).ready(function () {
            $('#ListFunctions').DataTable(TandemDataTablesList.applyListDefaults({
                lengthMenu: [
                    [10, 25, 50, -1],
                    ['10 ' + secDt.rowsSuffix, '25 ' + secDt.rowsSuffix, '50 ' + secDt.rowsSuffix, secDt.allRows]
                ],
                buttons: [{
                    extend: 'collection',
                    text: "<i class='fas fa-bars'></i>",
                    attr: { 'aria-label': secDt.ariaMenu },
                    className: 'custom-html-collection',
                    buttons: [
                        '<h5>' + secDt.sectionRecords + '</h5>',
                        'pageLength',
                        '<h5>' + secDt.sectionExport + '</h5>',
                        'print',
                        'copy',
                        'pdf',
                        { extend: 'csv', exportOptions: secExportOpts },
                        { extend: 'excel', exportOptions: secExportOpts },
                        '<h5 class="not-top-heading">' + secDt.sectionCols + '</h5>',
                        'colvis'
                    ]
                }],
                serverSide: true,
                processing: true,
                colReorder: { iFixedColumnsRight: 2 },
                ajax: {
                    url: '@Url.Action("ListFunctions", "Function")',
                    type: 'POST'
                },
                order: [[2, 'asc'], [0, 'asc']],
                columns: [
                    {
                        data: 'TextLabel',
                        name: 'TextLabel',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextLabelPlain || '';
                            }
                            return data;
                        }
                    },
                    {
                        data: 'TextCode',
                        name: 'TextCode',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextCodePlain || '';
                            }
                            return data;
                        }
                    },
                    { data: 'TextModule', name: 'TextModule' },
                    { data: 'NRoles', name: 'NRoles', searchable: false },
                    { data: 'activeBadge', name: 'Is_Active', orderable: true, searchable: false },
                    {
                        data: 'rowActions',
                        orderable: false,
                        searchable: false,
                        className: 'tandem-col-actions text-end align-middle text-nowrap'
                    },
                    { data: 'IdObject', visible: false }
                ],
                drawCallback: function () {
                    $('[title]').tooltip({
                        delay: { show: 100, hide: 100 },
                        placement: 'auto'
                    });
                }
            }));
        });

        /* Crear en ventana emergente: GET del formulario parcial y POST por AJAX. */
        (function () {
            var $modal = $('#createModalFunction');
            var modal = null;
            function getModal() {
                if (!modal) { modal = bootstrap.Modal.getOrCreateInstance($modal[0]); }
                return modal;
            }
            $('#btnCreateFunction').on('click', function (e) {
                e.preventDefault();
                $.get(this.href, function (html) {
                    $modal.find('.modal-content').html(html);
                    getModal().show();
                }).fail(function (xhr) {
                    var msg = xhr.responseJSON && xhr.responseJSON.Message;
                    if (msg) { alert(msg); } else { window.location.href = $('#btnCreateFunction').attr('href'); }
                });
            });
            $modal.on('submit', 'form[data-tandem-modal-form]', function (e) {
                e.preventDefault();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]').prop('disabled', true);
                $.ajax({ url: $form.attr('action'), type: 'POST', data: $form.serialize() })
                    .done(function (res) {
                        if (res && res.IsOk) {
                            getModal().hide();
                            $('#ListFunctions').DataTable().ajax.reload(null, false);
                            if (res.Message) { alert(res.Message); }
                        } else if (typeof res === 'string') {
                            $modal.find('.modal-content').html(res);
                        } else if (res && res.Message) {
                            alert(res.Message);
                        }
                    })
                    .fail(function (xhr) {
                        var msg = xhr.responseJSON && xhr.responseJSON.Message;
                        alert(msg || xhr.statusText);
                    })
                    .always(function () { $btn.prop('disabled', false); });
            });
        })();

        window.DeleteFunction = function (id) {
            if (!confirm(secDt.confirmDelete)) return;
            $.post('@Url.Action("DeleteFunction", "Function")',
                { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                function (res) {
                    if (res && res.Message) { alert(res.Message); }
                    if (res && res.IsOk) {
                        $('#ListFunctions').DataTable().ajax.reload(null, false);
                    }
                });
        };
    </script>
    <div style="display:none;">@Html.AntiForgeryToken()</div>
}
