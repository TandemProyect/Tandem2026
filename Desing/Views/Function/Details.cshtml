@model Desing.Models.SecurityFunctionRow
@using Desing.Resources
@{
    ViewBag.Title = Model.TextLabel;
    var roles = (ViewBag.Roles as IList<Desing.Models.SecurityRoleRow>) ?? new List<Desing.Models.SecurityRoleRow>();
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">@Security.Common_Home</a> /
            @Security.Common_Security /
            <a href="@Url.Action("Index", "Function")">@Security.Function_Index_Breadcrumb</a> /
        </span> @Model.TextLabel
    </h4>
    <a class="btn btn-warning" href="@Url.Action("Edit", "Function", new { id = Model.IdObject })">
        <i class="icon-base ri ri-pencil-line me-1"></i> @Common.Btn_Edit
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Security.Function_Lbl_NameRequired.TrimEnd(' ', '*')</dt>
            <dd class="col-sm-9">@Model.TextLabel</dd>
            <dt class="col-sm-3">@Security.Function_Lbl_CodeRequired.TrimEnd(' ', '*')</dt>
            <dd class="col-sm-9"><code>@Model.TextCode</code></dd>
            <dt class="col-sm-3">@Security.Function_Lbl_Module</dt>
            <dd class="col-sm-9">@(Model.TextModule ?? "—")</dd>
            <dt class="col-sm-3">@Security.Function_Lbl_Description</dt>
            <dd class="col-sm-9">@(Model.TextDescription ?? "—")</dd>
            <dt class="col-sm-3">@Security.Col_State</dt>
            <dd class="col-sm-9">
                @if (Model.Is_Active)
                {
                    <span class="badge bg-label-success">@Security.Function_State_Protected</span>
                }
                else
                {
                    <span class="badge bg-label-secondary">@Security.Function_State_Free</span>
                }
            </dd>
            <dt class="col-sm-3">@Security.Function_Lbl_Roles</dt>
            <dd class="col-sm-9">
                @if (roles.Count == 0)
                {
                    <span>—</span>
                }
                else
                {
                    <ul class="mb-0 ps-3">
                        @foreach (var r in roles)
                        {
                            <li><a href="@Url.Action("Details", "Role", new { id = r.IdObject })">@r.TextLabel</a></li>
                        }
                    </ul>
                }
            </dd>
        </dl>
    </div>
</div>

@if (ViewBag.Audit != null)
{
    @Html.Partial("_IntranetAuditSection", (Desing.Models.IntranetAuditDisplayModel)ViewBag.Audit)
}
