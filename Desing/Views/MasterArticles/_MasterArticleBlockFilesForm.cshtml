@model DAL.Tsql_Master_Articles
@using Desing.Resources

@{
    var blocksDwg = new[]
    {
        new { Key = "LinkBlockDwgPlant3D", Label = MasterArticles.BlockSlot_Plant3D, Val = Model.LinkBlockDwgPlant3D },
        new { Key = "LinkBlockDwgVerticalElevation3D", Label = MasterArticles.BlockSlot_VertElev3D, Val = Model.LinkBlockDwgVerticalElevation3D },
        new { Key = "LinkBlockDwgHorizontalElevation3D", Label = MasterArticles.BlockSlot_HorzElev3D, Val = Model.LinkBlockDwgHorizontalElevation3D },
        new { Key = "LinkBlockDwgPlantMckUp", Label = MasterArticles.BlockSlot_PlantMockup, Val = Model.LinkBlockDwgPlantMckUp },
        new { Key = "LinkBlockDwgVerticalElevationMockUp", Label = MasterArticles.BlockSlot_VertElevMockup, Val = Model.LinkBlockDwgVerticalElevationMockUp },
        new { Key = "LinkBlockDwgHorizontalElevationMockUp", Label = MasterArticles.BlockSlot_HorzElevMockup, Val = Model.LinkBlockDwgHorizontalElevationMockUp },
    };
}

<div class="col-12"><hr class="my-2 text-muted" /></div>

<div class="col-12">
    <h6 class="mb-2 text-muted">@MasterArticles.Lbl_BlockDwgFilesSection</h6>
    <p class="small text-muted mb-2">@MasterArticles.Lbl_BlockDwgFilesHelp</p>
</div>

@foreach (var b in blocksDwg)
{
    <div class="col-md-6 mb-3">
        <label class="form-label">@b.Label</label>
        <input type="file" name="blockFile_@(b.Key)" class="form-control" accept=".dwg,.DWG" />
        @Html.Hidden(b.Key, b.Val)
        @if (!string.IsNullOrWhiteSpace(b.Val))
        {
            var href = Url.Content(b.Val.StartsWith("~/") ? b.Val : "~/" + b.Val.TrimStart('/'));
            var fileLabel = System.IO.Path.GetFileName(b.Val.Trim().Replace('\\', '/'));
            <div class="mt-2 small">
                <span class="text-muted d-block mb-1">@MasterArticles.BlockSlot_SavedFile <strong>@fileLabel</strong></span>
                <a href="@href" target="_blank" rel="noopener" class="me-2">@MasterArticles.BlockSlot_OpenFile</a>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="clear_@(b.Key)" value="true" id="clear_@(b.Key)" />
                    <label class="form-check-label" for="clear_@(b.Key)">@MasterArticles.BlockSlot_Remove</label>
                </div>
            </div>
        }
    </div>
}
