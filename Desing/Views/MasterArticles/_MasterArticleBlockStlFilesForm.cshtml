@model DAL.Tsql_Master_Articles

@{
    var blocksStl = new[]
    {
        new { Key = "LinkBlockDwgPlantStl", Label = "Planta — archivo .stl", Val = Model.LinkBlockDwgPlantStl },
        new { Key = "LinkBlockDwgVerticalElevationStl", Label = "Elevación vertical — archivo .stl", Val = Model.LinkBlockDwgVerticalElevationStl },
        new { Key = "LinkBlockDwgHorizontalElevationStl", Label = "Elevación horizontal — archivo .stl", Val = Model.LinkBlockDwgHorizontalElevationStl },
    };
}

@foreach (var b in blocksStl)
{
    <div class="col-md-6 mb-3">
        <label class="form-label">@b.Label</label>
        <input type="file" name="blockFile_@(b.Key)" class="form-control" accept=".stl,.STL" />
        @Html.Hidden(b.Key, b.Val)
        @if (!string.IsNullOrWhiteSpace(b.Val))
        {
            var href = Url.Content(b.Val.StartsWith("~/") ? b.Val : "~/" + b.Val.TrimStart('/'));
            var fileLabel = System.IO.Path.GetFileName(b.Val.Trim().Replace('\\', '/'));
            <div class="mt-2 small">
                <span class="text-muted d-block mb-1">Archivo guardado: <strong>@fileLabel</strong></span>
                <a href="@href" target="_blank" rel="noopener" class="me-2">Abrir archivo</a>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="clear_@(b.Key)" value="true" id="clear_@(b.Key)" />
                    <label class="form-check-label" for="clear_@(b.Key)">Quitar</label>
                </div>
            </div>
        }
    </div>
}
