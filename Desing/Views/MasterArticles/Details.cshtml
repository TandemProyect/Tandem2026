@model Desing.Models.MasterArticleDetailsViewModel
@using System.Linq
@{
    var a = Model.Article;
    var hasStlPreview = Model.AttachmentSlots != null && Model.AttachmentSlots.Any(s => s.StlPreviewExists);
}
@Html.Partial("_MasterArticleStlPreviewStyles")
<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> / <a href="@Url.Action("Index", "MasterArticles")">Artículos</a> /</span> Detalles
    </h4>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "MasterArticles")">Volver a la lista</a>
        <a class="btn btn-primary" href="@Url.Action("Edit", "MasterArticles", new { id = a.IdObject })">
            <i class="icon-base ri ri-edit-line me-1"></i> Editar artículo
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><strong>Identificación y sistema</strong></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5">Descripción</dt><dd class="col-sm-7">@a.TextLabel</dd>
                    <dt class="col-sm-5">Código Atenko</dt><dd class="col-sm-7">@(a.AddAtenkoCode ?? "—")</dd>
                    <dt class="col-sm-5">Empresa</dt><dd class="col-sm-7">@Model.CompanyTextLabel</dd>
                    <dt class="col-sm-5">Sistema</dt><dd class="col-sm-7">@Model.SystemTextLabel</dd>
                    <dt class="col-sm-5">Activo</dt><dd class="col-sm-7">@(a.AddIsActive ? "Sí" : "No")</dd>
                    <dt class="col-sm-5">Insertar en Master Articles</dt><dd class="col-sm-7">@(a.IInsertinMaterArticles ? "Sí" : "No")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header"><strong>Medidas y referencias</strong></div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-sm-5">Alto</dt><dd class="col-sm-7">@(a.NumberHigh?.ToString("G") ?? "—")</dd>
                    <dt class="col-sm-5">Ancho</dt><dd class="col-sm-7">@(a.NumberWidth?.ToString("G") ?? "—")</dd>
                    <dt class="col-sm-5">Largo</dt><dd class="col-sm-7">@(a.NumberLong?.ToString("G") ?? "—")</dd>
                    <dt class="col-sm-5">Peso</dt><dd class="col-sm-7">@(a.NumberWeight?.ToString("G") ?? "—")</dd>
                    <dt class="col-sm-5">M²</dt><dd class="col-sm-7">@(a.NumberMts2?.ToString("G") ?? "—")</dd>
                    <dt class="col-sm-5">M³</dt><dd class="col-sm-7">@(a.NumberMts3?.ToString("G") ?? "—")</dd>
                    <dt class="col-sm-5">Bloque DWG (texto)</dt><dd class="col-sm-7">@(a.TextBlockNumber ?? "—")</dd>
                    <dt class="col-sm-5">.Stl (texto)</dt><dd class="col-sm-7">@(a.TextStlNumber ?? "—")</dd>
                </dl>
            </div>
        </div>
    </div>
    @Html.Partial("_MasterArticleStlPreviewSection", new Desing.Models.MasterArticleStlPreviewSectionModel { AttachmentSlots = Model.AttachmentSlots ?? new System.Collections.Generic.List<Desing.Models.MasterArticleAttachmentSlot>(), TextColor1Hex = Model.StlPreviewTextColor1Hex, TextColor2Hex = Model.StlPreviewTextColor2Hex })
</div>

@section scripts
{
    @if (hasStlPreview)
    {
        var masterArticleImports = new System.Collections.Generic.Dictionary<string, string>
        {
            { "three", Url.Content("~/Scripts/Design/build/three.module.js") },
            { "@masterarticles/OrbitControls", Url.Content("~/Scripts/Design/jsm/controls/OrbitControls.js") },
            { "@masterarticles/STLLoader", Url.Content("~/Scripts/Design/jsm/loaders/STLLoader.js") },
            { "@masterarticles/InfiniteGridHelper", Url.Content("~/Scripts/MasterArticles/infinite-grid-helper.module.js") }
        };
        var masterArticleImportMap = new System.Collections.Generic.Dictionary<string, object> { { "imports", masterArticleImports } };
        <script type="importmap">
@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(masterArticleImportMap))
        </script>
        <script type="module" src="@Url.Content("~/Scripts/MasterArticles/master-article-details-stl-viewer.js")"></script>
    }
}
