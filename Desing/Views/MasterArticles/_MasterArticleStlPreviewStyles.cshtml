    }
    .ma-stl-vc-cube--iso .ma-stl-vc-face:hover {
        background: linear-gradient(180deg, #f0f6ff 0%, #dce8f8 100%);
    }
    /* Pantalla completa: panel del visor (toolbar + canvas + estado). */
    #ma-stl-viewer-shell:fullscreen {
        display: flex !important;
        flex-direction: column;
