        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        height: 52%;
        max-height: 260px;
        pointer-events: auto;
    }
    .ma-stl-clip-y-wrap input[type="range"] {
        writing-mode: vertical-lr;
        direction: rtl;
        width: 22px;
        min-height: 120px;
        flex: 1 1 auto;
        cursor: pointer;
    }
    .ma-stl-clip-x-wrap {
        position: absolute;
        left: 44px;
        right: 12px;
        bottom: 8px;
        z-index: 8;
        display: flex;
        flex-direction: column;
