        width: auto;
        max-width: min(250px, 92vw);
        pointer-events: auto;
        user-select: none;
    }
    .ma-stl-vc-wrap.d-none { pointer-events: none !important; }
    .ma-stl-vc-scene {
        width: 222px;
        height: auto;
        min-height: 106px;
        margin: 0 0 0 auto;
        padding-top: 2px;
        padding-bottom: 11px;
        perspective: 616px;
        perspective-origin: 70% 18%;
        display: flex;
        justify-content: flex-end;
        align-items: flex-start;
        filter: drop-shadow(6px 14px 14px rgba(0, 0, 0, 0.28));
    }
    .ma-stl-vc-cube {
        position: relative;
        width: 90px;
        height: 90px;
        margin: 0;
        flex-shrink: 0;
        transform-style: preserve-3d;
        transform-origin: 50% 50% 0;
    }
    /* Cubo: caras claras, líneas finas (arista exterior). */
    .ma-stl-vc-face {
        position: absolute;
        width: 90px;
        height: 90px;
        box-sizing: border-box;
        border: 1px solid #1f1f1f;
        background: linear-gradient(180deg, #f7f8fa 0%, #e4e7ec 100%);
        transform-style: preserve-3d;
    }
    .ma-stl-vc-face--front { transform: rotateY(0deg) rotateX(180deg) translateZ(-45px); }
    .ma-stl-vc-face--back { transform: rotateY(180deg) rotateX(180deg) translateZ(-45px); }
    .ma-stl-vc-face--right { transform: rotateY(90deg) rotateX(180deg) translateZ(-45px); }
    .ma-stl-vc-face--left { transform: rotateY(-90deg) rotateX(180deg) translateZ(-45px); }
    .ma-stl-vc-face--top { transform: rotateX(-90deg) rotateX(180deg) translateZ(-45px); }
    .ma-stl-vc-face--bottom { transform: rotateX(90deg) rotateX(180deg) translateZ(-45px); }
    /* Texto centrado en la cara; sin marco interior (solo borde de la cara .ma-stl-vc-face). */
    .ma-stl-vc-face-inside {
        position: absolute;
        top: 7px;
        left: 7px;
        width: 76px;
        height: 76px;
        line-height: 76px;
