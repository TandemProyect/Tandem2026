<style>
    .master-article-stl-load.is-active { box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.85); }
    #ma-stl-viewer-gl-host canvas { display: block; width: 100%; height: 100%; }
    .ma-stl-vc-wrap {
        position: absolute;
        top: 10px;
