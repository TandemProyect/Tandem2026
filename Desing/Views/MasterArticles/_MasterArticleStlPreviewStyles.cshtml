        cursor: pointer;
        z-index: 4;
        transition: background 0.12s;
    }
    .ma-stl-vc-face-inside:hover {
        background: rgba(255, 249, 230, 0.55);
    }
    .ma-stl-vc-corner {
        position: absolute;
        width: 19px;
        height: 19px;
        z-index: 5;
        cursor: pointer;
        border-radius: 3px;
    }
    .ma-stl-vc-corner:hover { background: rgba(255, 195, 0, 0.85); }
    .ma-stl-vc-corner.tl { top: -1px; left: -1px; }
    .ma-stl-vc-corner.tr { top: -1px; right: -1px; }
    .ma-stl-vc-corner.bl { bottom: -1px; left: -1px; }
    .ma-stl-vc-corner.br { bottom: -1px; right: -1px; }
    .ma-stl-vc-edge-h {
        position: absolute;
        width: 14px;
        height: 76px;
        z-index: 5;
        cursor: pointer;
    }
    .ma-stl-vc-edge-h:hover { background: rgba(255, 195, 0, 0.85); }
    .ma-stl-vc-edge-h.left { top: 7px; left: -1px; }
    .ma-stl-vc-edge-h.right { top: 7px; right: -1px; }
    .ma-stl-vc-edge-v {
        position: absolute;
        width: 76px;
        height: 14px;
        z-index: 5;
        cursor: pointer;
    }
    .ma-stl-vc-edge-v:hover { background: rgba(255, 195, 0, 0.85); }
    .ma-stl-vc-edge-v.top { top: -1px; left: 7px; }
    .ma-stl-vc-edge-v.bottom { bottom: -1px; left: 7px; }
    /* Cubo isométrico: mismas líneas finas que el ortogonal. */
    .ma-stl-vc-cube--iso .ma-stl-vc-face {
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        font-size: 20px;
        font-weight: 700;
        color: #3a3f4a;
        text-transform: uppercase;
