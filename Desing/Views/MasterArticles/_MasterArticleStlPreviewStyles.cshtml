        gap: 2px;
        pointer-events: auto;
    }
    .ma-stl-clip-x-wrap input[type="range"] {
        width: 100%;
        cursor: pointer;
        /* Izquierda = 1000 (vista completa), derecha = 0 (máximo recorte), coherente con la fracción f = (1000−v)/1000. */
        transform: scaleX(-1);
    }
</style>
