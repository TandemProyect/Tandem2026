@model DAL.Tsql_Master_Articles
@using System.Collections.Generic
@using System.Text.RegularExpressions
@using Desing.Models
@{
    ViewBag.Title = "Editar artículo";
    var stlSection = ViewData["MasterArticleStlPreview"] as MasterArticleStlPreviewSectionModel
        ?? new MasterArticleStlPreviewSectionModel { AttachmentSlots = new List<MasterArticleAttachmentSlot>() };

    /** Valor válido #rrggbb para atributo value del color (misma idea que Plantilla/Edit). */
    Func<string, string> maHexForPicker = raw =>
    {
        if (string.IsNullOrWhiteSpace(raw)) return "#000000";
        var v = raw.Trim().Replace(" ", "");
        if (v.Length == 0) return "#000000";
        if (v[0] != '#') v = "#" + v;
        if (v.Length == 9 && v[0] == '#') v = v.Substring(0, 7);
        if (Regex.IsMatch(v, "^#[0-9a-fA-F]{6}$")) return v.ToLowerInvariant();
        if (Regex.IsMatch(v, "^#[0-9a-fA-F]{3}$"))
            return ("#" + v[1] + v[1] + v[2] + v[2] + v[3] + v[3]).ToLowerInvariant();
        return "#000000";
    };
}

@section Styles
{
    @Html.Partial("_MasterArticleStlPreviewStyles")
}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> / <a href="@Url.Action("Index", "MasterArticles")">Artículos</a> /</span> Editar
    </h4>
</div>

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "MasterArticles", FormMethod.Post, new { @class = "row g-3", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdObject)
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2", role = "alert" })

            <div class="col-md-4">
                <label class="form-label">Código *</label>
                @Html.TextBoxFor(m => m.TextCode, new { @class = "form-control", maxlength = "128", autocomplete = "off" })
                @Html.ValidationMessageFor(m => m.TextCode, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-5">
                <label class="form-label">Descripción *</label>
                @Html.TextBoxFor(m => m.TextLabel, new { @class = "form-control", maxlength = "500" })
                @Html.ValidationMessageFor(m => m.TextLabel, "", new { @class = "text-danger small" })
            </div>
            <div class="col-md-3">
                <label class="form-label">Sistema *</label>
                @Html.DropDownListFor(m => m.LinkSystem, (SelectList)ViewBag.ArticleLinkSystemSelectList, "-- Seleccionar --", new { @class = "form-select" })
                @Html.ValidationMessageFor(m => m.LinkSystem, "", new { @class = "text-danger small" })
            </div>

            <div class="col-md-4">
                <label class="form-label">Código Atenko</label>
                @Html.TextBoxFor(m => m.AddAtenkoCode, new { @class = "form-control", maxlength = "50" })
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.AddIsActive, new { @class = "form-check-input" })
                    <label class="form-check-label" for="@Html.IdFor(m => m.AddIsActive)">Activo</label>
                </div>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <div class="form-check mb-2">
                    @Html.CheckBoxFor(m => m.IInsertinMaterArticles, new { @class = "form-check-input" })
                    <label class="form-check-label" for="@Html.IdFor(m => m.IInsertinMaterArticles)">Insertar en Master Articles</label>
                </div>
            </div>

            <div class="col-12"><hr class="my-1 text-muted" /></div>

            <div class="col-md-3">
                <label class="form-label">Alto</label>
                @Html.TextBoxFor(m => m.NumberHigh, "{0:G}", new { @class = "form-control", type = "number", step = "any" })
            </div>
            <div class="col-md-3">
                <label class="form-label">Ancho</label>
                @Html.TextBoxFor(m => m.NumberWidth, "{0:G}", new { @class = "form-control", type = "number", step = "any" })
            </div>
            <div class="col-md-3">
                <label class="form-label">Largo</label>
                @Html.TextBoxFor(m => m.NumberLong, "{0:G}", new { @class = "form-control", type = "number", step = "any" })
            </div>
            <div class="col-md-3">
                <label class="form-label">Peso</label>
                @Html.TextBoxFor(m => m.NumberWeight, "{0:G}", new { @class = "form-control", type = "number", step = "any" })
            </div>
            <div class="col-md-3">
                <label class="form-label">M²</label>
                @Html.TextBoxFor(m => m.NumberMts2, "{0:G}", new { @class = "form-control", type = "number", step = "any" })
            </div>
            <div class="col-md-3">
                <label class="form-label">M³</label>
                @Html.TextBoxFor(m => m.NumberMts3, "{0:G}", new { @class = "form-control", type = "number", step = "any" })
            </div>

            <div class="col-md-6">
                <label class="form-label">Bloque DWG</label>
                @Html.TextBoxFor(m => m.TextBlockNumber, new { @class = "form-control", maxlength = "200" })
            </div>
            <div class="col-md-6">
                <label class="form-label">.Stl</label>
                @Html.TextBoxFor(m => m.TextStlNumber, new { @class = "form-control", maxlength = "200" })
            </div>

            <div class="col-12"><hr class="my-1 text-muted" /></div>
            <div class="col-12">
                <h6 class="mb-1 text-muted">Archivos modelo STL</h6>
                <p class="text-muted small mb-0">Adjunte un archivo <strong>.stl</strong> por cada vista (planta y elevaciones). Son opcionales; se guardan en <code>Files/MasterArticles/blocks</code> y se muestran en Detalles con el visor 3D.</p>
            </div>
            @Html.Partial("_MasterArticleBlockStlFilesForm", Model)

            <div class="col-12">
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Color 1</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" id="ma_picker_TextColor1" value="@maHexForPicker(Model.TextColor1)" class="form-control form-control-color p-1" style="width:3.25rem;height:2.5rem" title="Color 1" />
                            @Html.TextBox("TextColor1", maHexForPicker(Model.TextColor1), new { @class = "form-control", id = "ma_TextColor1", maxlength = "200", autocomplete = "off", spellcheck = "false" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Color 2</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" id="ma_picker_TextColor2" value="@maHexForPicker(Model.TextColor2)" class="form-control form-control-color p-1" style="width:3.25rem;height:2.5rem" title="Color 2" />
                            @Html.TextBox("TextColor2", maHexForPicker(Model.TextColor2), new { @class = "form-control", id = "ma_TextColor2", maxlength = "10", autocomplete = "off", spellcheck = "false" })
                        </div>
                        <small class="text-muted d-block mt-1">Máx. 10 caracteres al guardar.</small>
                    </div>
                </div>
            </div>

            @Html.Partial("_MasterArticleBlockFilesForm", Model)

            @Html.Partial("_MasterArticleStlPreviewSection", stlSection)

            <div class="col-12 d-flex justify-content-end gap-2 tandem-form-actions mt-3">
                <a href="@Url.Action("Index", "MasterArticles")" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">
                    <i class="icon-base ri ri-save-line me-1"></i> Guardar cambios
                </button>
            </div>
        }
    </div>
</div>

@section scripts
{
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        /// <reference path="../../Scripts/types/jquery-global.d.ts" />
        /* Igual que Plantilla/Edit (syncHexPair + input/change) + ruta nativa por si el color no dispara bien con jQuery en Chromium. */
        (function () {
            /**
             * @@param {string} v
             * @@returns {string}
             */
            function expand3(v) {
                if (/^#[0-9a-fA-F]{3}$/.test(v)) {
                    return ('#' + v[1] + v[1] + v[2] + v[2] + v[3] + v[3]).toLowerCase();
                }
                return v;
            }
            /**
             * @@param {string} pickerId
             * @@param {string} textId
             */
            function wireNative(pickerId, textId) {
                var p = document.getElementById(pickerId);
                var t = document.getElementById(textId);
                if (!(p instanceof HTMLInputElement) || !(t instanceof HTMLInputElement)) return;
                function pickerToText() {
                    t.value = p.value;
                }
                function textToPicker() {
                    var v = (t.value || '').trim();
                    if (/^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/.test(v)) {
                        p.value = expand3(v);
                    }
                }
                p.addEventListener('input', pickerToText);
                p.addEventListener('change', pickerToText);
                p.addEventListener('blur', pickerToText);
                t.addEventListener('input', textToPicker);
                t.addEventListener('change', textToPicker);
            }
            wireNative('ma_picker_TextColor1', 'ma_TextColor1');
            wireNative('ma_picker_TextColor2', 'ma_TextColor2');
        })();
        if (typeof window !== 'undefined' && typeof window.jQuery === 'function') {
            /**
             * @@param {any} jq
             */
            window.jQuery(function (jq) {
                /**
                 * @@param {string} pickerSel
                 * @@param {string} inputSel
                 */
                function syncHexPair(pickerSel, inputSel) {
                    var $p = jq(pickerSel), $i = jq(inputSel);
                    if (!$p.length || !$i.length) return;
                    $p.on('input change', function () {
                        var src = /** @@type {HTMLInputElement} */ (this);
                        $i.val(src.value);
                    });
                    $i.on('input change', function () {
                        var src = /** @@type {HTMLInputElement} */ (this);
                        var v = src.value;
                        if (/^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$/.test(v)) {
                            $p.val(v);
                        }
                    });
                }
                syncHexPair('#ma_picker_TextColor1', '#ma_TextColor1');
                syncHexPair('#ma_picker_TextColor2', '#ma_TextColor2');
            });
        }
    </script>
    @if (stlSection.HasStlPreview)
    {
        var masterArticleImports = new System.Collections.Generic.Dictionary<string, string>
        {
            { "three", Url.Content("~/Scripts/Design/build/three.module.js") },
            { "@masterarticles/OrbitControls", Url.Content("~/Scripts/Design/jsm/controls/OrbitControls.js") },
            { "@masterarticles/STLLoader", Url.Content("~/Scripts/Design/jsm/loaders/STLLoader.js") },
            { "@masterarticles/InfiniteGridHelper", Url.Content("~/Scripts/MasterArticles/infinite-grid-helper.module.js") }
        };
        var masterArticleImportMap = new System.Collections.Generic.Dictionary<string, object> { { "imports", masterArticleImports } };
        <script type="importmap">
@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(masterArticleImportMap))
        </script>
        <script type="module" src="@Url.Content("~/Scripts/MasterArticles/master-article-details-stl-viewer.js")"></script>
    }
}
