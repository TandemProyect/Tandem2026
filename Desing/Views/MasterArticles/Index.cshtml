@model DAL.Tsql_Master_Articles
<ul class="breadcrumb">
    <li><a style="color:black" id="sidebarCollapse" href="#" class=""><i class="fas fa-align-justify"></i></a></li>
    <li><a href="@Url.Action("Index", "Home" )"><i class="fas fa-home"></i> Inicio</a></li>
    <li><i class="fa fa-align-justify"></i> Articulos Tandem</li>
    <li><a class="success" href="@Url.Action("Create", "MasterArticles")"><i class="fa fa-plus"></i> &nbsp;&nbsp;  Crear Nuevo artículo</a> </li>
</ul>
<div class="panel panel-default">
    <div class="panel-body" style="padding:5px;margin:5px">
        <table id="Master_Articles" class="table table-striped table-bordered table-hover" cellspacing="0" style="width: 100%; overflow: scroll">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Alto</th>
                    <th>Ancho</th>
                    <th>largo</th>
                    <th>Peso </th>
                    <th>M 2 </th>
                    <th>M 3 </th>
                    <th> Bloque Dwg </th>
                    <th>.Stl  </th>
                    <th>Color Ancho </th>
                    <th>Color Alto  </th>
                    <th>Empresa</th>
                    <th>Sistema</th>
                    <th></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section scripts
    {
    <script type="text/javascript">
        $(document).ready(function () {
        var MasterArticles = {
            dt: null,
            init: function () {
                dt = $('#Master_Articles').DataTable({
                    scrollX: true,
                    scrollY: 550,
                    dom: '<"dataTables-length-position">Bfrt<"dataTables-length-position"i>p',
                    lengthMenu: [
                        [10, 25, 50, -1],
                        ['10 rows', '25 rows', '50 rows', 'Show all']
                    ],
                    buttons: [
                        {
                            extend: 'collection',
                            text: "<i class='fas fa-bars'></i>",
                            className: 'custom-html-collection',
                            buttons: [
                                '<h5>Select Record</h5>',
                                'pageLength',
                                '<h5>Export</h5>',
                                'print',
                                'copy',
                                'pdf',
                                'csv',
                                'excel',
                                '<h5 class="not-top-heading">Column Visibility</h5>',
                                'colvis'
                            ]
                        }
                    ],
                    //buttons: [
                    //    'copy', 'csv', 'excel', 'pdf', 'print'
                    //],
                    "serverSide": true,
                    "processing": true,
                    "stateSave": true,
                    "stateDuration": 12,
                    "scrollCollapse": true,
                 
                    //stateSaveCallback: function(settings,data) {
                    //    //Save personalized buttons data:
                    //    var dataString = JSON.stringify(data);
                    //    localStorage.setItem(LocalStorageKey, dataString)
                    //},
                    //stateLoadCallback: function(settings) {
                    //    //Load Personalized buttons with selected options.
                    //    var options = JSON.parse(localStorage.getItem(LocalStorageKey));
                    //    return options;
                    //},
                    "ajax": {
                        "url": "@Url.Content("~/MasterArticles/ListMasterArticles/")",
                    "type": "POST"
                        },
                    "columns": [
                        { "data": "TextCode" },
                        { "data": "TextLabel" },
                        { "data": "NumberHigh" },
                        { "data": "NumberWidth" },
                        { "data": "NumberLong" },
                        { "data": "NumberWeight" },
                        { "data": "NumberMts2" },
                        { "data": "NumberMts3" },
                        { "data": "TextBlockNumber" },
                        { "data": "TextStlNumber" },
                        { "data": "TextColor1" },
                        { "data": "TextColor2" },
                        { "data": "CompanyTextLabel" },
                        { "data": "System_TextLabel" },
                        { "data": "emptyColumn" },
                        { "data": "SysObjectID" }
            ],
            "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
            /*   "iDisplayLength": parseInt(leerCookie("_rowsPerPage")),*/
            "fnRowCallback": function (nRow, data, iDisplayIndex) {
                $('td:eq(0)', nRow).html(data.AttName);

                if (data.allowEdit == true) {
                    $('td:eq(14)', nRow).append(data.buttonEdit + '&nbsp;');
                    $('td:eq(14)', nRow).append(data.buttonDelete + '&nbsp;');
                }
                return nRow;
            },
            "aaSorting": [[1, 'desc']],
            "aoColumnDefs": [
                { "bVisible": false, "aTargets": [15] },
                { "bSortable": false, "aTargets": [14] },
                { "width": "300px", "aTargets": [0] },
                { "width": "50px", "aTargets": [15] },
            ],
            drawCallback: function () {
                $('[data-toggle="tooltip"]').tooltip({
                    delay: { "show": 100, "hide": 100 },
                    placement: "auto right"
                }),
                    $('[title]').tooltip({
                        delay: { "show": 100, "hide": 100 },
                        placement: "auto"
                    })
            },

        });
                }
            }
    MasterArticles.init();
        });
    $('#sidebar').toggleClass('active');
        $(this).toggleClass('active');
        $('#sidebar').load('/Menu/Index');
    </script>
}

