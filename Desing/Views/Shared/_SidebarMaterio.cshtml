@*

    Sidebar vertical estilo Materio adaptado al menu de T Desing.net.

    Resalta el item activo segun la ruta actual.

    Submenus expandibles: estructura propia con clases js-menu-group /
    js-menu-group-toggle (NO se usa .menu-toggle de Materio para evitar
    que su menu.js intercepte el click y lance "Toggable .menu-item not found").
    El click lo gestiona Scripts/Intranet/sidebar-menu.js.
    Plantilla: ver _SidebarMenuItemGroup.cshtml.

*@

@using Desing.Models
@using Desing.Controllers
@using Desing.Helpers

@{

    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    var bcMenu = ViewContext.Controller as BaseController;
    var dbMenu = bcMenu != null ? bcMenu.ConexionData : null;
    Func<string, string, string> UiCommon = (key, fallback) =>
        dbMenu != null
            ? LanguageUiHelper.GetUiStringWithFallback(dbMenu, Request, key, fallback, "Common")
            : fallback;



    Func<string, string, string> activeClass = (ctrl, action) =>

        currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase) ? " active" : "";



    bool isDocumentTypeController = currentController.Equals("DocumentType", StringComparison.OrdinalIgnoreCase);

    bool isExtensionController = currentController.Equals("Extension", StringComparison.OrdinalIgnoreCase);



    bool isOfferStateController = currentController.Equals("OfferState", StringComparison.OrdinalIgnoreCase);



    bool isUiTranslationController = currentController.Equals("UiTranslation", StringComparison.OrdinalIgnoreCase);



    bool isLanguageController = currentController.Equals("Language", StringComparison.OrdinalIgnoreCase);



    bool isCountryController = currentController.Equals("Country", StringComparison.OrdinalIgnoreCase);



    var configuracionMenu = new SidebarMenuGroupModel

    {

        GroupId = "menu-configuracion",

        Title = UiCommon("Menu.Configuration", "Configuración"),

        IconClass = "ri ri-settings-3-line",

        IsOpen = isDocumentTypeController || isExtensionController || isOfferStateController || isUiTranslationController || isLanguageController || isCountryController,

        Children = new List<SidebarMenuChildItem>

        {

            new SidebarMenuChildItem

            {

                Controller = "DocumentType",

                Text = UiCommon("Menu.DocumentTypes", "Tipos de documento")

            },

            new SidebarMenuChildItem

            {

                Controller = "Extension",

                Text = UiCommon("Menu.Extensions", "Extensiones")

            },

            new SidebarMenuChildItem

            {

                Controller = "OfferState",

                Text = UiCommon("Menu.OfferStates", "Estados de oferta")

            },

            new SidebarMenuChildItem

            {

                Controller = "Language",

                Text = UiCommon("Menu.Languages", "Idiomas")

            },

            new SidebarMenuChildItem

            {

                Controller = "Country",

                Text = UiCommon("Menu.Countries", "Países")

            },

            new SidebarMenuChildItem

            {

                Controller = "UiTranslation",

                Text = UiCommon("Menu.UiTranslations", "Traducciones UI")

            }

        }

    };

}



<aside id="layout-menu" class="layout-menu menu-vertical menu">



    @* Brand Tandem (logo dinamico desde la plantilla del usuario) *@

    @{

        var plantillaLogo = (ViewBag.PlantillaLogo as string) ?? "/Content/images/Login/at.png";

        var plantillaLogoUrl = plantillaLogo.StartsWith("http", StringComparison.OrdinalIgnoreCase)

            ? plantillaLogo

            : Url.Content("~" + (plantillaLogo.StartsWith("/") ? plantillaLogo : "/" + plantillaLogo));

    }

    <div class="app-brand demo">

        <a href="@Url.Action("Index", "Home")" class="app-brand-link gap-xl-0 gap-2">

            <span class="app-brand-logo demo me-1">

                <img src="@plantillaLogoUrl" alt="Tandem" style="height:28px" />

            </span>

            <span class="app-brand-text demo menu-text fw-bold ms-2 brand-svg-sidebar">

                @Html.Partial("_BrandSvg")

            </span>

        </a>

    </div>



    <div class="menu-inner-shadow"></div>



    <ul class="menu-inner py-1">



        @* Inicio *@

        <li class="menu-item@(activeClass("Home", ""))">

            <a href="@Url.Action("Index", "Home")" class="menu-link">

                <i class="menu-icon icon-base ri ri-home-smile-line"></i>

                <div>@Html.Ui("Menu.Home", "Inicio", "Common")</div>

            </a>

        </li>



        @* Diseno *@

        <li class="menu-item@(activeClass("DesignTools", ""))">

            <a href="@Url.Action("Index", "DesignTools", new { OnlyUser = true })" class="menu-link">

                <i class="menu-icon icon-base ri ri-shape-line"></i>

                <div>@Html.Ui("Menu.Design", "Diseño", "Common")</div>

            </a>

        </li>



        @* Header Administracion *@

        <li class="menu-header small text-uppercase"><span class="menu-header-text">@Html.Ui("Menu.Administration", "Administración", "Common")</span></li>



        <li class="menu-item@(activeClass("TSql_Company", ""))">

            <a href="@Url.Action("Index", "TSql_Company")" class="menu-link">

                <i class="menu-icon icon-base ri ri-building-line"></i>

                <div>@Html.Ui("Menu.Companies", "Empresas", "Common")</div>

            </a>

        </li>



        <li class="menu-item@(activeClass("Employee", ""))">

            <a href="@Url.Action("Index", "Employee")" class="menu-link">

                <i class="menu-icon icon-base ri ri-user-line"></i>

                <div>@Html.Ui("Menu.Employees", "Empleados", "Common")</div>

            </a>

        </li>



        <li class="menu-item@(activeClass("MasterArticles", ""))">

            <a href="@Url.Action("Index", "MasterArticles")" class="menu-link">

                <i class="menu-icon icon-base ri ri-list-check-2"></i>

                <div>@Html.Ui("Menu.Articles", "Artículos", "Common")</div>

            </a>

        </li>



        <li class="menu-item@(activeClass("Plantilla", ""))">

            <a href="@Url.Action("Index", "Plantilla")" class="menu-link">

                <i class="menu-icon icon-base ri ri-palette-line"></i>

                <div>@Html.Ui("Menu.Templates", "Plantillas", "Common")</div>

            </a>

        </li>



        <li class="menu-item@(activeClass("ClientV2", ""))">

            <a href="@Url.Action("Index", "ClientV2")" class="menu-link">

                <i class="menu-icon icon-base ri ri-group-line"></i>

                <div>@Html.Ui("Menu.Clients", "Clientes", "Common")</div>

            </a>

        </li>



        <li class="menu-item@(activeClass("Jobside", ""))">

            <a href="@Url.Action("Index", "Jobside")" class="menu-link">

                <i class="menu-icon icon-base ri ri-map-pin-line"></i>

                <div>@Html.Ui("Menu.JobSites", "Obras", "Common")</div>

            </a>

        </li>



        @* Header Configuracion *@

        <li class="menu-header small text-uppercase"><span class="menu-header-text">@Html.Ui("Menu.ConfigurationSection", "Configuración", "Common")</span></li>



        @Html.Partial("_SidebarMenuItemGroup", configuracionMenu)



        @* Header Soporte *@

        <li class="menu-header small text-uppercase"><span class="menu-header-text">@Html.Ui("Menu.Support", "Soporte", "Common")</span></li>



        <li class="menu-item@(activeClass("HelpDesing", ""))">

            <a href="@Url.Action("Index", "HelpDesing")" class="menu-link">

                <i class="menu-icon icon-base ri ri-question-line"></i>

                <div>@Html.Ui("Menu.Help", "Ayuda", "Common")</div>

            </a>

        </li>



    </ul>

</aside>

