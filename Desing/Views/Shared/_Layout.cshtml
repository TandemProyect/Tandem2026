    <div id="IdLine" style="position: absolute; bottom:165px; left:0px; display:none; width:245px">
        <hr style="background-color:#ffc107; height: 1.5px; margin: 1px; padding: 1px">
    </div>

    <div id="IdDivAvatar" style="position: absolute; bottom:105px; left:5px; display:none; ">
        <div class="col-md-12" style="display: flex; align-items: center; gap: 10px;">
            <!-- Imagen del usuario -->
            <img id="Iduser" src="" style="width:50px; height:50px; border-radius: 50%;">
            <!-- Contenedor para el nombre y opciones -->
            <div style="display: flex; flex-direction: column; justify-content: flex-start;">
                <!-- Nombre del usuario -->
                <label id="IdName" style="font-weight: bold; font-size: 14px; color:white;" class="mb-2 "></label>
                <!-- Opciones debajo del nombre (alineadas horizontalmente) -->
