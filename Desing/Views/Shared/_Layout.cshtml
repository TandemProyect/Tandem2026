    <div id="Toas_General" abindex="-1" style="z-index: 250;position: absolute;display: none;">
        <div class="toast-header" style="background-color: darkgray">
            <img src="~/Content/images/Login/at.png" style="width:17px;height:17px" class="rounded mr-2" alt="...">
            <h5 id="LableToasTileGeneral" style="color: white;margin:20px"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Label</h5>
            <button id="Id_Clouse_Toas" type="button" class="ml-2 mb-1 close" data-dismiss="toast" aria-label="Close">
                <span aria-hidden="true"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;  &times;</span>
            </button>
        </div>
        <div class="toast-body" style="background-color:white">
            <h5 id="LableToasContentedeGeneral" style="color: black"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Atk-60 </h5>
        </div>
    </div>
    <div id="Toas_General" abindex="-1" role="dialog" style="z-index: 250; background-color: #E4E5E3; position: absolute; top: 70px; left: 50px; width: 500px; display: none; border-radius: 2rem; box-shadow: 5px 10px #888888; padding: 0px; margin: 0px ">
        <div class="col-md-12">
            <div class="modal-body">
                <div class="col-md-12">
                    &nbsp;&nbsp;<i class="fa fa-info fa-2x" style="color: #4CBCF8; ">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</i>
                    <label id="LableToasTileGeneral" style="color: #1A30E0">Label</label>
                </div>
            </div>
            <hr style="color: #F88402; margin: 0px " />
            <div class="col-md-12" style="padding: 10px; margin:10px">
                <div class="col-md-12" style="height: 50px;">
                    <label id="LableToasContentedeGeneral" style="color: black">Label Contented</label>
                </div>

            </div>
            <hr style="color: #F88402; margin: 0px " />
        </div>
    </div>
    <div class="wrapper" id="leftMenu">
        <nav id="sidebar" style="height:1500px">
            @*@Html.Action("Index", "Menu")*@
        </nav>
        <!-- Page Content Holder -->
        <div id="MainContainer" style="width: 100%; height: 100%">
            @RenderBody()
        </div>
    </div>

    <div class="modal_background" id="IdDivmodal_background" style="position: absolute; bottom: 0px; width: 100%; background-color: #00428A">
        <div id="menufooter" style="height: 35px; background: #00428A; width: 100%; border-top: 2px solid darkgray; background-color: #00428A">
            <div style="margin-bottom:50px; padding-left: 20px; color:white">   @DateTime.Now.Year - Tandem Desing V 1.0 Entorno Develop  <span style="color:aliceblue">  Última publicación 20/01/2025</span></div>
        </div>
    </div>
    <div style="width:100%" id="View">
        <div class="modal fade" id="DesingModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Modal title</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        ...
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary">Save changes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
