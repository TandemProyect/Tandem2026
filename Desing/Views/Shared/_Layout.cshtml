    <script type="text/javascript">
        $(document).ready(function () {
            /*$("#content").slideUp('fast', function () { $('#nav').css('overflow', 'hidden') });*/
            document.getElementById("View").style.overflow = "hidden";
            var screenWidth = screen.width;
            var screenHeight = screen.height;

            // Get the browser window size
            var windowWidth = window.innerWidth;
            var windowHeight = window.innerHeight;

            // Get the size of the entire webpage
            const pageWidth = document.documentElement.scrollWidth;
            const pageHeight = document.documentElement.scrollHeight;

            $('#content').height(window.innerHeight - 85)
            $('#Id_Sub_VS_Menu').height(window.innerHeight - 160)
            $('#Id_VS_Menu').height(window.innerHeight - 225)

            $('#sidebarCollapse').on('click', function () {
                if (document.getElementById("IdDivAvatar").style.display == "inline") {
                    //document.getElementById("IdDivUser").style.display = "none";
                    document.getElementById("IdDivAvatar").style.display = "none";
                    //document.getElementById("IdDivUserExit").style.display = "none";
                    document.getElementById("IdLine").style.display = "none";
                    document.getElementById("IdLine_2").style.display = "none";

                }
                else {
                    setTimeout(function () {
                       // document.getElementById("IdDivUser").style.display = "inline";
                        document.getElementById("IdDivAvatar").style.display = "inline";
                      //  document.getElementById("IdDivUserExit").style.display = "inline";
                        document.getElementById("IdLine").style.display = "inline";
                        document.getElementById("IdLine_2").style.display = "inline";

                    }, 400);
                }
                $('#sidebar').toggleClass('active');
                $(this).toggleClass('active');

            });
            $('#CloseLoginBtn').on('click', function () {
                $('.Login').toggleClass('collapsed');
            });
            $('#Iddiva').on('click', function () {
                $('#MenuDesign').fadeIn();
            });

        });

    </script>
    @RenderSection("scripts", required: false)
