@using Desing.Resources
@using Newtonsoft.Json
@{
    var onceKey = ViewBag.BootSplashOnceKey as string;
    var cookieLogo = Request.Cookies != null && Request.Cookies[Desing.Helpers.PluginCadDeviceHelper.LogoCookieName] != null
        ? Request.Cookies[Desing.Helpers.PluginCadDeviceHelper.LogoCookieName].Value
        : null;
    var raw = (ViewBag.CompanyLogoUrl as string)
        ?? cookieLogo
        ?? (ViewBag.PlantillaLogo as string)
        ?? Desing.Helpers.PluginCadDeviceHelper.DefaultLogoVirtualPath;
    if (string.IsNullOrWhiteSpace(raw)
        || raw.IndexOf("/Login/at.png", StringComparison.OrdinalIgnoreCase) >= 0)
    {
        raw = Desing.Helpers.PluginCadDeviceHelper.DefaultLogoVirtualPath;
    }
    var logoUrl = raw.StartsWith("http", StringComparison.OrdinalIgnoreCase) || raw.StartsWith("//", StringComparison.Ordinal)
        ? raw
        : Url.Content("~" + (raw.StartsWith("/") ? raw : "/" + raw));
    var loadingText = Common.App_BootLoading;
    if (string.IsNullOrWhiteSpace(loadingText))
    {
        loadingText = "Cargando TDesing…";
    }
    var etaSeconds = Common.App_BootEtaSeconds;
    if (string.IsNullOrWhiteSpace(etaSeconds))
    {
        etaSeconds = "Quedan unos {0} s";
    }
    var etaMinute = Common.App_BootEtaMinute;
    if (string.IsNullOrWhiteSpace(etaMinute))
    {
        etaMinute = "Queda 1 min";
    }
    var etaMinutes = Common.App_BootEtaMinutes;
    if (string.IsNullOrWhiteSpace(etaMinutes))
    {
        etaMinutes = "Quedan unos {0} min";
    }
    var etaAlmost = Common.App_BootEtaAlmost;
    if (string.IsNullOrWhiteSpace(etaAlmost))
    {
        etaAlmost = "Casi listo…";
    }
    var etaCold = Common.App_BootEtaCold;
    if (string.IsNullOrWhiteSpace(etaCold))
    {
        etaCold = "Sigue conectando…";
    }
}
<style>
    #tdesing-boot-splash {
        position: fixed;
        inset: 0;
        z-index: 20000;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #FFF8F5 0%, #F5F5F9 45%, #EEF1F8 100%);
        font-family: Segoe UI, Arial, sans-serif;
        transition: opacity .35s ease;
    }
    #tdesing-boot-splash.is-done { opacity: 0; pointer-events: none; }
    #tdesing-boot-splash .tdesing-boot-card {
        width: 280px;
        background: #fff;
        border: 1px solid #ece7e1;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(44,51,64,.16);
        text-align: center;
        overflow: hidden;
        padding: 0 0 24px;
    }
    #tdesing-boot-splash .tdesing-boot-bar { height: 6px; background: var(--tandem-primary, #349d7d); }
    #tdesing-boot-splash img { max-width: 220px; height: 52px; object-fit: contain; margin: 28px auto 0; display: block; }
    #tdesing-boot-splash .tdesing-boot-clock {
        width: 56px; height: 56px; margin: 20px auto 0; position: relative;
    }
    #tdesing-boot-splash .tdesing-boot-ring {
        position: absolute; inset: 0;
        border: 4px solid transparent;
        border-top-color: var(--tandem-primary, #349d7d);
        border-radius: 50%;
        animation: tdesing-boot-spin .85s linear infinite;
    }
    #tdesing-boot-splash .tdesing-boot-hands {
        position: absolute; inset: 0;
        animation: tdesing-boot-spin 1.35s linear infinite;
    }
    #tdesing-boot-splash .tdesing-boot-hands:before,
    #tdesing-boot-splash .tdesing-boot-hands:after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        background: #2C3340;
        border-radius: 2px;
        transform-origin: 50% 0;
    }
    #tdesing-boot-splash .tdesing-boot-hands:before {
        width: 2.4px; height: 14px; margin: -14px 0 0 -1.2px; background: #2C3340;
    }
    #tdesing-boot-splash .tdesing-boot-hands:after {
        width: 2.4px; height: 10px; margin: 0 0 0 -1.2px; background: var(--tandem-primary, #349d7d); transform: rotate(90deg); transform-origin: 50% 0;
    }
    #tdesing-boot-splash .tdesing-boot-dot {
        position: absolute; left: 50%; top: 50%; width: 8px; height: 8px;
        margin: -4px 0 0 -4px; background: var(--tandem-primary, #349d7d); border-radius: 50%;
    }
    #tdesing-boot-splash p {
        margin: 16px 20px 0;
        font-size: 15px; font-weight: 600; color: #2C3340;
    }
    #tdesing-boot-splash .tdesing-boot-eta {
        margin: 8px 20px 0;
        font-size: 13px; font-weight: 600; color: #0f172a;
        font-variant-numeric: tabular-nums;
    }
    #tdesing-boot-splash .tdesing-boot-progress {
        width: 200px; height: 6px; margin: 12px auto 0;
        background: #E8E6F4; border-radius: 999px; overflow: hidden;
    }
    #tdesing-boot-splash .tdesing-boot-progress-bar {
        height: 100%; width: 8%; background: var(--tandem-primary, #349d7d); border-radius: 999px;
        transition: width .28s linear;
    }
    @@keyframes tdesing-boot-spin { to { transform: rotate(360deg); } }
</style>
<div id="tdesing-boot-splash" role="status" aria-live="polite">
    <div class="tdesing-boot-card">
        <div class="tdesing-boot-bar"></div>
        <img src="@logoUrl" alt="TDesing" />
        <div class="tdesing-boot-clock" aria-hidden="true">
            <div class="tdesing-boot-ring"></div>
            <div class="tdesing-boot-hands"></div>
            <div class="tdesing-boot-dot"></div>
        </div>
        <p>@loadingText</p>
        <div id="tdesing-boot-eta" class="tdesing-boot-eta">@etaAlmost</div>
        <div class="tdesing-boot-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="8">
            <div id="tdesing-boot-progress-bar" class="tdesing-boot-progress-bar"></div>
        </div>
    </div>
</div>
<script>
    (function () {
        var el = document.getElementById('tdesing-boot-splash');
        if (!el) return;
        var onceKey = @Html.Raw(JsonConvert.SerializeObject(onceKey ?? ""));
        var hold = @Html.Raw(((ViewBag.BootSplashHold as bool?) == true).ToString().ToLowerInvariant());
        var tplSeconds = @Html.Raw(JsonConvert.SerializeObject(etaSeconds));
        var tplMinute = @Html.Raw(JsonConvert.SerializeObject(etaMinute));
        var tplMinutes = @Html.Raw(JsonConvert.SerializeObject(etaMinutes));
        var tplAlmost = @Html.Raw(JsonConvert.SerializeObject(etaAlmost));
        var tplCold = @Html.Raw(JsonConvert.SerializeObject(etaCold));
        var etaEl = document.getElementById('tdesing-boot-eta');
        var barEl = document.getElementById('tdesing-boot-progress-bar');
        var storeKey = 'tdesing-boot-eta-ms';
        var startedAt = Date.now();
        var predicted = hold ? 15000 : 8000;
        var coldMs = 20000;
        var cold = false;
        var tickTimer = null;
        try {
            if (onceKey && window.sessionStorage && sessionStorage.getItem(onceKey)) {
                el.parentNode.removeChild(el);
                return;
            }
        } catch (e) { }
        try {
            if (window.sessionStorage) {
                var last = parseInt(sessionStorage.getItem(storeKey) || '0', 10);
                if (last >= 2500) predicted = last;
            }
        } catch (e4) { }

        function formatEta(ms, coldHang) {
            if (coldHang) return tplCold;
            if (!(ms > 0) || ms < 1400) return tplAlmost;
            var sec = Math.max(1, Math.ceil(ms / 1000));
            if (sec < 55) return String(tplSeconds || '').replace('{0}', String(sec));
            var min = Math.max(1, Math.round(sec / 60));
            if (min <= 1) return tplMinute;
            return String(tplMinutes || '').replace('{0}', String(min));
        }

        function refreshEta() {
            var elapsed = Date.now() - startedAt;
            if (!cold && elapsed > predicted + 1500) {
                cold = true;
                predicted = coldMs;
            }
            var remaining = Math.max(1100, predicted - elapsed * 0.72);
            var coldHang = cold && elapsed > predicted;
            if (etaEl) etaEl.textContent = formatEta(remaining, coldHang);
            var pct;
            if (coldHang) pct = Math.min(96, 78 + (elapsed - predicted) / 4000);
            else pct = Math.max(6, Math.min(92, (elapsed / Math.max(1, predicted)) * 88));
            if (barEl) barEl.style.width = pct + '%';
        }

        function stopEta() {
            if (tickTimer) {
                window.clearInterval(tickTimer);
                tickTimer = null;
            }
        }

        function dismiss() {
            if (!el || el.getAttribute('data-done') === '1') return;
            el.setAttribute('data-done', '1');
            stopEta();
            try {
                if (window.sessionStorage)
                    sessionStorage.setItem(storeKey, String(Math.max(2500, Date.now() - startedAt)));
            } catch (e5) { }
            el.classList.add('is-done');
            try {
                if (onceKey && window.sessionStorage) sessionStorage.setItem(onceKey, '1');
            } catch (e2) { }
            setTimeout(function () {
                if (el && el.parentNode) el.parentNode.removeChild(el);
            }, 400);
            try {
                if (window.chrome && window.chrome.webview)
                    window.chrome.webview.postMessage(JSON.stringify({ action: 'page-ready' }));
            } catch (e3) { }
        }

        window.TdesingBootSplashDismiss = dismiss;
        refreshEta();
        tickTimer = window.setInterval(refreshEta, 280);
        if (!hold) {
            if (document.readyState === 'complete') dismiss();
            else window.addEventListener('load', dismiss);
            setTimeout(dismiss, 12000);
        } else {
            setTimeout(dismiss, 20000);
        }
    })();
</script>
