<style>
    .tandem-pwd-toggle {
        min-width: 44px;
        z-index: 3;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .tandem-pwd-toggle svg {
        width: 20px;
        height: 20px;
        fill: none;
        stroke: #6e6b80;
        stroke-width: 1.8;
    }
    .tandem-pwd-toggle .pwd-eye-on { display: none; }
</style>
<script>
    document.addEventListener('click', function (e) {
        var btn = e.target.closest ? e.target.closest('.tandem-pwd-toggle') : null;
        if (!btn) return;
        e.preventDefault();
        var group = btn.closest('.input-group');
        var pwd = group ? group.querySelector('input') : null;
        if (!pwd) return;
        var show = pwd.getAttribute('type') === 'password';
        pwd.setAttribute('type', show ? 'text' : 'password');
        btn.setAttribute('aria-pressed', show ? 'true' : 'false');
        var off = btn.querySelector('.pwd-eye-off');
        var on = btn.querySelector('.pwd-eye-on');
        if (off) off.style.display = show ? 'none' : '';
        if (on) on.style.display = show ? '' : 'none';
    });
</script>
