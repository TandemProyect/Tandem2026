@*
    Layout principal estilo Materio adaptado para ASP.NET MVC 5 / .NET Framework 4.8.
    Reemplaza al _Layout.cshtml clasico de T Desing.net.
*@
<!DOCTYPE html>
<html lang="es"
      class="light-style layout-menu-fixed layout-compact"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="@Url.Content("~/assets/materio/")"
      data-template="vertical-menu-template-free">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <title>@(ViewBag.Title ?? "T Desing.net")</title>

    @{
        var faviconPath = (ViewBag.PlantillaFavicon as string) ?? "/assets/client/images/Default/Ico/at.ico";
        var faviconUrl = faviconPath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? faviconPath
            : Url.Content("~" + (faviconPath.StartsWith("/") ? faviconPath : "/" + faviconPath));
    }
    <link rel="icon" href="@faviconUrl" />

    @{
        var googleFontsUrl = "https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap";
    }
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="@googleFontsUrl" rel="stylesheet" />

    <!-- Iconify icons -->
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/fonts/iconify-icons.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/libs/node-waves/node-waves.css")" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/css/core.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/css/demo.css")" />

    <!-- perfect-scrollbar (requerido por SideNav) -->
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/libs/perfect-scrollbar/perfect-scrollbar.css")" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/css/site.css")" />

    @* DataTables - estilo Bootstrap 5 (Materio) via CDN *@
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/colreorder/1.7.0/css/colReorder.bootstrap5.min.css" />
    @* Resize de columnas (handles propios) *@
    <link rel="stylesheet" href="@Url.Content("~/Scripts/datatables-resize.css")" />
    @* DataTables: color, tamaño y capitalización de cabeceras *@
    <link rel="stylesheet" href="@Url.Content("~/Scripts/datatables-tandem.css")" />

    @* Identificacion del usuario para clave de cookies de DataTables *@
    <meta name="dt-user" content="@(User != null && User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "anon")" />

    @* FontAwesome (compatibilidad con vistas existentes) *@
    <link href="@Url.Content("~/lib/font-awesome/css/all.css")" rel="stylesheet" />

    @* Helpers de Materio (config inicial del template) *@
    <script src="@Url.Content("~/assets/materio/vendor/js/helpers.js")"></script>
    <script src="@Url.Content("~/assets/materio/js/config.js")"></script>

    @* === Plantilla del usuario (color principal) ============================== *@
    @Html.Partial("_PlantillaStyles")

    @RenderSection("Styles", required: false)
</head>

<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">

            @Html.Partial("_SidebarMaterio")

            <div class="layout-page">

                @Html.Partial("_NavbarMaterio")

                <div class="content-wrapper">
                    <div class="container-fluid flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>

                    @Html.Partial("_FooterMaterio")

                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>

        <div class="layout-overlay layout-menu-toggle"></div>
        <div class="drag-target"></div>
    </div>

    <!-- Core Scripts -->
    <script src="@Url.Content("~/assets/materio/vendor/libs/jquery/jquery.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/libs/popper/popper.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/js/bootstrap.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/libs/node-waves/node-waves.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/libs/perfect-scrollbar/perfect-scrollbar.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/js/menu.js")"></script>

    <!-- Main JS -->
    <script src="@Url.Content("~/assets/materio/js/main.js")"></script>

    @* DataTables - JS con bridge Bootstrap 5 *@
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.colVis.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    @* ColReorder: arrastrar columnas para reordenar *@
    <script src="https://cdn.datatables.net/colreorder/1.7.0/js/dataTables.colReorder.min.js"></script>
    @* Helper de estado por usuario en cookie (orden, anchos, visibilidad...) *@
    <script src="@Url.Content("~/Scripts/datatables-state.js")"></script>

    @* Toggle del sidebar en escritorio: cookie por usuario (misma meta dt-user que DataTables) *@
    <script>
        (function () {
            var toggleBtn = document.getElementById('navbarMenuToggle');
            if (!toggleBtn) return;
            var html = document.documentElement;
            var LS_LEGACY = 'tandem-menu-collapsed';
            var COOKIE_GLOBAL_LEGACY = 'tandem_menu_collapsed';
            var COOKIE_DAYS = 365;

            function getDtUser() {
                var meta = document.querySelector('meta[name="dt-user"]');
                var c = meta && meta.getAttribute('content');
                return (c && c.length) ? c : 'anon';
            }

            var COOKIE_NAME = 'tandem_menu_collapsed_' + getDtUser();

            function getCookie(name) {
                var re = new RegExp('(?:^|; )' + name.replace(/([.$?*|{}()\[\]\\\/\+^])/g, '\\$1') + '=([^;]*)');
                var m = document.cookie.match(re);
                return m ? decodeURIComponent(m[1]) : null;
            }
            function setCookie(name, value) {
                var d = new Date();
                d.setTime(d.getTime() + COOKIE_DAYS * 86400000);
                try {
                    document.cookie = name + '=' + encodeURIComponent(value) +
                        ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
                } catch (err) { /* noop */ }
            }
            function deleteCookie(name) {
                try {
                    document.cookie = name + '=;expires=Thu, 01 Jan 1970 00:00:01 GMT;path=/';
                } catch (e3) { /* noop */ }
            }

            /* Migrar: cookie global sin usuario, luego localStorage legacy */
            try {
                if (getCookie(COOKIE_NAME) === null) {
                    var g = getCookie(COOKIE_GLOBAL_LEGACY);
                    if (g === '1' || g === '0') {
                        setCookie(COOKIE_NAME, g);
                        deleteCookie(COOKIE_GLOBAL_LEGACY);
                    } else if (window.localStorage) {
                        var legacy = localStorage.getItem(LS_LEGACY);
                        if (legacy === '1' || legacy === '0') {
                            setCookie(COOKIE_NAME, legacy);
                            localStorage.removeItem(LS_LEGACY);
                        }
                    }
                }
            } catch (e2) { /* noop */ }

            if (getCookie(COOKIE_NAME) === '1') {
                html.classList.add('layout-menu-collapsed');
            }

            toggleBtn.addEventListener('click', function (e) {
                if (window.innerWidth >= 1200) {
                    e.preventDefault();
                    e.stopPropagation();
                    html.classList.toggle('layout-menu-collapsed');
                    setCookie(COOKIE_NAME, html.classList.contains('layout-menu-collapsed') ? '1' : '0');
                }
            }, true);
        })();
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
