<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "T Desing.net")</title>
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/assets/client/images/Default/Ico/at.ico")" />

    <link href="@Url.Content("~/assets/dist/css/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
    <link href="@Url.Content("~/assets/materio/vendor/fonts/iconify-icons.css")" rel="stylesheet" />
    <link href="@Url.Content("~/lib/font-awesome/css/all.css")" rel="stylesheet" />

    @RenderSection("Styles", required: false)
</head>
<body style="background-color:#f8fafc;">
    <div class="container-fluid py-3">
        @RenderBody()
    </div>

    <script src="@Url.Content("~/Scripts/jquery-3.5.1.js")"></script>
    <script src="@Url.Content("~/assets/dist/js/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
