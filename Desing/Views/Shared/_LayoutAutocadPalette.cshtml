@*
    Layout mínimo para paletas flotantes del plugin AutoCAD (sin navbar/sidebar).
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Tandem 2026")</title>
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/fonts/iconify-icons.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/css/core.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/css/site.css")" />
    @Html.Partial("_PlantillaStyles")
    @{
        var pluginLogoRaw = (ViewBag.PlantillaLogo as string) ?? "/Content/images/tDesing/t-desing-net.png";
        string pluginPlantillaLogoAbs;
        if (pluginLogoRaw.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            || pluginLogoRaw.StartsWith("//", StringComparison.Ordinal))
        {
            pluginPlantillaLogoAbs = pluginLogoRaw.StartsWith("//", StringComparison.Ordinal)
                ? ((Request.Url != null ? Request.Url.Scheme : "https") + ":" + pluginLogoRaw)
                : pluginLogoRaw;
        }
        else
        {
            var virtualLogo = pluginLogoRaw.StartsWith("~/") ? pluginLogoRaw : ("~" + (pluginLogoRaw.StartsWith("/") ? pluginLogoRaw : "/" + pluginLogoRaw));
            var origin = Request.Url != null ? Request.Url.GetLeftPart(UriPartial.Authority) : "";
            pluginPlantillaLogoAbs = origin + Url.Content(virtualLogo);
        }
    }
    <style>
        html, body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            height: 100%;
            background: transparent;
        }
        .autocad-palette {
            padding: 0;
            height: 100%;
            display: flex;
            align-items: center;
        }
        .autocad-palette .desing2-stl-mode-toolbar,
        .autocad-palette .desing2-stl-top-toolbar {
            position: static;
            transform: none;
            left: auto;
            top: auto;
            pointer-events: auto;
        }
        .autocad-palette .desing2-stl-floating-toolbar__group-gap {
            width: 0.45rem;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="autocad-palette desing2-stl-view-scope">
        @RenderBody()
    </div>
    <script src="@Url.Content("~/assets/materio/vendor/libs/jquery/jquery.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/libs/popper/popper.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/js/bootstrap.js")"></script>
    <script>
        (function () {
            function post(payload) {
                try {
                    if (!window.chrome || !window.chrome.webview) return;
                    try { window.chrome.webview.postMessage(payload); }
                    catch (e) { window.chrome.webview.postMessage(JSON.stringify(payload)); }
                } catch (e) { }
            }
            post({
                action: 'plantilla-theme',
                color: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((ViewBag.PlantillaColor as string) ?? "#7367F0")),
                textColor: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(string.IsNullOrWhiteSpace(ViewBag.PlantillaBrandTextColor as string) ? "#ffffff" : ((string)ViewBag.PlantillaBrandTextColor).Trim())),
                logo: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(pluginPlantillaLogoAbs))
            });
            document.addEventListener('click', function (e) {
                var menu = e.target.closest('[data-plugin-menu]');
                if (menu && !menu.disabled) {
                    var payload = { action: menu.getAttribute('data-plugin-menu') };
                    var view = menu.getAttribute('data-view');
                    if (view) payload.view = view;
                    post(payload);
                    return;
                }
                var el = e.target.closest('[data-ma-stl-tool],[data-ma-stl-mode],[data-ma-system]');
                if (!el || el.disabled) return;
                post({
                    tool: el.getAttribute('data-ma-stl-tool'),
                    mode: el.getAttribute('data-ma-stl-mode'),
                    system: el.getAttribute('data-ma-system')
                });
            });
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
