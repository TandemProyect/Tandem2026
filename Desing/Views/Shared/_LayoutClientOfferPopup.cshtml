@*
    Layout mínimo para el popup de oferta desde el visor: sin menú, navbar ni pie.
*@
@{
    Layout = null;
    ViewBag.SkipIntranetDataTables = true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Oferta cliente")</title>
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/vendor/css/core.css")" />
    <link rel="stylesheet" href="@Url.Content("~/assets/materio/css/demo.css")" />
    <style>
        html, body { height: 100%; margin: 0; background: #f8fafc; }
        body { overflow: auto; }
        .offer-popup-shell { min-height: 100%; padding: 12px; box-sizing: border-box; }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="offer-popup-shell">
        @RenderBody()
    </div>
    <script src="@Url.Content("~/assets/materio/vendor/libs/jquery/jquery.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/libs/popper/popper.js")"></script>
    <script src="@Url.Content("~/assets/materio/vendor/js/bootstrap.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
