@*
    Overrides globales del color primario con el color de la plantilla activa.
    Se inyecta en todos los layouts para que Bootstrap, Materio y DataTables usen
    var(--tandem-primary) en lugar del #349d7d hardcodeado del tema.

    Uso: @Html.Partial("_PlantillaStyles") dentro del <head> despues de los <link>
    a las hojas de estilo del tema.
*@
@{
    var _plantillaColor = (ViewBag.PlantillaColor as string) ?? "#349d7d";
    var _brandAccent = (ViewBag.PlantillaBrandAccentColor as string) ?? "#f29100";
    var _plantillaLinkRaw = ViewBag.PlantillaLinkColor as string;
    var _linkColor = string.IsNullOrWhiteSpace(_plantillaLinkRaw) ? _plantillaColor : _plantillaLinkRaw.Trim();
    var _activeMenuColor = string.IsNullOrWhiteSpace(_plantillaLinkRaw) ? "#fff" : _linkColor;
    var _brandTextRaw = ViewBag.PlantillaBrandTextColor as string;
    var _brandText = string.IsNullOrWhiteSpace(_brandTextRaw) ? null : _brandTextRaw.Trim();
    var _contentLinkColor = _brandText ?? _plantillaColor;
    var _menuIdleColor = _brandText ?? _plantillaColor;
    var _menuUiVars =
        "#layout-menu { --bs-menu-color: " + _menuIdleColor + "; --bs-menu-hover-color: " + _menuIdleColor + "; --bs-menu-item-icon-color: " + _menuIdleColor + "; --bs-menu-active-color: " + _activeMenuColor + "; }" +
        "#layout-menu .menu-item.active > .menu-link:not(.js-menu-group-toggle) { color: var(--bs-menu-active-color) !important; }" +
        "#layout-menu .menu-item.active .menu-icon, #layout-menu .menu-item.active .menu-icon-arrow { color: var(--bs-menu-active-color) !important; }";
    var _linkUiVars = string.IsNullOrWhiteSpace(_plantillaLinkRaw)
        ? string.Empty
        : ":is(.btn, .dt-button, .page-link, .dropdown-item, .nav-link, .list-group-item-action, .paginate_button) { color: var(--tandem-link) !important; }" +
          ".dt-buttons .btn, .dt-buttons .dt-button, div.dt-buttons > .btn, div.dt-buttons > .dt-button, " +
          ".dataTables_wrapper .dt-buttons .btn, .dataTables_wrapper .dt-buttons .dt-button, .dataTables_wrapper .dt-buttons .btn-secondary, " +
          ".dt-button-collection .dt-button, .dt-button-collection .dropdown-item, .dt-button-collection button.dt-button, " +
          ".dt-button-collection .dropdown-header, .dt-button-collection h6, .dt-button-collection .dt-button-collection-title { color: var(--tandem-link) !important; }" +
          ".dt-buttons .btn:hover, .dt-buttons .dt-button:hover, div.dt-buttons > .btn:hover, div.dt-buttons > .dt-button:hover, " +
          ".dt-buttons .btn:focus, .dt-buttons .dt-button:focus, .dt-buttons .btn:active, .dt-buttons .dt-button:active, .dt-buttons .dt-button.active, " +
          ".dt-button-collection .dt-button:hover, .dt-button-collection .dropdown-item:hover, " +
          ".dt-button-collection .dt-button.active, .dt-button-collection .dropdown-item.active, .dt-button-collection .dropdown-item:active { color: var(--tandem-link) !important; }" +
          ":is(.btn, .dt-button, .dropdown-item, .page-link, .nav-link, .list-group-item-action) :is(i, svg, .icon-base) { color: var(--tandem-link) !important; }";
    var _brandTextRootVar = _brandText == null ? string.Empty : "--tandem-brand-text: " + _brandText + ";";
    var _brandTextUi = _brandText == null ? string.Empty :
        "#desing2-stl-hover-side-panel .form-label, " +
        "#desing2-stl-hover-side-panel label, " +
        "#desing2-stl-hover-side-panel .form-text, " +
        "#desing2-stl-hover-side-panel small, " +
        "#desing2-stl-hover-side-panel .text-muted, " +
        "#desing2-stl-hover-side-panel .form-select, " +
        "#desing2-stl-hover-side-panel .form-control { color: var(--tandem-brand-text) !important; }";
}
@*
    Tipografia de la marca "T Desing.net":
      - Windows: usa Candara Light (instalada de serie).
      - Otros sistemas: fallback a Questrial (Google Fonts, humanista similar).
*@
@if (ViewBag.SkipRemoteFonts as bool? != true)
{
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Questrial&display=swap" rel="stylesheet" />
}
<style>
    /* ---- Marca T Desing.net -------------------------------------------- */
    .brand-font,
    .app-brand-text,
    .app-brand-text .brand-font,
    .app-brand-text .brand-font * {
        font-family: 'Candara Light', 'Candara', 'Questrial', 'Segoe UI', sans-serif !important;
        font-weight: 300 !important;
        letter-spacing: 0.01em;
        white-space: nowrap;
        text-transform: none !important;
    }
    /* Primera letra en italica; color acento configurable por plantilla. */
    .brand-font .brand-t {
        font-style: italic;
        color: @_brandAccent !important;
        font-weight: 400 !important;
        margin-right: 0.05em;
    }
    /* "Desing.net" hereda el color del contenedor (currentColor / plantilla). */
    .brand-font .brand-rest {
        font-style: normal;
        color: inherit;
    }
    /* Compatibilidad: clases .brand-svg* heredadas siguen sirviendo de tamano. */
    .brand-svg,
    .brand-font {
        display: inline-block;
        vertical-align: middle;
        line-height: 1;
    }
    .brand-svg-sidebar, .brand-font.brand-svg-sidebar { font-size: 20px; }
    .brand-svg-login,   .brand-font.brand-svg-login   { font-size: 30px; }
    .brand-svg-footer,  .brand-font.brand-svg-footer  { font-size: 14px; }
    .brand-svg-preview, .brand-font.brand-svg-preview { font-size: 24px; }
    /* ---- Variables Bootstrap a nivel raiz ----------------------------- */
    :root,
    [data-bs-theme="light"],
    [data-bs-theme="dark"] {
        --tandem-primary: @_plantillaColor;
        --tandem-link: @_linkColor;
        --tandem-content-link: @_contentLinkColor;
        --bs-primary: @_plantillaColor !important;
        --bs-primary-rgb: var(--tandem-primary-rgb, 52, 157, 125);
        --bs-link-color: @_linkColor !important;
        --bs-link-hover-color: @_linkColor !important;
        @Html.Raw(_brandTextRootVar)
    }

    /* ---- Boton primary ------------------------------------------------- */
    .btn-primary {
        --bs-btn-bg: var(--tandem-primary) !important;
        --bs-btn-border-color: var(--tandem-primary) !important;
        --bs-btn-hover-bg: var(--tandem-primary) !important;
        --bs-btn-hover-border-color: var(--tandem-primary) !important;
        --bs-btn-active-bg: var(--tandem-primary) !important;
        --bs-btn-active-border-color: var(--tandem-primary) !important;
        --bs-btn-disabled-bg: var(--tandem-primary) !important;
        --bs-btn-disabled-border-color: var(--tandem-primary) !important;
        filter: none;
    }
    .btn-primary:hover,
    .btn-primary:focus,
    .btn-primary:active,
    .btn-primary.active {
        filter: brightness(0.92);
    }

    /* ---- Boton outline-primary ---------------------------------------- */
    .btn-outline-primary {
        --bs-btn-color: var(--tandem-primary) !important;
        --bs-btn-border-color: var(--tandem-primary) !important;
        --bs-btn-hover-bg: var(--tandem-primary) !important;
        --bs-btn-hover-border-color: var(--tandem-primary) !important;
        --bs-btn-active-bg: var(--tandem-primary) !important;
        --bs-btn-active-border-color: var(--tandem-primary) !important;
        --bs-btn-disabled-color: var(--tandem-primary) !important;
        --bs-btn-disabled-border-color: var(--tandem-primary) !important;
    }

    /* ---- Backgrounds / textos / bordes utilitarios -------------------- */
    .bg-primary { background-color: var(--tandem-primary) !important; }
    .text-primary { color: var(--tandem-primary) !important; }
    .border-primary { border-color: var(--tandem-primary) !important; }
    .link-primary { color: var(--tandem-primary) !important; }
    a { color: var(--tandem-content-link); text-decoration: underline; text-decoration-color: var(--tandem-primary); text-underline-offset: 0.15em; }
    a:not([href]) { text-decoration: none; }
    a:hover { color: var(--tandem-content-link); filter: brightness(0.9); }
    /* Los iconos dentro de un enlace heredan el color de link (currentColor). */
    a i, a svg, a .icon-base { color: inherit; }
    /* Componentes de interfaz: se mantienen sin subrayado. */
    .btn, .nav-link, .dropdown-item, .page-link, .menu-link,
    .list-group-item, .breadcrumb-item, .navbar-brand { text-decoration: none; }

    /* ---- Badges con color primario ------------------------------------ */
    .bg-label-primary {
        background-color: color-mix(in srgb, var(--tandem-primary) 18%, transparent) !important;
        color: var(--tandem-primary) !important;
    }

    /* ---- Sidebar Materio: elemento activo ----------------------------- */
    .menu-vertical .menu-item.active > .menu-link:not(.js-menu-group-toggle) {
        background: var(--tandem-primary) !important;
        color: var(--bs-menu-active-color) !important;
    }
    /* ---- Sidebar: grupos expandibles (sin menu-toggle de Materio) -----
       El click lo maneja Scripts/Intranet/sidebar-menu.js anyadiendo la
       clase "open" al <li class="menu-item js-menu-group">. */
    #layout-menu .menu-item.js-menu-group > .js-menu-group-sub {
        display: none !important;
    }
    #layout-menu .menu-item.js-menu-group.open > .js-menu-group-sub {
        display: flex !important;
        flex-direction: column;
    }
    #layout-menu .js-menu-group-toggle {
        cursor: pointer;
    }
    #layout-menu .js-menu-group-toggle .menu-icon-arrow {
        transition: transform .2s ease;
        font-size: 1.1em;
    }
    #layout-menu .menu-item.js-menu-group.open > .js-menu-group-toggle .menu-icon-arrow {
        transform: rotate(90deg);
    }
    /* Brand superior del sidebar: altura Materio demo (64px) */
    #layout-menu.menu-vertical > .app-brand.demo {
        height: 64px;
        min-height: 64px;
        align-items: center;
    }
    #layout-menu .app-brand-link {
        flex: 1 1 auto;
        min-width: 0;
    }
    .app-brand-text { color: var(--tandem-primary) !important; }

    /* ---- Navbar: boton hamburguesa del menu en color principal -------- */
    #layout-navbar #navbarMenuToggle,
    #layout-navbar #navbarMenuToggle i {
        color: var(--tandem-primary) !important;
    }

    /* ---- Tabs: textos como links subrayados en todo el proyecto ------ */
    .nav-tabs .nav-link:not(.active),
    .nav-pills .nav-link:not(.active) {
        color: var(--tandem-content-link) !important;
        text-decoration: underline !important;
        text-decoration-color: var(--tandem-primary) !important;
        text-underline-offset: 0.15em;
    }
    .nav-tabs .nav-link:not(.active) :is(i, svg, .icon-base),
    .nav-pills .nav-link:not(.active) :is(i, svg, .icon-base) {
        color: var(--tandem-content-link) !important;
    }
    .nav-tabs .nav-link.active,
    .nav-tabs .nav-link.active:hover,
    .nav-pills .nav-link.active,
    .nav-pills .show > .nav-link {
        text-decoration: underline !important;
        text-decoration-color: currentColor !important;
    }
    /* El visor Desing_2 mantiene su chrome fijo sin subrayados de pestana. */
    .desing2-stl-view-scope .nav-tabs .nav-link,
    .desing2-stl-view-scope .nav-pills .nav-link {
        text-decoration: none !important;
    }

    /* ---- DataTables: linea bajo la cabecera en color plantilla -------- */
    table.dataTable > thead > tr > th,
    table.dataTable > thead > tr > td,
    table.dataTable thead th.sorting,
    table.dataTable thead th.sorting_asc,
    table.dataTable thead th.sorting_desc {
        border-bottom: 2px solid var(--tandem-primary) !important;
    }
    /* Cuando hay scrollX, DataTables clona la cabecera en .dataTables_scrollHead. */
    .dataTables_scrollHead table.dataTable thead th,
    .dataTables_scrollHeadInner table.dataTable thead th {
        border-bottom: 2px solid var(--tandem-primary) !important;
    }

    /* ---- Formularios: etiquetas en color marca (sustituye --bs-heading-color de Materio) */
    .form-label,
    .col-form-label,
    label.control-label {
        color: var(--tandem-primary);
        font-weight: 500;
    }

    /* ---- Formularios: focus, checkboxes, radios, range ---------------- */
    .form-control:focus,
    .form-select:focus,
    .form-check-input:focus {
        border-color: var(--tandem-primary) !important;
        box-shadow: 0 0 0 0.15rem color-mix(in srgb, var(--tandem-primary) 25%, transparent) !important;
    }
    .form-check-input:checked {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
    }
    .form-switch .form-check-input:checked {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
    }

    /* ---- Progress bars ------------------------------------------------- */
    .progress-bar { background-color: var(--tandem-primary) !important; }

    /* ---- Pagination (Bootstrap + DataTables) -------------------------- */
    .page-link { color: var(--tandem-primary) !important; }
    .page-item.active .page-link,
    .page-link.active {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
        color: #fff !important;
    }

    /* ---- DataTables ---------------------------------------------------- */
    .dataTables_wrapper .dataTables_paginate .paginate_button.current,
    .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
        background: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
        color: #fff !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: color-mix(in srgb, var(--tandem-primary) 15%, transparent) !important;
        border-color: var(--tandem-primary) !important;
        color: var(--tandem-primary) !important;
    }
    table.dataTable tbody tr.selected,
    table.dataTable tbody tr.selected td {
        background-color: color-mix(in srgb, var(--tandem-primary) 20%, transparent) !important;
        color: inherit !important;
    }
    .dataTables_wrapper .dataTables_length select:focus,
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: var(--tandem-primary) !important;
        box-shadow: 0 0 0 0.15rem color-mix(in srgb, var(--tandem-primary) 25%, transparent) !important;
    }

    /* ---- DataTables Buttons (Select / Export / Column visibility) ----- */
    /* Botones principales */
    .dt-buttons .btn,
    .dt-buttons .dt-button,
    div.dt-buttons > .btn,
    div.dt-buttons > .dt-button,
    .dataTables_wrapper .dt-buttons .btn-secondary {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
        color: #fff !important;
    }
    .dt-buttons .btn:hover,
    .dt-buttons .dt-button:hover,
    div.dt-buttons > .btn:hover,
    div.dt-buttons > .dt-button:hover,
    .dt-buttons .btn:focus,
    .dt-buttons .dt-button:focus,
    .dt-buttons .btn:active,
    .dt-buttons .dt-button:active,
    .dt-buttons .dt-button.active {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
        color: #fff !important;
        filter: brightness(0.92);
    }
    /* Menu desplegable de los botones (Collection) */
    .dt-button-collection,
    div.dt-button-collection,
    .dt-button-collection.dropdown-menu {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
    }
    /* Cabeceras de seccion: SELECT RECORD, EXPORT, COLUMN VISIBILITY */
    .dt-button-collection .dropdown-header,
    .dt-button-collection h6,
    .dt-button-collection .dt-button-collection-title {
        color: rgba(255, 255, 255, 0.85) !important;
        background: transparent !important;
        border-color: rgba(255, 255, 255, 0.2) !important;
    }
    /* Items del menu */
    .dt-button-collection .dt-button,
    .dt-button-collection .dropdown-item,
    .dt-button-collection button.dt-button {
        background-color: transparent !important;
        color: #fff !important;
        border: 0 !important;
    }
    .dt-button-collection .dt-button:hover,
    .dt-button-collection .dropdown-item:hover,
    .dt-button-collection .dt-button.active,
    .dt-button-collection .dropdown-item.active,
    .dt-button-collection .dropdown-item:active {
        background-color: rgba(255, 255, 255, 0.15) !important;
        color: #fff !important;
    }
    /* Separadores entre secciones */
    .dt-button-collection .dropdown-divider {
        border-color: rgba(255, 255, 255, 0.2) !important;
    }

    /* ---- Nav tabs / pills activas ------------------------------------- */
    .nav-pills .nav-link.active,
    .nav-pills .show > .nav-link {
        background-color: var(--tandem-primary) !important;
        color: #fff !important;
    }
    .nav-tabs .nav-link.active {
        color: var(--tandem-primary) !important;
        border-bottom-color: var(--tandem-primary) !important;
    }

    /* ---- Dropdown items activos / seleccionados ----------------------- */
    .dropdown-item.active,
    .dropdown-item:active {
        background-color: var(--tandem-primary) !important;
        color: #fff !important;
    }

    /* ---- Alertas primary ---------------------------------------------- */
    .alert-primary {
        background-color: color-mix(in srgb, var(--tandem-primary) 15%, #fff) !important;
        border-color: color-mix(in srgb, var(--tandem-primary) 40%, #fff) !important;
        color: var(--tandem-primary) !important;
    }

    /* ---- Spinner -------------------------------------------------------- */
    .spinner-border.text-primary,
    .spinner-grow.text-primary { color: var(--tandem-primary) !important; }

    /* ---- List group items activos ------------------------------------- */
    .list-group-item.active {
        background-color: var(--tandem-primary) !important;
        border-color: var(--tandem-primary) !important;
        color: #fff !important;
    }

    /* ---- Formularios: pie de acciones (Cancelar / Guardar) a la derecha */
    .tandem-form-actions,
    .form-actions,
    .card .card-body > form.row .col-12.d-flex.gap-2:has(.btn-primary),
    .card .card-body > form > .d-flex:last-child:has(.btn-primary),
    .card-footer.tandem-form-actions,
    .card-footer:has(.btn-primary) {
        justify-content: flex-end !important;
    }

    @Html.Raw(_linkUiVars + _brandTextUi + _menuUiVars)

    /* ---- Fondos de color: texto e iconos en blanco (13/11/2026) --------
       _linkUiVars (color de enlace de la plantilla, inyectado justo arriba con !important) pintaba
       tambien el texto de los botones rellenos (.btn-primary, .btn-success, ...) y de los botones
       DataTables; si el enlace coincide con el color de marca el texto desaparecia (p. ej. «Aceptar»
       del popup Insertar muro curvo). Este bloque va despues para ganar. Botones claros, outline
       (en Materio su hover es un tinte claro: texto de marca, no blanco), link y la toolbar del visor
       siguen con el color de marca. El visor Desing_2 tiene su propia regla (.desing2-stl-view-scope
       .btn en Views/Desing_2/Viewer.cshtml), que tambien excluye los botones de fondo de color. */
    html :is(.btn-primary, .btn-secondary, .btn-success, .btn-danger, .btn-warning, .btn-info, .btn-dark),
    html :is(.btn-primary, .btn-secondary, .btn-success, .btn-danger, .btn-warning, .btn-info, .btn-dark):is(:hover, :focus, :focus-visible, :active, .active, .show, :disabled, .disabled),
    html .dt-buttons :is(.btn, .dt-button),
    html .dt-buttons :is(.btn, .dt-button):is(:hover, :focus, :active, .active),
    html .dt-button-collection :is(.dt-button, .dropdown-item),
    html .dt-button-collection :is(.dt-button, .dropdown-item):is(:hover, :active, .active) {
        --bs-btn-color: #fff;
        --bs-btn-hover-color: #fff;
        --bs-btn-active-color: #fff;
        --bs-btn-disabled-color: #fff;
        color: #fff !important;
    }
    html :is(.btn-primary, .btn-secondary, .btn-success, .btn-danger, .btn-warning, .btn-info, .btn-dark) :is(i, svg, .icon-base),
    html .dt-buttons :is(.btn, .dt-button) :is(i, svg, .icon-base),
    html .dt-button-collection :is(.dt-button, .dropdown-item) :is(i, svg, .icon-base),
    html .nav-pills :is(.nav-link.active, .show > .nav-link) :is(i, svg, .icon-base),
    html :is(.dropdown-item.active, .dropdown-item:active, .list-group-item.active, .page-item.active .page-link, .page-link.active) :is(i, svg, .icon-base) {
        color: #fff !important;
    }
    html .dt-button-collection :is(.dropdown-header, h6, .dt-button-collection-title) {
        color: rgba(255, 255, 255, 0.85) !important;
    }
</style>
