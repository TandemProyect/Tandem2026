@model Desing.Models.GooglePlacesAddressBlockModel
@if (Model == null) { return; }

@{
    var prefix = Model.Prefix ?? "Loc";
    var mapId = string.IsNullOrEmpty(Model.MapElementId) ? prefix + "AddressMap" : Model.MapElementId;
    var searchValue = Model.Formatted_Address ?? "";
}

<fieldset class="border rounded p-2 mb-2 tandem-address-block tandem-address-block--compact address-block" data-prefix="@prefix" data-map-id="@mapId">
    <legend class="float-none w-auto px-2 fs-6 mb-0">@(Model.Title ?? "Dirección")</legend>

    <div class="alert alert-warning js-tandem-address-maps-error d-none mb-2 py-2" role="alert"></div>

    <div class="row g-2 align-items-start">
        <div class="col-12 col-md-7 tandem-address-fields">
            <div class="mb-2">
                <label class="form-label" for="@(prefix)_PlacesSearch">Buscar dirección</label>
                <input type="text"
                       id="@(prefix)_PlacesSearch"
                       class="form-control form-control-sm js-tandem-places-autocomplete"
                       autocomplete="off"
                       placeholder="Escriba calle, localidad o código postal…"
                       value="@searchValue" />
            </div>

            <div class="mb-2">
                <label class="form-label" for="@(prefix)_Formatted_Address">Dirección formateada</label>
                <input type="text" name="@(prefix)_Formatted_Address" id="@(prefix)_Formatted_Address" class="form-control form-control-sm"
                       value="@Model.Formatted_Address" maxlength="1000" />
            </div>

            <input type="hidden" name="@(prefix)_Place_Id" id="@(prefix)_Place_Id" value="@Model.Place_Id" />
            <input type="hidden" name="@(prefix)_Lat" id="@(prefix)_Lat" value="@(Model.Lat.HasValue ? Model.Lat.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
            <input type="hidden" name="@(prefix)_Lng" id="@(prefix)_Lng" value="@(Model.Lng.HasValue ? Model.Lng.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
            <input type="hidden" name="@(prefix)_Address_Components_Json" id="@(prefix)_Address_Components_Json" value="@Model.Address_Components_Json" />

            <div class="row g-1 tandem-address-fields-grid">
                <div class="col-4 col-md-2">
                    <label class="form-label" for="@(prefix)_Street_Number">Nº</label>
                    <input type="text" name="@(prefix)_Street_Number" id="@(prefix)_Street_Number" class="form-control form-control-sm" maxlength="50"
                           value="@Model.Street_Number" />
                </div>
                <div class="col-8 col-md-5">
                    <label class="form-label" for="@(prefix)_Route">Vía</label>
                    <input type="text" name="@(prefix)_Route" id="@(prefix)_Route" class="form-control form-control-sm" maxlength="250"
                           value="@Model.Route" />
                </div>
                <div class="col-12 col-md-5">
                    <label class="form-label" for="@(prefix)_Subpremise">Piso / puerta</label>
                    <input type="text" name="@(prefix)_Subpremise" id="@(prefix)_Subpremise" class="form-control form-control-sm" maxlength="100"
                           value="@Model.Subpremise" />
                </div>
                <div class="col-6 col-md-4">
                    <label class="form-label" for="@(prefix)_Locality">Localidad</label>
                    <input type="text" name="@(prefix)_Locality" id="@(prefix)_Locality" class="form-control form-control-sm" maxlength="250"
                           value="@Model.Locality" />
                </div>
                <div class="col-6 col-md-4">
                    <label class="form-label" for="@(prefix)_Admin_Area_1">Provincia</label>
                    <input type="text" name="@(prefix)_Admin_Area_1" id="@(prefix)_Admin_Area_1" class="form-control form-control-sm" maxlength="250"
                           value="@Model.Admin_Area_1" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label" for="@(prefix)_Postal_Code">CP</label>
                    <input type="text" name="@(prefix)_Postal_Code" id="@(prefix)_Postal_Code" class="form-control form-control-sm" maxlength="20"
                           value="@Model.Postal_Code" />
                </div>
                <div class="col-4 col-md-2">
                    <label class="form-label" for="@(prefix)_Country_Code">País</label>
                    <input type="text" name="@(prefix)_Country_Code" id="@(prefix)_Country_Code" class="form-control form-control-sm" maxlength="10"
                           value="@Model.Country_Code" />
                </div>
                <input type="hidden" name="@(prefix)_Admin_Area_2" id="@(prefix)_Admin_Area_2" value="@Model.Admin_Area_2" />
                <input type="hidden" name="@(prefix)_Country_Name" id="@(prefix)_Country_Name" value="@Model.Country_Name" />
            </div>
        </div>

        <div class="col-12 col-md-5 tandem-address-map-col">
            <label class="form-label">Ubicación en mapa</label>
            <div id="@mapId" class="tandem-address-map is-empty" role="img" aria-label="Vista previa del mapa">
                <span>Seleccione una dirección para ver el mapa</span>
            </div>
        </div>
    </div>
</fieldset>
