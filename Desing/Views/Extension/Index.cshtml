@{
    ViewBag.Title = "Extensiones";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> / Configuración /</span> Extensiones
    </h4>
    <a class="btn btn-primary" href="@Url.Action("Create")">
        <i class="icon-base ri ri-add-line me-1"></i> Nueva extensión
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListExtensions" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th></th>
                    <th>Nombre</th>
                    <th>Tamaño máx.</th>
                    <th>Estado</th>
                    <th></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        function deleteExtension(id) {
            if (!confirm('¿Eliminar esta extensión?')) return;

            $.post('@Url.Action("DeleteExtension")',
                { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                function (r) {
                    alert(r.Message);
                    if (r.IsOk) $('#ListExtensions').DataTable().ajax.reload();
                });
        }

        $(document).ready(function () {
            $('#ListExtensions').DataTable(TandemDataTablesList.applyListDefaults({
                serverSide: true,
                processing: true,
                ajax: { url: '@Url.Action("ListExtensions")', type: 'POST' },
                columns: [
                    { data: 'IcoThumb', name: 'IcoThumb', orderable: false, searchable: false },
                    { data: 'TextLabel', name: 'TextLabel' },
                    { data: 'MaxFileSize', name: 'MaxFileSize' },
                    { data: 'activeBadge', name: 'Is_Active' },
                    { data: 'buttonEdit', orderable: false, searchable: false },
                    { data: 'IdObject', visible: false }
                ]
            }));
        });
    </script>
    @* Token AntiForgery para que deleteExtension pueda incluirlo en el POST. *@
    <div style="display:none;">@Html.AntiForgeryToken()</div>
}
