@model DAL.TSql_Extension
@{
    ViewBag.Title = "Editar extensión";
}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> / <a href="@Url.Action("Index")">Configuración</a> / <a href="@Url.Action("Index")">Extensiones</a> /</span> Editar
    </h4>
</div>
<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "Extension", FormMethod.Post, new { @class = "row g-3", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdObject)
            @Html.Partial("_ExtensionFormFields", Model)
            <div class="col-12 d-flex justify-content-end gap-2 tandem-form-actions mt-2">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar</button>
            </div>
        }
    </div>
</div>
