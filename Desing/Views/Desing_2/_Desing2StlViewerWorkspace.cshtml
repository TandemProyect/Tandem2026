@model Desing.Models.Desing2ViewerPageModel
@using System.Web
@using Desing.Resources
@{
    var textColor1Hex = string.IsNullOrWhiteSpace(Model.TextColor1Hex) ? "#000000" : Model.TextColor1Hex.Trim();
    var textColor2Hex = string.IsNullOrWhiteSpace(Model.TextColor2Hex) ? "#000000" : Model.TextColor2Hex.Trim();
    var stlUrlAttr = HttpUtility.HtmlAttributeEncode(Model.InitialStlUrl ?? string.Empty);
    var stlLabelAttr = HttpUtility.HtmlAttributeEncode(Model.InitialStlLabel ?? string.Empty);
    var logoUrl = Model.BrandLogoUrl ?? Url.Content("~/Content/images/Login/at.png");
    var stlSrcUnits = string.IsNullOrWhiteSpace(Model.StlSourceUnits) ? "m" : Model.StlSourceUnits.Trim();
    // Evita CS0117 si el Designer.cs local no tiene aún estas claves.
    Func<string, string, string> maStr = (key, fallback) =>
    {
        try { return MasterArticles.ResourceManager.GetString(key) ?? fallback; }
        catch { return fallback; }
    };
    var wallModelRenderingText = maStr("StlPreview_WallModelRendering", "Generando modelo de muros…");
    var imageSketchErrorModalTitle = maStr("StlPreview_ImageSketchErrorModalTitle", "Error al analizar la imagen");
    var imageSketchErrorModalAccept = maStr("StlPreview_ImageSketchErrorModalAccept", "Aceptar");
}
@* Solo Desing_2: clase desing2-stl-view-scope; barra única marca + contexto izq., herramientas + Volver derecha.
   data-ma-stl-source-units: vértices STL → m → mm escena (×1000; reglas/rejilla en mm).
   Persistencia vista: #ma-stl-save-viewer-state → cookie global; restauración tras primer refit (ver desing-2-stl-viewer-funciones.md). *@
@* Opcional desarrollo en #ma-stl-viewer-shell: data-ma-stl-dev-auto-load="true", data-ma-stl-dev-default-stl="~/Files/.../3120270090P.stl" (URL resuelta con @Url.Content), data-ma-stl-dev-default-label="..." *@
<div id="ma-stl-viewer-shell" class="desing2-stl-view-scope border rounded overflow-hidden bg-white h-100 d-flex flex-column border-secondary" data-ma-text-color1="@HttpUtility.HtmlAttributeEncode(textColor1Hex)" data-ma-text-color2="@HttpUtility.HtmlAttributeEncode(textColor2Hex)" data-ma-stl-show-rulers-toggle="true" data-ma-stl-desing2-persist-view="true" data-ma-stl-source-units="@HttpUtility.HtmlAttributeEncode(stlSrcUnits)" data-ma-stl-wall3d-api-url="@Url.Action("ProcesarLineasZwcad", "DesignToolsAutocad")" data-ma-stl-image-sketch-api-url="@Url.Action("DetectarEsquinasImagen", "DesignToolsAutocad")" data-ma-stl-map-building-search-url="@Url.Action("BuscarDireccionOsm", "DesignToolsAutocad")" data-ma-stl-map-building-buildings-url="@Url.Action("BuscarEdificiosOsm", "DesignToolsAutocad")" data-ma-stl-map-building-import-url="@Url.Action("ImportarEdificioOsm", "DesignToolsAutocad")" data-ma-stl-map-building-catastro-url="@Url.Action("ConsultarCatastroPorCoordenadas", "DesignToolsAutocad")" data-ma-stl-wall-connections-api-url="@Url.Action("SaveWallConnections", "Desing_2")" data-ma-stl-wall-diagnostics-api-url="@Url.Action("SaveWallDiagnostics", "Desing_2")" data-ma-stl-wall3d-mat-wall="@Url.Content("~/Content/DesignTools/Material/concrete.png")" data-ma-stl-escape-cancel-toast="@MasterArticles.StlPreview_EscapeCancelToolsToast" data-ma-stl-user-floor-line-dim-edit-aria="@MasterArticles.StlPreview_UserFloorLineDimEditAria" data-ma-stl-user-floor-line-dim-edit-x-aria="@MasterArticles.StlPreview_UserFloorLineDimEditDeltaXAria" data-ma-stl-user-floor-line-dim-edit-z-aria="@MasterArticles.StlPreview_UserFloorLineDimEditDeltaZAria" data-ma-stl-user-floor-line-dim-edit-thickness-aria="@MasterArticles.StlPreview_UserFloorLineDimEditThicknessAria" data-ma-stl-user-floor-line-drag-handle-aria="@MasterArticles.StlPreview_UserFloorLineDragHandleAria" data-ma-stl-user-floor-line-p1-handle-aria="@MasterArticles.StlPreview_UserFloorLineP1HandleAria" data-ma-stl-user-floor-line-p2-handle-aria="@MasterArticles.StlPreview_UserFloorLineP2HandleAria">
    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap px-2 py-2 border-bottom desing2-stl-actions-toolbar" id="master-article-stl-viewer-toolbar">
        <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1 desing2-stl-toolbar-leading">
            <span class="app-brand-logo demo flex-shrink-0">
                <img src="@logoUrl" alt="" width="28" height="28" style="object-fit:contain;max-height:28px;" />
            </span>
            <div class="small fw-semibold text-white text-truncate flex-grow-1 desing2-stl-toolbar-context" title="@HttpUtility.HtmlAttributeEncode(Model.ContextSubtitleLine ?? "")">
                @(string.IsNullOrWhiteSpace(Model.ContextSubtitleLine) ? "—" : Model.ContextSubtitleLine)
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0 flex-wrap justify-content-end">
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-fullscreen-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_FullscreenTitle">
                <i class="icon-base ri ri-fullscreen-line" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-save-viewer-state" title="@MasterArticles.StlPreview_SaveViewTitle" data-ma-stl-save-view-title="@MasterArticles.StlPreview_SaveViewTitle" data-ma-stl-save-view-saved="@MasterArticles.StlPreview_SaveViewSavedTitle" data-ma-stl-save-view-toast="@MasterArticles.StlPreview_SaveViewSavedToast" aria-label="@MasterArticles.StlPreview_SaveViewAria">
                <i class="icon-base ri ri-save-3-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_SaveViewAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-sky-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_SkyToggleTitle">
                <i class="icon-base ri ri-cloud-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_SkyToggleAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-ground-shadow-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_GroundShadowTitle">
                <i class="icon-base ri ri-shadow-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_GroundShadowAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-dark-bg-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_DarkBgTitle">
                <i class="icon-base ri ri-moon-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_DarkBgAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-clip-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_ClipToggleTitle">
                <i class="icon-base ri ri-scissors-cut-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_ClipToggleAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect active" id="ma-stl-xyz-axes-toggle" aria-pressed="true" title="@MasterArticles.StlPreview_XyzAxesToggleTitle">
                <i class="icon-base ri ri-compass-3-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_XyzAxesAria</span>
            </button>
            <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary waves-effect flex-shrink-0">@Common.Btn_Back</a>
        </div>
    </div>
    <div id="master-article-details-stl-viewer-canvas" class="flex-grow-1 position-relative bg-white ma-stl-canvas--clips d-flex flex-column">
        @* inset edges (not h-100): percentage height on absolute children can collapse inside nested flex until layout settles *@
        <div id="ma-stl-viewer-gl-host" class="position-absolute top-0 bottom-0 start-0 end-0"></div>
        <div id="ma-stl-wall-model-render-overlay" class="desing2-stl-render-overlay d-none" aria-live="polite" aria-atomic="true">
            <div class="desing2-stl-render-overlay__card shadow-lg">
                <div class="spinner-border text-primary desing2-stl-render-overlay__spinner" role="status" aria-hidden="true"></div>
                <div class="desing2-stl-render-overlay__text">@wallModelRenderingText</div>
            </div>
        </div>
        <div id="ma-stl-edge-rulers-overlay" class="ma-stl-edge-rulers-overlay d-none" aria-hidden="true">
            <canvas id="ma-stl-edge-ruler-top" class="ma-stl-edge-ruler ma-stl-edge-ruler--top" aria-hidden="true"></canvas>
            <canvas id="ma-stl-edge-ruler-right" class="ma-stl-edge-ruler ma-stl-edge-ruler--right" aria-hidden="true"></canvas>
        </div>
        <div id="ma-stl-line-dim-edit-overlay" class="desing2-stl-floor-dim-overlay" aria-hidden="true" hidden="hidden">
            <button type="button" id="ma-stl-floor-dim-readout" class="desing2-stl-floor-dim-readout" hidden="hidden" aria-hidden="true"></button>
            <button type="button" id="ma-stl-floor-dim-readout-dx" class="desing2-stl-floor-dim-readout desing2-stl-floor-dim-readout--compact" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDimReadoutDeltaXAria"></button>
            <button type="button" id="ma-stl-floor-dim-readout-dz" class="desing2-stl-floor-dim-readout desing2-stl-floor-dim-readout--compact" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDimReadoutDeltaZAria"></button>
            <button type="button" id="ma-stl-floor-dim-readout-thickness" class="desing2-stl-floor-dim-readout desing2-stl-floor-dim-readout--compact" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDimReadoutThicknessAria"></button>
            <input type="text" id="ma-stl-floor-dim-input" class="desing2-stl-floor-dim-input" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <input type="text" id="ma-stl-floor-dim-input-dx" class="desing2-stl-floor-dim-input desing2-stl-floor-dim-input--compact" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <input type="text" id="ma-stl-floor-dim-input-dz" class="desing2-stl-floor-dim-input desing2-stl-floor-dim-input--compact" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <input type="text" id="ma-stl-floor-dim-input-thickness" class="desing2-stl-floor-dim-input desing2-stl-floor-dim-input--compact" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <button type="button" id="ma-stl-floor-line-drag-handle" class="desing2-stl-floor-line-drag-handle" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDragHandleAria"></button>
            <button type="button" id="ma-stl-floor-line-p1-handle" class="desing2-stl-floor-line-endpoint-handle desing2-stl-floor-line-p1-handle" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineP1HandleAria"></button>
            <button type="button" id="ma-stl-floor-line-p2-handle" class="desing2-stl-floor-line-endpoint-handle desing2-stl-floor-line-p2-handle" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineP2HandleAria"></button>
        </div>
        <div id="ma-stl-wall-dim-overlay" class="desing2-stl-floor-dim-overlay desing2-stl-wall-dim-overlay" aria-hidden="true" hidden="hidden"></div>
        <aside id="desing2-stl-mode-toolbar" class="desing2-stl-mode-toolbar desing2-stl-floating-toolbar" role="region" aria-label="@MasterArticles.StlPreview_Desing2TopToolbarAria">
            <div class="desing2-stl-floating-toolbar__inner d-flex align-items-center" role="toolbar" aria-label="@MasterArticles.StlPreview_Desing2TopToolbarAria">
                <div class="desing2-stl-floating-toolbar__group desing2-stl-floating-toolbar__group--mode" role="group" aria-label="@MasterArticles.StlPreview_Desing2TopToolbarDrawGroupAria">
                    <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn active" id="ma-stl-mode-lines" data-ma-stl-mode="lines" title="@MasterArticles.StlPreview_Desing2ToolPolylineAria" aria-label="@MasterArticles.StlPreview_Desing2ToolPolylineAria" aria-pressed="true">
                        <i class="icon-base ri ri-route-line" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-mode-wall-2d" data-ma-stl-mode="wall-2d" title="@MasterArticles.StlPreview_Desing2ToolWall2dAria" aria-label="@MasterArticles.StlPreview_Desing2ToolWall2dAria" aria-pressed="false">
                        <svg class="icon-base desing2-stl-tool-icon desing2-stl-tool-icon--wall-2d" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M3 8.5h18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            <path d="M4 12h16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
                            <path d="M3 15.5h18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                        </svg>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-mode-wall-3d" data-ma-stl-mode="wall-3d" title="@MasterArticles.StlPreview_Desing2RightMenuWall3dAria" aria-label="@MasterArticles.StlPreview_Desing2RightMenuWall3dAria" aria-pressed="false">
                        <i class="icon-base ri ri-building-2-line" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-mode-formwork" data-ma-stl-mode="formwork" data-ma-formwork-url-atk60="@Url.Action("GetWallsAtk-60", "Desing_2")" title="Encofrar" aria-label="Encofrar" aria-pressed="false">
                        Encofrar
                    </button>
                </div>
                <div class="dropdown desing2-stl-mode-toolbar__systems">
                    <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle desing2-stl-mode-toolbar__systems-toggle" id="ma-stl-mode-system-dropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@MasterArticles.Col_System">
                        Atk-60
                    </button>
                    <ul class="dropdown-menu desing2-stl-mode-toolbar__systems-menu" aria-labelledby="ma-stl-mode-system-dropdown">
                        <li><button type="button" class="dropdown-item active" data-ma-system="Atk-60" aria-current="true">Atk-60</button></li>
                        <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 2" disabled="disabled" aria-disabled="true">Sistema 2</button></li>
                        <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 3" disabled="disabled" aria-disabled="true">Sistema 3</button></li>
                        <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 4" disabled="disabled" aria-disabled="true">Sistema 4</button></li>
                        <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 5" disabled="disabled" aria-disabled="true">Sistema 5</button></li>
                    </ul>
                </div>
            </div>
        </aside>
        @* Barra superior centrada (hover / bloqueo); herramientas CAD — placeholders. *@
        @Html.Partial("_Desing2TopToolBar")
        @Html.Partial("_Desing2BottomToolBar")
        @* Borde izq. hover + contraer manual; zona “peek” a la izquierda del strip (CSS). *@
        <aside id="desing2-stl-hover-side-panel" class="desing2-stl-hover-side-panel" role="region" aria-label="@MasterArticles.StlPreview_Desing2SideMenuAria">
            <div class="desing2-stl-hover-side-panel__hover-zone">
                <div class="desing2-stl-hover-side-panel__sheet border border-start-0 rounded-end shadow-sm">
                    <div class="desing2-stl-hover-side-panel__toolbar d-flex justify-content-end align-items-center px-2 py-1 border-bottom border-light">
                        <button type="button" class="btn btn-sm btn-text-secondary waves-effect p-1 desing2-stl-hover-side-panel__collapse rounded" id="desing2-stl-side-panel-collapse" title="@MasterArticles.StlPreview_Desing2SideMenuCollapseTitle" aria-label="@MasterArticles.StlPreview_Desing2SideMenuCollapseTitle">
                            <i class="icon-base ri ri-menu-fold-line fs-6" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="desing2-stl-hover-side-panel__body px-0 pb-2 pt-1">
                        <div class="desing2-stl-hover-side-panel__tabs-bar px-2 pt-1">
                            <ul class="nav nav-tabs mb-0 w-100 flex-nowrap overflow-x-auto tandem-desing2-hsp-tablist" role="tablist" style="min-width:0;" aria-label="@MasterArticles.StlPreview_Desing2SideMenuAria">
                                <li class="nav-item flex-fill text-center" role="presentation">
                                    <button type="button" class="nav-link w-100 rounded-0 py-2 active" id="desing2-stl-side-tab-entorno" data-bs-toggle="tab" data-bs-target="#desing2-stl-side-pane-entorno" role="tab" aria-controls="desing2-stl-side-pane-entorno" aria-selected="true">
                                        @MasterArticles.StlPreview_Desing2SideMenuTabEntorno
                                    </button>
                                </li>
                                <li class="nav-item flex-fill text-center" role="presentation">
                                    <button type="button" class="nav-link w-100 rounded-0 py-2" id="desing2-stl-side-tab-config" data-bs-toggle="tab" data-bs-target="#desing2-stl-side-pane-config" role="tab" aria-controls="desing2-stl-side-pane-config" aria-selected="false">
                                        @MasterArticles.StlPreview_Desing2SideMenuTabConfiguracion
                                    </button>
                                </li>
                            </ul>
                        </div>
                        <div class="tab-content desing2-stl-hover-side-panel__tab-content px-3 pt-2" id="desing2-stl-side-tab-panels">
                            <div class="tab-pane fade show active" id="desing2-stl-side-pane-entorno" role="tabpanel" aria-labelledby="desing2-stl-side-tab-entorno" tabindex="0">
                                <div class="vstack gap-3">
                                    <div>
                                        <label class="form-label mb-1" for="ma-stl-entorno-grid-snap-mm">@MasterArticles.StlPreview_Desing2EntornoGridSnapLabel</label>
                                        <select class="form-select form-select-sm" id="ma-stl-entorno-grid-snap-mm" aria-label="@MasterArticles.StlPreview_Desing2EntornoGridSnapAria">
                                            <option value="50">50 mm (0,05 m)</option>
                                            <option value="100">100 mm (0,1 m)</option>
                                            <option value="250">250 mm (0,25 m)</option>
                                            <option value="500" selected>500 mm (0,5 m)</option>
                                            <option value="1000">1000 mm (1 m)</option>
                                            <option value="2000">2000 mm (2 m)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label mb-1" for="ma-stl-entorno-ruler-extent-m">@MasterArticles.StlPreview_Desing2EntornoRulerExtentLabel</label>
                                        <select class="form-select form-select-sm" id="ma-stl-entorno-ruler-extent-m" aria-label="@MasterArticles.StlPreview_Desing2EntornoRulerExtentAria">
                                            <option value="5">5 m</option>
                                            <option value="10">10 m</option>
                                            <option value="15">15 m</option>
                                            <option value="20">20 m</option>
                                            <option value="25" selected>25 m</option>
                                            <option value="30">30 m</option>
                                            <option value="40">40 m</option>
                                            <option value="50">50 m</option>
                                            <option value="60">60 m</option>
                                            <option value="80">80 m</option>
                                        </select>
                                    </div>
                                    <hr class="my-1" />
                                    <p class="form-label mb-1 small fw-semibold">@MasterArticles.StlPreview_Desing2EntornoLightingSectionTitle</p>
                                    <div>
                                        <label class="form-label mb-1 d-flex justify-content-between" for="ma-stl-entorno-sun-azimuth">
                                            <span>@MasterArticles.StlPreview_Desing2EntornoSunAzimuthLabel</span>
                                            <span id="ma-stl-entorno-sun-azimuth-val" class="text-body-secondary">135°</span>
                                        </label>
                                        <input type="range" class="form-range" id="ma-stl-entorno-sun-azimuth" min="0" max="360" step="1" value="135" aria-label="@MasterArticles.StlPreview_Desing2EntornoSunAzimuthAria" />
                                    </div>
                                    <div>
                                        <label class="form-label mb-1 d-flex justify-content-between" for="ma-stl-entorno-sun-elevation">
                                            <span>@MasterArticles.StlPreview_Desing2EntornoSunElevationLabel</span>
                                            <span id="ma-stl-entorno-sun-elevation-val" class="text-body-secondary">48°</span>
                                        </label>
                                        <input type="range" class="form-range" id="ma-stl-entorno-sun-elevation" min="5" max="85" step="1" value="48" aria-label="@MasterArticles.StlPreview_Desing2EntornoSunElevationAria" />
                                    </div>
                                    <div>
                                        <label class="form-label mb-1 d-flex justify-content-between" for="ma-stl-entorno-sun-intensity">
                                            <span>@MasterArticles.StlPreview_Desing2EntornoSunIntensityLabel</span>
                                            <span id="ma-stl-entorno-sun-intensity-val" class="text-body-secondary">1.20</span>
                                        </label>
                                        <input type="range" class="form-range" id="ma-stl-entorno-sun-intensity" min="0.2" max="2.5" step="0.05" value="1.2" aria-label="@MasterArticles.StlPreview_Desing2EntornoSunIntensityAria" />
                                    </div>
                                    <div>
                                        <label class="form-label mb-1 d-flex justify-content-between" for="ma-stl-entorno-ambient-intensity">
                                            <span>@MasterArticles.StlPreview_Desing2EntornoAmbientIntensityLabel</span>
                                            <span id="ma-stl-entorno-ambient-intensity-val" class="text-body-secondary">0.22</span>
                                        </label>
                                        <input type="range" class="form-range" id="ma-stl-entorno-ambient-intensity" min="0" max="0.8" step="0.02" value="0.22" aria-label="@MasterArticles.StlPreview_Desing2EntornoAmbientIntensityAria" />
                                    </div>
                                    <div>
                                        <label class="form-label mb-1 d-flex justify-content-between" for="ma-stl-entorno-ibl-intensity">
                                            <span>@MasterArticles.StlPreview_Desing2EntornoIblIntensityLabel</span>
                                            <span id="ma-stl-entorno-ibl-intensity-val" class="text-body-secondary">0.65</span>
                                        </label>
                                        <input type="range" class="form-range" id="ma-stl-entorno-ibl-intensity" min="0" max="1.5" step="0.05" value="0.65" aria-label="@MasterArticles.StlPreview_Desing2EntornoIblIntensityAria" />
                                    </div>
                                    <div>
                                        <label class="form-label mb-1 d-flex justify-content-between" for="ma-stl-entorno-exposure">
                                            <span>@MasterArticles.StlPreview_Desing2EntornoExposureLabel</span>
                                            <span id="ma-stl-entorno-exposure-val" class="text-body-secondary">1.22</span>
                                        </label>
                                        <input type="range" class="form-range" id="ma-stl-entorno-exposure" min="0.6" max="2.2" step="0.02" value="1.22" aria-label="@MasterArticles.StlPreview_Desing2EntornoExposureAria" />
