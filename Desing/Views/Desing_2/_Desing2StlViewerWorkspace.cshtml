                                               placeholder="@MasterArticles.StlPreview_Desing2ConfigOffsetDefaultPlaceholder" />
                                    </div>
                                    <div class="desing2-config-wall-section">
                                        <p class="form-label mb-2 small text-body-secondary mb-0">@MasterArticles.StlPreview_Desing2ConfigWallSectionTitle</p>
                                        <figure class="desing2-config-wall-section__figure mb-2" aria-hidden="true">
