@model Desing.Models.Desing2ViewerPageModel
@using System.Web
@using Desing.Resources
@{
    var textColor1Hex = string.IsNullOrWhiteSpace(Model.TextColor1Hex) ? "#000000" : Model.TextColor1Hex.Trim();
    var textColor2Hex = string.IsNullOrWhiteSpace(Model.TextColor2Hex) ? "#000000" : Model.TextColor2Hex.Trim();
    var stlUrlAttr = HttpUtility.HtmlAttributeEncode(Model.InitialStlUrl ?? string.Empty);
    var stlLabelAttr = HttpUtility.HtmlAttributeEncode(Model.InitialStlLabel ?? string.Empty);
    var logoUrl = Model.BrandLogoUrl ?? Url.Content("~/Content/images/Login/at.png");
    var stlSrcUnits = string.IsNullOrWhiteSpace(Model.StlSourceUnits) ? "m" : Model.StlSourceUnits.Trim();
}
@* Solo Desing_2: clase desing2-stl-view-scope; barra única marca + contexto izq., herramientas + Volver derecha.
   data-ma-stl-source-units: vértices STL → m → mm escena (×1000; reglas/rejilla en mm).
   Persistencia vista: #ma-stl-save-viewer-state → cookie global; restauración tras primer refit (ver desing-2-stl-viewer-funciones.md). *@
@* Opcional desarrollo en #ma-stl-viewer-shell: data-ma-stl-dev-auto-load="true", data-ma-stl-dev-default-stl="~/Files/.../3120270090P.stl" (URL resuelta con @Url.Content), data-ma-stl-dev-default-label="..." *@
<div id="ma-stl-viewer-shell" class="desing2-stl-view-scope border rounded overflow-hidden bg-white h-100 d-flex flex-column border-secondary" data-ma-text-color1="@HttpUtility.HtmlAttributeEncode(textColor1Hex)" data-ma-text-color2="@HttpUtility.HtmlAttributeEncode(textColor2Hex)" data-ma-stl-show-rulers-toggle="true" data-ma-stl-desing2-persist-view="true" data-ma-stl-source-units="@HttpUtility.HtmlAttributeEncode(stlSrcUnits)" data-ma-stl-wall3d-api-url="@Url.Action("ProcesarLineasZwcad", "DesignToolsAutocad")" data-ma-stl-image-sketch-api-url="@Url.Action("DetectarEsquinasImagen", "DesignToolsAutocad")" data-ma-stl-wall3d-mat-wall="@Url.Content("~/Content/DesignTools/Material/concrete.png")" data-ma-stl-escape-cancel-toast="@MasterArticles.StlPreview_EscapeCancelToolsToast" data-ma-stl-user-floor-line-dim-edit-aria="@MasterArticles.StlPreview_UserFloorLineDimEditAria" data-ma-stl-user-floor-line-dim-edit-x-aria="@MasterArticles.StlPreview_UserFloorLineDimEditDeltaXAria" data-ma-stl-user-floor-line-dim-edit-z-aria="@MasterArticles.StlPreview_UserFloorLineDimEditDeltaZAria" data-ma-stl-user-floor-line-drag-handle-aria="@MasterArticles.StlPreview_UserFloorLineDragHandleAria" data-ma-stl-user-floor-line-p1-handle-aria="@MasterArticles.StlPreview_UserFloorLineP1HandleAria" data-ma-stl-user-floor-line-p2-handle-aria="@MasterArticles.StlPreview_UserFloorLineP2HandleAria">
    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap px-2 py-2 border-bottom desing2-stl-actions-toolbar" id="master-article-stl-viewer-toolbar">
        <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1 desing2-stl-toolbar-leading">
            <span class="app-brand-logo demo flex-shrink-0">
                <img src="@logoUrl" alt="" width="28" height="28" style="object-fit:contain;max-height:28px;" />
            </span>
            <div class="small fw-semibold text-white text-truncate flex-grow-1 desing2-stl-toolbar-context" title="@HttpUtility.HtmlAttributeEncode(Model.ContextSubtitleLine ?? "")">
                @(string.IsNullOrWhiteSpace(Model.ContextSubtitleLine) ? "—" : Model.ContextSubtitleLine)
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0 flex-wrap justify-content-end">
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-fullscreen-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_FullscreenTitle">
                <i class="icon-base ri ri-fullscreen-line" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-save-viewer-state" title="@MasterArticles.StlPreview_SaveViewTitle" data-ma-stl-save-view-title="@MasterArticles.StlPreview_SaveViewTitle" data-ma-stl-save-view-saved="@MasterArticles.StlPreview_SaveViewSavedTitle" data-ma-stl-save-view-toast="@MasterArticles.StlPreview_SaveViewSavedToast" aria-label="@MasterArticles.StlPreview_SaveViewAria">
                <i class="icon-base ri ri-save-3-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_SaveViewAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-sky-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_SkyToggleTitle">
                <i class="icon-base ri ri-cloud-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_SkyToggleAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-ground-shadow-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_GroundShadowTitle">
                <i class="icon-base ri ri-shadow-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_GroundShadowAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-dark-bg-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_DarkBgTitle">
                <i class="icon-base ri ri-moon-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_DarkBgAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-clip-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_ClipToggleTitle">
                <i class="icon-base ri ri-scissors-cut-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_ClipToggleAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect active" id="ma-stl-xyz-axes-toggle" aria-pressed="true" title="@MasterArticles.StlPreview_XyzAxesToggleTitle">
                <i class="icon-base ri ri-compass-3-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_XyzAxesAria</span>
            </button>
            <a href="javascript:history.back()" class="btn btn-sm btn-outline-secondary waves-effect flex-shrink-0">@Common.Btn_Back</a>
        </div>
    </div>
    <div id="master-article-details-stl-viewer-canvas" class="flex-grow-1 position-relative bg-white ma-stl-canvas--clips d-flex flex-column">
        @* inset edges (not h-100): percentage height on absolute children can collapse inside nested flex until layout settles *@
        <div id="ma-stl-viewer-gl-host" class="position-absolute top-0 bottom-0 start-0 end-0"></div>
        <div id="ma-stl-edge-rulers-overlay" class="ma-stl-edge-rulers-overlay d-none" aria-hidden="true">
            <canvas id="ma-stl-edge-ruler-top" class="ma-stl-edge-ruler ma-stl-edge-ruler--top" aria-hidden="true"></canvas>
            <canvas id="ma-stl-edge-ruler-right" class="ma-stl-edge-ruler ma-stl-edge-ruler--right" aria-hidden="true"></canvas>
        </div>
        <div id="ma-stl-line-dim-edit-overlay" class="desing2-stl-floor-dim-overlay" aria-hidden="true" hidden="hidden">
            <button type="button" id="ma-stl-floor-dim-readout" class="desing2-stl-floor-dim-readout" hidden="hidden" aria-hidden="true"></button>
            <button type="button" id="ma-stl-floor-dim-readout-dx" class="desing2-stl-floor-dim-readout desing2-stl-floor-dim-readout--compact" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDimReadoutDeltaXAria"></button>
            <button type="button" id="ma-stl-floor-dim-readout-dz" class="desing2-stl-floor-dim-readout desing2-stl-floor-dim-readout--compact" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDimReadoutDeltaZAria"></button>
            <input type="text" id="ma-stl-floor-dim-input" class="desing2-stl-floor-dim-input" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <input type="text" id="ma-stl-floor-dim-input-dx" class="desing2-stl-floor-dim-input desing2-stl-floor-dim-input--compact" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <input type="text" id="ma-stl-floor-dim-input-dz" class="desing2-stl-floor-dim-input desing2-stl-floor-dim-input--compact" hidden="hidden" autocomplete="off" aria-hidden="true" />
            <button type="button" id="ma-stl-floor-line-drag-handle" class="desing2-stl-floor-line-drag-handle" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineDragHandleAria"></button>
            <button type="button" id="ma-stl-floor-line-p1-handle" class="desing2-stl-floor-line-endpoint-handle desing2-stl-floor-line-p1-handle" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineP1HandleAria"></button>
            <button type="button" id="ma-stl-floor-line-p2-handle" class="desing2-stl-floor-line-endpoint-handle desing2-stl-floor-line-p2-handle" hidden="hidden" aria-hidden="true" aria-label="@MasterArticles.StlPreview_UserFloorLineP2HandleAria"></button>
        </div>
        <div id="ma-stl-wall-dim-overlay" class="desing2-stl-floor-dim-overlay desing2-stl-wall-dim-overlay" aria-hidden="true" hidden="hidden"></div>
        @* Barra superior centrada (hover / bloqueo); herramientas CAD — placeholders. *@
        @Html.Partial("_Desing2TopToolBar")
        @Html.Partial("_Desing2BottomToolBar")
        @* Borde izq. hover + contraer manual; zona “peek” a la izquierda del strip (CSS). *@
        <aside id="desing2-stl-hover-side-panel" class="desing2-stl-hover-side-panel" role="region" aria-label="@MasterArticles.StlPreview_Desing2SideMenuAria">
            <div class="desing2-stl-hover-side-panel__hover-zone">
                <div class="desing2-stl-hover-side-panel__sheet border border-start-0 rounded-end shadow-sm">
