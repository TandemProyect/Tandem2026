    @if (Model.AutoLoadInitialStl && !string.IsNullOrWhiteSpace(Model.InitialStlUrl))
    {
        <button type="button" class="d-none master-article-stl-load" id="desing2-initial-stl-boot" data-stl-url="@stlUrlAttr" data-slot-label="@stlLabelAttr"></button>
    }
    <div id="ma-stl-desing2-toast-container" class="toast-container position-fixed top-0 end-0 p-3 ma-stl-desing2-toast-container" aria-live="polite" aria-atomic="true"></div>
    <div class="modal fade desing2-stl-image-sketch-modal" id="ma-stl-image-sketch-modal" tabindex="-1" aria-labelledby="ma-stl-image-sketch-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ma-stl-image-sketch-modal-title">@MasterArticles.StlPreview_ImageSketchFormTitle</h5>
                    <button type="button" class="btn-close" id="ma-stl-image-sketch-modal-close" data-bs-dismiss="modal" aria-label="@MasterArticles.StlPreview_ImageSketchFormCancel"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-body-secondary mb-3">@MasterArticles.StlPreview_ImageSketchFormHint</p>
                    <label class="btn btn-sm btn-outline-secondary w-100 mb-3" for="ma-stl-image-sketch-file-input">
                        @MasterArticles.StlPreview_ImageSketchFormChooseFile
                    </label>
                    <input type="file" id="ma-stl-image-sketch-file-input" class="d-none" accept="image/jpeg,image/png,.jpg,.jpeg,.png" />
                    <div id="ma-stl-image-sketch-preview-wrap" class="desing2-stl-image-sketch-form__preview-wrap d-none mb-0">
                        <img id="ma-stl-image-sketch-preview" class="desing2-stl-image-sketch-form__preview img-fluid rounded border" alt="" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" id="ma-stl-image-sketch-cancel" data-bs-dismiss="modal">
                        @MasterArticles.StlPreview_ImageSketchFormCancel
                    </button>
                    <button type="button" class="btn btn-primary" id="ma-stl-image-sketch-accept" disabled
                            data-ma-stl-image-sketch-no-file="@MasterArticles.StlPreview_ImageSketchFormNoFile"
                            data-ma-stl-image-sketch-processing="@MasterArticles.StlPreview_ImageSketchProcessing"
                            data-ma-stl-image-sketch-error="@MasterArticles.StlPreview_ImageSketchError"
                            data-ma-stl-image-sketch-success="@MasterArticles.StlPreview_ImageSketchSuccess">
                        @MasterArticles.StlPreview_ImageSketchFormAccept
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
