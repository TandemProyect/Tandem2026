    function findCountPropPreviewDef(code, alt) {
        var selected = Object.create(null);
        var codeKey = countArticleKey(code);
        var altKey = countArticleKey(alt);
        if (codeKey) selected[codeKey] = true;
        if (altKey) selected[altKey] = true;
        var selectedQty = countMaterialRowQty(code) || countMaterialRowQty(alt) || countSceneRowQty(code) || countSceneRowQty(alt);

        for (var i = 0; i < countPropPreviewDefs.length; i++) {
            var direct = countPropPreviewDefs[i];
            if (selected[countArticleKey(direct.inner)]) return direct;
            if ((selected[countArticleKey(direct.body)] && /^htipo(?:2|3|3-2|4-41)$/i.test(direct.body)) || selected[countArticleKey(direct.body)] && selected[countArticleKey(direct.inner)]) return direct;
        }

        for (var j = 0; j < countPropPreviewDefs.length; j++) {
            var byBody = countPropPreviewDefs[j];
            if (!selected[countArticleKey(byBody.body)]) continue;
            var innerQty = countSceneRowQty(byBody.inner) || countMaterialRowQty(byBody.inner);
            if (innerQty !== null && countQtyMatches(selectedQty, innerQty)) return byBody;
        }

        for (var k = 0; k < countPropPreviewDefs.length; k++) {
            var byLower = countPropPreviewDefs[k];
            var lowerSelected = selected[countArticleKey(byLower.lower)] || selected[countArticleKey(byLower.lowerInner)];
            if (!lowerSelected) continue;
            var matchQty = countSceneRowQty(byLower.inner || byLower.body) || countMaterialRowQty(byLower.inner || byLower.body);
            if (matchQty !== null && countQtyMatches(selectedQty, matchQty)) return byLower;
        }

        for (var n = 0; n < countPropPreviewDefs.length; n++) {
            var fallback = countPropPreviewDefs[n];
            if (selected[countArticleKey(fallback.body)] || selected[countArticleKey(fallback.inner)] || selected[countArticleKey(fallback.lower)] || selected[countArticleKey(fallback.lowerInner)]) return fallback;
        }
        return null;
    }

    function countCompositeStlUrls(code, alt, url, url2) {
        var result = [];
        function add(raw) {
            var value = String(raw || '').trim();
            if (value && result.indexOf(value) < 0) result.push(value);
        }
        var key = countArticleKey(code);
        var altKey = countArticleKey(alt);
        if (key === '10000221' || key === '10000221b' || key === '1120100040' || altKey === '10000221' || altKey === '10000221b' || altKey === '1120100040') {
            add(countKnownStlUrl('10000221.stl'));
            add(countKnownStlUrl('10000221-2.stl'));
            return result;
        }
        var propDef = findCountPropPreviewDef(code, alt);
        if (propDef) {
            for (var i = 0; i < propDef.files.length; i++) add(countKnownStlUrl(propDef.files[i]));
            return result;
        }
        add(url);
        add(url2);
        return result;
    }

