    var articleStlHead = document.querySelector('#desing2-article-stl .desing2-article-stl__head');
    if (articleStlHead) {
        articleStlHead.addEventListener('pointerdown', function (ev) {
            if (ev.button !== 0) return;
            if (ev.target.closest('button, a, input')) return;
            var box = document.getElementById('desing2-article-stl');
            if (box && box.classList.contains('is-screen')) return;
            var start = currentArticleStlGeom(box);
            if (!start) return;
            var dx = ev.clientX - box.getBoundingClientRect().left;
            var dy = ev.clientY - box.getBoundingClientRect().top;
            articleStlHead.classList.add('is-dragging');
            articleStlHead.setPointerCapture(ev.pointerId);
            function move(e) {
                var canvas = articleStlHost();
                if (!canvas) return;
                var host = canvas.getBoundingClientRect();
                applyArticleStlBox({
                    x: e.clientX - host.left - dx,
                    y: e.clientY - host.top - dy,
                    w: start.w
                }, false);
            }
            function up(e) {
                articleStlHead.classList.remove('is-dragging');
                articleStlHead.removeEventListener('pointermove', move);
                articleStlHead.removeEventListener('pointerup', up);
                try { articleStlHead.releasePointerCapture(e.pointerId); } catch (err) { }
                var geom = currentArticleStlGeom(box);
                if (geom) applyArticleStlBox(geom, true);
            }
            articleStlHead.addEventListener('pointermove', move);
            articleStlHead.addEventListener('pointerup', up);
            ev.preventDefault();
        });
    }

