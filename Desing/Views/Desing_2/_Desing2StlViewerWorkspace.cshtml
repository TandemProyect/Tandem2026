</script>
<script>
(function () {
    var shell = document.getElementById('ma-stl-viewer-shell');
    var openBtn = document.getElementById('ma-stl-material-count');
    var panel = document.getElementById('desing2-material-count');
    var closeBtn = document.getElementById('desing2-material-count-close');
    if (!shell || !openBtn || !panel) return;
    var emptyText = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountEmpty));
    var countMsg = {
        checking: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusChecking)),
        unchanged: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusUnchanged)),
        missing: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusMissing)),
        changed: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusChanged)),
        raising: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusRaising)),
        formwork: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusFormwork)),
        saving: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusSaving)),
        clearing: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusClearing)),
        savingCount: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusSavingCount)),
        savingDesign: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusSavingDesign)),
        saved: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountSaved)),
        showing: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusShowing)),
        error: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(MasterArticles.StlPreview_MaterialCountStatusError))
    };
    var zipUrl = '@Url.Content("~/Scripts/datatables/JSZip-2.5.0/jszip.min.js")';
    var pdfMakeUrl = '@Url.Content("~/Scripts/datatables/pdfmake-0.1.36/pdfmake.min.js")';
    var pdfFontsUrl = '@Url.Content("~/Scripts/datatables/pdfmake-0.1.36/vfs_fonts.js")';
    var tableReady = false;
    var closeTimer = 0;
    var countBusy = false;
    var statusEl = document.getElementById('desing2-material-count-status');
    var summaryEl = panel.querySelector('.desing2-material-count__summary');
    var materialCountRows = [];
    var materialSceneRows = [];

    function setStatus(text) {
        if (!statusEl) return;
        statusEl.hidden = !text;
        statusEl.textContent = text || '';
    }

    function setCountLoading(on) {
        var el = document.getElementById('desing2-material-count-loading');
        panel.classList.toggle('is-loading', !!on);
        if (!el) return;
        el.hidden = !on;
    }

    function materialNumber(value) {
        var n = Number(value);
        return isFinite(n) ? n : 0;
    }

    function formatMaterialNumber(value, digits) {
        return materialNumber(value).toLocaleString('es-ES', {
            minimumFractionDigits: digits,
            maximumFractionDigits: digits
        });
    }

    function renderMaterialSummary(rows) {
        if (!summaryEl) return;
        var list = rows || [];
        var articleQty = 0;
        var totalWeight = 0;
        var totalMts2 = 0;
        for (var i = 0; i < list.length; i++) {
            var row = list[i] || {};
            var qty = materialNumber(row.qty);
            articleQty += qty;
            totalWeight += materialNumber(row.totalWeight || (materialNumber(row.unitWeight) * qty));
            totalMts2 += materialNumber(row.totalMts2 || (materialNumber(row.unitMts2) * qty));
        }
        summaryEl.innerHTML = ''
            + '<div class="desing2-material-count__summary-item">'
            + '<span>Nº artículos</span><strong>' + formatMaterialNumber(articleQty, 0) + '</strong>'
            + '</div>'
            + '<div class="desing2-material-count__summary-item">'
            + '<span>Peso total</span><strong>' + formatMaterialNumber(totalWeight, 2) + ' kg</strong>'
            + '</div>'
            + '<div class="desing2-material-count__summary-item">'
            + '<span>Total m²</span><strong>' + formatMaterialNumber(totalMts2, 2) + ' m²</strong>'
            + '</div>';
    }

    function renderMaterialDetails(rows) {
        var tbody = document.querySelector('#desing2-material-count-details-table tbody');
        if (!tbody) return;
        var list = rows || [];
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">' + escHtml(emptyText) + '</td></tr>';
            return;
        }
        var html = '';
        for (var i = 0; i < list.length; i++) {
            var row = list[i] || {};
            var qty = materialNumber(row.qty);
            var unitWeight = materialNumber(row.unitWeight);
            var unitMts2 = materialNumber(row.unitMts2);
            var totalWeight = materialNumber(row.totalWeight || (unitWeight * qty));
            var totalMts2 = materialNumber(row.totalMts2 || (unitMts2 * qty));
            html += '<tr>'
                + '<td>' + (i + 1) + '</td>'
                + '<td>' + escHtml(row.code) + '</td>'
                + '<td>' + escHtml(row.name) + '</td>'
                + '<td class="text-end">' + formatMaterialNumber(qty, 0) + '</td>'
                + '<td class="text-end">' + formatMaterialNumber(unitWeight, 2) + '</td>'
                + '<td class="text-end">' + formatMaterialNumber(totalWeight, 2) + '</td>'
                + '<td class="text-end">' + formatMaterialNumber(unitMts2, 2) + '</td>'
                + '<td class="text-end">' + formatMaterialNumber(totalMts2, 2) + '</td>'
                + '</tr>';
        }
        tbody.innerHTML = html;
    }

    var countHead = panel.querySelector('.desing2-material-count__head');
    if (countHead) {
        countHead.addEventListener('pointerdown', function (ev) {
            if (ev.button !== 0) return;
            if (ev.target.closest('button, a, input, .dt-buttons')) return;
            var canvas = document.getElementById('master-article-details-stl-viewer-canvas');
            if (!canvas) return;
            var rect = panel.getBoundingClientRect();
            var dx = ev.clientX - rect.left;
            var dy = ev.clientY - rect.top;
            panel.classList.add('is-placed');
            panel.style.width = rect.width + 'px';
            panel.style.height = rect.height + 'px';
            panel.style.bottom = 'auto';
            panel.style.right = 'auto';
            function place(clientX, clientY) {
                var host = canvas.getBoundingClientRect();
                var x = clientX - host.left - dx;
                var y = clientY - host.top - dy;
                var maxX = Math.max(0, host.width - rect.width);
                var maxY = Math.max(0, host.height - rect.height);
                panel.style.left = Math.max(0, Math.min(x, maxX)) + 'px';
                panel.style.top = Math.max(0, Math.min(y, maxY)) + 'px';
            }
            place(ev.clientX, ev.clientY);
            countHead.setPointerCapture(ev.pointerId);
            function move(e) { place(e.clientX, e.clientY); }
            function up(e) {
                countHead.removeEventListener('pointermove', move);
                countHead.removeEventListener('pointerup', up);
                try { countHead.releasePointerCapture(e.pointerId); } catch (err) { }
            }
            countHead.addEventListener('pointermove', move);
            countHead.addEventListener('pointerup', up);
            ev.preventDefault();
        });
    }

    function escAttr(value) {
        return String(value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    }

    function escHtml(value) {
        return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    var fadedCodes = Object.create(null);
    var hiddenCodes = Object.create(null);
