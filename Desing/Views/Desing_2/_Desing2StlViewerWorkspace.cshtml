@model Desing.Models.Desing2ViewerPageModel
@using System.Web
@using Desing.Resources
@{
    var textColor1Hex = string.IsNullOrWhiteSpace(Model.TextColor1Hex) ? "#000000" : Model.TextColor1Hex.Trim();
    var textColor2Hex = string.IsNullOrWhiteSpace(Model.TextColor2Hex) ? "#000000" : Model.TextColor2Hex.Trim();
    var stlUrlAttr = HttpUtility.HtmlAttributeEncode(Model.InitialStlUrl ?? string.Empty);
    var stlLabelAttr = HttpUtility.HtmlAttributeEncode(Model.InitialStlLabel ?? string.Empty);
    var logoUrl = Model.BrandLogoUrl ?? Url.Content("~" + Desing.Helpers.PluginCadDeviceHelper.DefaultMarkVirtualPath);
    var stlSrcUnits = string.IsNullOrWhiteSpace(Model.StlSourceUnits) ? "m" : Model.StlSourceUnits.Trim();
    // Evita CS0117 si el Designer.cs local no tiene aún estas claves.
    Func<string, string, string> maStr = (key, fallback) =>
    {
        try { return MasterArticles.ResourceManager.GetString(key) ?? fallback; }
        catch { return fallback; }
    };
    var wallModelRenderingText = maStr("StlPreview_WallModelRendering", "Generando modelo de muros…");
    var formworkRenderingTitle = maStr("StlPreview_FormworkRenderingTitle", "Renderizando sistema {0}");
    var formworkRenderingPhaseServer = maStr("StlPreview_FormworkRenderingPhaseServer", "Calculando módulos…");
    var formworkRenderingPhasePaint = maStr("StlPreview_FormworkRenderingPhasePaint", "Pintando paneles…");
    var formworkRenderingRemainingSeconds = maStr("StlPreview_FormworkRenderingRemainingSeconds", "Quedan unos {0} s");
    var formworkRenderingRemainingMinute = maStr("StlPreview_FormworkRenderingRemainingMinute", "Queda 1 min");
    var formworkRenderingRemainingMinutes = maStr("StlPreview_FormworkRenderingRemainingMinutes", "Quedan unos {0} min");
    var formworkRenderingAlmostDone = maStr("StlPreview_FormworkRenderingAlmostDone", "Casi listo…");
    var saveWallsSavedToast = maStr("StlPreview_SaveWallsSavedToast", "Muros guardados");
    var saveWallsAndPhotoToast = maStr("StlPreview_SaveWallsAndPhotoToast", "Muros guardados. La foto se ha guardado en el servidor.");
    var screenshotDownloadedToast = maStr("StlPreview_ScreenshotDownloadedToast", "Imagen descargada. La foto se ha guardado en el servidor.");
    var screenshotDownloadedOnlyToast = maStr("StlPreview_ScreenshotDownloadedOnlyToast", "Imagen descargada.");
    var screenshotPhotoFailedToast = maStr("StlPreview_ScreenshotPhotoFailedToast", "Imagen descargada. No se pudo guardar la foto en el servidor.");
    var saveWallsNeedDesignToast = maStr("StlPreview_SaveWallsNeedDesignToast", "Abre un diseño para guardar los muros");
    var saveWallsErrorToast = maStr("StlPreview_SaveWallsErrorToast", "No se pudieron guardar los muros");
    var designSavingText = maStr("StlPreview_DesignSaving", "Guardando diseño…");
    var designLoadingText = maStr("StlPreview_DesignLoading", "Cargando diseño…");
    var leaveSaveTitle = maStr("StlPreview_LeaveSaveTitle", "Salir del diseño");
    var leaveSaveMessage = maStr("StlPreview_LeaveSaveMessage", "¿Quieres guardar los muros antes de salir?");
    var leaveSaveYes = maStr("StlPreview_LeaveSaveYes", "Sí");
    var leaveSaveNo = maStr("StlPreview_LeaveSaveNo", "No");
    var imageSketchErrorModalTitle = maStr("StlPreview_ImageSketchErrorModalTitle", "Error al analizar la imagen");
    var screenshotTitle = maStr("StlPreview_ScreenshotTitle", "Descargar una foto del diseño, sin menús");
    var screenshotAria = maStr("StlPreview_ScreenshotAria", "Foto del diseño");
    var imageSketchErrorModalAccept = maStr("StlPreview_ImageSketchErrorModalAccept", "Aceptar");
}
@* Solo Desing_2: clase desing2-stl-view-scope; barra única marca + contexto izq., herramientas + Volver derecha.
   data-ma-stl-source-units: vértices STL → m → mm escena (×1000; reglas/rejilla en mm).
    Persistencia vista: #ma-stl-save-viewer-state → servidor + cookie por diseño; restauración tras primer refit. *@
@* Opcional desarrollo en #ma-stl-viewer-shell: data-ma-stl-dev-auto-load="true", data-ma-stl-dev-default-stl="~/Files/.../3120270090P.stl" (URL resuelta con @Url.Content), data-ma-stl-dev-default-label="..." *@
<div id="ma-stl-viewer-shell" class="desing2-stl-view-scope border rounded overflow-hidden bg-white h-100 d-flex flex-column border-secondary" data-ma-text-color1="@HttpUtility.HtmlAttributeEncode(textColor1Hex)" data-ma-text-color2="@HttpUtility.HtmlAttributeEncode(textColor2Hex)" data-ma-stl-show-rulers-toggle="true" data-ma-stl-desing2-persist-view="true" data-ma-stl-source-units="@HttpUtility.HtmlAttributeEncode(stlSrcUnits)" data-ma-stl-wall3d-api-url="@Url.Action("ProcesarLineasZwcad", "DesignToolsAutocad")" data-ma-stl-image-sketch-api-url="@Url.Action("DetectarEsquinasImagen", "DesignToolsAutocad")" data-ma-stl-map-building-search-url="@Url.Action("BuscarDireccionOsm", "DesignToolsAutocad")" data-ma-stl-map-building-buildings-url="@Url.Action("BuscarEdificiosOsm", "DesignToolsAutocad")" data-ma-stl-map-building-import-url="@Url.Action("ImportarEdificioOsm", "DesignToolsAutocad")" data-ma-stl-map-building-catastro-url="@Url.Action("ConsultarCatastroPorCoordenadas", "DesignToolsAutocad")" data-ma-stl-wall-connections-api-url="@Url.Action("SaveWallConnections", "Desing_2")" data-ma-stl-wall-diagnostics-api-url="@Url.Action("SaveWallDiagnostics", "Desing_2")" data-ma-stl-save-design-walls-api-url="@Url.Action("SaveDesignWalls", "Desing_2")" data-ma-stl-save-design-photo-api-url="@Url.Action("SaveDesignPhoto", "Desing_2")" data-ma-stl-load-design-walls-api-url="@Url.Action("GetDesignWalls", "Desing_2")" data-ma-stl-material-count-url="@Url.Action("ListDesignMaterialCount", "Desing_2")" data-ma-stl-material-count-preview-url="@Url.Action("PreviewMaterialCount", "Desing_2")" data-ma-stl-material-count-clear-url="@Url.Action("ClearDesignMaterialCount", "Desing_2")" data-ma-stl-design-id="@(Model.DesignId.HasValue ? Model.DesignId.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" data-ma-stl-prop-spacing-mm="@Model.PropSpacingMm.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-ma-stl-save-prop-spacing-api-url="@Url.Action("SavePropSpacing", "Desing_2")" data-ma-stl-wall3d-mat-wall="@Url.Content("~/Content/DesignTools/Material/concrete.png")" data-ma-stl-escape-cancel-toast="@MasterArticles.StlPreview_EscapeCancelToolsToast" data-ma-stl-user-floor-line-dim-edit-aria="@MasterArticles.StlPreview_UserFloorLineDimEditAria" data-ma-stl-user-floor-line-dim-edit-x-aria="@MasterArticles.StlPreview_UserFloorLineDimEditDeltaXAria" data-ma-stl-user-floor-line-dim-edit-z-aria="@MasterArticles.StlPreview_UserFloorLineDimEditDeltaZAria" data-ma-stl-user-floor-line-dim-edit-thickness-aria="@MasterArticles.StlPreview_UserFloorLineDimEditThicknessAria" data-ma-stl-user-floor-line-drag-handle-aria="@MasterArticles.StlPreview_UserFloorLineDragHandleAria" data-ma-stl-user-floor-line-p1-handle-aria="@MasterArticles.StlPreview_UserFloorLineP1HandleAria" data-ma-stl-user-floor-line-p2-handle-aria="@MasterArticles.StlPreview_UserFloorLineP2HandleAria">
    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap px-2 py-2 border-bottom desing2-stl-actions-toolbar" id="master-article-stl-viewer-toolbar">
        <div class="d-flex align-items-center gap-2 min-w-0 flex-grow-1 desing2-stl-toolbar-leading">
            <span class="app-brand-logo demo flex-shrink-0">
                <img src="@logoUrl" alt="" width="28" height="28" style="object-fit:contain;max-height:28px;" />
            </span>
            <div class="small fw-semibold text-white text-truncate flex-grow-1 desing2-stl-toolbar-context" title="@HttpUtility.HtmlAttributeEncode(Model.ContextSubtitleLine ?? "")">
                @(string.IsNullOrWhiteSpace(Model.ContextSubtitleLine) ? "—" : Model.ContextSubtitleLine)
            </div>
        </div>
        <div class="d-flex align-items-center gap-2 flex-shrink-0 flex-wrap justify-content-end">
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-fullscreen-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_FullscreenTitle">
                <i class="icon-base ri ri-fullscreen-line" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-save-viewer-state" title="@MasterArticles.StlPreview_SaveViewTitle" data-ma-stl-save-view-title="@MasterArticles.StlPreview_SaveViewTitle" data-ma-stl-save-view-saved="@MasterArticles.StlPreview_SaveViewSavedTitle" data-ma-stl-save-view-toast="@MasterArticles.StlPreview_SaveViewSavedToast" data-ma-stl-save-walls-toast="@HttpUtility.HtmlAttributeEncode(saveWallsSavedToast)" data-ma-stl-save-walls-photo-toast="@HttpUtility.HtmlAttributeEncode(saveWallsAndPhotoToast)" data-ma-stl-save-walls-need-design="@HttpUtility.HtmlAttributeEncode(saveWallsNeedDesignToast)" data-ma-stl-save-walls-error="@HttpUtility.HtmlAttributeEncode(saveWallsErrorToast)" aria-label="@MasterArticles.StlPreview_SaveViewAria">
                <i class="icon-base ri ri-save-3-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_SaveViewAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-screenshot" title="@screenshotTitle" aria-label="@screenshotAria" data-ma-stl-screenshot-downloaded="@HttpUtility.HtmlAttributeEncode(screenshotDownloadedToast)" data-ma-stl-screenshot-downloaded-only="@HttpUtility.HtmlAttributeEncode(screenshotDownloadedOnlyToast)" data-ma-stl-screenshot-photo-failed="@HttpUtility.HtmlAttributeEncode(screenshotPhotoFailedToast)">
                <i class="icon-base ri ri-camera-line" aria-hidden="true"></i>
                <span class="visually-hidden">@screenshotAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect d-none" id="ma-stl-material-count" title="@MasterArticles.StlPreview_MaterialCountTitle" aria-label="@MasterArticles.StlPreview_MaterialCountAria" aria-pressed="false" aria-controls="desing2-material-count">
                <i class="icon-base ri ri-list-check-2" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_MaterialCountAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-sky-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_SkyToggleTitle">
                <i class="icon-base ri ri-cloud-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_SkyToggleAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-ground-shadow-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_GroundShadowTitle">
                <i class="icon-base ri ri-shadow-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_GroundShadowAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-dark-bg-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_DarkBgTitle">
                <i class="icon-base ri ri-moon-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_DarkBgAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect" id="ma-stl-clip-toggle" aria-pressed="false" title="@MasterArticles.StlPreview_ClipToggleTitle">
                <i class="icon-base ri ri-scissors-cut-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_ClipToggleAria</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect active" id="ma-stl-xyz-axes-toggle" aria-pressed="true" title="@MasterArticles.StlPreview_XyzAxesToggleTitle">
                <i class="icon-base ri ri-compass-3-line" aria-hidden="true"></i>
                <span class="visually-hidden">@MasterArticles.StlPreview_XyzAxesAria</span>
            </button>
            <a href="#" class="btn btn-sm btn-outline-secondary waves-effect flex-shrink-0" id="ma-stl-leave-design">@Common.Btn_Back</a>
        </div>
    </div>
    <div id="master-article-details-stl-viewer-canvas" class="flex-grow-1 position-relative bg-white ma-stl-canvas--clips d-flex flex-column">
        @* inset edges (not h-100): percentage height on absolute children can collapse inside nested flex until layout settles *@
        <div id="ma-stl-viewer-gl-host" class="position-absolute top-0 bottom-0 start-0 end-0"></div>
        <section id="desing2-material-count" class="desing2-material-count" hidden="hidden" aria-hidden="true" role="region" aria-label="@MasterArticles.StlPreview_MaterialCountAria"
                 data-ma-count-select="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_MaterialCountActionSelect)"
                 data-ma-count-select-fade="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_MaterialCountActionSelectFade)"
                 data-ma-count-toggle="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_MaterialCountActionToggle)"
                 data-ma-count-fade="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_MaterialCountActionFade)"
                 data-ma-count-stl="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_LoadStlTooltip)"
                 data-ma-count-stl-missing="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_NoStlInViewerTooltip)"
                 data-ma-count-excel="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_MaterialCountExportExcel)"
                 data-ma-count-pdf="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_MaterialCountExportPdf)">
            <div class="desing2-material-count__head">
                <span class="desing2-material-count__title">@MasterArticles.StlPreview_MaterialCountTitle</span>
                <button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" id="desing2-material-count-save" title="@MasterArticles.StlPreview_MaterialCountSave" aria-label="@MasterArticles.StlPreview_MaterialCountSave">
                    <i class="icon-base ri ri-save-3-line" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" id="desing2-material-count-reset" title="@MasterArticles.StlPreview_MaterialCountReset" aria-label="@MasterArticles.StlPreview_MaterialCountReset">
                    <i class="icon-base ri ri-restart-line" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" id="desing2-material-count-close" aria-label="@Common.Aria_CloseModal">
                    <i class="icon-base ri ri-close-line" aria-hidden="true"></i>
                </button>
            </div>
            <div class="desing2-material-count__tabs-row">
            <ul class="nav nav-tabs tandem-folder-tabs desing2-material-count__tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link active" id="desing2-material-tab-articles" data-bs-toggle="tab" data-bs-target="#desing2-material-pane-articles" role="tab" aria-controls="desing2-material-pane-articles" aria-selected="true">@MasterArticles.StlPreview_MaterialCountTabArticles</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link" id="desing2-material-tab-details" data-bs-toggle="tab" data-bs-target="#desing2-material-pane-details" role="tab" aria-controls="desing2-material-pane-details" aria-selected="false">Detalles</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button type="button" class="nav-link" id="desing2-material-tab-area" data-bs-toggle="tab" data-bs-target="#desing2-material-pane-area" role="tab" aria-controls="desing2-material-pane-area" aria-selected="false">@MasterArticles.StlPreview_MaterialCountTabArea</button>
                </li>
            </ul>
            <div id="desing2-material-count-search" class="desing2-material-count__search"></div>
            </div>
            <p id="desing2-material-count-status" class="desing2-material-count__status" hidden="hidden"></p>
            <div id="desing2-material-count-loading" class="desing2-material-count__loading" hidden="hidden">
                <div class="tandem-opening-design-clock" aria-hidden="true">
                    <div class="tandem-opening-design-ring"></div>
                    <div class="tandem-opening-design-hands"></div>
                    <div class="tandem-opening-design-dot"></div>
                </div>
            </div>
            <div class="tab-content desing2-material-count__body">
                <div class="tab-pane fade show active" id="desing2-material-pane-articles" role="tabpanel" aria-labelledby="desing2-material-tab-articles">
                    <table id="desing2-material-count-table" class="table table-sm table-hover w-100" cellspacing="0">
                        <thead>
                            <tr>
                                <th>@MasterArticles.StlPreview_MaterialCountColCode</th>
                                <th>@MasterArticles.StlPreview_MaterialCountColName</th>
                                <th class="text-end">@MasterArticles.StlPreview_MaterialCountColQty</th>
                                <th class="desing2-material-count__actions-col"><span class="visually-hidden">@MasterArticles.StlPreview_MaterialCountAria</span></th>
                            </tr>
                        </thead>
                    </table>
                </div>
                <div class="tab-pane fade" id="desing2-material-pane-details" role="tabpanel" aria-labelledby="desing2-material-tab-details">
                    <div class="desing2-material-count__details-scroll">
                        <table id="desing2-material-count-details-table" class="table table-sm table-hover w-100" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Nº</th>
                                    <th>@MasterArticles.StlPreview_MaterialCountColCode</th>
                                    <th>@MasterArticles.StlPreview_MaterialCountColName</th>
                                    <th class="text-end">@MasterArticles.StlPreview_MaterialCountColQty</th>
                                    <th class="text-end">Peso Uds</th>
                                    <th class="text-end">Peso Total</th>
                                    <th class="text-end">M2</th>
                                    <th class="text-end">M2 Total</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane fade" id="desing2-material-pane-area" role="tabpanel" aria-labelledby="desing2-material-tab-area">
                    <p class="desing2-material-count__soon">@MasterArticles.StlPreview_MaterialCountSoon</p>
                </div>
            </div>
            <div class="desing2-material-count__summary"></div>
        </section>
        <section id="desing2-article-stl" class="desing2-article-stl plugin-blocks" hidden="hidden" aria-hidden="true" data-missing="@HttpUtility.HtmlAttributeEncode(MasterArticles.StlPreview_NoStlInViewerTooltip)">
            <div class="desing2-article-stl__head">
                <span class="desing2-article-stl__title" id="desing2-article-stl-title">@MasterArticles.StlPreview_LoadStlTooltip</span>
                <button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" id="desing2-article-stl-screen" title="@MasterArticles.StlPreview_FullscreenTitle" aria-label="@MasterArticles.StlPreview_FullscreenTitle" aria-pressed="false">
                    <i class="icon-base ri ri-fullscreen-line" id="desing2-article-stl-screen-icon" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-icon btn-text-secondary rounded-pill" id="desing2-article-stl-close" aria-label="@Common.Aria_CloseModal">
                    <i class="icon-base ri ri-close-line" aria-hidden="true"></i>
                </button>
            </div>
            <div class="plugin-blocks__tools" id="plugin-blocks-tools">
                <button type="button" class="plugin-blocks__tool" id="plugin-blocks-tool-expand" title="@MasterArticles.StlPreview_FullscreenTitle" data-tool="expand">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
                </button>
                <button type="button" class="plugin-blocks__tool" id="plugin-blocks-tool-zoomin" title="@Common.PluginCad_BlocksZoomIn" data-tool="zoomin">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M14.5 14.5L20 20M7 10h6M10 7v6"/></svg>
                </button>
                <button type="button" class="plugin-blocks__tool" id="plugin-blocks-tool-zoomout" title="@Common.PluginCad_BlocksZoomOut" data-tool="zoomout">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M14.5 14.5L20 20M7 10h6"/></svg>
                </button>
                <button type="button" class="plugin-blocks__tool" id="plugin-blocks-tool-fit" title="@Common.PluginCad_BlocksZoomFit" data-tool="fit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 8V4h4M20 8V4h-4M4 16v4h4M20 16v4h-4M8 8h8v8H8z"/></svg>
                </button>
                <button type="button" class="plugin-blocks__tool" id="plugin-blocks-tool-dark" title="@MasterArticles.StlPreview_DarkBgTitle" data-tool="dark">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M15 4.5A8 8 0 1 0 19.5 15 6.5 6.5 0 0 1 15 4.5z"/></svg>
                </button>
                <button type="button" class="plugin-blocks__tool" id="plugin-blocks-tool-clip" title="@MasterArticles.StlPreview_ClipToggleTitle" data-tool="clip">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="7" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="17" r="2.4" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M8 8l12 9M8 16l12-9"/></svg>
                </button>
                <button type="button" class="plugin-blocks__tool is-on" id="plugin-blocks-tool-axes" title="@MasterArticles.StlPreview_XyzAxesToggleTitle" data-tool="axes">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 4v16M4 12h16"/></svg>
                </button>
            </div>
            <div class="plugin-blocks__viewer">
                <div class="plugin-blocks__viewer-host" id="plugin-blocks-viewer" data-article-preview="1"></div>
                <div class="plugin-blocks__vc" id="plugin-blocks-vc">
                    <div class="plugin-blocks__vc-scene">
                        <div class="plugin-blocks__vc-cube" id="plugin-blocks-vc-cube">
                            <div class="plugin-blocks__vc-face plugin-blocks__vc-face--front" data-face="front">FRONT</div>
                            <div class="plugin-blocks__vc-face plugin-blocks__vc-face--back" data-face="back">BACK</div>
                            <div class="plugin-blocks__vc-face plugin-blocks__vc-face--top" data-face="top">TOP</div>
                            <div class="plugin-blocks__vc-face plugin-blocks__vc-face--bottom" data-face="bottom">BOTT.</div>
                            <div class="plugin-blocks__vc-face plugin-blocks__vc-face--right" data-face="right">RIGHT</div>
                            <div class="plugin-blocks__vc-face plugin-blocks__vc-face--left" data-face="left">LEFT</div>
                        </div>
                    </div>
                    <div class="plugin-blocks__vc-cams" role="group" aria-label="@MasterArticles.StlPreview_CameraModeAria">
                        <button type="button" id="plugin-blocks-cam-ortho" class="is-on" title="@MasterArticles.StlPreview_CameraOrthoTitle" data-cam="ortho">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg>
