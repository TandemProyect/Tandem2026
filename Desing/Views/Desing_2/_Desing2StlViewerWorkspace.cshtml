    function usableArticleHex(hex) {
        var s = String(hex || '').trim();
        if (!/^#?[0-9a-fA-F]{6}$/.test(s) && !/^#?[0-9a-fA-F]{3}$/.test(s)) return '';
        if (s.charAt(0) !== '#') s = '#' + s;
        if (s.toLowerCase() === '#000' || s.toLowerCase() === '#000000') return '';
        return s;
    }

    function countKnownPaintHex(code) {
        var c = String(code || '');
        if (isGrayPreviewArticle(c)) return '#908f8e';
        if (/4120000042/.test(c) || /185016[234]/.test(c)) return '#2a7ab8';
        if (/Tablon/i.test(c)) return '#c4894a';
        return '';
    }

    function isGrayPreviewArticle(code, alt) {
        function match(value) {
            var c = countArticleKey(value);
            return /^(?:HTipo|H0_|H03|10000221|10000221B|1120100040)/i.test(c)
                || /^(?:1110210015|4110010045|4110030554|1920804|1900144|190013[45]|546|550|551|736|737|738)$/i.test(c);
        }
        return match(code) || match(alt);
    }

    function looksLikePanelCode(code) {
        var c = String(code || '').replace(/^PANEL_/i, '');
        return /^3120\d{6}$/.test(c) || /^(?:12|24|27)\d{5,}/.test(c);
    }

    function previewColors(code, alt, color1, color2, panelPair) {
        if (isGrayPreviewArticle(code, alt)) {
            return { color1: '#908f8e', color2: '#908f8e' };
        }
        if (panelPair) {
            return { color1: '#efb608', color2: '#1a1816' };
        }
        var c1 = usableArticleHex(color1);
        var c2 = usableArticleHex(color2);
        if (!c1) {
            var paint = typeof window.maStlDesing2CountArticlePaintColors === 'function'
                ? window.maStlDesing2CountArticlePaintColors(code, alt)
                : null;
            if (paint && paint.color1) c1 = usableArticleHex(paint.color1);
        }
        if (!c1) c1 = countKnownPaintHex(code) || countKnownPaintHex(alt);
        if (!c2) c2 = c1;
        return { color1: c1 || '', color2: c2 || '' };
    }

    function stlOptsFromButton(btn, code) {
        var url = (btn.getAttribute('data-stl') || '').trim();
        var url2 = (btn.getAttribute('data-stl2') || '').trim();
        var alt = btn.getAttribute('data-alt') || '';
        var panelPair = !!(url2) || looksLikePanelCode(code) || looksLikePanelCode(alt);
        if (!url) {
            url = countArticleStlFallback(code);
        }
        if (panelPair && url && !url2) url2 = url.replace(/\.stl$/i, '_F.stl');
        var urls = countCompositeStlUrls(code, alt, url, url2);
        var colors = previewColors(code, alt, btn.getAttribute('data-c1'), btn.getAttribute('data-c2'), panelPair);
        return {
            url: urls[0] || url,
            url2: urls[1] || url2,
            urls: urls,
            color1: colors.color1,
            color2: colors.color2,
            label: btn.getAttribute('data-label') || btn.getAttribute('data-alt') || code
        };
    }

    function rowActionsHtml(row) {
