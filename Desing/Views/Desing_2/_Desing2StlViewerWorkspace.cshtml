            panel.style.zIndex = '40';
            panel.setAttribute('aria-hidden', 'false');
            panel.classList.remove('is-open');
            void panel.offsetWidth;
            panel.classList.add('is-open');
            openBtn.setAttribute('aria-pressed', 'true');
            openBtn.classList.add('active');
            if (!skipLoad) loadTable();
            return;
        }
        hideCountStl();
        panel.classList.remove('is-open');
        panel.style.transform = '';
        panel.style.display = '';
        panel.setAttribute('aria-hidden', 'true');
        openBtn.setAttribute('aria-pressed', 'false');
        openBtn.classList.remove('active');
        closeTimer = window.setTimeout(function () {
            if (!panel.classList.contains('is-open')) panel.hidden = true;
        }, 300);
    }

    function loadScript(src) {
        return new Promise(function (resolve, reject) {
            var existing = document.querySelector('script[src="' + src + '"]');
            if (existing) {
                if (existing.getAttribute('data-loaded') === '1' || existing.readyState === 'complete') {
                    resolve();
                    return;
                }
                existing.addEventListener('load', function () { resolve(); });
                existing.addEventListener('error', reject);
                return;
            }
            var el = document.createElement('script');
            el.src = src;
            el.onload = function () {
                el.setAttribute('data-loaded', '1');
                resolve();
            };
            el.onerror = reject;
            document.body.appendChild(el);
        });
    }

    function loadScripts(done) {
        var chain = [];
        if (!(window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable)) {
            var css = document.createElement('link');
            css.rel = 'stylesheet';
            css.href = 'https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css';
            document.head.appendChild(css);
            chain.push('https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js');
            chain.push('https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js');
        }
        chain.push(zipUrl);
        chain.push(pdfMakeUrl);
        chain.push(pdfFontsUrl);
        chain.push('https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js');
        chain.push('https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js');
        chain.push('https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js');
        var seq = Promise.resolve();
        chain.forEach(function (src) {
            seq = seq.then(function () { return loadScript(src); });
        });
        seq.then(done).catch(function () { done(); });
    }

    function loadTable() {
        if (tableReady) {
            window.jQuery('#desing2-material-count-table').DataTable().columns.adjust();
            return;
        }
        setCountLoading(true);
        loadScripts(function () {
            var sceneRows = typeof window.maStlDesing2FormworkCountRows === 'function'
                ? (window.maStlDesing2FormworkCountRows() || [])
                : [];
            materialSceneRows = sceneRows;
            var url = shell.getAttribute('data-ma-stl-material-count-preview-url') || '';
            function openSelectedStlFromRows(rows) {
                if (!stlCode || !rows || !rows.length) return;
                var match = null;
                for (var j = 0; j < rows.length; j++) {
                    var candidate = rows[j];
                    if ((candidate.sceneCode || candidate.code) === stlCode) {
                        match = candidate;
                        break;
                    }
                }
                if (!match) return;
                var url = (match.stlUrl || '').trim() || countArticleStlFallback(stlCode);
                var url2 = (match.stlUrl2 || '').trim();
                var panelPair = !!url2 || looksLikePanelCode(stlCode) || looksLikePanelCode(match.code);
                if (panelPair && url && !url2) url2 = url.replace(/\.stl$/i, '_F.stl');
                var urls = countCompositeStlUrls(stlCode, match.code, url, url2);
                var colors = previewColors(stlCode, match.code, match.color1, match.color2, panelPair);
                openCountStl({
                    url: urls[0] || url,
                    url2: urls[1] || url2,
                    urls: urls,
                    color1: colors.color1,
                    color2: colors.color2,
                    label: match.name || match.code || stlCode
                });
            }
            function buildTable(dataRows) {
                materialCountRows = dataRows || [];
                renderMaterialSummary(materialCountRows);
                renderMaterialDetails(materialCountRows);
                if (tableReady) {
                    setCountLoading(false);
                    return;
                }
                try {
                window.jQuery('#desing2-material-count-table').DataTable({
                    data: dataRows,
                    paging: false,
                    searching: true,
                    info: false,
                    ordering: true,
                    order: [[0, 'asc']],
                    lengthChange: false,
                    autoWidth: false,
                    scrollX: false,
                    dom: 'Bfrt',
                    language: {
                        search: 'Buscar:',
                        emptyTable: emptyText,
                        zeroRecords: emptyText
                    },
                    buttons: [
                        {
                            extend: 'excel',
                            text: '<i class="icon-base ri ri-file-excel-2-line" aria-hidden="true"></i>',
                            className: 'btn btn-sm btn-icon btn-text-secondary rounded-pill',
                            titleAttr: panel.getAttribute('data-ma-count-excel') || '',
                            title: panel.getAttribute('data-ma-count-excel') || '',
                            exportOptions: { columns: [0, 1, 2] }
                        },
                        {
                            extend: 'pdf',
                            text: '<i class="icon-base ri ri-file-pdf-2-line" aria-hidden="true"></i>',
                            className: 'btn btn-sm btn-icon btn-text-secondary rounded-pill',
                            titleAttr: panel.getAttribute('data-ma-count-pdf') || '',
                            title: panel.getAttribute('data-ma-count-pdf') || '',
                            exportOptions: { columns: [0, 1, 2] },
                            orientation: 'portrait',
                            pageSize: 'A4'
                        }
                    ],
                    columns: [
                        { data: 'code', defaultContent: '' },
                        { data: 'name', defaultContent: '' },
                        { data: 'qty', className: 'text-end', defaultContent: '' },
                        {
                            data: null,
                            orderable: false,
                            searchable: false,
                            className: 'desing2-material-count__row-actions',
                            defaultContent: '',
                            render: function (data, type, row) { return rowActionsHtml(row); }
                        }
                    ],
                    initComplete: function () {
                        var box = panel.querySelector('.dt-buttons');
                        var save = document.getElementById('desing2-material-count-save');
                        if (box && save && save.parentNode) save.parentNode.insertBefore(box, save);
                        var filter = panel.querySelector('.dataTables_filter');
                        var searchHost = document.getElementById('desing2-material-count-search');
                        if (filter && searchHost) searchHost.appendChild(filter);
                        panel.style.setProperty('--desing2-count-head-top', '0px');
                    }
                });
                tableReady = true;
            } finally {
                setCountLoading(false);
            }
            }
            if (!sceneRows.length || !url || !window.jQuery) {
                buildTable(sceneRows);
                return;
            }
            window.jQuery.ajax({
                url: url,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ items: sceneRows })
            }).done(function (data) {
                if (!data || data.ok === false || !data.rows) {
                    setStatus((data && data.message) ? (countMsg.error + ' ' + data.message) : countMsg.error);
                    buildTable([]);
                    return;
                }
                var keys = sceneRows.map(function (row) { return row.code; }).sort();
                for (var i = 0; i < data.rows.length; i++) {
                    if (!data.rows[i].sceneCode && keys[i]) data.rows[i].sceneCode = keys[i];
                }
                buildTable(data.rows);
                openSelectedStlFromRows(data.rows);
            }).fail(function () {
                setStatus(countMsg.error);
                buildTable([]);
            });
        });
    }

    function resetTable() {
        if (window.jQuery && window.jQuery.fn && window.jQuery.fn.DataTable && window.jQuery.fn.DataTable.isDataTable('#desing2-material-count-table')) {
            window.jQuery('#desing2-material-count-table').DataTable().destroy();
        }
        materialCountRows = [];
        materialSceneRows = [];
        renderMaterialSummary([]);
        renderMaterialDetails([]);
        tableReady = false;
    }

    function paintStatus(text) {
        setStatus(text);
        if (typeof window.maStlDesing2SetPersistOverlay === 'function') {
            window.maStlDesing2SetPersistOverlay(true, 'save', text);
        }
        return new Promise(function (resolve) {
            window.requestAnimationFrame(function () {
                window.setTimeout(resolve, 0);
            });
        });
    }

    function hideSavePopup() {
        if (typeof window.maStlDesing2SetPersistOverlay === 'function') {
            window.maStlDesing2SetPersistOverlay(false);
        }
    }

    function postClearArticles() {
        var url = shell.getAttribute('data-ma-stl-material-count-clear-url') || '';
        var designId = shell.getAttribute('data-ma-stl-design-id') || '';
        if (!url || !designId) {
            return Promise.reject(new Error(countMsg.error));
        }
        return fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
            credentials: 'same-origin',
            body: 'designId=' + encodeURIComponent(designId)
        }).then(function (res) {
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
        }).then(function (data) {
            if (!data || data.ok === false) {
                throw new Error((data && data.message) || countMsg.error);
            }
            return data;
        });
    }

    function saveStep(options) {
        if (typeof window.maStlDesing2SaveDesignWallsToServer !== 'function') {
            return Promise.reject(new Error(countMsg.error));
        }
        return window.maStlDesing2SaveDesignWallsToServer(options).then(function (result) {
            if (!result || result.ok !== true) {
                throw new Error((result && (result.message || result.photoMessage)) || countMsg.error);
            }
            return result;
        });
    }

    var saveBtn = document.getElementById('desing2-material-count-save');
    if (saveBtn) {
        saveBtn.addEventListener('click', function () {
            if (countBusy) return;
            countBusy = true;
            paintStatus(countMsg.savingCount)
                .then(function () { return saveStep({ articlesOnly: true, includePhoto: false, quiet: true }); })
                .then(function (result) {
                    var saved = result.articleCount != null ? Number(result.articleCount) : null;
                    if (saved === 0) throw new Error(emptyText);
                    return paintStatus(countMsg.savingDesign);
                })
                .then(function () { return saveStep({ includePhoto: true, quiet: true, hideForms: true }); })
                .then(function (result) {
                    if (typeof window.maStlDesing2SaveCurrentViewerState !== 'function') return result;
                    return window.maStlDesing2SaveCurrentViewerState().then(function (viewResult) {
                        if (viewResult && viewResult.failed && typeof window.maStlDesing2ShowSaveViewToast === 'function') {
                            window.maStlDesing2ShowSaveViewToast(
                                viewResult.message || 'No se pudo guardar la vista de cámara',
                                true
                            );
                        }
                        return result;
                    });
                })
                .then(function (result) {
                    hideSavePopup();
                    setStatus(countMsg.saved);
                    countBusy = false;
                    if (result && result.photoFailed && typeof window.maStlDesing2ShowSaveViewToast === 'function') {
                        window.maStlDesing2ShowSaveViewToast(
                            result.photoMessage || 'No se pudo guardar la foto del diseño',
                            true
                        );
                    }
                })
                .catch(function (err) {
                    hideSavePopup();
                    setStatus((err && err.message) ? (countMsg.error + ' ' + err.message) : countMsg.error);
                    countBusy = false;
                });
        });
    }

    panel.addEventListener('click', function (ev) {
        var btn = ev.target.closest('[data-count-action]');
        if (!btn || !panel.contains(btn)) return;
        var action = btn.getAttribute('data-count-action');
        if (action === 'stl') {
            ev.preventDefault();
            ev.stopPropagation();
            var stlKey = btn.getAttribute('data-code') || '';
            if (!stlKey) return;
            if (stlCode === stlKey) {
                hideCountStl();
                return;
            }
            stlCode = stlKey;
            var stlBtns = panel.querySelectorAll('[data-count-action="stl"]');
            for (var s = 0; s < stlBtns.length; s++) {
                var onStl = stlBtns[s].getAttribute('data-code') === stlKey;
                stlBtns[s].classList.toggle('is-faded', onStl);
                stlBtns[s].setAttribute('aria-pressed', onStl ? 'true' : 'false');
            }
            openCountStl(stlOptsFromButton(btn, stlKey));
            return;
        }
        if (action !== 'opacity' && action !== 'hide' && action !== 'solo' && action !== 'isolate') return;
        ev.preventDefault();
        ev.stopPropagation();
        var code = btn.getAttribute('data-code') || '';
        if (!code) return;
        var alt = btn.getAttribute('data-alt') || '';
        if (action === 'solo' || action === 'isolate') {
            var was = (action === 'isolate' ? soloHideCode : soloCode) === code;
            clearAppearanceButtons();
            if (!was) {
                btn.classList.add('is-faded');
                btn.setAttribute('aria-pressed', 'true');
                if (action === 'isolate') {
                    soloHideCode = code;
                    if (typeof window.maStlDesing2SetCountArticleSoloHide === 'function') {
                        window.maStlDesing2SetCountArticleSoloHide(code, true, alt);
                    }
                } else {
                    soloCode = code;
                    if (typeof window.maStlDesing2SetCountArticleSolo === 'function') {
                        window.maStlDesing2SetCountArticleSolo(code, true, alt);
                    }
                }
            } else if (typeof window.maStlDesing2ResetCountArticleAppearance === 'function') {
                window.maStlDesing2ResetCountArticleAppearance();
            }
            return;
        }
        var store = action === 'hide' ? hiddenCodes : fadedCodes;
        var on = !store[code];
        if (on) store[code] = true;
        else delete store[code];
        var buttons = panel.querySelectorAll('[data-count-action="' + action + '"]');
        for (var i = 0; i < buttons.length; i++) {
            if (buttons[i].getAttribute('data-code') !== code) continue;
            buttons[i].classList.toggle('is-faded', on);
            buttons[i].setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        if (action === 'hide') {
            if (typeof window.maStlDesing2SetCountArticleHidden === 'function') {
                window.maStlDesing2SetCountArticleHidden(code, on, alt);
            }
            return;
        }
        if (typeof window.maStlDesing2SetCountArticleOpacity === 'function') {
            window.maStlDesing2SetCountArticleOpacity(code, on, alt);
        }
    });

    var resetBtn = document.getElementById('desing2-material-count-reset');
    if (resetBtn) {
        resetBtn.addEventListener('click', function () {
            clearAppearanceButtons();
            if (typeof window.maStlDesing2ResetCountArticleAppearance === 'function') {
                window.maStlDesing2ResetCountArticleAppearance();
            }
        });
    }

    document.addEventListener('desing2-material-count-visibility', function (ev) {
        var show = !!(ev && ev.detail && ev.detail.show);
        openBtn.classList.toggle('d-none', !show);
        if (!show && !panel.hidden) setOpen(false);
    });

    openBtn.addEventListener('click', function () {
        if (!panel.hidden && panel.classList.contains('is-open')) {
            setOpen(false);
            return;
        }
        setStatus('');
        resetTable();
        setOpen(true);
    });
    if (closeBtn) {
        closeBtn.addEventListener('click', function () {
            setOpen(false);
        });
    }
})();
</script>
