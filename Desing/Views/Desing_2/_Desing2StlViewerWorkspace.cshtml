            return '<button type="button" class="' + cls + '" title="' + title + '" aria-label="' + title + '" aria-pressed="' + (item[3] ? 'true' : 'false') + '"' + action + '><i class="icon-base ri ' + item[0] + '" aria-hidden="true"></i></button>';
