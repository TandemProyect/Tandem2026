                                                       placeholder="@MasterArticles.StlPreview_Desing2ConfigWallWidthYPlaceholder" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="desing2-config-enclosure-section">
                                        <p class="form-label mb-2 small text-body-secondary mb-0">@MasterArticles.StlPreview_Desing2ConfigEnclosureSectionTitle</p>
