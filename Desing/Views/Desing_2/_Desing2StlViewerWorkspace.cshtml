    function readArticleStlCookie() {
        var prefix = ARTICLE_STL_COOKIE + '=';
        var parts = document.cookie ? document.cookie.split(';') : [];
        for (var i = 0; i < parts.length; i++) {
            var chunk = parts[i].replace(/^\s+/, '');
            if (chunk.indexOf(prefix) !== 0) continue;
            try {
                var data = JSON.parse(decodeURIComponent(chunk.slice(prefix.length)));
                if (!data || data.v !== 1) return null;
                if (!isFinite(data.x) || !isFinite(data.y) || !isFinite(data.w)) return null;
                return data;
            } catch (err) {
                return null;
            }
        }
        return null;
    }

    function articleStlHost() {
        return document.getElementById('master-article-details-stl-viewer-canvas');
