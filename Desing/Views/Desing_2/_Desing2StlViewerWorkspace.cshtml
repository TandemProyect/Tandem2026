    function applyArticleStlBox(geom, save) {
        var box = document.getElementById('desing2-article-stl');
        var canvas = articleStlHost();
        if (!box || !canvas || !geom) return;
        var host = canvas.getBoundingClientRect();
        var w = geom.w;
        var h = w * ARTICLE_STL_RATIO;
        if (host.width > 40 && host.height > 40) {
            var maxW = Math.min(host.width - 4, (host.height - 4) / ARTICLE_STL_RATIO);
            w = Math.max(220, Math.min(w, Math.max(220, maxW)));
            h = w * ARTICLE_STL_RATIO;
        }
        var x = geom.x;
        var y = geom.y;
        if (host.width > 40) {
            x = Math.max(0, Math.min(x, Math.max(0, host.width - w)));
            y = Math.max(0, Math.min(y, Math.max(0, host.height - h)));
        }
        box.classList.add('is-placed');
        box.style.right = 'auto';
        box.style.bottom = 'auto';
        box.style.left = Math.round(x) + 'px';
        box.style.top = Math.round(y) + 'px';
        box.style.width = Math.round(w) + 'px';
        box.style.height = Math.round(h) + 'px';
        if (save) {
            var payload = JSON.stringify({ v: 1, x: Math.round(x), y: Math.round(y), w: Math.round(w) });
            document.cookie = ARTICLE_STL_COOKIE + '=' + encodeURIComponent(payload) + '; path=/; max-age=' + (30 * 24 * 60 * 60) + '; SameSite=Lax';
        }
    }

    function currentArticleStlGeom(box) {
        var canvas = articleStlHost();
        if (!box || !canvas) return null;
        var host = canvas.getBoundingClientRect();
        var rect = box.getBoundingClientRect();
        if (rect.width < 40) return null;
        return { x: rect.left - host.left, y: rect.top - host.top, w: rect.width };
    }

    function restoreArticleStlBox() {
