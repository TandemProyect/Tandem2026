                                    <div>
                                        <label class="form-label mb-1" for="ma-stl-entorno-grid-snap-mm">@MasterArticles.StlPreview_Desing2EntornoGridSnapLabel</label>
                                        <select class="form-select form-select-sm" id="ma-stl-entorno-grid-snap-mm" aria-label="@MasterArticles.StlPreview_Desing2EntornoGridSnapAria">
                                            <option value="50">50 mm (0,05 m)</option>
                                            <option value="100">100 mm (0,1 m)</option>
                                            <option value="250">250 mm (0,25 m)</option>
                                            <option value="500" selected>500 mm (0,5 m)</option>
                                            <option value="1000">1000 mm (1 m)</option>
                                            <option value="2000">2000 mm (2 m)</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label mb-1" for="ma-stl-entorno-ruler-extent-m">@MasterArticles.StlPreview_Desing2EntornoRulerExtentLabel</label>
                                        <select class="form-select form-select-sm" id="ma-stl-entorno-ruler-extent-m" aria-label="@MasterArticles.StlPreview_Desing2EntornoRulerExtentAria">
                                            <option value="5">5 m</option>
                                            <option value="10">10 m</option>
                                            <option value="15">15 m</option>
                                            <option value="20">20 m</option>
                                            <option value="25" selected>25 m</option>
                                            <option value="30">30 m</option>
                                            <option value="40">40 m</option>
                                            <option value="50">50 m</option>
                                            <option value="60">60 m</option>
                                            <option value="80">80 m</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-pane fade" id="desing2-stl-side-pane-config" role="tabpanel" aria-labelledby="desing2-stl-side-tab-config" tabindex="0">
                                <div class="vstack gap-3">
                                    <div>
                                        <label class="form-label mb-1" for="ma-stl-config-offset-default">@MasterArticles.StlPreview_Desing2ConfigOffsetDefaultLabel</label>
                                        <input type="text" class="form-control form-control-sm" id="ma-stl-config-offset-default" maxlength="48" autocomplete="off"
