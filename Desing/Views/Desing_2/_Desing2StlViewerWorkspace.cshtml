        var safeAlt = escAttr(displayCode || '');
        var items = [
            ['ri-focus-2-line', panel.getAttribute('data-ma-count-select'), 'opacity', !!fadedCodes[key]],
            ['ri-contrast-drop-2-line', panel.getAttribute('data-ma-count-select-fade'), 'hide', !!hiddenCodes[key]],
            ['ri-eye-line', panel.getAttribute('data-ma-count-toggle'), 'solo', soloCode === key],
            ['ri-drop-line', panel.getAttribute('data-ma-count-fade'), 'isolate', soloHideCode === key],
            ['ri-box-3-line', panel.getAttribute('data-ma-count-stl'), 'stl', stlCode === key]
        ];
        var stlExtra = ' data-stl="' + escAttr(row && row.stlUrl) + '" data-stl2="' + escAttr(row && row.stlUrl2) + '" data-c1="' + escAttr(row && row.color1) + '" data-c2="' + escAttr(row && row.color2) + '" data-label="' + escAttr(row && (row.name || displayCode)) + '"';
        return items.map(function (item) {
            var title = escAttr(item[1]);
            var action = item[2] ? ' data-count-action="' + item[2] + '" data-code="' + safeKey + '" data-alt="' + safeAlt + '"' : '';
            if (item[2] === 'stl') action += stlExtra;
