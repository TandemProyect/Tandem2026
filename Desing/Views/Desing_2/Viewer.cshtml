@model Desing.Models.Desing2ViewerPageModel
@using Desing.Resources
@{
    ViewBag.Title = "Diseño — visor STL";
    Layout = "~/Views/Shared/_LayoutMaterio.cshtml";
}
@*
    Desing_2 / Viewer — Three.js STL. Barra única: logo plantilla + contexto obra/oferta/diseño (izq.);
    fullscreen, rejilla, cielo, sombra, fondo oscuro, cortes, reglas UCS (Desing_2), rosa náutica, cubo vistas, Volver.
*@
@section Styles
{
    @Html.Partial("~/Views/MasterArticles/_MasterArticleStlPreviewStyles.cshtml")
    @* MapLibre CSS/JS se cargan bajo demanda al abrir el modal Mapa (evita bloquear Desing_2 1–3 min si unpkg va lento). *@
    <style>
        /* Barra única: logo + contexto (izquierda); iconos + Volver (derecha) — color plantilla */
        .desing2-stl-view-scope #master-article-stl-viewer-toolbar.desing2-stl-actions-toolbar {
            background-color: var(--tandem-primary, var(--bs-primary)) !important;
            border-bottom-color: rgba(255, 255, 255, 0.22) !important;
            min-height: calc(44px + 0.75rem);
        }
        .desing2-stl-view-scope #master-article-stl-viewer-toolbar .btn-outline-secondary {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.55);
        }
        .desing2-stl-view-scope #master-article-stl-viewer-toolbar .btn-outline-secondary:hover,
        .desing2-stl-view-scope #master-article-stl-viewer-toolbar .btn-outline-secondary:focus {
            background: rgba(255, 255, 255, 0.18);
            color: #fff;
            border-color: #fff;
        }
        .desing2-stl-view-scope #master-article-stl-viewer-toolbar .btn-outline-secondary.active,
        .desing2-stl-view-scope #master-article-stl-viewer-toolbar .btn-check:checked + .btn-outline-secondary {
            background: rgba(0, 0, 0, 0.2);
            color: #fff;
            border-color: #fff;
        }
        .desing2-stl-toolbar-leading {
            flex-basis: 12rem;
        }
        /* Cubo de vistas: esquina superior derecha; contenedor sin fondo (solo el toggle orto/iso lleva pastilla) */
        .desing2-stl-cube-camera-stack {
            position: absolute;
            top: 10px;
            right: 10px;
            z-index: 11;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 4px;
            width: max-content;
            max-width: none;
            pointer-events: none;
        }
        .desing2-stl-cube-camera-stack > * {
            pointer-events: auto;
        }
        .desing2-stl-view-scope .desing2-stl-cube-camera-stack .ma-stl-vc-wrap {
            position: relative !important;
            top: auto !important;
            right: auto !important;
            width: auto;
            max-width: none;
        }
        .desing2-stl-view-scope .desing2-stl-cube-camera-stack .ma-stl-vc-scene {
            width: auto;
            min-height: 0;
            margin: 0;
        }
        .desing2-stl-camera-below-cube {
            background: rgba(255, 255, 255, 0.94);
            border-radius: 8px;
            padding: 4px 8px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        }
        .desing2-stl-view-scope #master-article-stl-camera-modes .btn-outline-secondary {
            color: #334155;
            border-color: rgba(51, 65, 85, 0.35);
        }
        .desing2-stl-view-scope #master-article-stl-camera-modes .btn-outline-secondary:hover {
            background: rgba(51, 65, 85, 0.08);
            color: #0f172a;
        }
        .desing2-stl-view-scope #master-article-stl-camera-modes .btn-check:checked + .btn-outline-secondary {
            background: rgba(51, 65, 85, 0.15);
            color: #0f172a;
            border-color: #334155;
        }
        .desing2-stl-view-scope .ma-stl-ruler-anchor-coords-hud {
            position: absolute;
            left: 10px;
            bottom: 46px;
            z-index: 13;
            pointer-events: none;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.8125rem;
            font-weight: 600;
            line-height: 1.35;
            letter-spacing: 0.02em;
            color: #0f172a;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(51, 65, 85, 0.28);
            border-radius: 0.375rem;
            padding: 0.35rem 0.55rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
        }
        .desing2-stl-view-scope .ma-stl-line-tool-ortho-status-hud {
            position: absolute;
            left: 10px;
            bottom: 10px;
            z-index: 14;
            pointer-events: auto;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            font-size: 0.82rem;
            font-weight: 700;
            line-height: 1.2;
            cursor: pointer;
            user-select: none;
            color: #0d6efd;
            background: rgba(255, 255, 255, 0.94);
            border: 1px solid rgba(13, 110, 253, 0.45);
            border-radius: 999px;
            padding: 0.32rem 0.58rem;
            box-shadow: 0 2px 8px rgba(15, 23, 42, 0.16);
        }
        .desing2-stl-view-scope .ma-stl-line-tool-ortho-status-hud:hover {
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 3px 10px rgba(15, 23, 42, 0.2);
        }
        .desing2-stl-view-scope .ma-stl-line-tool-ortho-status-hud.is-on {
            color: #0d6efd;
            border-color: rgba(13, 110, 253, 0.45);
        }
        .desing2-stl-view-scope .ma-stl-line-tool-ortho-status-hud.is-off {
            color: #dc3545;
            border-color: rgba(220, 53, 69, 0.45);
        }
        .desing2-stl-view-scope .ma-stl-line-tool-hud {
            position: absolute;
            left: 10px;
            bottom: 46px;
            z-index: 13;
            pointer-events: none;
            background: rgba(255, 255, 255, 0.92);
            border: 1px solid rgba(51, 65, 85, 0.28);
            border-radius: 0.375rem;
            padding: 0.4rem 0.6rem 0.45rem;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
            max-width: min(92vw, 22rem);
        }
        .desing2-stl-view-scope .ma-stl-line-tool-hud__instruction {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            line-height: 1.3;
        }
        .desing2-stl-view-scope .ma-stl-line-tool-hud__coords {
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            font-size: 0.8125rem;
            font-weight: 600;
            letter-spacing: 0.02em;
            color: #0f172a;
            line-height: 1.35;
        }
        .desing2-stl-view-scope .ma-stl-line-tool-hud__distance-row {
            pointer-events: auto;
            max-width: 100%;
        }
        .desing2-stl-view-scope .ma-stl-line-tool-hud__distance-field {
            min-width: 6.75rem;
            max-width: 12rem;
            width: auto;
        }
        .desing2-stl-view-scope .ma-stl-line-tool-hud__angle-field {
            min-width: 4.25rem;
            max-width: 5.5rem;
        }
        .desing2-stl-view-scope .ma-stl-desing2-toast-container {
            z-index: 11000;
            pointer-events: none;
        }
        .desing2-stl-view-scope .ma-stl-desing2-toast-container .toast {
            pointer-events: auto;
        }
    </style>
}

<div class="tandem-desing2-stl-viewport">
    <div class="tandem-desing2-stl-viewport__fill">
        @Html.Partial("_Desing2StlViewerWorkspace", Model)
    </div>
</div>

@section scripts
{
    @{
        var masterArticleImports = new System.Collections.Generic.Dictionary<string, string>
        {
            { "three", Url.Content("~/Scripts/Design/build/three.module.js") },
            { "@masterarticles/OrbitControls", Url.Content("~/Scripts/Design/jsm/controls/OrbitControls.js") },
            { "@masterarticles/STLLoader", Url.Content("~/Scripts/Design/jsm/loaders/STLLoader.js") },
            { "@masterarticles/InfiniteGridHelper", Url.Content("~/Scripts/MasterArticles/infinite-grid-helper.module.js") }
        };
        var masterArticleImportMap = new System.Collections.Generic.Dictionary<string, object> { { "imports", masterArticleImports } };
    }
    <script type="importmap">
@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(masterArticleImportMap))
    </script>
    <script src="@Url.Content("~/Scripts/Desing2/desing2-map-building-import.js")"></script>
    <script type="module" src="@Url.Content("~/Scripts/MasterArticles/master-article-details-stl-viewer.js")"></script>
    <script src="@Url.Content("~/Scripts/Desing2/desing2-stl-viewer-toolbar-wiring.js")"></script>
}
