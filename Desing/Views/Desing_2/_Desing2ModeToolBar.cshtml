@using Desing.Resources
@{
    var isPluginCadHost = ViewBag.PluginCadHost as bool? == true;
}

@*
    Desing_2 — barra de modo (líneas / muro 2D / muro 3D / encofrar) + sistema Atk-60.
    Compartida por el visor intranet y las paletas AutoCAD.
    En CAD: el primer botón abre el menú general (obras / ofertas / diseños).
*@
<aside id="desing2-stl-mode-toolbar" class="desing2-stl-mode-toolbar desing2-stl-floating-toolbar" role="region" aria-label="@MasterArticles.StlPreview_Desing2TopToolbarAria">
    <div class="desing2-stl-floating-toolbar__inner d-flex align-items-center" role="toolbar" aria-label="@MasterArticles.StlPreview_Desing2TopToolbarAria">
        @if (isPluginCadHost)
        {
            <div class="desing2-stl-floating-toolbar__group desing2-stl-floating-toolbar__group--home" role="group" aria-label="@Common.PluginCad_MenuHomeAria">
                <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-plugin-update" data-plugin-menu="update-library" title="@Common.PluginCad_BlocksUpdate" aria-label="@Common.PluginCad_BlocksUpdate">
                    <i class="icon-base ri ri-refresh-line" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-plugin-home" data-plugin-menu="show-home" title="@Common.PluginCad_MenuHomeTitle" aria-label="@Common.PluginCad_MenuHomeAria">
                    <i class="icon-base ri ri-apps-2-line" aria-hidden="true"></i>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-plugin-blocks" data-plugin-menu="show-blocks" title="@Common.PluginCad_BlocksOpenTitle" aria-label="@Common.PluginCad_BlocksOpenAria">
                    <svg class="icon-base desing2-stl-tool-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <rect x="4" y="5" width="16" height="14" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <path d="M4 10h16M10 5v14" fill="none" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-plugin-convert" data-plugin-menu="convert-blocks" title="@Common.PluginCad_ConvertTitle" aria-label="@Common.PluginCad_ConvertAria">
                    <svg class="icon-base desing2-stl-tool-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.6" />
                        <path d="M12 8.2v3.1M10.2 9.6L12 7.6l1.8 2" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M12 15.8v-3.1M13.8 14.4L12 16.4l-1.8-2" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-plugin-save" data-plugin-menu="save-walls" title="@Common.PluginCad_SaveWalls" aria-label="@Common.PluginCad_SaveWallsAria">
                    <i class="icon-base ri ri-save-line" aria-hidden="true"></i>
                </button>
            </div>
            <span class="desing2-stl-floating-toolbar__group-gap" aria-hidden="true"></span>
        }
        <div class="desing2-stl-floating-toolbar__group desing2-stl-floating-toolbar__group--mode" role="group" aria-label="@MasterArticles.StlPreview_Desing2TopToolbarDrawGroupAria">
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn active" id="ma-stl-mode-lines" data-ma-stl-mode="lines" title="@MasterArticles.StlPreview_Desing2ToolPolylineAria" aria-label="@MasterArticles.StlPreview_Desing2ToolPolylineAria" aria-pressed="true">
                <i class="icon-base ri ri-route-line" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-mode-wall-2d" data-ma-stl-mode="wall-2d" title="@MasterArticles.StlPreview_Desing2ToolWall2dAria" aria-label="@MasterArticles.StlPreview_Desing2ToolWall2dAria" aria-pressed="false">
                <svg class="icon-base desing2-stl-tool-icon desing2-stl-tool-icon--wall-2d" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M3 8.5h18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M4 12h16" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
                    <path d="M3 15.5h18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-mode-wall-3d" data-ma-stl-mode="wall-3d" title="@MasterArticles.StlPreview_Desing2RightMenuWall3dAria" aria-label="@MasterArticles.StlPreview_Desing2RightMenuWall3dAria" aria-pressed="false">
                <i class="icon-base ri ri-building-2-line" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary waves-effect ma-stl-viewer-toolbar-btn desing2-stl-floating-toolbar__tool-btn" id="ma-stl-mode-formwork" data-ma-stl-mode="formwork" data-ma-formwork-url-atk60="@Url.Action("GetWallsAtk-60", "Desing_2")" title="Encofrar" aria-label="Encofrar" aria-pressed="false">
                Encofrar
            </button>
        </div>
        <div class="dropdown desing2-stl-mode-toolbar__systems">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle desing2-stl-mode-toolbar__systems-toggle" id="ma-stl-mode-system-dropdown" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@MasterArticles.Col_System">
                Atk-60
            </button>
            <ul class="dropdown-menu desing2-stl-mode-toolbar__systems-menu" aria-labelledby="ma-stl-mode-system-dropdown">
                <li><button type="button" class="dropdown-item active" data-ma-system="Atk-60" aria-current="true">Atk-60</button></li>
                <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 2" disabled="disabled" aria-disabled="true">Sistema 2</button></li>
                <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 3" disabled="disabled" aria-disabled="true">Sistema 3</button></li>
                <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 4" disabled="disabled" aria-disabled="true">Sistema 4</button></li>
                <li><button type="button" class="dropdown-item disabled" data-ma-system="Sistema 5" disabled="disabled" aria-disabled="true">Sistema 5</button></li>
            </ul>
        </div>
    </div>
</aside>
