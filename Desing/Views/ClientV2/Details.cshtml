@model DAL.TSql_Client_V2
@using Desing.Resources
@using Desing.Helpers
@using Newtonsoft.Json
@using System.Globalization
@using System.Linq
@functions {
    private static string JoinParts(params string[] parts)
    {
        return string.Join(", ", parts.Where(s => !string.IsNullOrWhiteSpace(s)));
    }
}
@{
    ViewBag.Title = Model.TextLabel;
    var ci = CultureInfo.CurrentUICulture?.TwoLetterISOLanguageName ?? "es";
    var icoSrc = string.IsNullOrWhiteSpace(Model.Path_Ico)
        ? null
        : IntranetFileHelper.ResolvePublicUrl(Url, IntranetFileHelper.NormalizeUploadedWebPath(Model.Path_Ico));
    var logoSrc = string.IsNullOrWhiteSpace(Model.Path_Logo)
        ? null
        : IntranetFileHelper.ResolvePublicUrl(Url, IntranetFileHelper.NormalizeUploadedWebPath(Model.Path_Logo));

    var mapsKey = GoogleMapsConfigHelper.GetApiKey();
    var hasMapsKey = !string.IsNullOrWhiteSpace(mapsKey);
    var hasLocCoords = Model.Loc_Lat.HasValue && Model.Loc_Lng.HasValue;
    object mapPayload;
    if (hasLocCoords && hasMapsKey)
    {
        mapPayload = new { lat = (double)Model.Loc_Lat.Value, lng = (double)Model.Loc_Lng.Value };
    }
    else
    {
        mapPayload = new { lat = (double?)null, lng = (double?)null };
    }
    var mapBoot = JsonConvert.SerializeObject(mapPayload);

    var locStreetLine = JoinParts(Model.Loc_Street_Number, Model.Loc_Route, Model.Loc_Subpremise);
    var locRest = JoinParts(Model.Loc_Locality, Model.Loc_Admin_Area_2, Model.Loc_Admin_Area_1, Model.Loc_Postal_Code, Model.Loc_Country_Name);
    var listUi = JsonConvert.SerializeObject(new
    {
        culture = ci,
        rowsSuffix = ClientV2.Dt_Rows_N,
        allRows = ClientV2.Dt_Rows_All,
        sectionRecords = ClientV2.Dt_Section_Records,
        sectionExport = ClientV2.Dt_Section_Export,
        sectionCols = ClientV2.Dt_Section_ColumnsVisible,
        ariaMenu = ClientV2.Dt_MenuAria
    });
}

<div id="clientWorkspaceRoot" class="tandem-jobside-workspace">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2 tandem-jobside-workspace-toolbar">
        <h4 class="py-3 mb-0">
            <span class="text-muted fw-light">
                <a href="@Url.Action("Index", "Home")">@ClientV2.Common_Home</a> /
                <a href="@Url.Action("Index", "ClientV2")">@ClientV2.Index_Breadcrumb</a> /
            </span> @Model.TextLabel
        </h4>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light" href="@Url.Action("Index", "ClientV2")">
                <i class="icon-base ri ri-arrow-left-line me-1"></i> @Common.Btn_Back
            </a>
            <a class="btn btn-warning" href="@Url.Action("Edit", "ClientV2", new { id = Model.IdObject })">
                <i class="icon-base ri ri-pencil-line me-1"></i> @ClientV2.Btn_Edit
            </a>
        </div>
    </div>

    <div class="row g-4 align-items-stretch tandem-jobside-workspace-row">
        <div class="col-12 col-lg-5 tandem-jobside-col-left">
            <div class="card border shadow-none">
                <div class="card-header fw-semibold text-primary py-3 px-4 d-flex align-items-center justify-content-between gap-2">
                    <span>@ClientV2.Workspace_LeftTitle</span>
                    <a class="btn btn-sm btn-warning flex-shrink-0" href="@Url.Action("Edit", "ClientV2", new { id = Model.IdObject })">
                        <i class="icon-base ri ri-pencil-line me-1"></i>@ClientV2.Btn_Edit
                    </a>
                </div>
                <div class="card-body pt-3 px-4 pb-4 tandem-fill-scroll">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Name</dt>
                        <dd class="col-sm-8">@Model.TextLabel</dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Code</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.TextCode) ? ClientV2.Details_NoValue : Model.TextCode)</dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_TaxId</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.TextTaxId) ? ClientV2.Details_NoValue : Model.TextTaxId)</dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Email</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.TextEmail) ? ClientV2.Details_NoValue : Model.TextEmail)</dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Phone</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.TextPhone) ? ClientV2.Details_NoValue : Model.TextPhone)</dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_AddressFormatted</dt>
                        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Loc_Formatted_Address) ? ClientV2.Details_NoValue : Model.Loc_Formatted_Address)</dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Section_AddressDetail</dt>
                        <dd class="col-sm-8">
                            @if (string.IsNullOrEmpty(locStreetLine) && string.IsNullOrEmpty(locRest))
                            {
                                @ClientV2.Details_NoValue
                            }
                            else
                            {
                                if (!string.IsNullOrEmpty(locStreetLine))
                                {
                                    <div>@locStreetLine</div>
                                }
                                if (!string.IsNullOrEmpty(locRest))
                                {
                                    <div>@locRest</div>
                                }
                            }
                        </dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Active</dt>
                        <dd class="col-sm-8">
                            @if (Model.Is_Active)
                            {
                                <span class="badge bg-label-success">@ClientV2.State_Active</span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary">@ClientV2.State_Inactive</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Icon</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(icoSrc))
                            {
                                <img src="@icoSrc" style="height:32px;background:#fff;padding:2px;border:1px solid #eee;border-radius:4px" alt="" />
                            }
                            else
                            {
                                <span class="text-muted">@ClientV2.Details_NoValue</span>
                            }
                        </dd>

                        <dt class="col-sm-4 text-primary fw-semibold">@ClientV2.Details_Field_Logo</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrWhiteSpace(logoSrc))
                            {
                                <img src="@logoSrc" style="max-height:80px;background:#fff;padding:4px;border:1px solid #eee;border-radius:6px" alt="" />
                            }
                            else
                            {
                                <span class="text-muted">@ClientV2.Details_NoValue</span>
                            }
                        </dd>
                    </dl>

                    <div class="mt-3">
                        <div class="fw-semibold text-primary mb-2">@ClientV2.Details_MapTitle</div>
                        @if (!hasLocCoords)
                        {
                            <div class="tandem-address-block tandem-address-block--compact border rounded p-2 mb-0">
                                <div class="tandem-address-map is-empty mb-0" role="status">
                                    @Common.Google_Msg_NoAddress
                                </div>
                            </div>
                        }
                        else if (!hasMapsKey)
                        {
                            <div class="alert alert-warning mb-0 py-2" role="alert">
                                <strong>@ClientV2.Google_NotConfiguredStrong</strong>@ClientV2.Google_NotConfiguredBody
                            </div>
                        }
                        else
                        {
                            <div class="tandem-address-block tandem-address-block--compact border rounded p-2 mb-0">
                                <div id="clientV2DetailsLocMap" class="tandem-address-map mb-0" role="img" aria-label="@Common.Google_Aria_MapPreview"></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-7 tandem-jobside-col-right d-flex">
            <div class="card tandem-jobside-right-card h-100 w-100 border shadow-none">
                <div class="card-body tandem-jobside-right-card-body">
                    <div class="d-flex align-items-end gap-2 flex-nowrap tandem-jobside-tabs-bar flex-shrink-0">
                        <ul class="nav nav-tabs tandem-folder-tabs flex-grow-1 mb-0 flex-nowrap overflow-x-auto" role="tablist" style="min-width:0">
                            <li class="nav-item text-nowrap" role="presentation">
                                <button type="button" class="nav-link active" id="client-tab-docs" data-bs-toggle="tab" data-bs-target="#client-pane-docs" role="tab" aria-controls="client-pane-docs" aria-selected="true">
                                    @ClientV2.Tab_Documents
                                </button>
                            </li>
                            <li class="nav-item text-nowrap" role="presentation">
                                <button type="button" class="nav-link" id="client-tab-jobs" data-bs-toggle="tab" data-bs-target="#client-pane-jobs" role="tab" aria-controls="client-pane-jobs" aria-selected="false">
                                    @ClientV2.Tab_Jobsides
                                </button>
                            </li>
                            <li class="nav-item text-nowrap" role="presentation">
                                <button type="button" class="nav-link" id="client-tab-offers" data-bs-toggle="tab" data-bs-target="#client-pane-offers" role="tab" aria-controls="client-pane-offers" aria-selected="false">
                                    @ClientV2.Tab_Offers
                                </button>
                            </li>
                            <li class="nav-item text-nowrap" role="presentation">
                                <button type="button" class="nav-link" id="client-tab-designs" data-bs-toggle="tab" data-bs-target="#client-pane-designs" role="tab" aria-controls="client-pane-designs" aria-selected="false">
                                    @ClientV2.Tab_Designs
                                </button>
                            </li>
                        </ul>
                    </div>
                    <div class="tab-content tandem-jobside-tab-content pt-3" id="clientWorkspaceTabContent">
                        <div class="tab-pane fade show active" id="client-pane-docs" role="tabpanel" aria-labelledby="client-tab-docs">
                            <p class="text-muted small mb-2">@ClientV2.Ws_DocsTitle</p>
                            <div class="mb-3 table-responsive" style="padding:5px">
                                <table id="ClientDocumentsTable" class="table table-hover w-100" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>@Jobside.Docs_Col_Name</th>
                                            <th>@Jobside.Docs_Col_Type</th>
                                            <th>@Jobside.Docs_Col_OfferNumber</th>
                                            <th>@Jobside.Docs_Col_Extension</th>
                                            <th>@Jobside.Docs_Col_Date</th>
                                            <th class="text-end text-nowrap" style="width:1%;">@Jobside.Docs_Col_Actions</th>
                                            <th>ID</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="client-pane-jobs" role="tabpanel" aria-labelledby="client-tab-jobs">
                            <p class="text-muted small mb-2">@ClientV2.Ws_JobsTitle</p>
                            <div class="mb-3 table-responsive" style="padding:5px">
                                <table id="ClientJobsTable" class="table table-hover w-100" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>@Jobside.Details_Field_Name</th>
                                            <th>@Jobside.Details_Field_AddNJobside</th>
                                            <th>@ClientV2.Details_Field_Active</th>
                                            <th>@Jobside.Docs_Col_Date</th>
                                            <th class="text-end text-nowrap" style="width:1%;">@Jobside.Docs_Col_Actions</th>
                                            <th>ID</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="client-pane-offers" role="tabpanel" aria-labelledby="client-tab-offers">
                            <p class="text-muted small mb-2">@ClientV2.Ws_OffersTitle</p>
                            <div class="mb-3 table-responsive" style="padding:5px">
                                <table id="ClientOffersTable" class="table table-hover w-100" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>@Jobside.Offers_Col_Number</th>
                                            <th>@Jobside.Offers_Col_Name</th>
                                            <th>@ClientV2.Ws_Col_Jobside</th>
                                            <th>@Jobside.Offers_Col_State</th>
                                            <th>@Jobside.Docs_Col_Date</th>
                                            <th class="text-end text-nowrap" style="width:1%;">@Jobside.Docs_Col_Actions</th>
                                            <th>ID</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                        <div class="tab-pane fade" id="client-pane-designs" role="tabpanel" aria-labelledby="client-tab-designs">
                            <p class="text-muted small mb-2">@ClientV2.Ws_DesignsTitle</p>
                            <div class="mb-3 table-responsive" style="padding:5px">
                                <table id="ClientDesignsTable" class="table table-hover w-100" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>@ClientV2.Ws_Col_Design</th>
                                            <th>@Jobside.Docs_Col_OfferNumber</th>
                                            <th>@Jobside.Docs_Col_Date</th>
                                            <th class="text-end text-nowrap" style="width:1%;">@Jobside.Docs_Col_Actions</th>
                                            <th>ID</th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    @Html.Partial("~/Views/Shared/_GooglePlacesAddressScripts.cshtml")
    <script type="text/javascript">
        $(function () {
            var m = @Html.Raw(mapBoot);
            if (m && m.lat != null && m.lng != null && window.TandemAddressPlaces && TandemAddressPlaces.loadMapsApi) {
                TandemAddressPlaces.loadMapsApi().then(function () {
                    TandemAddressPlaces.updateMap('clientV2Details', 'clientV2DetailsLocMap', { lat: m.lat, lng: m.lng });
                }).catch(function () { });
            }

            var ui = @Html.Raw(listUi);
            var exportOpts = { columns: ':visible:not(.tandem-col-actions)' };
            function clientWsButtons() {
                return [{
                    extend: 'collection',
                    text: "<i class='fas fa-bars'></i>",
                    attr: { 'aria-label': ui.ariaMenu },
                    className: 'custom-html-collection',
                    buttons: [
                        '<h5>' + ui.sectionRecords + '</h5>',
                        'pageLength',
                        '<h5>' + ui.sectionExport + '</h5>',
                        'print',
                        'copy',
                        'pdf',
                        { extend: 'csv', exportOptions: exportOpts },
                        { extend: 'excel', exportOptions: exportOpts },
                        '<h5 class="not-top-heading">' + ui.sectionCols + '</h5>',
                        'colvis'
                    ]
                }];
            }
            function clientWsTable(selector, url, emptyMessage, order, columns) {
                return $(selector).DataTable(TandemDataTablesList.applyListDefaults({
                    lengthMenu: [
                        [10, 25, 50, -1],
                        ['10 ' + ui.rowsSuffix, '25 ' + ui.rowsSuffix, '50 ' + ui.rowsSuffix, ui.allRows]
                    ],
                    buttons: clientWsButtons(),
                    serverSide: true,
                    processing: true,
                    language: { emptyTable: emptyMessage, zeroRecords: emptyMessage },
                    ajax: { url: url, type: 'POST' },
                    order: order,
                    columns: columns
                }));
            }
            var actionCol = {
                data: 'rowActions',
                orderable: false,
                searchable: false,
                className: 'tandem-col-actions text-end align-middle text-nowrap'
            };
            var idCol = { data: 'IdObject', visible: false };
            function textCol(data, plain) {
                return {
                    data: data,
                    name: data,
                    render: function (value, type, row) {
                        if (plain && (type === 'export' || type === 'sort' || type === 'type')) {
                            return row[plain] || '';
                        }
                        return value;
                    }
                };
            }
            function dateCol(fmt, raw) {
                return {
                    data: fmt,
                    name: raw,
                    render: function (value, type, row) {
                        if (type === 'sort' || type === 'type') {
                            return row[raw] || '';
                        }
                        return value;
                    }
                };
            }

            clientWsTable('#ClientDocumentsTable', '@Url.Action("ListClientDocuments", "ClientV2", new { clientId = Model.IdObject })', @Html.Raw(JsonConvert.SerializeObject(ClientV2.Ws_DocsEmpty)), [[4, 'desc']], [
                textCol('displayName', 'displayNamePlain'),
                { data: 'documentTypeName', name: 'documentTypeName' },
                textCol('offerNumber', 'offerNumberPlain'),
                { data: 'fileExtension', name: 'fileExtension' },
                dateCol('addDateMadeFmt', 'addDateMade'),
                actionCol,
                idCol
            ]);
            clientWsTable('#ClientJobsTable', '@Url.Action("ListClientJobsides", "ClientV2", new { clientId = Model.IdObject })', @Html.Raw(JsonConvert.SerializeObject(ClientV2.Ws_JobsEmpty)), [[3, 'desc']], [
                textCol('textLabel', 'textLabelPlain'),
                { data: 'addNJobside', name: 'addNJobside' },
                { data: 'activeBadge', name: 'activeBadge' },
                dateCol('addDateMadeFmt', 'addDateMade'),
                actionCol,
                idCol
            ]);
            clientWsTable('#ClientOffersTable', '@Url.Action("ListClientOffers", "ClientV2", new { clientId = Model.IdObject })', @Html.Raw(JsonConvert.SerializeObject(ClientV2.Ws_OffersEmpty)), [[4, 'desc']], [
                textCol('addOfferNumber', 'addOfferNumberPlain'),
                textCol('textLabel', 'textLabelPlain'),
                { data: 'jobsideName', name: 'jobsideName' },
                { data: 'stateName', name: 'stateName' },
                dateCol('addDateMadeFmt', 'addDateMade'),
                actionCol,
                idCol
            ]);
            clientWsTable('#ClientDesignsTable', '@Url.Action("ListClientDesigns", "ClientV2", new { clientId = Model.IdObject })', @Html.Raw(JsonConvert.SerializeObject(ClientV2.Ws_DesignsEmpty)), [[2, 'desc']], [
                textCol('attLabel', 'attLabelPlain'),
                textCol('offerNumber', 'offerNumberPlain'),
                dateCol('attChangeFmt', 'attChange'),
                actionCol,
                idCol
            ]);

            document.querySelectorAll('#clientWorkspaceRoot button[data-bs-toggle="tab"]').forEach(function (btn) {
                btn.addEventListener('shown.bs.tab', function () {
                    if ($.fn.dataTable) {
                        $.fn.dataTable.tables({ visible: true, api: true }).columns.adjust();
                    }
                });
            });
        });
    </script>
}
