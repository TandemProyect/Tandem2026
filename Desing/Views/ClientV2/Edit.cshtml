@model DAL.TSql_Client_V2
@using Desing.Resources
@{
    ViewBag.Title = ClientV2.Page_EditTitle;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">@ClientV2.Common_Home</a> /
            <a href="@Url.Action("Index", "ClientV2")">@ClientV2.Index_Breadcrumb</a> /
        </span> @ClientV2.Page_EditTitle
    </h4>
</div>

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Edit", "ClientV2", FormMethod.Post, new { @class = "row g-3", role = "form", @id = "frmClientV2", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.IdObject)

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            @Html.Partial("_ClientV2FormFields", Model)

            <div class="col-12 border-top pt-3 d-flex justify-content-end gap-2 tandem-form-actions mt-2">
                <a href="@Url.Action("Index", "ClientV2")" class="btn btn-outline-secondary">@ClientV2.Btn_Exit</a>
                <button type="submit" class="btn btn-primary">@ClientV2.Btn_SaveChanges</button>
            </div>
        }
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
