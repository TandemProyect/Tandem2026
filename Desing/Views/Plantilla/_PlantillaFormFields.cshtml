@model Desing.Models.PlantillaViewModel
@using Desing.Resources
@{
    var brand = string.IsNullOrWhiteSpace(Model.AttBrandText) ? "T Desing.net" : Model.AttBrandText.Trim();
    var b0 = brand.Length > 0 ? brand.Substring(0, 1) : "T";
    var b1 = brand.Length > 1 ? brand.Substring(1) : "";
    var accent = string.IsNullOrWhiteSpace(Model.AttBrandAccentColor) ? "#f29100" : Model.AttBrandAccentColor.Trim();
    var textCol = string.IsNullOrWhiteSpace(Model.AttBrandTextColor) ? "" : Model.AttBrandTextColor.Trim();
}

<div class="col-lg-7">
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label">@Plantilla.Lbl_NameRequired</label>
            @Html.EditorFor(m => m.AttName, new { htmlAttributes = new { @class = "form-control", placeholder = Plantilla.Ph_Name } })
            @Html.ValidationMessageFor(m => m.AttName, "", new { @class = "text-danger" })
        </div>

        <div class="col-12">
            <label class="form-label">@Plantilla.Lbl_BrandTextRequired</label>
            @Html.EditorFor(m => m.AttBrandText, new { htmlAttributes = new { @class = "form-control", id = "AttBrandText", maxlength = "120", placeholder = Plantilla.Ph_BrandText } })
            <small class="text-muted">@Plantilla.Help_BrandText</small>
            @Html.ValidationMessageFor(m => m.AttBrandText, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-4">
            <label class="form-label">@Plantilla.Lbl_BrandAccentColor</label>
            <div class="d-flex align-items-center gap-2">
                <input type="color" id="AttBrandAccentPicker" value="@accent" class="form-control form-control-color p-1" style="width:3.25rem;height:2.5rem" title="@Plantilla.Lbl_BrandAccentColorTitle" />
                @Html.TextBoxFor(m => m.AttBrandAccentColor, new { @class = "form-control", id = "AttBrandAccentColor", maxlength = "7" })
            </div>
            @Html.ValidationMessageFor(m => m.AttBrandAccentColor, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-4">
            <label class="form-label">@Plantilla.Lbl_BrandTextColor</label>
            <div class="d-flex align-items-center gap-2">
                <input type="color" id="AttBrandTextColorPicker" value="@(string.IsNullOrEmpty(textCol) ? "#ffffff" : textCol)" class="form-control form-control-color p-1" style="width:3.25rem;height:2.5rem" title="@Plantilla.Lbl_BrandTextColorTitle" />
                @Html.TextBoxFor(m => m.AttBrandTextColor, new { @class = "form-control", id = "AttBrandTextColor", maxlength = "7", placeholder = Plantilla.Ph_BrandTextColor })
            </div>
            <small class="text-muted">@Plantilla.Help_BrandTextColor</small>
            @Html.ValidationMessageFor(m => m.AttBrandTextColor, "", new { @class = "text-danger" })
        </div>

        <div class="col-md-4">
            <label class="form-label">@Plantilla.Lbl_MainColor</label>
            <div class="d-flex align-items-center gap-2">
                <input type="color" id="AttColorPicker" value="@model.AttColor" class="form-control form-control-color p-1" style="width:3.25rem;height:2.5rem" />
                @Html.TextBoxFor(m => m.AttColor, new { @class = "form-control", id = "AttColorText", maxlength = "7" })
            </div>
            @Html.ValidationMessageFor(m => m.AttColor, "", new { @class = "text-danger" })
        </div>

        <div class="col-12">
            <label class="form-label">@Plantilla.Lbl_Logo</label>
            <input type="file" id="logoFile" name="logoFile" class="form-control" accept=".png,.jpg,.jpeg,.gif,.svg,.webp,.ico" />
            <small class="text-muted">@Plantilla.Help_LogoFormats</small>
            @Html.TextBoxFor(m => m.AttLogo, new { @class = "form-control mt-2", @readonly = "readonly", style = "background:#f8f7fa", placeholder = Plantilla.Ph_LogoPath })
            @Html.ValidationMessageFor(m => m.AttLogo, "", new { @class = "text-danger" })
        </div>

        <div class="col-12">
            <label class="form-label">@Plantilla.Lbl_Favicon</label>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <img id="PlantillaFaviconPreview"
                     src="@(Url.Content("~" + (Model.AttFavicon ?? "/assets/client/images/Default/Ico/at.ico")))"
                     alt="favicon" style="width:36px;height:36px;border:1px solid var(--bs-border-color);border-radius:6px;background:#fff;padding:2px" />
                <div class="flex-grow-1" style="min-width:200px">
                    <input type="file" id="faviconFile" name="faviconFile" class="form-control" accept=".ico,.png,.svg,.jpg,.jpeg,.gif" />
                    <small class="text-muted">@Plantilla.Help_FaviconSize</small>
                </div>
            </div>
            @Html.TextBoxFor(m => m.AttFavicon, new { @class = "form-control mt-2", @readonly = "readonly", style = "background:#f8f7fa", placeholder = Plantilla.Ph_FaviconPath })
            @Html.ValidationMessageFor(m => m.AttFavicon, "", new { @class = "text-danger" })
        </div>

        <div class="col-12">
            <div class="form-check form-switch">
                @Html.CheckBoxFor(m => m.AttIsDefault, new { @class = "form-check-input" })
                <label class="form-check-label" for="AttIsDefault">@Plantilla.Lbl_IsDefault</label>
            </div>
            <small class="text-muted">@Plantilla.Help_OnlyOneDefault</small>
        </div>
    </div>
</div>

<div class="col-lg-5">
    <div class="card border shadow-none h-100">
        <div class="card-header fw-semibold">@Plantilla.Preview_Title</div>
        <div id="PlantillaPreview" class="card-body text-center d-flex flex-column align-items-center justify-content-center" style="min-height:220px;background:@model.AttColor;border-radius:0 0 .375rem .375rem;color:#fff;">
            <img id="PlantillaPreviewLogo" src="@(Url.Content("~" + (Model.AttLogo ?? "/Content/images/Login/at.png")))" alt="logo" style="height:48px;background:#fff;padding:6px;border-radius:8px" />
            <div id="BrandPreviewRow" class="brand-font brand-svg-preview mt-3" style="color:#fff;">
                <span id="pvFirst" class="brand-t" style="color:@accent">@b0</span><span id="pvRest" class="brand-rest" style="@(string.IsNullOrEmpty(textCol) ? "" : "color:" + textCol + ";")">@b1</span>
            </div>
            <div class="small mt-2 opacity-75">@Plantilla.Preview_ColorLabel <code id="PlantillaPreviewColorTxt" class="text-white">@model.AttColor</code></div>
        </div>
    </div>
</div>
