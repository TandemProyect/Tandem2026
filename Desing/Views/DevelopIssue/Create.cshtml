@model Desing.Helpers.DevelopIssueRow
@using Desing.Resources
@{
    ViewBag.Title = DevelopIssue.Page_CreateTitle;
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">
        <a href="@Url.Action("Index", "Home")">@DevelopIssue.Common_Home</a> /
        @DevelopIssue.Common_Develop /
        <a href="@Url.Action("Index", "DevelopIssue")">@DevelopIssue.Index_Breadcrumb</a> /
    </span> @DevelopIssue.Page_CreateTitle
</h4>

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Create", "DevelopIssue", FormMethod.Post, new { @class = "row g-3", role = "form", @id = "developIssueForm", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            @Html.Partial("_DevelopIssueFormFields", Model)
            @Html.Partial("_DevelopIssueDetailFields")
            <div class="col-12 border-top pt-3 d-flex justify-content-end gap-2 tandem-form-actions mt-2">
                <a href="@Url.Action("Index", "DevelopIssue")" class="btn btn-outline-secondary">@Common.Btn_Cancel</a>
                <button type="submit" class="btn btn-primary">@Common.Btn_Save</button>
            </div>
        }
    </div>
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/Intranet/develop-issue.js")"></script>
}
