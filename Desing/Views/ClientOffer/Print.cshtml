@model Desing.Helpers.ClientOfferRow
@using System
@using System.Linq
@using Desing.Helpers
@using Desing.Resources
@{
    Layout = null;
    var logo = Model.TextLogo ?? "";
    var logos = (Model.TemplateLogos ?? new System.Collections.Generic.List<string>())
        .Where(p => !string.IsNullOrWhiteSpace(p))
        .ToList();
    if (logos.Count == 0 && !string.IsNullOrWhiteSpace(logo))
    {
        logos.Add(logo);
    }

    var headerRaw = Model.HeaderBody ?? "";
    var marker = ClientOfferMerge.LogosMarker;
    var markerIndex = headerRaw.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
    var headerBeforeLogos = markerIndex >= 0 ? headerRaw.Substring(0, markerIndex) : headerRaw;
    var headerAfterLogos = markerIndex >= 0 ? headerRaw.Substring(markerIndex + marker.Length) : "";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ClientOffer.Page_Print</title>
    <style>
        body { font-family: Arial, sans-serif; color: #222; margin: 24px; }
        img.logo { max-height: 72px; max-width: 220px; }
        h1 { font-size: 20px; margin: 16px 0; }
        pre { white-space: pre-wrap; font-family: Arial, sans-serif; font-size: 14px; }
        .toolbar { margin-bottom: 16px; }
        @@media print { .toolbar { display: none; } }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">@ClientOffer.Btn_Print</button>
    </div>
    @if (markerIndex < 0)
    {
        if (logos.Count > 0)
        {
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin:8px 0 16px 0;">
                @foreach (var logoPath in logos)
                {
                    var logoUrl = logoPath.StartsWith("/") ? Url.Content("~" + logoPath) : logoPath;
                    <img class="logo" src="@logoUrl" alt="" />
                }
            </div>
        }
        <h1>@Model.TextSubject</h1>
        <pre>@headerRaw</pre>
    }
    else
    {
        <h1>@Model.TextSubject</h1>
        if (!string.IsNullOrWhiteSpace(headerBeforeLogos))
        {
            <pre>@headerBeforeLogos</pre>
        }
        if (logos.Count > 0)
        {
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin:8px 0 16px 0;">
                @foreach (var logoPath in logos)
                {
                    var logoUrl = logoPath.StartsWith("/") ? Url.Content("~" + logoPath) : logoPath;
                    <img class="logo" src="@logoUrl" alt="" />
                }
            </div>
        }
        if (!string.IsNullOrWhiteSpace(headerAfterLogos))
        {
            <pre>@headerAfterLogos</pre>
        }
    }
    @if (!string.IsNullOrWhiteSpace(Model.TextMaterial))
    {
        <h2 style="font-size:16px;margin:16px 0 8px 0;">@ClientOffer.Lbl_Material</h2>
        <pre>@Model.TextMaterial</pre>
    }
    @if (Model.Captures != null && Model.Captures.Count > 0)
    {
        <h2 style="font-size:16px;margin:16px 0 8px 0;">@ClientOffer.Lbl_CapturesTitle</h2>
        for (var i = 0; i < Model.Captures.Count; i++)
        {
            var cap = Model.Captures[i];
            var path = cap.TextImagePath ?? "";
            var url = path.StartsWith("/") ? Url.Content("~" + path) : path;
            <div style="margin-bottom:12px;">
                <div style="font-size:12px;color:#666;">Plano @(i + 1)</div>
                <img src="@url" alt="" style="max-width:100%;border:1px solid #ddd;" />
            </div>
        }
    }
    <pre>@Model.TextBody</pre>
</body>
</html>
