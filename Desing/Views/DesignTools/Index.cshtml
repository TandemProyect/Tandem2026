@model DAL.TSql_Design
<div class="btn-group mb-3" role="group" aria-label="Filtrar diseños">
    <a id="btnAllDesing" href="@Url.Action("Index", "DesignTools", new { OnlyUser = false })" class="btn btn-outline-primary">
        <i class="icon-base ri ri-list-check me-1"></i> Ver todos los diseños
    </a>
    <a id="btnMyDesing" href="@Url.Action("Index", "DesignTools", new { OnlyUser = true })" class="btn btn-outline-primary">
        <i class="icon-base ri ri-user-line me-1"></i> Solo mis diseños
    </a>
</div>
<div id="Loading" style="z-index:5; position: absolute; background-color:   darkgrey; width: 100%; height: 100%; display: none; opacity: 0.8">
    &nbsp;&nbsp;&nbsp;&nbsp;
</div>
<div id="CreateDesign" style="position: absolute; z-index: 1200; background-color: ghostwhite; position: absolute; top: 70px; width: 750px; height:500px; display: none; border-radius: 0.9rem ">
    <button type="button" id="BtnCloseCreateDesign" class="close" data-dismiss="modal" aria-label="Close" style="padding:5px;margin:5px;top:0px"><i class="fas fa-home"></i>&nbsp;&nbsp;</button>
    <hr style="background-color:gray; height: 1px; margin: 1px; padding: 1px">
    <form>
        <fieldset>
            <div id="ContentFormDesign" style="background-position: center;width:100%;height:100%">
                <div id="IDCargandoCrear " class="col-md-12" style="position: absolute; left:300px">
                    <img src="~/Content/comunIcon/LoadingAtK.gif" style="width:150px;height:150px">
                </div>
                <div class="col-md-12" style="position: absolute; left:300px;top:280px">
                    <p>
                        Cargando pagina ..
                    </p>
                </div>
            </div>
        </fieldset>
    </form>
</div>
<div id="DivDesignPoup" style="position: absolute; z-index: 1200; background-color: ghostwhite; position: absolute; top: 70px; width: 750px; height:500px; display: none; border-radius: 0.9rem ">
    
        <button type="button" id="BtnCloseDivDesignPoup" class="close" data-dismiss="modal" aria-label="Close" style="padding:5px;margin:5px;top:0px"><i class="fas fa-home"></i>&nbsp;&nbsp;</button>
  
        <hr style="background-color:gray; height: 1px; margin: 1px; padding: 1px">
    <form>
        <fieldset>
            <div id="DivContentFormDesign" style="background-position: center;width:100%;height:100%">
                <div id="IDCargandoCrear " class="col-md-12" style="position: absolute; left:300px">
                    <img src="~/Content/comunIcon/LoadingAtK.gif" style="width:150px;height:150px">

                </div>
                <div class="col-md-12" style="position: absolute; left:300px;top:280px">
                    <p>
                        Cargando pagina ..
                    </p>
                </div>
            </div>
        </fieldset>
    </form>
</div>
<div class="slimScrollDiv" style="position: relative; overflow: hidden; width: 100%;height:100%">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h4 class="py-3 mb-0">
            <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> /</span> Lista de Diseños
        </h4>
        <a id="btDesign" class="btn btn-primary" style="cursor:pointer">
            <i class="icon-base ri ri-add-line me-1"></i> Crear Nuevo Diseño
        </a>
    </div>

</div>
<div style="height:15px">
    <hr style="background-color:#0d6efd; height: 3px ">
</div>
<div class="card mb-4" style="height: 100%; width: 100%;">
    <div class="card-body" style="padding:5px;margin:5px">
        <table id="Design" class="table table-hover" cellspacing="0" style="width: 100%; overflow: scroll">
            <thead>
                <tr>
                    @*0*@<th style="background-color: #F4C53D; color: black;">Diseño</th>
                    @*1*@<th style="background-color: #F4C53D; color: black ">Descripción</th>
                    @*2*@<th style="background-color: #F4C53D; color: black ">Creado por</th>
                    @*3*@<th style="background-color: #F4C53D; color: black "></th>
                    @*4*@<th style="background-color: #F4C53D; color: black ">Empresa</th>
                    @*5*@<th style="background-color: #F4C53D; color: black ">Delegación</th>
                    @*6*@<th style="background-color: #F4C53D; color: black ">Modificada</th>
                    @*7*@<th style="background-color: #F4C53D; color: black ">Creada</th>
                    @*8*@<th style="background-color: #F4C53D; color: black "></th>
                    @*9*@<th style="background-color: #F4C53D; color: black "></th>
                </tr>
            </thead>
        </table>
    </div>
</div>
@section scripts
    {
    <script src="~/Scripts/jquery-ui.js.js"></script>
    <script type="text/javascript">
        function deleteOB(id) {
            var w = (screen.width / 2) - 375 + "px";
            document.getElementById("DivDesignPoup").style.left = w;
            document.getElementById("DivDesignPoup").style.height = "300px";
            $("#DivDesignPoup").show("slide", { direction: "right" }, 1000);
            $("#Loading").show();
               $.ajax({
              type: 'POST',
                   url: '@Url.Content("~/DesignTools/_Delete")',
                   data: {Id:id},
            success: function (data) {
                if (data.IsOk == true) {
                    type: 'POST',
                        $('#DivContentFormDesign').load("/DesignTools/Delete")
                };
            }, error: function () {
                alert('Error occured');
            }
        });
        };
        function EditOB(id) {
      var w = (screen.width / 2) - 375 + "px";
            document.getElementById("CreateDesign").style.left = w;
            document.getElementById("CreateDesign").style.height = "600px";
            $("#CreateDesign").show("slide", { direction: "right" }, 1000);
      $("#Loading").show();
         $.ajax({
        type: 'POST',
             url: '@Url.Content("~/DesignTools/_Edit")',
             data: {Id:id},
      success: function (data) {
          if (data.IsOk == true) {
              type: 'POST',
                  $('#CreateDesign').load("/DesignTools/Edit")
          };
      }, error: function () {
          alert('Error occured');
      }
  });
  };
        $(document).ready(function () {
            var _Toas = '@TempData["ToastType"]';

            if ('@ViewBag.onlyUser' === "True")
            {
                document.getElementById("btnAllDesing").style.display = "inline";
                document.getElementById("btnMyDesing").style.display = "none"
            }
            else
            {
                document.getElementById("btnAllDesing").style.display = "none";
                document.getElementById("btnMyDesing").style.display = "inline";
            }
            if (_Toas === "Act")
            {
                document.getElementById("LableToasTileGeneral").innerHTML = '@TempData["ToastTitle"]';
                document.getElementById("LableToasContentedeGeneral").innerHTML = '@TempData["ToastMessage"]';
                $("#Toas_General").show("slide", 400, callback);
                function callback() {
                    setTimeout(function () {
                        $("#Toas_General").hide("slide", 400, callback);
                    }, 4000);
                };

            }
        var ListDesign = {
            dt: null,
            init: function () {
                dt = $('#Design').DataTable({
                    language: {
                        "decimal": "",
                        "emptyTable": "No hay información",
                        "info": "Mostrando _START_ a _END_ de _TOTAL_ Entradas",
                        "infoEmpty": "Mostrando 0 to 0 of 0 Entradas",
                        "infoFiltered": "(Filtrado de _MAX_ total entradas)",
                        "infoPostFix": "",
                        "thousands": ",",
                        "lengthMenu": "Mostrar _MENU_ Entradas",
                        "loadingRecords": "Cargando...",
                        "processing": "Procesando...",
                        "search": "Buscar:",
                        "zeroRecords": "Sin resultados encontrados",
                        "paginate": {
                            "first": "Primero",
                            "last": "Ultimo",
                            "next": "Siguiente",
                            "previous": "Anterior"
                        },
                    },
                    dom: '<"dataTables-length-position">Bfrt<"dataTables-length-position"i>p',
                    lengthMenu: [
                        [10, 25, 50, -1],
                        ['10 rows', '25 rows', '50 rows', 'Show all']
                    ],
                    buttons: [
                        {
                            extend: 'collection',
                            text: "<i class='fas fa-bars'></i>",
                            className: 'custom-html-collection',
                            buttons: [
                                '<h5>Select Record</h5>',
                                'pageLength',
                                '<h5>Export</h5>',
                                'print',
                                'copy',
                                'pdf',
                                'csv',
                                'excel',
                                '<h5 class="not-top-heading">Column Visibility</h5>',
                                'colvis'
                            ]
                        }
                    ],
                    //buttons: [
                    //    'copy', 'csv', 'excel', 'pdf', 'print'
                    //],
                    "serverSide": true,
                    "processing": true,
                    "stateSave": true,
                    "stateDuration": 12,


                    //stateSaveCallback: function(settings,data) {
                    //    //Save personalized buttons data:
                    //    var dataString = JSON.stringify(data);
                    //    localStorage.setItem(LocalStorageKey, dataString)
                    //},
                    //stateLoadCallback: function(settings) {
                    //    //Load Personalized buttons with selected options.
                    //    var options = JSON.parse(localStorage.getItem(LocalStorageKey));
                    //    return options;
                    //},
                    "ajax": {
                        "url": "@Url.Content("~/DesignTools/ListDesing/")",
                        data: {
                            OnlyUser: '@ViewBag.onlyUser',
                        },
                    "type": "POST"
                        },
                    "columns": [
                        /*0*/{ "data": "AttLabel"},
                        /*1*/{ "data": "AttDescription"},
                        /*2*/{ "data": "AttNameEmployee"},
                        /*3*/{ "data": "AttSurnameEmployee"},
                        /*4*/{ "data": "Attcompany"},
                        /*5*/{ "data": "AttLabelBranch"},
                        /*6*/{ "data": "DateChange" },
                        /*7*/{ "data": "DateCreate" },
                        /*8*/{ "data": "emptyColumn"},
                        /*9*/{ "data": "SysObjectID"}
            ],
            "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
            /*   "iDisplayLength": parseInt(leerCookie("_rowsPerPage")),*/
            "fnRowCallback": function (nRow, data, iDisplayIndex) {
                $('td:eq(0)', nRow).html(data.AttLabel);
                if (data.allowEdit == true) {
                    $('td:eq(8)', nRow).append(data.buttonOpen +   '&nbsp;');
                    $('td:eq(8)', nRow).append(data.buttonEdit +   '&nbsp;');
                    $('td:eq(8)', nRow).append(data.buttonDelete + '&nbsp;');
                }
                return nRow;
            },
            "aaSorting": [[1, 'desc']],
            "aoColumnDefs": [
                { "bVisible": false, "aTargets": [9] },
                { "bSortable": false, "aTargets": [9] },
                { "bSortable": false, "aTargets": [8] },
                { "width": "250px", "aTargets": [1] },
                { "width": "50px", "aTargets": [7] },
                { "width": "50px", "aTargets": [6] },
                { "width": "100px", "aTargets": [8] },
            ],
            drawCallback: function () {
                $('[data-toggle="tooltip"]').tooltip({
                    delay: { "show": 100, "hide": 100 },
                    placement: "auto right"
                }),
                    $('[title]').tooltip({
                        delay: { "show": 100, "hide": 100 },
                        placement: "auto"
                    })
            },
        });
                }
            }
            ListDesign.init();
       $('#CreateDesing').on('click', function ()
            {
           var w = (screen.width / 2) - 375 + "px";
           document.getElementById("CreateDesign").style.height = "600px";
           document.getElementById("CreateDesign").style.left = w;
           $("#Loading").show();
               $("#CreateDesign").show("slide", { direction: "right" }, 1000);
           $.ajax
               (
               {
              type: 'POST',
              url: '@Url.Content("~/DesignTools/_Create")',
            data: {},
            success: function (data) {
                if (data.IsOk == true) {
                    $('#ContentFormDesign').load('/DesignTools/Create');
                }
            }, error: function () {
                alert('Error occured');
            }
        });
            });
            $('#BtnCloseCreateDesign').on('click', function () {
                $("#CreateDesign").hide("slide", { direction: "right" }, 1000);
                $("#Loading").hide();
            });

        });

        $('#BtnCloseDivDesignPoup').on('click', function () {
            $("#DivDesignPoup").hide("slide", { direction: "right" }, 1000);
            $("#Loading").hide();
        });
    $('#sidebar').hide;
    $('#sidebar').toggleClass('active');
        $(this).toggleClass('active');
    </script>
}
