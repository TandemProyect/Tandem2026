@model DAL.TSql_Design
<div class="btn-group mb-3" role="group" aria-label="Filtrar diseños">
    <a id="btnAllDesing" href="@Url.Action("Index", "DesignTools", new { OnlyUser = false })" class="btn btn-outline-primary">
        <i class="icon-base ri ri-list-check me-1"></i> Ver todos los diseños
    </a>
    <a id="btnMyDesing" href="@Url.Action("Index", "DesignTools", new { OnlyUser = true })" class="btn btn-outline-primary">
        <i class="icon-base ri ri-user-line me-1"></i> Solo mis diseños
    </a>
</div>
<div id="Loading" style="z-index:5; position: absolute; background-color:   darkgrey; width: 100%; height: 100%; display: none; opacity: 0.8">
    &nbsp;&nbsp;&nbsp;&nbsp;
</div>
<div id="CreateDesign" class="tandem-popup-shell" style="display: none;">
    <div id="ContentFormDesign" class="tandem-popup-content">
        <div class="text-center p-5">
            <img src="~/Content/comunIcon/LoadingAtK.gif" style="width:120px;height:120px">
            <p class="mt-3 text-muted">Cargando página ..</p>
        </div>
    </div>
</div>
<div id="DivDesignPoup" class="tandem-popup-shell" style="display: none;">
    <div id="DivContentFormDesign" class="tandem-popup-content">
        <div class="text-center p-5">
            <img src="~/Content/comunIcon/LoadingAtK.gif" style="width:120px;height:120px">
            <p class="mt-3 text-muted">Cargando página ..</p>
        </div>
    </div>
</div>
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> /</span> Lista de Diseños
    </h4>
    <a id="btDesign" class="btn btn-primary" style="cursor:pointer">
        <i class="icon-base ri ri-add-line me-1"></i> Crear Nuevo Diseño
    </a>
</div>
<div class="card mb-4">
    <div class="card-body">
        <table id="Design" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    @*0*@<th>Diseño</th>
                    @*1*@<th>Descripción</th>
                    @*2*@<th>Creado por</th>
                    @*3*@<th>Apellido</th>
                    @*4*@<th>Empresa</th>
                    @*5*@<th>Delegación</th>
                    @*6*@<th>Modificada</th>
                    @*7*@<th>Creada</th>
                    @*8*@<th class="text-nowrap">Acciones</th>
                    @*9*@<th></th>
                </tr>
            </thead>
        </table>
    </div>
</div>
@section scripts
    {
    <script src="~/Scripts/jquery-ui.js.js"></script>
    <script type="text/javascript">
        function deleteOB(id) {
            $("#Loading").show();
            $("#DivDesignPoup").fadeIn(300);
               $.ajax({
              type: 'POST',
                   url: '@Url.Content("~/DesignTools/_Delete")',
                   data: {Id:id},
            success: function (data) {
                if (data.IsOk == true) {
                    type: 'POST',
                        $('#DivContentFormDesign').load("/DesignTools/Delete")
                };
            }, error: function () {
                alert('Error occured');
            }
        });
        };
        function EditOB(id) {
            $("#Loading").show();
            $("#CreateDesign").fadeIn(300);
         $.ajax({
        type: 'POST',
             url: '@Url.Content("~/DesignTools/_Edit")',
             data: {Id:id},
      success: function (data) {
          if (data.IsOk == true) {
              type: 'POST',
                  $('#CreateDesign').load("/DesignTools/Edit")
          };
      }, error: function () {
          alert('Error occured');
      }
  });
  };
        $(document).ready(function () {
            var _Toas = '@TempData["ToastType"]';

            if ('@ViewBag.onlyUser' === "True")
            {
                document.getElementById("btnAllDesing").style.display = "inline";
                document.getElementById("btnMyDesing").style.display = "none"
            }
            else
            {
                document.getElementById("btnAllDesing").style.display = "none";
                document.getElementById("btnMyDesing").style.display = "inline";
            }
            if (_Toas === "Act")
            {
                document.getElementById("LableToasTileGeneral").innerHTML = '@TempData["ToastTitle"]';
                document.getElementById("LableToasContentedeGeneral").innerHTML = '@TempData["ToastMessage"]';
                $("#Toas_General").show("slide", 400);
                setTimeout(function () {
                    $("#Toas_General").hide("slide", 400);
                }, 4000);

            }
        var ListDesign = {
            dt: null,
            init: function () {
                dt = $('#Design').DataTable({
                    dom: '<"dataTables-length-position">Bfrt<"dataTables-length-position"i>p',
                    lengthMenu: [
                        [10, 25, 50, -1],
                        ['10 filas', '25 filas', '50 filas', 'Todas']
                    ],
                    buttons: [
                        {
                            extend: 'collection',
                            text: "<i class='fas fa-bars'></i>",
                            className: 'custom-html-collection',
                            buttons: [
                                '<h5>Registros</h5>',
                                'pageLength',
                                '<h5>Exportar</h5>',
                                'print',
                                'copy',
                                'pdf',
                                'csv',
                                'excel',
                                '<h5 class="not-top-heading">Columnas visibles</h5>',
                                'colvis'
                            ]
                        }
                    ],
                    //buttons: [
                    //    'copy', 'csv', 'excel', 'pdf', 'print'
                    //],
                    "serverSide": true,
                    "processing": true,
                    "stateSave": true,
                    "stateDuration": 12,
                    "colReorder": { "iFixedColumnsRight": 2 },

                    //stateSaveCallback: function(settings,data) {
                    //    //Save personalized buttons data:
                    //    var dataString = JSON.stringify(data);
                    //    localStorage.setItem(LocalStorageKey, dataString)
                    //},
                    //stateLoadCallback: function(settings) {
                    //    //Load Personalized buttons with selected options.
                    //    var options = JSON.parse(localStorage.getItem(LocalStorageKey));
                    //    return options;
                    //},
                    "ajax": {
                        "url": "@Url.Content("~/DesignTools/ListDesing/")",
                        data: {
                            OnlyUser: '@ViewBag.onlyUser',
                        },
                    "type": "POST"
                        },
                    "columns": [
                        /*0*/{ "data": "AttLabel"},
                        /*1*/{ "data": "AttDescription"},
                        /*2*/{ "data": "AttNameEmployee"},
                        /*3*/{ "data": "AttSurnameEmployee"},
                        /*4*/{ "data": "Attcompany"},
                        /*5*/{ "data": "AttLabelBranch"},
                        /*6*/{ "data": "DateChange" },
                        /*7*/{ "data": "DateCreate" },
                        /*8*/{
                            "data": "emptyColumn",
                            "orderable": false,
                            "className": "text-nowrap",
                            "render": function (data, type, row) {
                                if (type !== "display") { return ""; }
                                if (row.allowEdit != true) { return ""; }
                                return (row.buttonOpen || "") + "&nbsp;" +
                                    (row.buttonEdit || "") + "&nbsp;" +
                                    (row.buttonDelete || "") + "&nbsp;";
                            }
                        },
                        /*9*/{ "data": "SysObjectID"}
            ],
            /*   "iDisplayLength": parseInt(leerCookie("_rowsPerPage")),*/
            "aaSorting": [[1, 'desc']],
            "aoColumnDefs": [
                { "bVisible": false, "aTargets": [9] },
                { "bSortable": false, "aTargets": [9] },
                { "bSortable": false, "aTargets": [8] },
                { "width": "250px", "aTargets": [1] },
                { "width": "50px", "aTargets": [7] },
                { "width": "50px", "aTargets": [6] },
                { "width": "100px", "aTargets": [8] },
            ],
            drawCallback: function () {
                $('[data-toggle="tooltip"]').tooltip({
                    delay: { "show": 100, "hide": 100 },
                    placement: "auto right"
                }),
                    $('[title]').tooltip({
                        delay: { "show": 100, "hide": 100 },
                        placement: "auto"
                    })
            },
        });
                }
            }
            ListDesign.init();
       $('#btDesign').on('click', function ()
            {
           $("#Loading").show();
           $("#CreateDesign").fadeIn(300);
           $.ajax
               (
               {
              type: 'POST',
              url: '@Url.Content("~/DesignTools/_Create")',
            data: {},
            success: function (data) {
                if (data.IsOk == true) {
                    $('#ContentFormDesign').load('/DesignTools/Create');
                }
            }, error: function () {
                alert('Error occured');
            }
        });
            });
        });

        // Cerrar popups al hacer click en el backdrop oscuro
        $('#Loading').on('click', function () {
            $("#CreateDesign").hide("slide", { direction: "right" }, 600);
            $("#DivDesignPoup").hide("slide", { direction: "right" }, 600);
            $("#Loading").hide();
        });
    $('#sidebar').hide;
    $('#sidebar').toggleClass('active');
        $(this).toggleClass('active');
    </script>
}
