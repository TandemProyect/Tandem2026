<div id="MenubottomDesign" abindex="-1" role="dialog" style="z-index: 200; background-color: white; position: absolute; bottom:5px; left:10px; width:385px; height: 850px; display: none; border-radius: 0.9rem "> 
        <button type="button" id="CloseMenubottom" class="close" data-dismiss="modal" aria-label="Close" style="padding:5px;margin:5px"><i class="fas fa-home"></i>&nbsp;&nbsp;</button>
        <hr style="color: #F88402;margin:5px" />
        <div class="col-md-12" style="padding:1px;margin:1px">
            <h6> Valores por defecto</h6>
            <div class="col-md-12" style="padding:1px;margin:1px">
                <div class="col-md-5" style="padding:1px;margin:1px">
                    <h5>Espesor</h5>
                    <input style="width:150px;height:25px;padding:15px 15px" title="Inserta Espesor del muro por defecto" type="number" class="form-control-mandatory" value="0.30" id="IdWidthDefault" placeholder="Espesor">
                    <label class="text-danger" style="display:none" id="Id_Validate_WidthDefault">El valor del Ancho del muro debe de ser superior a 0,1 mts y menor de 1 metro</label>
                </div>
                <div class="col-md-6" style="padding:1px;margin:1px">
                    <h5>Altura</h5>
                    <input style="width:150px;height:25px;padding:15px 15px" title="Inserta Altura del muro por defecto" type="number" class="form-control-mandatory" value="2.70" id="IdHeightDefault" placeholder="Altura">
                    <label class="text-danger" style="display:none" id="Id_Validate_hightDefault">La altura del muro debe de ser superior a 0,1 mts y menor de 10 metros</label>

                </div>
            </div>
        </div>
        <div class="col-md-12" style="padding:1px;margin:1px">
            <h6> Ayudas de diseño</h6>
            <div class="col-md-12" style="padding:1px;margin:1px">
                <div class="form-check form-switch">
                    <button class="btn-circle.btn-xl" title="Insertar Muro Paralelo" id="Insert_Paralelas"><img src="~/Content/DesignTools/MenuIcon/Paralelas.png" /></button>
                    <button class="btn-circle.btn-xl" title="Crear conexión entre Muro" id="Insert_Conexion"><img src="~/Content/DesignTools/MenuIcon/ConexionL.png" /></button>
                </div>
            </div>
            <hr style="color: #F88402; margin: 5px" />
            <div class="col-md-12" style="padding:1px;margin:1px">
                <h6> Insertar Muro</h6>
                <div class="form-check form-switch">
                    <button class="btn-circle.btn-xl" title="Insertar Muro 0" id="Insert_Wall">    <img src="~/Content/DesignTools/MenuIcon/Recto.png" /></button>
                    <button class="btn-circle.btn-xl" title="Insertar Muro 90" id="Insert_Wall_90"><img src="~/Content/DesignTools/MenuIcon/Recto_90.png" /></button>
                </div>
            </div>
            <hr style="color: #F88402" />
            <div class="col-md-12" style="padding:1px;margin:1px">
                <div class="form-check form-switch">
                    <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m1"><img src="~/Content/DesignTools/MenuIcon/m1.png" /></button>
                    <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m20"><img src="~/Content/DesignTools/MenuIcon/m2.png" /></button>
                    <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m3"><img src="~/Content/DesignTools/MenuIcon/m3.png" /></button>
                </div>
            </div>
        </div>
        <div class="col-md-12" style="padding:1px;margin:1px">

            <div class="form-check form-switch">
                <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m80"><img src="~/Content/DesignTools/MenuIcon/m4.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_X"><img src="~/Content/DesignTools/MenuIcon/m5.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m40"><img src="~/Content/DesignTools/MenuIcon/m6.png" /></button>
            </div>
        </div>
        <div class="col-md-12" style="padding:1px;margin:1px">
            <div class="form-check form-switch">
                <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m7"><img src="~/Content/DesignTools/MenuIcon/m7.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m60"><img src="~/Content/DesignTools/MenuIcon/m8.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Esquina" id="Insert_Wall_m5"><img src="~/Content/DesignTools/MenuIcon/m9.png" /></button>
            </div>
        </div>
        <hr style="color: #F88402; margin: 5px" />
        <div class="col-md-12">
            <h6> wizar</h6>
            <div class="form-check form-switch">
                <button class="btn-circle.btn-xl" title="Insertar Nuecleo" id="btWizarNucleo"><img src="~/Content/DesignTools/MenuIcon/wizarAccesor.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Pilar" id="Insert_Pilar"><img src="~/Content/DesignTools/MenuIcon/Pilar.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Trabajador" id="Insert_Worker"><img src="~/Content/DesignTools/MenuIcon/worker.png" /></button>
                <button class="btn-circle.btn-xl" title="Insertar Regilla" id="Insert_Grill"><img src="~/Content/DesignTools/MenuIcon/Grill.png" /></button>
            </div>
        </div>
        <div class="col-md-12" style="padding:1px;margin:1px">
            <div class="form-check form-switch">
                <button class="btn-circle.btn-xl" title="Eliminar Puntal" id="Insert_Puntal"><img src="~/Content/DesignTools/MenuIcon/Puntal.png" /></button>
                <button class="btn-circle.btn-xl" title="Borrar todo" id="Delete_All"><img src="~/Content/DesignTools/MenuIcon/reset.png" /></button>
            </div>
        </div>

        <hr style="color: #0056b2;margin: 5px" />
</div>
