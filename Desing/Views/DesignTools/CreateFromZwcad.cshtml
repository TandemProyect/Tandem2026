@{
    ViewBag.Title = "Crear diseño desde ZWCAD";
    Layout = "~/Views/Shared/_LayoutZwcadEmbed.cshtml";
    var createdOk = (ViewBag.ZwcadCreated as bool?) ?? false;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12 col-lg-8">
            @if (createdOk)
            {
                <div class="alert alert-success" role="alert">
                    Diseno creado correctamente desde ZWCAD.
                </div>
                <div class="d-flex gap-2 mb-3">
                    <a class="btn btn-outline-primary"
                       href="@Url.Action("CreateFromZwcad", "DesignTools", new { deviceId = ViewBag.ZwcadDeviceId })">
                        Crear otro
                    </a>
                    <a class="btn btn-primary"
                       href="@Url.Action("Index", "DesignTools")">
                        Ir a listado
                    </a>
                </div>
            }
            @Html.Partial("_CreateEdit")
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/jquery.validate.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.js"></script>
}
