@model IList<Desing.Helpers.SystemCatalogRow>
@{
    ViewBag.Title = "Sistemas";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">Inicio</a> / Configuración /
        </span> Sistemas
    </h4>
    <a class="btn btn-primary text-white" href="@Url.Action("Create")">
        <i class="icon-base ri ri-add-line me-1"></i> Nuevo sistema
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListSystems" class="table table-hover" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Color de paneles</th>
                    <th>Descripción</th>
                    <th>Activo</th>
                    <th class="text-end text-nowrap tandem-col-actions" style="width:1%;">Acciones</th>
                    <th>ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    var color = string.IsNullOrWhiteSpace(row.TextPanelColor) ? "" : row.TextPanelColor;
                    <tr>
                        <td>@row.TextLabel</td>
                        <td>
                            @if (!string.IsNullOrEmpty(color))
                            {
                                <span class="d-inline-block rounded border me-2 align-middle" style="width:1.25rem;height:1.25rem;background:@color"></span>
                                @color
                            }
                            else
                            {
                                <span>Sin color</span>
                            }
                        </td>
                        <td title="@SystemCatalogRepository.ToPlainText(row.TextDescription, 0)">@SystemCatalogRepository.ToPlainText(row.TextDescription, 140)</td>
                        <td>@(row.AddIsActive ? "Sí" : "No")</td>
                        <td class="text-end tandem-col-actions">
                            <div class="d-inline-flex align-items-center gap-2">
                                <a class="btn btn-warning btn-sm" href="@Url.Action("Edit", new { id = row.IdObject })">Editar</a>
                            </div>
                        </td>
                        <td>@row.IdObject</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        $(document).ready(function () {
            var tableOptions = TandemDataTablesList.applyListDefaults({
                order: [[0, 'asc']],
                colReorder: { iFixedColumnsRight: 2 },
                columnDefs: [
                    { targets: -1, visible: false },
                    { targets: -2, orderable: false, searchable: false }
                ]
            });
            delete tableOptions.ajax;
            $('#ListSystems').DataTable(tableOptions);
        });
    </script>
}
