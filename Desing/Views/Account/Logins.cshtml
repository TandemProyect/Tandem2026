@using Desing.Models
@model LoginViewModel
<div class="content-body" style="overflow: hidden; width: 100%">
    <div class="row membership" style="width: 100%;height:100%">
        <div class="col-lg-8 col-md-6 hidden-sm hidden-xs membership-brand">
            <div class="brand-wrapper" style="width:100%;height:100%">
                <div class="brand-container"  style="width:100%;height:100%">
                    <a href=""><span style="color:gold">Tandem </span>Staging Desing</a>
                    <div class="brand-title">
                        Bienvenidos,  <span style="color:aquamarine">TandemStaging.com  </span>
                    </div>
                    <div class="brand-subtitle">
                        @*Ultima Publicación 27/02/2024 13:30 h (No testear)*@
                    </div>
                    <div class="brand-description">
                    </div>
                    @*<ul class="brand-links">
                    <li>
                        <a href="">Terms & Conditions</a>
 
                    </li>
                    <li>
                        <a href="">License Agreement</a>
                    </li>
                    <li>
                        <a href="">Contact</a>
                    </li>
                    <li>
                        <a href="">Support</a>
                    </li>
                </ul>*@

                </div>

            </div>
        </div>
        <div class="col-lg-4 col-md-6 col-sm-12 membership-container" id="MenuRightLogin" abindex="-1" role="dialog" style="z-index: 250;position: absolute; top:10px; right: 10px; width:400px; height: 100%; display: none; border-radius: 0.9rem;">
            @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                @Html.AntiForgeryToken()
                @*<div class="membership-title" style="background-color: #F4C53D">
                    <span><img src="~/Content/images/Login/atenko.svg" style="width:100px;height:50px" />
                    </span> <span style="color:white">Desing</span><span style="color: gainsboro">.net</span>
                </div>*@
                <div class="login animated">
                    <div class="membership-title">Iniciar diseño</div>
                    <div class="membership-input">
                        @Html.TextBoxFor(m => m.Email, new { placeholder = "Email", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        <label class="text-danger">@ViewBag.ErrorMessage</label>
                    </div>
                    <div class="membership-input">
                        @Html.PasswordFor(m => m.Password, new { placeholder = "Password", @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger", id = "IdPasswordMessage" })
                    </div>
                    <div class="row">
                        <div class="col-lg-6">
                            <div class="membership-input">
                                <div class="checkbox">
                                    <label>
                                        <input type="checkbox">
                                        <span class="text">Recordarme</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="membership-forgot pull-right">
                                <p>
                                    @Html.ActionLink("Olvide mi contraseña?", "ForgotPassword")
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="membership-submit">
                        <input type="submit" class="btn btn-primary btn-lg btn-block" value="Entrar">
                    </div>
                </div>
            }
        </div>
    </div>
    </div>
 
<script src="~/Scripts/jquery-3.5.1.js"></script>
<script src="~/Scripts/jquery-ui.js.js"></script>
<script type="text/javascript">
    $("#MenuRightLogin").show("slide", { direction: "right" }, 400);
    $('#sidebar').toggleClass('active');
    $(this).toggleClass('active');
</script>