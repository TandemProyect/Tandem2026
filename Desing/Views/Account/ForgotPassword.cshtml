@using Desing.Resources
@model Desing.Models.ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/_LayoutMaterioBlank.cshtml";
    var brandText = (ViewBag.PlantillaBrandText as string) ?? Common.App_BrandFallback;
    ViewBag.Title = Common.Forgot_PageTitle + " - " + brandText;
}
<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner tandem-auth-inner py-6 mx-4">

            <div class="card p-sm-7 p-2">
                <div class="app-brand justify-content-center mt-5">
                    <a href="@Url.Action("Login", "Account")" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">
                            <img src="~/Content/images/Login/at.png" alt="Tandem" style="height:36px" />
                        </span>
                        <span class="app-brand-text demo text-heading brand-svg-login">
                            @Html.Partial("_BrandSvg")
                        </span>
                    </a>
                </div>

                <div class="card-body mt-1">
                    <h4 class="mb-1">@Common.Forgot_Heading</h4>
                    <p class="mb-5">@Common.Forgot_Subtitle</p>

                    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { id = "formForgot", @class = "mb-5", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small d-block mb-3" })

                        <div class="form-floating form-floating-outline mb-5 form-control-validation">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "email", placeholder = Common.Forgot_Lbl_Email, autofocus = "autofocus" })
                            <label for="email">@Common.Forgot_Lbl_Email</label>
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small d-block mb-3" })

                        <div class="mb-5">
                            <button class="btn btn-primary d-grid w-100" type="submit">@Common.Forgot_Btn_Send</button>
                        </div>

                        <div class="text-center">
                            <a href="@Url.Action("Login", "Account")" class="d-flex align-items-center justify-content-center">
                                <i class="icon-base ri ri-arrow-left-s-line me-1"></i>
                                <span>@Common.Forgot_Link_BackToLogin</span>
                            </a>
                        </div>
                    }
                </div>
            </div>

            <img src="~/assets/img/login-construction-skyline.png" class="tandem-login-skyline d-none d-lg-block" alt="construction-skyline" />
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
