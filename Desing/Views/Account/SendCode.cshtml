@model Desing.Models.SendCodeViewModel
@{
    Layout = "~/Views/Shared/_LayoutMaterioBlank.cshtml";
    ViewBag.Title = "Enviar codigo - T Desing.net";
}
<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner tandem-auth-inner py-6 mx-4">

            <div class="card p-sm-7 p-2">
                <div class="app-brand justify-content-center mt-5">
                    <a href="@Url.Action("Login", "Account")" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">
                            <img src="~/Content/images/Login/at.png" alt="Tandem" style="height:36px" />
                        </span>
                        <span class="app-brand-text demo text-heading brand-svg-login">
                            @Html.Partial("_BrandSvg")
                        </span>
                    </a>
                </div>

                <div class="card-body mt-1">
                    <h4 class="mb-1">Verificacion en dos pasos</h4>
                    <p class="mb-5">Selecciona como quieres recibir el codigo de verificacion.</p>

                    @using (Html.BeginForm("SendCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { @class = "mb-5", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("rememberMe", @Model.RememberMe)

                        <div class="mb-5">
                            <label class="form-label" for="SelectedProvider">Proveedor</label>
                            @Html.DropDownListFor(model => model.SelectedProvider, Model.Providers, new { @class = "form-select", id = "SelectedProvider" })
                        </div>

                        <div class="mb-5">
                            <button type="submit" class="btn btn-primary d-grid w-100">Enviar codigo</button>
                        </div>
                    }
                </div>
            </div>

            <img src="~/assets/img/login-construction-skyline.png" class="tandem-login-skyline d-none d-lg-block" alt="construction-skyline" />
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
