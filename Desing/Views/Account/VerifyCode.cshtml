@model Desing.Models.VerifyCodeViewModel
@{
    Layout = "~/Views/Shared/_LayoutMaterioBlank.cshtml";
    ViewBag.Title = "Verificar codigo - " + (ViewBag.PlantillaBrandText as string ?? "T Desing.net");
}
<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner tandem-auth-inner py-6 mx-4">

            <div class="card p-sm-7 p-2">
                <div class="app-brand justify-content-center mt-5">
                    <a href="@Url.Action("Login", "Account")" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">
                            <img src="~/Content/images/Login/at.png" alt="Tandem" style="height:36px" />
                        </span>
                        <span class="app-brand-text demo text-heading brand-svg-login">
                            @Html.Partial("_BrandSvg")
                        </span>
                    </a>
                </div>

                <div class="card-body mt-1">
                    <h4 class="mb-1">Verificar codigo</h4>
                    <p class="mb-5">Introduce el codigo que has recibido para completar el inicio de sesion.</p>

                    @using (Html.BeginForm("VerifyCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { id = "formVerify", @class = "mb-5", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("provider", @Model.Provider)
                        @Html.Hidden("rememberMe", @Model.RememberMe)
                        @Html.ValidationSummary(true, "", new { @class = "text-danger small d-block mb-3" })

                        <div class="form-floating form-floating-outline mb-5 form-control-validation">
                            @Html.TextBoxFor(m => m.Code, new { @class = "form-control", id = "code", placeholder = "Codigo", autofocus = "autofocus" })
                            <label for="code">Codigo</label>
                        </div>
                        @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger small d-block mb-3" })

                        <div class="form-check mb-5">
                            @Html.CheckBoxFor(m => m.RememberBrowser, new { @class = "form-check-input", id = "rememberBrowser" })
                            <label class="form-check-label" for="rememberBrowser">Recordar este navegador</label>
                        </div>

                        <div class="mb-5">
                            <button type="submit" class="btn btn-primary d-grid w-100">Confirmar</button>
                        </div>
                    }
                </div>
            </div>

            <img src="~/assets/img/login-construction-skyline.png" class="tandem-login-skyline d-none d-lg-block" alt="construction-skyline" />
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
