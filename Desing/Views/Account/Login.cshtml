@using Desing.Models
@using Desing.Resources
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutMaterioBlank.cshtml";
    var brandText = (ViewBag.PlantillaBrandText as string) ?? Common.App_BrandFallback;
    ViewBag.Title = Common.Login_PageTitle + " - " + brandText;
    var isPluginCad = ViewBag.PluginCadLogin as bool? == true;
    var loginLogo = (ViewBag.PlantillaLogo as string)
        ?? (isPluginCad ? "/Content/images/tDesing/t-desing-net.png" : "/Content/images/Login/at.png");
    var loginLogoUrl = loginLogo.StartsWith("http", StringComparison.OrdinalIgnoreCase)
        ? loginLogo
        : Url.Content("~" + (loginLogo.StartsWith("/") ? loginLogo : "/" + loginLogo));
}
@if (isPluginCad)
{
    <style>
        html, body {
            margin: 0 !important;
            padding: 0 !important;
            background: transparent !important;
            overflow: hidden !important;
            min-height: 0 !important;
            height: auto !important;
        }
        .container-xxl { max-width: none; padding: 0; }
        .authentication-wrapper,
        .authentication-wrapper.authentication-basic {
            min-block-size: 0 !important;
            min-height: 0 !important;
            display: block !important;
            padding: 0 !important;
            background: transparent !important;
        }
        .tandem-auth-inner {
            min-height: 0 !important;
            margin: 0 !important;
            padding: 0 !important;
            display: block !important;
        }
        .tandem-login-skyline { display: none !important; }
        .tandem-cad-login-card {
            margin: 0;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(15, 20, 34, 0.12);
            overflow: hidden;
            background: #fff;
        }
        .tandem-cad-login-card .app-brand { margin-top: 0.75rem !important; }
        .tandem-cad-login-card .card-body { padding-top: 0.25rem; }
        .tandem-cad-login-card h4 { font-size: 1.15rem; }
        .tandem-cad-login-card .mb-5 { margin-bottom: 0.9rem !important; }
        .tandem-pwd-toggle {
            min-width: 44px;
            z-index: 3;
            background: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .tandem-pwd-toggle svg { width: 20px; height: 20px; fill: none; stroke: #6e6b80; stroke-width: 1.8; }
        .tandem-login-overlay {
            display: none;
            pointer-events: none;
            position: absolute;
            inset: 0;
            z-index: 20;
            background: rgba(255, 255, 255, 0.88);
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 16px;
        }
        .tandem-login-overlay.is-on { display: flex; pointer-events: auto; }
        .tandem-login-spin {
            width: 36px;
            height: 36px;
            border: 3px solid #e8e6f4;
            border-top-color: var(--tandem-primary, #7367F0);
            border-radius: 50%;
            animation: tandem-login-spin 0.75s linear infinite;
        }
        @@keyframes tandem-login-spin { to { transform: rotate(360deg); } }
        .tandem-login-overlay strong { margin-top: 10px; color: #433c65; }
        .tandem-login-overlay span { margin-top: 4px; font-size: 12px; color: #6e6b80; }
        .tandem-login-quality {
            border-top: 1px solid #e8e6f4;
            padding: 10px 14px 12px;
            font-size: 11px;
            color: #6e6b80;
            line-height: 1.45;
        }
    </style>
}
<div class="position-relative">
    <div class="authentication-wrapper authentication-basic @(isPluginCad ? "" : "container-p-y")">
        <div class="authentication-inner tandem-auth-inner @(isPluginCad ? "" : "py-6 mx-4")">

            <div class="card @(isPluginCad ? "tandem-cad-login-card p-3" : "p-sm-7 p-2") position-relative">

                <div class="app-brand justify-content-center mt-5">
                    <a href="@Url.Action("Index", "Home")" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">
                            <img src="@loginLogoUrl" alt="TDesing" style="height:@(isPluginCad ? "48px" : "36px")" />
                        </span>
                        @if (!isPluginCad)
                        {
                            <span class="app-brand-text demo text-heading brand-svg-login">
                                @Html.Partial("_BrandSvg")
                            </span>
                        }
                    </a>
                </div>

                <div class="card-body mt-1">
                    <h4 class="mb-1">@string.Format(Common.Login_Welcome, brandText)</h4>
                    <p class="mb-5">@Common.Login_Subtitle</p>

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "formAuthentication", @class = "mb-5", role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-floating form-floating-outline mb-5 form-control-validation">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "email", placeholder = Common.Login_Lbl_Email, autofocus = "autofocus" })
                            <label for="email">@Common.Login_Lbl_Email</label>
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small d-block mb-3" })

                        <div class="mb-5">
                            <div class="form-control-validation">
                                <div class="input-group input-group-merge">
                                    <div class="form-floating form-floating-outline">
                                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "password", placeholder = Common.Login_Lbl_Password })
                                        <label for="password">@Common.Login_Lbl_Password</label>
                                    </div>
                                    <button type="button" class="input-group-text cursor-pointer tandem-pwd-toggle" id="togglePassword" aria-label="@Common.Aria_TogglePassword" aria-pressed="false">
                                        <svg id="pwdEyeOff" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M3 3l18 18" stroke-linecap="round" />
                                            <path d="M10.6 10.6A3 3 0 0012 15a3 3 0 002.4-4.4" stroke-linecap="round" />
                                            <path d="M9.9 5.2A10.8 10.8 0 0112 5c6 0 10 7 10 7a18.4 18.4 0 01-4.2 4.8M6.1 6.1C3.9 7.7 2 12 2 12s4 7 10 7a10.5 10.5 0 005.1-1.3" stroke-linecap="round" />
                                        </svg>
                                        <svg id="pwdEyeOn" viewBox="0 0 24 24" aria-hidden="true" style="display:none">
                                            <path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z" />
                                            <circle cx="12" cy="12" r="3" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small d-block mb-3" })

                        if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                        {
                            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                        }

                        <div class="mb-5 pb-2 d-flex justify-content-between pt-2 align-items-center">
                            <div class="form-check mb-0">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "remember-me" })
                                <label class="form-check-label" for="remember-me">@Common.Login_Lbl_RememberMe</label>
                            </div>
                            @if (!isPluginCad)
                            {
                                <a href="@Url.Action("ForgotPassword", "Account")" class="float-end mb-1">
                                    <span>@Common.Login_Link_ForgotPassword</span>
                                </a>
                            }
                        </div>

                        <div class="mb-5">
                            <button class="btn btn-primary d-grid w-100" type="submit" id="loginSubmit">@Common.Login_Btn_SignIn</button>
                        </div>
                    }
                </div>

                <div class="text-center text-muted small @(isPluginCad ? "mb-2" : "mb-4")">
                    @Common.Footer_LastReleaseLabel @(ViewBag.TandemReleaseNumber as string)
                </div>

                @if (isPluginCad)
                {
                    <div class="tandem-login-quality" id="cadLoginQuality">
                        <div id="cadWifiLine">@Common.PluginCad_SpeedWifiTitle · @Common.PluginCad_SpeedMeasuring</div>
                        <div id="cadServerLine">@Common.PluginCad_SpeedServerTitle · @Common.PluginCad_SpeedMeasuring</div>
                    </div>
                    <div class="tandem-login-overlay" id="cadLoginOverlay" aria-live="polite">
                        <div class="tandem-login-spin" role="status"></div>
                        <strong>@Common.Login_Connecting</strong>
                        <span>@Common.Login_ConnectingWait</span>
                    </div>
                }
            </div>

            @if (!isPluginCad)
            {
                <img src="~/assets/img/login-construction-skyline.png" class="tandem-login-skyline d-none d-lg-block" alt="construction-skyline" />
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var pwd = document.getElementById('password');
            var btn = document.getElementById('togglePassword');
            var eyeOff = document.getElementById('pwdEyeOff');
            var eyeOn = document.getElementById('pwdEyeOn');
            if (btn && pwd) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var show = pwd.getAttribute('type') === 'password';
                    pwd.setAttribute('type', show ? 'text' : 'password');
                    btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                    if (eyeOff) eyeOff.style.display = show ? 'none' : 'block';
                    if (eyeOn) eyeOn.style.display = show ? 'block' : 'none';
                });
            }

            var isCad = @(isPluginCad ? "true" : "false");
            if (!isCad) return;

            var form = document.getElementById('formAuthentication');
            var overlay = document.getElementById('cadLoginOverlay');
            var wifiEl = document.getElementById('cadWifiLine');
            var serverEl = document.getElementById('cadServerLine');
            var urlPing = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("PluginPing", "DesignToolsAutocad", new { light = 1 })));
            var speedWifi = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedWifi));
            var speedCable = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedCable));
            var speedServer = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedServer));
            var speedLocal = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedLocal));
            var speedGood = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedGood));
            var speedOk = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedOk));
            var speedPoor = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedPoor));
            var speedFail = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedFail));
            var localHost = /^(localhost|127\.0\.0\.1|::1)$/i.test(location.hostname || '');

            function post(payload) {
                try {
                    if (!window.chrome || !window.chrome.webview) return;
                    try { window.chrome.webview.postMessage(payload); }
                    catch (e) { window.chrome.webview.postMessage(JSON.stringify(payload)); }
                } catch (e2) { }
            }

            function fmt(tpl, value) {
                return (tpl || '').replace('{0}', value);
            }

            function qualityMs(ms) {
                if (ms < 0) return speedFail;
                if (localHost) return speedGood;
                if (ms < 80) return speedGood;
                if (ms < 200) return speedOk;
                if (ms < 500) return speedPoor;
                return speedFail;
            }

            function setWifi(kind, mbps, line) {
                if (!wifiEl) return;
                if (line) { wifiEl.textContent = line; return; }
                var name = kind === 'cable' ? speedCable : speedWifi;
                if (!(mbps > 0)) {
                    wifiEl.textContent = (kind === 'cable' ? 'Cable' : 'Wi‑Fi') + ' · ' + (localHost ? speedGood : speedFail);
                    return;
                }
                wifiEl.textContent = fmt(name, mbps) + ' · ' + (mbps >= 20 || localHost ? speedGood : (mbps >= 10 ? speedOk : speedPoor));
            }

            function setServer(ms, line) {
                if (!serverEl) return;
                if (line) { serverEl.textContent = line; return; }
                if (ms == null || ms < 0) {
                    serverEl.textContent = (localHost ? fmt(speedLocal, '—') : speedFail);
                    return;
                }
                serverEl.textContent = fmt(localHost ? speedLocal : speedServer, ms) + ' · ' + qualityMs(ms);
            }

            function tellReady() {
                var card = document.querySelector('.tandem-cad-login-card') || document.body;
                post({
                    action: 'login-ready',
                    width: Math.ceil((card.offsetWidth || 380) + 16),
                    height: Math.ceil((card.offsetHeight || 560) + 16)
                });
                post({ action: 'request-link-speed' });
            }

            function ping() {
                if (!urlPing) return;
                var t0 = Date.now();
                fetch(urlPing + (urlPing.indexOf('?') >= 0 ? '&' : '?') + 't=' + t0, {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                }).then(function (r) { return r.json(); }).then(function (data) {
                    var httpMs = Date.now() - t0;
                    var serverMs = data && (data.serverMs != null ? data.serverMs : data.ServerMs);
                    setServer(typeof serverMs === 'number' && serverMs >= 0 ? serverMs : httpMs);
                }).catch(function () {
                    setServer(localHost ? 0 : -1);
                });
            }

            function onHost(raw) {
                try {
                    var msg = typeof raw === 'string' ? JSON.parse(raw) : raw;
                    if (!msg) return;
                    if (msg.action === 'link-speed' || msg.type === 'link-speed' || msg.action === 'link-quality') {
                        setWifi(msg.kind, msg.mbps, msg.wifiLine || msg.WifiLine);
                        if (msg.serverLine || msg.ServerLine)
                            setServer(msg.serverMs, msg.serverLine || msg.ServerLine);
                    }
                } catch (e) { }
            }

            if (form) {
                form.addEventListener('submit', function () {
                    if (overlay) overlay.classList.add('is-on');
                    post({ action: 'login-submit' });
                });
            }

            if (window.chrome && window.chrome.webview && window.chrome.webview.addEventListener)
                window.chrome.webview.addEventListener('message', function (ev) { onHost(ev.data); });
            ping();
            tellReady();
            setInterval(function () {
                ping();
                post({ action: 'request-link-speed' });
            }, 3000);
        })();
    </script>
}
