@using Desing.Models
@model LoginViewModel
@{
    Layout = "~/Views/Shared/_LayoutMaterioBlank.cshtml";
    ViewBag.Title = "Iniciar sesion - Tandem Desing";
}
<div class="position-relative">
    <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner tandem-auth-inner py-6 mx-4">

            <div class="card p-sm-7 p-2">

                @* Logo (dinamico desde la plantilla recordada en cookie) *@
                @{
                    var loginLogo = (ViewBag.PlantillaLogo as string) ?? "/Content/images/Login/at.png";
                    var loginLogoUrl = loginLogo.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                        ? loginLogo
                        : Url.Content("~" + (loginLogo.StartsWith("/") ? loginLogo : "/" + loginLogo));
                }
                <div class="app-brand justify-content-center mt-5">
                    <a href="@Url.Action("Index", "Home")" class="app-brand-link gap-3">
                        <span class="app-brand-logo demo">
                            <img src="@loginLogoUrl" alt="Tandem" style="height:36px" />
                        </span>
                        <span class="app-brand-text demo text-heading fw-semibold">Tandem Desing</span>
                    </a>
                </div>

                <div class="card-body mt-1">
                    <h4 class="mb-1">Bienvenido a Tandem Desing</h4>
                    <p class="mb-5">Inicia sesion para acceder a tu espacio de trabajo</p>

                    @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "formAuthentication", @class = "mb-5", role = "form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-floating form-floating-outline mb-5 form-control-validation">
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", id = "email", placeholder = "Email", autofocus = "autofocus" })
                            <label for="email">Email</label>
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small d-block mb-3" })

                        <div class="mb-5">
                            <div class="form-password-toggle form-control-validation">
                                <div class="input-group input-group-merge">
                                    <div class="form-floating form-floating-outline">
                                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "password", placeholder = "Password" })
                                        <label for="password">Password</label>
                                    </div>
                                    <button type="button" class="input-group-text cursor-pointer" id="togglePassword" aria-label="Mostrar u ocultar contraseña" aria-pressed="false" onclick="togglePasswordVisibility(event)">
                                        <i class="icon-base ri ri-eye-off-line icon-20px"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small d-block mb-3" })

                        if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
                        {
                            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                        }

                        <div class="mb-5 pb-2 d-flex justify-content-between pt-2 align-items-center">
                            <div class="form-check mb-0">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "remember-me" })
                                <label class="form-check-label" for="remember-me">Recordarme</label>
                            </div>
                            <a href="@Url.Action("ForgotPassword", "Account")" class="float-end mb-1">
                                <span>Olvide mi contrasena?</span>
                            </a>
                        </div>

                        <div class="mb-5">
                            <button class="btn btn-primary d-grid w-100" type="submit">Entrar</button>
                        </div>
                    }
                </div>
            </div>

            <img src="~/assets/img/login-construction-skyline.png" class="tandem-login-skyline d-none d-lg-block" alt="construction-skyline" />
        </div>
    </div>
</div>

@section scripts {
    <script>
        window.togglePasswordVisibility = function (e) {
            if (e && typeof e.preventDefault === 'function') e.preventDefault();
            var toggle = document.getElementById('togglePassword');
            var pwd = document.getElementById('password');
            if (!toggle || !pwd) return false;

            var isPwd = pwd.getAttribute('type') === 'password';
            pwd.setAttribute('type', isPwd ? 'text' : 'password');
            toggle.setAttribute('aria-pressed', isPwd ? 'true' : 'false');
            var icon = toggle.querySelector('i');
            if (icon) {
                icon.className = isPwd
                    ? 'icon-base ri ri-eye-line icon-20px'
                    : 'icon-base ri ri-eye-off-line icon-20px';
            }
            return false;
        };

        (function initPasswordToggle() {
            document.addEventListener('click', function (e) {
                var toggle = e.target.closest('#togglePassword');
                if (!toggle) return;
                window.togglePasswordVisibility(e);
            });
        })();
    </script>
}
