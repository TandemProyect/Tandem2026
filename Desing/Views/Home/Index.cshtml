@using Newtonsoft.Json

@using Desing.Resources

@using System.Globalization

@{

    Layout = "~/Views/Shared/_LayoutMaterio.cshtml";

    ViewBag.Title = "Inicio - " + (ViewBag.PlantillaBrandText as string ?? "T Desing.net");

    var ci = CultureInfo.CurrentUICulture != null ? CultureInfo.CurrentUICulture.TwoLetterISOLanguageName : "es";

    var dashDt = JsonConvert.SerializeObject(new

    {

        culture = ci,

        rowsSuffix = Common.Dt_Rows_N,

        allRows = Common.Dt_Rows_All,

        ariaMenu = Common.Dt_MenuAria

    });

}



@section Styles

{

    <style>

        .home-dash-shell {

            display: flex;

            flex-direction: column;

            gap: 1rem;

            height: calc(100vh - 8rem);

            min-height: 420px;

            max-height: calc(100vh - 8rem);

        }



        .home-dash-row {

            flex: 1 1 50%;

            min-height: 0;

            display: flex;

            flex-direction: column;

        }



        .home-dash-grid {

            flex: 1;

            min-height: 0;

            display: grid;

            grid-template-columns: repeat(4, minmax(0, 1fr));

            gap: 1rem;

            align-content: stretch;

        }



        .home-dash-row--top .home-dash-grid {

            grid-template-columns: repeat(3, minmax(0, 1fr));

        }



        .home-dash-tile--designs {

            grid-column: span 3;

        }



        .home-dash-tile {

            min-height: 0;

            display: flex;

            flex-direction: column;

        }



            .home-dash-tile > .card {

                flex: 1;

                display: flex;

                flex-direction: column;

                min-height: 0;

            }



            .home-dash-tile .card-body.home-dash-card-body {

                flex: 1;

                min-height: 0;

                overflow-y: auto;

                overflow-x: hidden;

                padding: 0.35rem 0.5rem 0.5rem;

            }



            .home-dash-tile--placeholder .card-body.home-dash-card-body {

                overflow: hidden;

            }



            .home-dash-tile table.dataTable {

                margin-bottom: 0 !important;

                font-size: 0.8125rem;

            }



            .home-dash-tile .dataTables_wrapper {

                padding: 0;

            }



            .home-dash-tile .dash-new-design.btn-icon {

                width: 1.25rem;

                height: 1.25rem;

                min-width: 1.25rem;

                padding: 0;

            }



            .home-dash-tile .dash-new-design.btn-icon .icon-base {

                width: 0.73rem;

                height: 0.73rem;

                font-size: 0.73rem;

            }



            .home-dash-tile--designs .dataTables_filter {

                margin: 0 0 0.35rem;

                text-align: right;

            }



            .home-dash-tile--designs .dataTables_filter input {

                margin-left: 0.35rem;

                display: inline-block;

                width: auto;

            }



        @@media (max-width: 1199.98px) {

            .home-dash-shell {

                height: auto;

                max-height: none;

            }



            .home-dash-row {

                flex: 0 0 auto;

            }



            .home-dash-grid,
            .home-dash-row--top .home-dash-grid {

                grid-template-columns: repeat(2, minmax(0, 1fr));

                grid-auto-rows: minmax(240px, auto);

            }



            .home-dash-tile--designs {

                grid-column: span 2;

            }

        }



        @@media (max-width: 575.98px) {

            .home-dash-grid,
            .home-dash-row--top .home-dash-grid {

                grid-template-columns: 1fr;

                grid-auto-rows: minmax(220px, auto);

            }



            .home-dash-tile--designs {

                grid-column: span 1;

            }

        }

    </style>

}



<div class="home-dash-shell mb-4">

    <div class="home-dash-row home-dash-row--top">

        <div class="home-dash-grid">

            <div class="home-dash-tile">

                <div class="card shadow-none border">

                    <div class="card-header py-2 d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">@Jobside.Index_Breadcrumb</span>

                        <a href="@Url.Action("Index", "Jobside")" class="small">@Common.Action_OpenList</a>

                    </div>

                    <div class="card-body home-dash-card-body">

                        <table id="DashJobs" class="table table-hover table-sm w-100" cellspacing="0">

                            <thead>

                                <tr>

                                    <th>@Jobside.Col_AddNJobside</th>

                                    <th>@Jobside.Col_Name</th>

                                    <th class="text-end text-nowrap" style="width:1%;"></th>

                                </tr>

                            </thead>

                        </table>

                    </div>

                </div>

            </div>

            <div class="home-dash-tile">

                <div class="card shadow-none border">

                    <div class="card-header py-2 d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">@Jobside.Offers_DtTitle</span>

                        <a href="@Url.Action("Index", "Jobside")" class="small">@Jobside.Index_Breadcrumb</a>

                    </div>

                    <div class="card-body home-dash-card-body">

                        <table id="DashOffers" class="table table-hover table-sm w-100" cellspacing="0">

                            <thead>

                                <tr>

                                    <th>@Jobside.Offers_Col_Number</th>

                                    <th>@Jobside.Offers_Col_Name</th>

                                    <th class="text-end text-nowrap" style="width:1%;"></th>

                                </tr>

                            </thead>

                        </table>

                    </div>

                </div>

            </div>

            <div class="home-dash-tile">

                <div class="card shadow-none border">

                    <div class="card-header py-2 d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">@ClientV2.Index_Breadcrumb</span>

                        <a href="@Url.Action("Index", "ClientV2")" class="small">@Common.Action_OpenList</a>

                    </div>

                    <div class="card-body home-dash-card-body">

                        <table id="DashClients" class="table table-hover table-sm w-100" cellspacing="0">

                            <thead>

                                <tr>

                                    <th>@ClientV2.Col_Code</th>

                                    <th>@ClientV2.Col_Name</th>

                                    <th class="text-end text-nowrap" style="width:1%;"></th>

                                </tr>

                            </thead>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="home-dash-row home-dash-row--bottom">

        <div class="home-dash-grid">

            <div class="home-dash-tile home-dash-tile--designs">

                <div class="card shadow-none border">

                    <div class="card-header py-2 d-flex justify-content-between align-items-center">

                        <span class="fw-semibold">@Jobside.OfferWorkspace_TabDesigns</span>

                        <button type="button"
                                class="btn btn-icon btn-lg btn-primary rounded-pill"
                                id="dashOpenNewOfferBtn"
                                title="@Jobside.Offers_Btn_New"
                                aria-label="@Jobside.Offers_Btn_New">
                            <i class="icon-base ri ri-add-line" aria-hidden="true"></i>
                        </button>

                    </div>

                    <div class="card-body home-dash-card-body">

                        <table id="DashDesigns" class="table table-hover table-sm w-100" cellspacing="0">

                            <thead>

                                <tr>

                                    <th>@Jobside.Offers_Col_Number</th>

                                    <th>@Jobside.Offers_Col_Client</th>

                                    <th>@Jobside.OfferWorkspace_Designs_Lbl_AttLabel</th>

                                    <th class="text-end text-nowrap" style="width:1%;"></th>

                                </tr>

                            </thead>

                        </table>

                    </div>

                </div>

            </div>

            @for (var i = 0; i < 1; i++)

            {

                <div class="home-dash-tile home-dash-tile--placeholder">

                    <div class="card shadow-none border h-100">

                        <div class="card-body home-dash-card-body d-flex align-items-center justify-content-center text-muted">

                            <span>@Jobside.Tab_ComingSoon</span>

                        </div>

                    </div>

                </div>

            }

        </div>

    </div>

</div>

<div class="modal fade" id="dashNewOfferModal" tabindex="-1" aria-labelledby="dashNewOfferModalTitle" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title text-white" id="dashNewOfferModalTitle">@Jobside.Offers_CreateModalTitle</h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Common.Aria_CloseModal"></button>

            </div>

            <div class="modal-body">

                <div id="dashNewOfferFlash" class="mb-2"></div>

                <div class="mb-3">

                    <label class="form-label" for="dashNewOfferJobside">@Jobside.OfferWorkspace_SubheaderJobsite</label>

                    <select class="form-select" id="dashNewOfferJobside">

                        <option value="">@Jobside.Offers_Dash_PickJobside</option>

                    </select>

                </div>

                <div id="dashNewOfferFormHost"></div>

            </div>

            <div class="modal-footer">

                <button type="button" class="btn btn-light" data-bs-dismiss="modal">@Common.Btn_Cancel</button>

                <button type="button" class="btn btn-primary" id="dashNewOfferSaveBtn">@Common.Btn_Save</button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade" id="dashNewDesignModal" tabindex="-1" aria-labelledby="dashNewDesignModalTitle" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header bg-primary text-white">

                <h5 class="modal-title text-white" id="dashNewDesignModalTitle">@Jobside.OfferWorkspace_Designs_ModalTitle</h5>

                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Common.Aria_CloseModal"></button>

            </div>

            <form id="dashNewDesignForm">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <div id="dashNewDesignFlash" class="mb-2"></div>

                    <input type="hidden" name="offerId" id="dashNewDesignOfferId" value="" />

                    <input type="hidden" name="jobsideId" id="dashNewDesignJobsideId" value="" />

                    <input type="hidden" name="attDescription" value="" />

                    <input type="hidden" name="attThumbnail" value="" />

                    <div class="mb-0">

                        <label class="form-label" for="dashNewDesignName">@Jobside.OfferWorkspace_Designs_Lbl_AttLabel</label>

                        <input type="text" class="form-control" id="dashNewDesignName" name="attLabel" maxlength="500" autocomplete="off" required="required" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">@Common.Btn_Cancel</button>

                    <button type="submit" class="btn btn-primary">@Jobside.OfferWorkspace_Designs_Save_Submit</button>

                </div>

            </form>

        </div>

    </div>

</div>



@section scripts

{

    <script type="text/javascript">

        var dashDt = @Html.Raw(dashDt);



        function tandemDashTableOptions(url, columns) {

            return TandemDataTablesList.applyListDefaults({

                dom: 'rtip',

                buttons: [],

                stateSave: false,

                lengthMenu: [

                    [5, 10, 15],

                    ['5 ' + dashDt.rowsSuffix, '10 ' + dashDt.rowsSuffix, '15 ' + dashDt.rowsSuffix]

                ],

                pageLength: 5,

                scrollCollapse: false,

                serverSide: true,

                processing: true,

                ordering: false,

                ajax: { url: url, type: 'POST' },

                order: [],

                language: window.tandemCommonDt ? window.tandemCommonDt[dashDt.culture] || window.tandemCommonDt.es : {},

                columns: columns

            });

        }



        $(document).ready(function () {

            $('#DashJobs').DataTable(tandemDashTableOptions('@Url.Action("ListDashboardJobs", "Home")', [

                { data: 'AddNJobside', name: 'AddNJobside', orderable: false },

                { data: 'TextLabel', name: 'TextLabel', orderable: false },

                { data: 'actions', name: 'actions', orderable: false, searchable: false, className: 'text-end text-nowrap' }

            ]));



            $('#DashOffers').DataTable(tandemDashTableOptions('@Url.Action("ListDashboardOffers", "Home")', [

                { data: 'AddOfferNumber', name: 'AddOfferNumber', orderable: false },

                { data: 'TextLabel', name: 'TextLabel', orderable: false },

                { data: 'actions', name: 'actions', orderable: false, searchable: false, className: 'text-end text-nowrap' }

            ]));



            var dashDesignOpts = tandemDashTableOptions('@Url.Action("ListDashboardDesigns", "Home")', [

                { data: 'AddOfferNumber', name: 'AddOfferNumber' },

                { data: 'ClientName', name: 'ClientName' },

                { data: 'AttLabel', name: 'AttLabel' },

                { data: 'actions', name: 'actions', orderable: false, searchable: false, className: 'text-end text-nowrap' }

            ]);

            dashDesignOpts.dom = 'frtip';

            dashDesignOpts.ordering = true;

            dashDesignOpts.order = [[2, 'asc']];

            $('#DashDesigns').DataTable(dashDesignOpts);



            $('#DashClients').DataTable(tandemDashTableOptions('@Url.Action("ListDashboardClients", "Home")', [

                { data: 'TextCode', name: 'TextCode', orderable: false },

                { data: 'TextLabel', name: 'TextLabel', orderable: false },

                { data: 'actions', name: 'actions', orderable: false, searchable: false, className: 'text-end text-nowrap' }

            ]));



            var dashOfferUi = {

                jobsUrl: '@Url.Action("DashboardJobsForOffer", "Home")',

                formUrl: '@Url.Action("JobsideOfferForm", "Jobside")',

                saveUrl: '@Url.Action("SaveJobsideOffer", "Jobside")',

                pickJob: @Html.Raw(JsonConvert.SerializeObject(Jobside.Offers_Dash_PickJobside)),

                failed: @Html.Raw(JsonConvert.SerializeObject(Jobside.Offers_SaveFailed)),

                success: @Html.Raw(JsonConvert.SerializeObject(Jobside.Offers_SaveSuccess))

            };



            function dashOfferFlash(kind, text) {

                var host = document.getElementById('dashNewOfferFlash');

                if (!host) return;

                host.innerHTML = '<div class="alert alert-' + kind + ' py-2 px-3 small mb-0" role="alert">' +

                    $('<div>').text(text || '').html() + '</div>';

            }



            function dashLoadOfferJobs(done) {

                var select = document.getElementById('dashNewOfferJobside');

                if (!select || select.getAttribute('data-loaded') === '1') {

                    if (done) done();

                    return;

                }

                $.getJSON(dashOfferUi.jobsUrl).done(function (rows) {

                    var html = '<option value="">' + $('<div>').text(dashOfferUi.pickJob).html() + '</option>';

                    (rows || []).forEach(function (row) {

                        var label = (row.code ? row.code + ' — ' : '') + (row.name || '');

                        html += '<option value="' + row.id + '">' + $('<div>').text(label).html() + '</option>';

                    });

                    select.innerHTML = html;

                    select.setAttribute('data-loaded', '1');

                    if (done) done();

                }).fail(function () {

                    dashOfferFlash('danger', dashOfferUi.failed);

                });

            }



            function dashLoadOfferForm(jobsideId) {

                var host = $('#dashNewOfferFormHost');

                host.empty();

                if (!jobsideId) return;

                host.load(dashOfferUi.formUrl + '?jobsideId=' + encodeURIComponent(jobsideId), function (response, status) {

                    if (status === 'error') {

                        dashOfferFlash('danger', dashOfferUi.failed);

                    }

                });

            }



            $('#dashOpenNewOfferBtn').on('click', function (e) {

                e.preventDefault();

                $('#dashNewOfferFlash').empty();

                $('#dashNewOfferFormHost').empty();

                $('#dashNewOfferJobside').val('');

                var modalEl = document.getElementById('dashNewOfferModal');

                if (modalEl && window.bootstrap && bootstrap.Modal) {

                    bootstrap.Modal.getOrCreateInstance(modalEl).show();

                }

                dashLoadOfferJobs();

            });



            $('#dashNewOfferJobside').on('change', function () {

                $('#dashNewOfferFlash').empty();

                dashLoadOfferForm(this.value);

            });



            $('#dashNewOfferSaveBtn').on('click', function () {

                var form = $('#dashNewOfferFormHost').find('#jobsideOfferForm');

                if (!form.length) {

                    dashOfferFlash('danger', dashOfferUi.pickJob);

                    return;

                }

                $.ajax({

                    url: dashOfferUi.saveUrl,

                    type: 'POST',

                    data: form.serialize()

                }).done(function (r) {

                    if (r && r.ok) {

                        var modalEl = document.getElementById('dashNewOfferModal');

                        if (modalEl && window.bootstrap) {

                            var inst = bootstrap.Modal.getInstance(modalEl);

                            if (inst) inst.hide();

                        }

                        $('#dashNewOfferFormHost').empty();

                        if ($.fn.dataTable.isDataTable('#DashOffers')) {

                            $('#DashOffers').DataTable().ajax.reload(null, false);

                        }

                    } else {

                        dashOfferFlash('danger', (r && r.message) ? r.message : dashOfferUi.failed);

                    }

                }).fail(function () {

                    dashOfferFlash('danger', dashOfferUi.failed);

                });

            });



            var dashDesignUi = {

                saveUrl: '@Url.Action("SaveOfferDesign", "Jobside")',

                labelRequired: @Html.Raw(JsonConvert.SerializeObject(Jobside.OfferWorkspace_Designs_Val_LabelRequired)),

                failed: @Html.Raw(JsonConvert.SerializeObject(Jobside.OfferWorkspace_Designs_SaveFailed)),

                success: @Html.Raw(JsonConvert.SerializeObject(Jobside.OfferWorkspace_Designs_SaveSuccess)),

                titleFmt: @Html.Raw(JsonConvert.SerializeObject(Jobside.OfferWorkspace_Designs_ModalTitleOfferFmt))

            };



            function dashDesignFlash(kind, text) {

                var host = document.getElementById('dashNewDesignFlash');

                if (!host) return;

                host.innerHTML = '<div class="alert alert-' + kind + ' py-2 px-3 small mb-0" role="alert">' +

                    $('<div>').text(text || '').html() + '</div>';

            }



            $('#DashDesigns').on('click', '.dash-new-design', function (e) {

                e.preventDefault();

                $('#dashNewDesignOfferId').val($(this).attr('data-offer-id') || '');

                $('#dashNewDesignJobsideId').val($(this).attr('data-jobside-id') || '');

                var offerNumber = $(this).attr('data-offer-number') || '';

                $('#dashNewDesignModalTitle').text((dashDesignUi.titleFmt || '').replace('{0}', offerNumber));

                $('#dashNewDesignName').val('');

                $('#dashNewDesignFlash').empty();

                var modalEl = document.getElementById('dashNewDesignModal');

                if (modalEl && window.bootstrap && bootstrap.Modal) {

                    bootstrap.Modal.getOrCreateInstance(modalEl).show();

                }

            });



            $('#dashNewDesignForm').on('submit', function (e) {

                e.preventDefault();

                var name = ($('#dashNewDesignName').val() || '').trim();

                if (!name) {

                    dashDesignFlash('danger', dashDesignUi.labelRequired);

                    return;

                }

                $.ajax({

                    url: dashDesignUi.saveUrl,

                    type: 'POST',

                    data: $(this).serialize()

                }).done(function (r) {

                    if (r && r.ok) {

                        var modalEl = document.getElementById('dashNewDesignModal');

                        if (modalEl && window.bootstrap) {

                            var inst = bootstrap.Modal.getInstance(modalEl);

                            if (inst) inst.hide();

                        }

                        if ($.fn.dataTable.isDataTable('#DashDesigns')) {

                            $('#DashDesigns').DataTable().ajax.reload(null, false);

                        }

                    } else {

                        dashDesignFlash('danger', (r && r.message) ? r.message : dashDesignUi.failed);

                    }

                }).fail(function () {

                    dashDesignFlash('danger', dashDesignUi.failed);

                });

            });



            var dashOfferModalEl = document.getElementById('dashNewOfferModal');

            if (dashOfferModalEl) {

                dashOfferModalEl.addEventListener('hidden.bs.modal', function () {

                    $('#dashNewOfferFormHost').empty();

                    $('#dashNewOfferFlash').empty();

                });

            }

        });

    </script>

}

