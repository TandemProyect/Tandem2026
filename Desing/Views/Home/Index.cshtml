            }



            .home-dash-tile table.dataTable tbody tr .tandem-col-actions .btn-icon,
            .home-dash-tile .dash-client-tree .btn-icon {

                color: var(--bs-primary);

                background-color: transparent;

            }



            .home-dash-tile table.dataTable tbody tr:hover .tandem-col-actions .btn-icon:not(.dash-new-design),
            .home-dash-tile table.dataTable tbody tr .tandem-col-actions .btn-icon:not(.dash-new-design):hover,
            .home-dash-tile table.dataTable tbody tr .tandem-col-actions .btn-icon:not(.dash-new-design):focus-visible,
            .home-dash-tile .dash-client-tree .dash-client-tree-design:hover .btn-icon,
            .home-dash-tile .dash-client-tree .btn-icon:hover,
            .home-dash-tile .dash-client-tree .btn-icon:focus-visible {

