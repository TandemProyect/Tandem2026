                border: 0;

                box-shadow: none;

                color: var(--bs-primary) !important;

            }



            .home-dash-tile .dash-new-design-sign {

                background: #fff !important;

                color: var(--bs-primary) !important;

                border-color: var(--bs-primary) !important;

            }



            .home-dash-tile tr:hover .dash-new-design-sign,
            .home-dash-tile .dash-new-design:hover .dash-new-design-sign,
            .home-dash-tile .dash-new-design:focus-visible .dash-new-design-sign {

