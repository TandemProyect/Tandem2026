            .home-dash-tile .dash-client-tree-offer,
            .home-dash-tile .dash-client-tree-date {

                color: var(--bs-secondary-color);

            }



            .home-dash-tile--designs #DashDesigns tbody td.dash-offer-number,
            .home-dash-tile--designs #DashClientDesigns tbody td.dash-client-name,
            .home-dash-tile--designs .dash-client-tree-offer {

                color: var(--bs-primary) !important;

                font-weight: 700;

            }



            .home-dash-tile .dash-client-tree-designs {

                display: flex;

                flex-direction: column;

                gap: 0.25rem;

                margin: 0 0 0.15rem;

            }



            .home-dash-tile .dash-client-tree-head,
            .home-dash-tile .dash-client-tree-design {

                display: grid;

                grid-template-columns: minmax(9rem, 1.6fr) minmax(7rem, 1fr) 10.5rem 4.75rem;

                column-gap: 1.25rem;

                align-items: center;

            }



            .home-dash-tile .dash-client-tree-head {

                font-size: 0.72rem;

                font-weight: 700;

                color: var(--bs-heading-color);

                padding: 0.35rem 0.7rem;

                background: var(--bs-table-header-bg-color, #f6f7fb);

                border-radius: 0.25rem;

            }



            .home-dash-tile .dash-client-tree-design {

                position: relative;

                min-height: 2.2rem;

                padding: 0.4rem 0.7rem;

                border-radius: 0.4rem;

                background: #fff;

                border: 1px solid transparent;

            }



            .home-dash-tile .dash-client-tree-design:hover {

                background: #fff;

                border-color: var(--bs-primary);

            }



            .home-dash-tile .dash-client-tree-eye {

                justify-self: end;

            }



            .home-dash-tile table.dataTable tr.dash-client-tree-row > td {

                padding: 0 0.75rem 0.2rem 0;

                background: #fff;

                overflow: visible;

            }



            .home-dash-tile--designs tr:has(> td .dash-client-tree-root[aria-expanded="true"]) > td.dash-tree-col {

                position: relative;

            }



            .home-dash-tile--designs tr:has(> td .dash-client-tree-root[aria-expanded="true"]) > td.dash-tree-col::after {

                content: "";

                position: absolute;

                left: 50%;

                top: calc(50% + 0.72rem);

                bottom: -1px;

                border-left: 1px solid #b7bec8;

            }



            .home-dash-tile .dash-client-tree-monthline::before {

                content: "";

                position: absolute;

                left: calc(-1.05rem + 1px);

                top: 50%;

                width: 0.85rem;

                border-top: 1px solid var(--dash-tree-line, #b7bec8);

            }



            .home-dash-tile .dash-client-tree-node:last-child .dash-client-tree-monthline::after {

                content: "";

                position: absolute;

                left: calc(-1.05rem - 1px);

                top: calc(50% + 1px);

                width: 3px;

                height: 4000px;

                background: #fff;

            }



            .home-dash-tile .dash-client-tree-head {

                margin-left: 1.7rem;

            }



            .home-dash-tile .dash-client-tree-leaves {

                position: relative;

                display: flex;

                flex-direction: column;

                gap: 0.35rem;

                margin: 0 0 0.15rem 0.62rem;

                padding-left: 1.05rem;

                border-left: 1px solid var(--dash-tree-line, #b7bec8);

                overflow: hidden;

            }



            .home-dash-tile .dash-client-tree-design::before {

                content: "";

                position: absolute;

                left: calc(-1.05rem + 1px);

                top: 50%;

                width: 0.85rem;

                border-top: 1px solid var(--dash-tree-line, #b7bec8);

            }



            .home-dash-tile .dash-client-tree-design:last-child::after {

                content: "";

                position: absolute;

                left: calc(-1.05rem - 1px);

                top: calc(50% + 1px);

                width: 3px;

                height: 400px;

                background: #fff;

            }



            .home-dash-tile--designs .dash-design-tabs {

