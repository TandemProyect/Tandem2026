                background-color: #fff !important;

                color: var(--bs-body-color) !important;

            }



            .home-dash-tile .dash-client-tree-label,
            .home-dash-tile .dash-client-tree-head,
            .home-dash-tile .dash-client-tree-name {

                color: var(--bs-body-color);

            }



            .home-dash-tile .dash-client-tree-label {

                font-weight: 600;

            }



