@{
    Layout = "~/Views/Shared/_LayoutMaterio.cshtml";
    ViewBag.Title = "Inicio - Atenko Desing";
}

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light">Inicio /</span> Bienvenido
</h4>

<div class="row g-4">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100">
            <img src="~/Content/images/Home/at4.jpg" class="card-img-top" alt="ATK60 / ATK40" />
            <div class="card-body">
                <h5 class="card-title">PANELES ATK60 / ATK40</h5>
                <p class="card-text">
                    <strong>PANELES ATK60:</strong> Ideal para muros de contencion, pilares, pantallas, nucleos de ascensor y cualquier tipo de estructura vertical.
                </p>
                <p class="card-text">
                    <strong>PANELES ATK40:</strong> Encofrado rapido, modular y con buena terminacion. Paneles de medidas variadas y facilmente manipulables por un solo hombre.
                </p>
                <a id="btDesign" href="@Url.Action("Index", "DesignTools", new { OnlyUser = true })" class="btn btn-primary">
                    <i class="icon-base ri ri-shape-line me-1"></i> Abrir Disenador
                </a>
            </div>
        </div>
    </div>
</div>