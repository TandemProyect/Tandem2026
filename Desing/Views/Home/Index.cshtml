@using Newtonsoft.Json

@using Desing.Resources

@using System.Globalization

@{

    Layout = "~/Views/Shared/_LayoutMaterio.cshtml";

    ViewBag.Title = "Inicio - " + (ViewBag.PlantillaBrandText as string ?? "T Desing.net");

    var ci = CultureInfo.CurrentUICulture != null ? CultureInfo.CurrentUICulture.TwoLetterISOLanguageName : "es";

    var dashDt = JsonConvert.SerializeObject(new

    {

        culture = ci,

        rowsSuffix = Common.Dt_Rows_N,

        allRows = Common.Dt_Rows_All,

        ariaMenu = Common.Dt_MenuAria,

        sectionRecords = Common.Dt_Section_Records,

        sectionExport = Common.Dt_Section_Export,

        sectionCols = Common.Dt_Section_ColumnsVisible

    });

}



@section Styles

{

    <style>

        .home-dash-shell {

            display: flex;

            flex-direction: column;

            gap: 1rem;

            height: calc(100vh - 8rem);

            min-height: 420px;

            max-height: calc(100vh - 8rem);

        }



        .home-dash-row {

            flex: 1 1 50%;

            min-height: 0;

            display: flex;

            flex-direction: column;

        }



        .home-dash-grid {

            flex: 1;

            min-height: 0;

            display: grid;

            grid-template-columns: repeat(4, minmax(0, 1fr));

            grid-template-rows: minmax(0, 1fr);

            gap: 1rem;

            align-content: stretch;

        }



        .home-dash-row--top .home-dash-grid {

            grid-template-columns: repeat(3, minmax(0, 1fr));

        }



        .home-dash-tile--designs {

            grid-column: 1 / -1;

        }



        .home-dash-tile {

            min-height: 0;

            display: flex;

            flex-direction: column;

        }



            .home-dash-tile > .card {

                flex: 1;

                display: flex;

                flex-direction: column;

                min-height: 0;

            }



            .home-dash-tile .card-body.home-dash-card-body {

                flex: 1;

                min-height: 0;

                overflow: visible;

                padding: 0.35rem 0.5rem 0.5rem;

            }



            .home-dash-tile .dataTables_wrapper {

                display: flex;

                flex-direction: column;

                min-height: 0;

                height: 100%;

            }



            .home-dash-tile .dataTables_scroll {

                flex: 1 1 auto;

                min-height: 0;

            }



            .home-dash-tile .dataTables_scrollBody {

                overflow-x: hidden !important;

                overflow-y: scroll !important;

                scrollbar-gutter: stable;

                scrollbar-color: rgba(46, 38, 61, 0.55) rgba(46, 38, 61, 0.12);

            }



            .home-dash-tile .dataTables_scrollBody::-webkit-scrollbar {

                width: 12px;

                -webkit-appearance: none;

            }



            .home-dash-tile .dataTables_scrollBody::-webkit-scrollbar-track {

                background: rgba(46, 38, 61, 0.12);

            }



            .home-dash-tile .dataTables_scrollBody::-webkit-scrollbar-thumb {

                background: rgba(46, 38, 61, 0.55);

                border-radius: 6px;

                border: 2px solid #fff;

            }



            .home-dash-tile--recent .dt-buttons,
            .home-dash-tile--recent .dataTables_filter,
            .home-dash-tile--recent .dataTables_info,
            .home-dash-tile--recent .dataTables_paginate,
            .home-dash-tile--recent .dataTables_length {

                display: none !important;

            }



            .home-dash-tile--recent > .card > .card-header {

                padding: 0.3rem 0.55rem !important;

            }



            .home-dash-tile--recent .card-body.home-dash-card-body {

                padding: 0 0.25rem 0.15rem;

            }



            .home-dash-tile--recent table.dataTable {

                font-size: 0.75rem;

            }



            .home-dash-tile--recent table.dataTable thead th,
            .home-dash-tile--recent .dataTables_scrollHead table.dataTable thead th {

                padding: 0.2rem 0.4rem !important;

                font-size: 0.68rem;

                line-height: 1.15;

                white-space: nowrap;

            }



            .home-dash-tile--recent table.dataTable tbody td {

                padding: 0.22rem 0.4rem !important;

                line-height: 1.25;

            }



            .home-dash-tile--recent table.dataTable .btn-icon {

                width: 1.7rem !important;

                height: 1.7rem !important;

                inline-size: 1.7rem !important;

                block-size: 1.7rem !important;

            }



            .home-dash-tile--recent table.dataTable .btn-icon .icon-base {

                font-size: 1.05rem !important;

                inline-size: 1.05rem !important;

                block-size: 1.05rem !important;

                line-height: 1;

            }



            .home-dash-tile--placeholder .card-body.home-dash-card-body {

                overflow: hidden;

            }



            .home-dash-tile table.dataTable {

                margin-bottom: 0 !important;

                font-size: 0.8125rem;

            }



            .home-dash-tile .dataTables_wrapper {

