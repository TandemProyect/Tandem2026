@using Newtonsoft.Json
@using Desing.Resources
@using System.Globalization
@{
    ViewBag.Title = Language.Index_Breadcrumb;
    var ci = CultureInfo.CurrentUICulture?.TwoLetterISOLanguageName ?? "es";
    var languageDt = JsonConvert.SerializeObject(new
    {
        culture = ci,
        rowsSuffix = Common.Dt_Rows_N,
        allRows = Common.Dt_Rows_All,
        sectionRecords = Common.Dt_Section_Records,
        sectionExport = Common.Dt_Section_Export,
        sectionCols = Common.Dt_Section_ColumnsVisible,
        confirmDeleteLanguage = Language.Js_ConfirmDeleteLanguage,
        ariaMenu = Common.Dt_MenuAria
    });
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">@Language.Common_Home</a> /
            @Language.Common_Settings /
        </span> @Language.Index_Breadcrumb
    </h4>
    <a class="btn btn-primary text-white" href="@Url.Action("Create", "Language")">
        <i class="icon-base ri ri-add-line me-1"></i> @Language.Index_CreateLanguage
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListLanguages" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th class="text-center" style="width:52px;">@Language.Col_Flag</th>
                    <th>@Language.Col_Name</th>
                    <th>@Language.Col_Code</th>
                    <th>@Language.Col_NativeName</th>
                    <th>@Language.Col_Default</th>
                    <th>@Language.Col_State</th>
                    <th class="text-end text-nowrap" style="width:1%;"></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<p class="text-body-secondary small mb-0">
    @Html.Raw(Language.Index_FallbackNote)
</p>

@section scripts {
    <script type="text/javascript">
        var languageDt = @Html.Raw(languageDt);
        var languageExportOpts = TandemDataTablesList.exportOptsPlainVisible;

        $(document).ready(function () {
            $('#ListLanguages').DataTable(TandemDataTablesList.applyListDefaults({
                lengthMenu: [
                    [10, 25, 50, -1],
                    ['10 ' + languageDt.rowsSuffix, '25 ' + languageDt.rowsSuffix, '50 ' + languageDt.rowsSuffix, languageDt.allRows]
                ],
                buttons: [{
                    extend: 'collection',
                    text: "<i class='fas fa-bars'></i>",
                    attr: { 'aria-label': languageDt.ariaMenu },
                    className: 'custom-html-collection',
                    buttons: [
                        '<h5>' + languageDt.sectionRecords + '</h5>',
                        'pageLength',
                        '<h5>' + languageDt.sectionExport + '</h5>',
                        'print',
                        'copy',
                        'pdf',
                        { extend: 'csv', exportOptions: languageExportOpts },
                        { extend: 'excel', exportOptions: languageExportOpts },
                        '<h5 class="not-top-heading">' + languageDt.sectionCols + '</h5>',
                        'colvis'
                    ]
                }],
                serverSide: true,
                processing: true,
                colReorder: { iFixedColumnsRight: 2 },
                ajax: { url: '@Url.Action("ListLanguages", "Language")', type: 'POST' },
                order: [[4, 'desc'], [1, 'asc']],
                columns: [
                    { data: 'flagImg', name: 'flagImg', orderable: false, searchable: false, className: 'text-center' },
                    {
                        data: 'TextLabel',
                        name: 'TextLabel',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextLabelPlain || '';
                            }
                            return data;
                        }
                    },
                    {
                        data: 'TextCode',
                        name: 'TextCode',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextCodePlain || '';
                            }
                            return data;
                        }
                    },
                    {
                        data: 'TextNativeName',
                        name: 'TextNativeName',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextNativeNamePlain || '';
                            }
                            return data;
                        }
                    },
                    { data: 'defaultBadge', name: 'Is_Default' },
                    { data: 'activeBadge', name: 'Is_Active' },
                    {
                        data: 'rowActions',
                        orderable: false,
                        searchable: false,
                        className: 'tandem-col-actions text-end align-middle text-nowrap'
                    },
                    { data: 'IdObject', visible: false }
                ],
                drawCallback: function () {
                    $('[data-toggle="tooltip"]').tooltip({
                        delay: { show: 100, hide: 100 },
                        placement: 'auto right'
                    });
                    $('[title]').tooltip({
                        delay: { show: 100, hide: 100 },
                        placement: 'auto'
                    });
                }
            }));
        });

        window.DeleteLanguage = function (id) {
            if (!confirm(languageDt.confirmDeleteLanguage)) return;
            $.post('@Url.Action("DeleteLanguage", "Language")',
                { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                function (res) {
                    if (res && res.Message) { alert(res.Message); }
                    if (res && res.IsOk) {
                        $('#ListLanguages').DataTable().ajax.reload(null, false);
                    }
                });
        };
    </script>
    @* Token AntiForgery para que DeleteLanguage pueda incluirlo en el POST. *@
    <div style="display:none;">@Html.AntiForgeryToken()</div>
}
