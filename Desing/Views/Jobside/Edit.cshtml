@model DAL.TSql_Jobside

@{

    ViewBag.Title = "Editar obra";

}

<div class="d-flex align-items-center justify-content-between mb-4">

    <h4 class="py-3 mb-0">

        <span class="text-muted fw-light"><a href="@Url.Action("Index")">Obras</a> /</span> Editar

    </h4>

</div>

<div class="card mb-4">

    <div class="card-body">

        @using (Html.BeginForm("Edit", "Jobside", FormMethod.Post, new { @class = "row g-3", id = "jobsideForm" }))

        {

            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.IdObject)

            @Html.Partial("_JobsideFormFields", Model)

            <div class="col-12 d-flex justify-content-end gap-2 tandem-form-actions mt-2">

                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Cancelar</a>

                <button type="submit" class="btn btn-primary">Guardar cambios</button>

            </div>

        }

    </div>

</div>



@section scripts {

    @{

        ViewData["GooglePlacesPageScript"] = "~/Scripts/Intranet/jobside-google-places.js";

    }

    @Html.Partial("~/Views/Shared/_GooglePlacesAddressScripts.cshtml")

}

