@model DAL.TSql_Jobside
@{
    ViewBag.Title = Model.TextLabel;
    var clientName = Model.TSql_Client_V2 != null ? Model.TSql_Client_V2.TextLabel : "—";
}
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index")">Obras</a> /</span> @Model.TextLabel
    </h4>
    <a class="btn btn-warning" href="@Url.Action("Edit", new { id = Model.IdObject })">Editar</a>
</div>
<div class="card">
    <div class="card-body row g-3">
        <div class="col-md-6"><strong>Cliente:</strong> @clientName</div>
        <div class="col-md-6"><strong>Activo:</strong> @(Model.Is_Active ? "Sí" : "No")</div>
        <div class="col-md-12"><strong>Local:</strong> @(Model.Loc_Formatted_Address ?? "—")</div>
        <div class="col-md-12"><strong>Facturación:</strong> @(Model.BitBillSameAsLoc ? "(igual que local)" : (Model.Bill_Formatted_Address ?? "—"))</div>
    </div>
</div>
