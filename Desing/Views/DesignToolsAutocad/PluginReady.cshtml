@using Desing.Models
@using Desing.Resources
@model PluginCadHomeVm
@{
    ViewBag.Title = Common.PluginCad_MenuHomeTitle;
    Layout = "~/Views/Shared/_LayoutAutocadPalette.cshtml";
    var userName = Model != null ? (Model.UserName ?? "") : "";
    ViewBag.BootSplashOnceKey = "tdesing-plugin-ready-boot";
}
@Html.Partial("_TdesingBootSplash")
@section Styles {
    <style>
        html, body { overflow: auto !important; height: 100%; background: #f5f7fb !important; }
        body .autocad-palette { align-items: stretch !important; flex-direction: column; height: 100%; }
        .plugin-home { display: flex; flex-direction: column; flex: 1 1 auto; min-height: 0; height: 100%; width: 100%; padding: 6px 8px 8px; box-sizing: border-box; gap: 6px; background: #f5f7fb; }
        .plugin-home__head { display: flex; align-items: center; gap: 6px; }
        .plugin-home__meta { flex: 1; font-size: 11px; color: #5e6a75; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .plugin-home__tabs { display: flex; gap: 4px; }
        .plugin-home__tabs .btn { font-size: 11px; padding: 2px 8px; }
        .plugin-home__search input { font-size: 12px; height: 30px; padding: 2px 8px; }
        .plugin-home__panel { display: none; flex: 1; min-height: 0; flex-direction: column; gap: 6px; }
        .plugin-home__panel.is-active { display: flex; }
        .plugin-home__form { display: none; border: 1px solid #d5dee8; border-radius: 8px; padding: 6px; background: #fff; gap: 6px; flex-direction: column; }
        .plugin-home__form.is-open { display: flex; }
        .plugin-home__form .form-control, .plugin-home__form .form-select { font-size: 12px; height: 30px; padding: 2px 8px; }
        .plugin-home__form label { font-size: 11px; margin-bottom: 0; color: #5e6a75; }
        .plugin-home__list { flex: 1; overflow: auto; display: flex; flex-direction: column; gap: 4px; }
        .plugin-home__item {
            display: block; width: 100%; text-align: left; border: 1px solid #d5dee8; background: #fff;
            border-radius: 8px; padding: 6px 8px; cursor: default;
        }
        .plugin-home__item[data-plugin-open-design] { cursor: pointer; }
        .plugin-home__item[data-plugin-open-design]:hover { border-color: #5a8dee; background: #f4f7ff; }
        .plugin-home__label { display: block; font-size: 12px; font-weight: 600; color: #2c3340; }
        .plugin-home__sub { display: block; font-size: 11px; color: #6b7785; }
        .plugin-home__empty { font-size: 12px; color: #6b7785; padding: 8px 0; }
        .plugin-home__empty.is-error { color: #d64545; }
        .plugin-home__status { font-size: 11px; color: #5a8dee; min-height: 16px; }
        .plugin-home__status.is-error { color: #d64545; }
        .plugin-home__speed {
            font-size: 13px; color: #5e6a75; border-top: 1px solid #e4e8ee;
            padding-top: 6px; display: flex; flex-wrap: wrap; gap: 6px 16px;
            align-items: center;
        }
        .plugin-home__speed-item { display: flex; align-items: center; gap: 7px; min-width: 0; }
        .plugin-home__speed-name { font-weight: 700; color: #2c3340; }
        .plugin-home__speed-label { font-weight: 600; }
        .plugin-home__speed-dots { display: flex; gap: 4px; }
        .plugin-home__speed-dots i {
            width: 8px; height: 8px; border-radius: 50%;
            background: #d5dee8; display: block;
        }
        .plugin-home__speed-item.is-good .plugin-home__speed-dots i.is-on { background: #2f9d6a; }
        .plugin-home__speed-item.is-good .plugin-home__speed-label { color: #2f9d6a; }
        .plugin-home__speed-item.is-ok .plugin-home__speed-dots i.is-on { background: #3d8bfd; }
        .plugin-home__speed-item.is-ok .plugin-home__speed-label { color: #3d8bfd; }
        .plugin-home__speed-item.is-poor .plugin-home__speed-dots i.is-on { background: #c45c26; }
        .plugin-home__speed-item.is-poor .plugin-home__speed-label { color: #c45c26; }
        .plugin-home__speed-item.is-bad .plugin-home__speed-dots i.is-on { background: #d64545; }
        .plugin-home__speed-item.is-bad .plugin-home__speed-label { color: #d64545; }
    </style>
}

<div class="plugin-home">
    @Html.AntiForgeryToken()
    <div class="plugin-home__head">
        <div class="plugin-home__meta">@string.Format(Common.PluginCad_ConnectedAs, userName)</div>
        <button type="button" class="btn btn-sm btn-icon btn-text-secondary" data-plugin-menu="hide-home" title="@Common.PluginCad_HideMenu" aria-label="@Common.PluginCad_HideMenu">
            <i class="icon-base ri ri-close-line" aria-hidden="true"></i>
        </button>
    </div>
    <div class="plugin-home__tabs" role="tablist">
        <button type="button" class="btn btn-sm btn-primary" data-plugin-tab="jobsides" role="tab" aria-selected="true">@Jobside.Index_Breadcrumb</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-plugin-tab="offers" role="tab" aria-selected="false">@Jobside.Offers_DtTitle</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-plugin-tab="designs" role="tab" aria-selected="false">@Jobside.OfferWorkspace_TabDesigns</button>
    </div>
    <div class="plugin-home__search">
        <input type="search" class="form-control" id="plugin-home-search" placeholder="@Common.PluginCad_Search" autocomplete="off" />
    </div>

    <div class="plugin-home__panel is-active" data-plugin-panel="jobsides">
        <button type="button" class="btn btn-sm btn-outline-primary align-self-start" data-plugin-toggle-form="jobside">@Jobside.Btn_New</button>
        <form class="plugin-home__form" id="plugin-form-jobside" autocomplete="off">
            <div>
                <label for="plugin-jobside-name">@Jobside.Col_Name</label>
                <input type="text" class="form-control" id="plugin-jobside-name" maxlength="500" required />
            </div>
            <div>
                <label for="plugin-jobside-client">@Jobside.Lbl_Client</label>
                <select class="form-select" id="plugin-jobside-client">
                    <option value="">@Jobside.Lbl_ClientEmpty</option>
                </select>
            </div>
            <div>
                <label for="plugin-jobside-branch">@Jobside.Lbl_Branch</label>
                <select class="form-select" id="plugin-jobside-branch" required>
                    <option value="">@Jobside.Lbl_BranchEmpty</option>
                </select>
            </div>
            <button type="submit" class="btn btn-sm btn-primary align-self-start">@Common.Btn_Create</button>
        </form>
        <div class="plugin-home__list" id="plugin-list-jobsides">
            <div class="plugin-home__empty" data-plugin-empty="jobsides">@Common.PluginCad_LoadingHome</div>
        </div>
    </div>

    <div class="plugin-home__panel" data-plugin-panel="offers">
        <button type="button" class="btn btn-sm btn-outline-primary align-self-start" data-plugin-toggle-form="offer">@Jobside.Offers_Btn_New</button>
        <form class="plugin-home__form" id="plugin-form-offer" autocomplete="off">
            <div>
                <label for="plugin-offer-jobside">@Jobside.Index_Breadcrumb</label>
                <select class="form-select" id="plugin-offer-jobside" required>
                    <option value="">@Common.PluginCad_SelectEmpty</option>
                </select>
            </div>
            <div>
                <label for="plugin-offer-name">@Jobside.Offers_Lbl_Name</label>
                <input type="text" class="form-control" id="plugin-offer-name" maxlength="500" required />
            </div>
            <div>
                <label for="plugin-offer-state">@Jobside.Offers_Lbl_State</label>
                <select class="form-select" id="plugin-offer-state" required>
                    <option value="">@Common.PluginCad_SelectEmpty</option>
                </select>
            </div>
            <button type="submit" class="btn btn-sm btn-primary align-self-start">@Common.Btn_Create</button>
        </form>
        <div class="plugin-home__list" id="plugin-list-offers">
            <div class="plugin-home__empty" data-plugin-empty="offers">@Common.PluginCad_LoadingHome</div>
        </div>
    </div>

    <div class="plugin-home__panel" data-plugin-panel="designs">
        <button type="button" class="btn btn-sm btn-outline-primary align-self-start" data-plugin-toggle-form="design">@Jobside.OfferWorkspace_Designs_Btn_New</button>
        <form class="plugin-home__form" id="plugin-form-design" autocomplete="off">
            <div>
                <label for="plugin-design-offer">@Jobside.Offers_DtTitle</label>
                <select class="form-select" id="plugin-design-offer" required>
                    <option value="">@Common.PluginCad_SelectEmpty</option>
                </select>
            </div>
            <div>
                <label for="plugin-design-name">@Jobside.OfferWorkspace_Designs_Lbl_AttLabel</label>
                <input type="text" class="form-control" id="plugin-design-name" maxlength="500" required />
            </div>
            <button type="submit" class="btn btn-sm btn-primary align-self-start">@Common.Btn_Create</button>
        </form>
        <div class="plugin-home__list" id="plugin-list-designs">
            <div class="plugin-home__empty" data-plugin-empty="designs">@Common.PluginCad_LoadingHome</div>
        </div>
    </div>

    <div class="plugin-home__status" id="plugin-home-status"></div>
    <div class="plugin-home__speed" id="plugin-home-speed" role="status">
        <div class="plugin-home__speed-item" data-speed="net">
            <span class="plugin-home__speed-name" data-speed-name="net">@Common.PluginCad_SpeedWifiTitle</span>
            <span class="plugin-home__speed-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="plugin-home__speed-label" data-speed-label="net">@Common.PluginCad_SpeedMeasuring</span>
        </div>
        <div class="plugin-home__speed-item" data-speed="server">
            <span class="plugin-home__speed-name">@Common.PluginCad_SpeedServerTitle</span>
            <span class="plugin-home__speed-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <span class="plugin-home__speed-label" data-speed-label="server">@Common.PluginCad_SpeedMeasuring</span>
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var loadingText = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_LoadingWalls));
            var failedText = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_LoadFailed));
            var createFailed = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_CreateFailed));
            var openInCad = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_OpenInCad));
            var loadingHome = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_LoadingHome));
            var homeFailed = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_HomeLoadFailed));
            var emptyJobs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_NoJobsides));
            var emptyOffers = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_NoOffers));
            var emptyDesigns = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_NoDesigns));
            var selectEmpty = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SelectEmpty));
            var urlWalls = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("GetDesignWalls", "Desing_2")));
            var urlHomeData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("PluginHomeData", "DesignToolsAutocad")));
            var urlPing = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("PluginPing", "DesignToolsAutocad")));
            var speedMeasuring = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedMeasuring));
            var speedWifi = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedWifi));
            var speedCable = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedCable));
            var speedNet = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedNet));
            var speedRound = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedRoundtrip));
            var speedServer = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedServer));
            var speedFail = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedFail));
            var speedWifiTitle = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedWifiTitle));
            var speedCableTitle = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedCableTitle));
            var speedNetTitle = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedNetTitle));
            var speedGood = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedGood));
            var speedOk = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedOk));
            var speedPoor = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedPoor));
            var speedBad = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Common.PluginCad_SpeedBad));
            var urlJobside = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("PluginCreateJobside", "DesignToolsAutocad")));
            var urlOffer = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("PluginCreateOffer", "DesignToolsAutocad")));
            var urlDesign = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Url.Action("PluginCreateDesign", "DesignToolsAutocad")));
            var companyLogoUrl = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject((ViewBag.CompanyLogoUrl as string) ?? ""));
            var statusEl = document.getElementById('plugin-home-status');
            var speedEl = document.getElementById('plugin-home-speed');
            var searchEl = document.getElementById('plugin-home-search');
            var nicKind = '';
            var nicMbps = 0;
            var lastRound = -1;
            var lastServer = -1;
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

            function post(payload) {
                try {
                    if (window.chrome && window.chrome.webview)
                        window.chrome.webview.postMessage(JSON.stringify(payload));
                } catch (e) { }
            }

            function setStatus(text, isError) {
                if (!statusEl) return;
                statusEl.textContent = text || '';
                statusEl.classList.toggle('is-error', !!isError);
            }

            function fmt(tpl, value) {
                return String(tpl || '').replace('{0}', String(value));
            }

            function netInfo() {
                if (nicMbps > 0)
                    return { kind: nicKind || 'net', mbps: nicMbps };
                try {
                    var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
                    if (c && c.downlink > 0) {
                        var t = (c.type || c.effectiveType || '') + '';
                        return {
                            kind: t.indexOf('wifi') >= 0 ? 'wifi' : (t.indexOf('ethernet') >= 0 ? 'cable' : 'net'),
                            mbps: Math.max(1, Math.round(c.downlink))
                        };
                    }
                } catch (e1) { }
                return { kind: '', mbps: 0 };
            }

            function qualityFromDots(dots) {
                if (dots >= 4) return { cls: 'is-good', text: speedGood };
                if (dots === 3) return { cls: 'is-ok', text: speedOk };
                if (dots === 2) return { cls: 'is-poor', text: speedPoor };
                return { cls: 'is-bad', text: speedBad };
            }

            function netDots(mbps, roundMs) {
                if (mbps >= 100) return 4;
                if (mbps >= 50) return 3;
                if (mbps >= 20) return 2;
                if (mbps > 0) return 1;
                if (roundMs < 0) return 0;
                if (roundMs < 80) return 4;
                if (roundMs < 200) return 3;
                if (roundMs < 500) return 2;
                return 1;
            }

            function serverDots(ms) {
                if (ms < 0) return 0;
                if (ms < 80) return 4;
                if (ms < 200) return 3;
                if (ms < 500) return 2;
                return 1;
            }

            function paintItem(key, dots, label, tip) {
                var item = speedEl ? speedEl.querySelector('[data-speed="' + key + '"]') : null;
                if (!item) return;
                var q = dots > 0 ? qualityFromDots(dots) : { cls: '', text: speedMeasuring };
                item.className = 'plugin-home__speed-item' + (q.cls ? ' ' + q.cls : '');
                var lab = item.querySelector('[data-speed-label]');
                if (lab) lab.textContent = label || q.text;
                var dotsEl = item.querySelectorAll('.plugin-home__speed-dots i');
                for (var i = 0; i < dotsEl.length; i++)
                    dotsEl[i].className = i < dots ? 'is-on' : '';
                if (tip) item.setAttribute('title', tip);
            }

            function paintSpeed() {
                if (!speedEl) return;
                var net = netInfo();
                var nameEl = speedEl.querySelector('[data-speed-name="net"]');
                if (nameEl)
                    nameEl.textContent = net.kind === 'cable' ? speedCableTitle : (net.kind === 'net' ? speedNetTitle : speedWifiTitle);
                var nDots = netDots(net.mbps, lastRound);
                var nTip = net.mbps > 0
                    ? fmt(net.kind === 'cable' ? speedCable : (net.kind === 'wifi' ? speedWifi : speedNet), net.mbps)
                    : (lastRound >= 0 ? fmt(speedRound, lastRound) : speedMeasuring);
                if (lastRound >= 0) nTip += ' · ' + fmt(speedRound, lastRound);
                paintItem('net', nDots, nDots > 0 ? qualityFromDots(nDots).text : speedMeasuring, nTip);
                var sDots = serverDots(lastServer);
                var sTip = lastServer >= 0 ? fmt(speedServer, lastServer) : speedFail;
                paintItem('server', sDots, sDots > 0 ? qualityFromDots(sDots).text : (lastServer < 0 && lastRound >= 0 ? speedFail : speedMeasuring), sTip);
            }

            function measurePing() {
                if (!urlPing) return;
                var t0 = Date.now();
                fetch(urlPing + (urlPing.indexOf('?') >= 0 ? '&' : '?') + 't=' + t0, {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                }).then(function (r) { return r.json(); }).then(function (data) {
                    lastRound = Date.now() - t0;
                    var db = data && (data.dbMs != null ? data.dbMs : data.DbMs);
                    lastServer = (db != null && db >= 0) ? db : lastRound;
                    paintSpeed();
                }).catch(function () {
                    lastRound = Date.now() - t0;
                    lastServer = -1;
                    paintSpeed();
                });
            }

            function onHostMessage(raw) {
                try {
                    var msg = typeof raw === 'string' ? JSON.parse(raw) : raw;
                    if (!msg) return;
                    if (msg.action === 'link-speed' || msg.type === 'link-speed') {
                        nicKind = (msg.kind || msg.Kind || '') + '';
                        nicMbps = parseInt(msg.mbps != null ? msg.mbps : msg.Mbps, 10) || 0;
                        paintSpeed();
                    }
                } catch (e2) { }
            }

            function token() {
                return tokenInput ? tokenInput.value : '';
            }

            function postForm(url, fields) {
                var body = new URLSearchParams();
                body.set('__RequestVerificationToken', token());
                Object.keys(fields).forEach(function (k) { body.set(k, fields[k] == null ? '' : String(fields[k])); });
                return fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: body.toString()
                }).then(function (r) { return r.json(); });
            }

            function hideEmpty(listId) {
                var empty = document.querySelector('#' + listId + ' [data-plugin-empty]');
                if (empty) empty.remove();
            }

            function val(item, camel, pascal) {
                if (!item) return '';
                var v = item[camel];
                if (v == null) v = item[pascal];
                return v == null ? '' : v;
            }

            function appendJobside(item) {
                hideEmpty('plugin-list-jobsides');
                var id = val(item, 'id', 'Id');
                var code = val(item, 'code', 'Code');
                var label = val(item, 'label', 'Label');
                var el = document.createElement('div');
                el.className = 'plugin-home__item';
                el.setAttribute('data-plugin-filter', code + ' ' + label);
                el.innerHTML = '<span class="plugin-home__label"></span>' + (code ? '<span class="plugin-home__sub"></span>' : '');
                el.querySelector('.plugin-home__label').textContent = label || ('#' + id);
                if (code) el.querySelector('.plugin-home__sub').textContent = code;
                document.getElementById('plugin-list-jobsides').prepend(el);
                var opt = document.createElement('option');
                opt.value = id;
                opt.textContent = label || code || ('#' + id);
                document.getElementById('plugin-offer-jobside').appendChild(opt);
            }

            function appendOffer(item) {
                hideEmpty('plugin-list-offers');
                var id = val(item, 'id', 'Id');
                var number = val(item, 'number', 'Number');
                var label = val(item, 'label', 'Label');
                var el = document.createElement('div');
                el.className = 'plugin-home__item';
                el.setAttribute('data-plugin-filter', number + ' ' + label);
                el.innerHTML = '<span class="plugin-home__label"></span>' + (number ? '<span class="plugin-home__sub"></span>' : '');
                el.querySelector('.plugin-home__label').textContent = label || number || ('#' + id);
                if (number) el.querySelector('.plugin-home__sub').textContent = number;
                document.getElementById('plugin-list-offers').prepend(el);
                var opt = document.createElement('option');
                opt.value = id;
                opt.textContent = number ? (number + ' · ' + (label || '')) : (label || ('#' + id));
                document.getElementById('plugin-design-offer').appendChild(opt);
            }

            function appendDesign(item) {
                hideEmpty('plugin-list-designs');
                var id = val(item, 'id', 'Id');
                var label = val(item, 'label', 'Label') || ('#' + id);
                var offerNumber = val(item, 'offerNumber', 'OfferNumber');
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'plugin-home__item';
                btn.setAttribute('data-plugin-open-design', id);
                btn.setAttribute('data-label', label);
                btn.setAttribute('data-plugin-filter', label + ' ' + offerNumber);
                btn.title = openInCad;
                btn.innerHTML = '<span class="plugin-home__label"></span>' + (offerNumber ? '<span class="plugin-home__sub"></span>' : '');
                btn.querySelector('.plugin-home__label').textContent = label;
                if (offerNumber) btn.querySelector('.plugin-home__sub').textContent = offerNumber;
                document.getElementById('plugin-list-designs').prepend(btn);
            }

            function setEmpty(listId, text, isError) {
                var list = document.getElementById(listId);
                if (!list) return;
                list.innerHTML = '';
                var el = document.createElement('div');
                el.className = 'plugin-home__empty' + (isError ? ' is-error' : '');
                el.setAttribute('data-plugin-empty', listId.replace('plugin-list-', ''));
                el.textContent = text;
                list.appendChild(el);
            }

            function fillSelect(selectId, items, emptyLabel, labelFn) {
                var sel = document.getElementById(selectId);
                if (!sel) return;
                var keepFirst = sel.querySelector('option[value=""]');
                sel.innerHTML = '';
                if (emptyLabel != null) {
                    var empty = document.createElement('option');
                    empty.value = '';
                    empty.textContent = emptyLabel;
                    sel.appendChild(empty);
                } else if (keepFirst) {
                    sel.appendChild(keepFirst);
                }
                (items || []).forEach(function (item) {
                    var opt = document.createElement('option');
                    opt.value = val(item, 'id', 'Id');
                    opt.textContent = labelFn ? labelFn(item) : (val(item, 'label', 'Label') || ('#' + opt.value));
                    sel.appendChild(opt);
                });
            }

            function rows(data, camel, pascal) {
                return (data && (data[camel] || data[pascal])) || [];
            }

            function renderHome(data) {
                var jobs = rows(data, 'jobsides', 'Jobsides');
                var offers = rows(data, 'offers', 'Offers');
                var designs = rows(data, 'designs', 'Designs');
                setEmpty('plugin-list-jobsides', emptyJobs);
                setEmpty('plugin-list-offers', emptyOffers);
                setEmpty('plugin-list-designs', emptyDesigns);
                jobs.forEach(function (item) { appendJobside(item); });
                offers.forEach(function (item) { appendOffer(item); });
                designs.forEach(function (item) { appendDesign(item); });
                fillSelect('plugin-jobside-client', rows(data, 'clients', 'Clients'), document.getElementById('plugin-jobside-client').options[0] ? document.getElementById('plugin-jobside-client').options[0].text : '', function (c) { return c.label || c.Label || ('#' + (c.id || c.Id)); });
                fillSelect('plugin-jobside-branch', rows(data, 'branches', 'Branches'), document.getElementById('plugin-jobside-branch').options[0] ? document.getElementById('plugin-jobside-branch').options[0].text : '', function (b) { return b.label || b.Label || ('#' + (b.id || b.Id)); });
                fillSelect('plugin-offer-jobside', jobs, selectEmpty, function (j) { return j.label || j.Label || j.code || j.Code || ('#' + (j.id || j.Id)); });
                fillSelect('plugin-offer-state', rows(data, 'offerStates', 'OfferStates'), null, function (s) { return s.label || s.Label || ('#' + (s.id || s.Id)); });
                fillSelect('plugin-design-offer', offers, selectEmpty, function (o) { return (o.number || o.Number) ? ((o.number || o.Number) + ' · ' + (o.label || o.Label || '')) : (o.label || o.Label || ('#' + (o.id || o.Id))); });
                var meta = document.querySelector('.plugin-home__meta');
                var uname = data.userName || data.UserName;
                if (meta && uname)
                    meta.textContent = meta.textContent.replace(/: .*$/, ': ' + uname);
            }

            function loadHome() {
                setEmpty('plugin-list-jobsides', loadingHome);
                setEmpty('plugin-list-offers', loadingHome);
                setEmpty('plugin-list-designs', loadingHome);
                var t0 = Date.now();
                fetch(urlHomeData + (urlHomeData.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now(), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                }).then(function (r) {
                    if (r.status === 401) throw new Error('auth');
                    return r.json();
                }).then(function (data) {
                    if (!data || data.ok === false) {
                        var msg = (data && data.message) || homeFailed;
                        setEmpty('plugin-list-jobsides', msg, true);
                        setEmpty('plugin-list-offers', msg, true);
                        setEmpty('plugin-list-designs', msg, true);
                        setStatus(msg, true);
                        return;
                    }
                    renderHome(data);
                    setStatus('');
                    lastRound = Date.now() - t0;
                    var listMs = data.listMs != null ? data.listMs : data.ListMs;
                    lastServer = (listMs != null && listMs >= 0) ? listMs : lastRound;
                    paintSpeed();
                }).catch(function () {
                    setEmpty('plugin-list-jobsides', homeFailed, true);
                    setEmpty('plugin-list-offers', homeFailed, true);
                    setEmpty('plugin-list-designs', homeFailed, true);
                    setStatus(homeFailed, true);
                }).then(function () {
                    post({ action: 'home-ready' });
                });
            }

            post({ action: 'company-logo', url: companyLogoUrl });
            post({ action: 'home-ready' });
            post({ action: 'request-link-speed' });
            paintSpeed();
            measurePing();
            loadHome();
            try {
                if (window.chrome && window.chrome.webview && window.chrome.webview.addEventListener)
                    window.chrome.webview.addEventListener('message', function (ev) { onHostMessage(ev.data); });
            } catch (e3) { }

            document.querySelectorAll('[data-plugin-tab]').forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var id = tab.getAttribute('data-plugin-tab');
                    document.querySelectorAll('[data-plugin-tab]').forEach(function (t) {
                        var on = t === tab;
                        t.classList.toggle('btn-primary', on);
                        t.classList.toggle('btn-outline-secondary', !on);
                        t.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    document.querySelectorAll('[data-plugin-panel]').forEach(function (p) {
                        p.classList.toggle('is-active', p.getAttribute('data-plugin-panel') === id);
                    });
                });
            });

            document.querySelectorAll('[data-plugin-toggle-form]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var form = document.getElementById('plugin-form-' + btn.getAttribute('data-plugin-toggle-form'));
                    if (form) form.classList.toggle('is-open');
                });
            });

            if (searchEl) {
                searchEl.addEventListener('input', function () {
                    var q = (searchEl.value || '').toLowerCase();
                    var panel = document.querySelector('.plugin-home__panel.is-active');
                    if (!panel) return;
                    var items = panel.querySelectorAll('.plugin-home__item');
                    for (var i = 0; i < items.length; i++) {
                        var text = (items[i].getAttribute('data-plugin-filter') || items[i].textContent || '').toLowerCase();
                        items[i].style.display = !q || text.indexOf(q) >= 0 ? '' : 'none';
                    }
                });
            }

            document.getElementById('plugin-form-jobside').addEventListener('submit', function (e) {
                e.preventDefault();
                setStatus('');
                postForm(urlJobside, {
                    textLabel: document.getElementById('plugin-jobside-name').value,
                    linkClientV2: document.getElementById('plugin-jobside-client').value,
                    linBranch: document.getElementById('plugin-jobside-branch').value
                }).then(function (data) {
                    if (!data || !data.ok) { setStatus((data && data.message) || createFailed, true); return; }
                    appendJobside(data.item);
                    document.getElementById('plugin-jobside-name').value = '';
                    document.getElementById('plugin-form-jobside').classList.remove('is-open');
                    setStatus(data.message || '');
                }).catch(function () { setStatus(createFailed, true); });
            });

            document.getElementById('plugin-form-offer').addEventListener('submit', function (e) {
                e.preventDefault();
                setStatus('');
                postForm(urlOffer, {
                    jobsideId: document.getElementById('plugin-offer-jobside').value,
                    textLabel: document.getElementById('plugin-offer-name').value,
                    linkOfferState: document.getElementById('plugin-offer-state').value
                }).then(function (data) {
                    if (!data || !data.ok) { setStatus((data && data.message) || createFailed, true); return; }
                    appendOffer(data.item);
                    document.getElementById('plugin-offer-name').value = '';
                    document.getElementById('plugin-form-offer').classList.remove('is-open');
                    setStatus(data.message || '');
                }).catch(function () { setStatus(createFailed, true); });
            });

            document.getElementById('plugin-form-design').addEventListener('submit', function (e) {
                e.preventDefault();
                setStatus('');
                postForm(urlDesign, {
                    offerId: document.getElementById('plugin-design-offer').value,
                    attLabel: document.getElementById('plugin-design-name').value
                }).then(function (data) {
                    if (!data || !data.ok) { setStatus((data && data.message) || createFailed, true); return; }
                    appendDesign(data.item);
                    document.getElementById('plugin-design-name').value = '';
                    document.getElementById('plugin-form-design').classList.remove('is-open');
                    setStatus(data.message || '');
                }).catch(function () { setStatus(createFailed, true); });
            });

            document.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-plugin-open-design]');
                if (!btn) return;
                var id = parseInt(btn.getAttribute('data-plugin-open-design'), 10);
                if (!id) return;
                setStatus(loadingText);
                fetch(urlWalls + '?designId=' + encodeURIComponent(id), {
                    credentials: 'same-origin',
                    headers: { 'Accept': 'application/json' }
                }).then(function (r) { return r.json(); }).then(function (data) {
                    if (!data || !(data.Exito === true || data.exito === true)) {
                        setStatus((data && (data.Mensaje || data.mensaje)) || failedText, true);
                        return;
                    }
                    post({ action: 'open-design', designId: id, snapshot: data.Snapshot || data.snapshot });
                    setStatus('');
                }).catch(function () { setStatus(failedText, true); });
            });
        })();
    </script>
}
