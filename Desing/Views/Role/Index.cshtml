@using Newtonsoft.Json
@using Desing.Resources
@using System.Globalization
@{
    ViewBag.Title = Security.Role_Index_Breadcrumb;
    var ci = CultureInfo.CurrentUICulture?.TwoLetterISOLanguageName ?? "es";
    var secDt = JsonConvert.SerializeObject(new
    {
        culture = ci,
        rowsSuffix = Common.Dt_Rows_N,
        allRows = Common.Dt_Rows_All,
        sectionRecords = Common.Dt_Section_Records,
        sectionExport = Common.Dt_Section_Export,
        sectionCols = Common.Dt_Section_ColumnsVisible,
        confirmDelete = Security.Role_Js_ConfirmDelete,
        ariaMenu = Common.Dt_MenuAria
    });
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">@Security.Common_Home</a> /
            @Security.Common_Security /
        </span> @Security.Role_Index_Breadcrumb
    </h4>
    <a class="btn btn-primary text-white" href="@Url.Action("Create", "Role")">
        <i class="icon-base ri ri-add-line me-1"></i> @Security.Role_Index_Create
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListRoles" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th>@Security.Role_Col_Name</th>
                    <th>@Security.Role_Col_Code</th>
                    <th>@Security.Role_Col_Functions</th>
                    <th>@Security.Role_Col_Users</th>
                    <th>@Security.Col_State</th>
                    <th class="text-end text-nowrap" style="width:1%;"></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var secDt = @Html.Raw(secDt);
        var secExportOpts = TandemDataTablesList.exportOptsPlainVisible;

        $(document).ready(function () {
            $('#ListRoles').DataTable(TandemDataTablesList.applyListDefaults({
                lengthMenu: [
                    [10, 25, 50, -1],
                    ['10 ' + secDt.rowsSuffix, '25 ' + secDt.rowsSuffix, '50 ' + secDt.rowsSuffix, secDt.allRows]
                ],
                buttons: [{
                    extend: 'collection',
                    text: "<i class='fas fa-bars'></i>",
                    attr: { 'aria-label': secDt.ariaMenu },
                    className: 'custom-html-collection',
                    buttons: [
                        '<h5>' + secDt.sectionRecords + '</h5>',
                        'pageLength',
                        '<h5>' + secDt.sectionExport + '</h5>',
                        'print',
                        'copy',
                        'pdf',
                        { extend: 'csv', exportOptions: secExportOpts },
                        { extend: 'excel', exportOptions: secExportOpts },
                        '<h5 class="not-top-heading">' + secDt.sectionCols + '</h5>',
                        'colvis'
                    ]
                }],
                serverSide: true,
                processing: true,
                colReorder: { iFixedColumnsRight: 2 },
                ajax: {
                    url: '@Url.Action("ListRoles", "Role")',
                    type: 'POST'
                },
                order: [[0, 'asc']],
                columns: [
                    {
                        data: 'TextLabel',
                        name: 'TextLabel',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextLabelPlain || '';
                            }
                            return data;
                        }
                    },
                    { data: 'TextCode', name: 'TextCode' },
                    {
                        data: 'NFunctions',
                        name: 'NFunctions',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.NFunctionsPlain || '';
                            }
                            return data;
                        }
                    },
                    { data: 'NUsers', name: 'NUsers', searchable: false },
                    { data: 'activeBadge', name: 'Is_Active', orderable: true, searchable: false },
                    {
                        data: 'rowActions',
                        orderable: false,
                        searchable: false,
                        className: 'tandem-col-actions text-end align-middle text-nowrap'
                    },
                    { data: 'IdObject', visible: false }
                ],
                drawCallback: function () {
                    $('[title]').tooltip({
                        delay: { show: 100, hide: 100 },
                        placement: 'auto'
                    });
                }
            }));
        });

        window.DeleteRole = function (id) {
            if (!confirm(secDt.confirmDelete)) return;
            $.post('@Url.Action("DeleteRole", "Role")',
                { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                function (res) {
                    if (res && res.Message) { alert(res.Message); }
                    if (res && res.IsOk) {
                        $('#ListRoles').DataTable().ajax.reload(null, false);
                    }
                });
        };
    </script>
    <div style="display:none;">@Html.AntiForgeryToken()</div>
}
