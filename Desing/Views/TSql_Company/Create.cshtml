@model DAL.TSql_Company
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> / <a href="@Url.Action("Index", "TSql_Company")">Empresas</a> /</span> Crear empresa
    </h4>
</div>

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Create", "TSql_Company", FormMethod.Post, new { @class = "row g-3" }))
        {
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label">Nombre *</label>
                @Html.TextBoxFor(m => m.TextLabel, new { @class = "form-control", maxlength = "120" })
                @Html.ValidationMessageFor(m => m.TextLabel, "", new { @class = "text-danger" })
            </div>
            <div class="col-md-2">
                <label class="form-label">Signadura</label>
                @Html.TextBoxFor(m => m.AddLeter, new { @class = "form-control", maxlength = "10" })
            </div>
            <div class="col-md-4">
                <label class="form-label">País</label>
                @Html.DropDownListFor(m => m.LinkCountry, (SelectList)ViewBag.LinkCountry, "-- Seleccionar --", new { @class = "form-select" })
            </div>
            <div class="col-md-12">
                <label class="form-label">Plantilla visual (colores, marca)</label>
                @Html.DropDownListFor(m => m.LinPlantilla, (IEnumerable<SelectListItem>)ViewBag.LinPlantilla, new { @class = "form-select" })
                <small class="text-muted">Todos los empleados de esta empresa verán esta plantilla. Vacío = plantilla global por defecto.</small>
            </div>
            <div class="col-md-12">
                <label class="form-label">Descripción</label>
                @Html.TextAreaFor(m => m.TextDescription, new { @class = "form-control", rows = "2" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Dirección</label>
                @Html.TextBoxFor(m => m.TextAddress_1, new { @class = "form-control", maxlength = "200" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Dirección 2</label>
                @Html.TextBoxFor(m => m.TextAddress_2, new { @class = "form-control", maxlength = "200" })
            </div>
            <div class="col-md-3">
                <label class="form-label">Código postal</label>
                @Html.TextBoxFor(m => m.TextPostal_Code, new { @class = "form-control", type = "number", min = "0" })
            </div>
            <div class="col-md-4">
                <label class="form-label">Ciudad</label>
                @Html.TextBoxFor(m => m.TextTown_1, new { @class = "form-control", maxlength = "120" })
            </div>
            <div class="col-md-5">
                <label class="form-label">Logo (texto/ruta)</label>
                @Html.TextBoxFor(m => m.TextLogo, new { @class = "form-control", maxlength = "250" })
            </div>
            <div class="col-12 d-flex justify-content-end gap-2 tandem-form-actions mt-2">
                <a href="@Url.Action("Index", "TSql_Company")" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary">Guardar empresa</button>
            </div>
        }
    </div>
</div>
