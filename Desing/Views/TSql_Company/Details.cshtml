@model DAL.TSql_Company
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">Inicio</a> /
            <a href="@Url.Action("Index", "TSql_Company")">Empresas</a> /
        </span> @Model.TextLabel
    </h4>
    <a class="btn btn-warning" href="@Url.Action("Edit", "TSql_Company", new { id = Model.SysObjectID })">
        <i class="icon-base ri ri-pencil-line me-1"></i> Editar
    </a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.TextLabel</dd>

            <dt class="col-sm-3">Signadura</dt>
            <dd class="col-sm-9">@Model.AddLeter</dd>

            <dt class="col-sm-3">Descripción</dt>
            <dd class="col-sm-9">@Model.TextDescription</dd>

            <dt class="col-sm-3">Dirección</dt>
            <dd class="col-sm-9">@Model.TextAddress_1</dd>

            <dt class="col-sm-3">Dirección 2</dt>
            <dd class="col-sm-9">@Model.TextAddress_2</dd>

            <dt class="col-sm-3">Código postal</dt>
            <dd class="col-sm-9">@Model.TextPostal_Code</dd>

            <dt class="col-sm-3">Ciudad</dt>
            <dd class="col-sm-9">@Model.TextTown_1</dd>

            <dt class="col-sm-3">País</dt>
            <dd class="col-sm-9">@(Model.TSql_Countrys != null ? Model.TSql_Countrys.TextLabel : "-")</dd>
        </dl>
    </div>
</div>
