@model DAL.TSql_Company
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> /</span> Empresas
    </h4>
    <a class="btn btn-primary" href="@Url.Action("Create", "TSql_Company")">
        <i class="icon-base ri ri-add-line me-1"></i> Crear Nueva empresa
    </a>
</div>
@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}
<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListTSql_Company" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Signadura</th>
                    <th>Logo</th>
                    <th>Descripción</th>
                    <th>Dirección</th>
                    <th>Dirección 2</th>
                    <th>Código Postal</th>
                    <th>Ciudad</th>
                    <th></th>
                    <th>Pais</th>
                    <th>Estado</th>
                    <th></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section scripts
    {
    <script type="text/javascript">
        $(document).ready(function () {
            var ListTSql_Company = {
            dt: null,
            init: function () {
                dt = $('#ListTSql_Company').DataTable({
                    dom: '<"dataTables-length-position">Bfrt<"dataTables-length-position"i>p',
                    lengthMenu: [
                        [10, 25, 50, -1],
                        ['10 filas', '25 filas', '50 filas', 'Todas']
                    ],
                    buttons: [
                        {
                            extend: 'collection',
                            text: "<i class='fas fa-bars'></i>",
                            className: 'custom-html-collection',
                            buttons: [
                                '<h5>Registros</h5>',
                                'pageLength',
                                '<h5>Exportar</h5>',
                                'print',
                                'copy',
                                'pdf',
                                'csv',
                                'excel',
                                '<h5 class="not-top-heading">Columnas visibles</h5>',
                                'colvis'
                            ]
                        }
                    ],
                    //buttons: [
                    //    'copy', 'csv', 'excel', 'pdf', 'print'
                    //],
                    "serverSide": true,
                    "processing": true,
                    "stateSave": true,
                    "colReorder": { "iFixedColumnsRight": 2 },
                    "ajax": {
                        "url": "@Url.Content("~/TSql_Company/ListTSql_Company/")",
                    "type": "POST"
                        },
                    "columns": [
                        { "data": "TextLabel"},
                        { "data": "AddLeter"},
                        { "data": "TextLogo"},
                        { "data": "TextDescription"},
                        { "data": "TextAddress_1"},
                        { "data": "TextAddress_2"},
                        { "data": "TextPostal_Code"},
                        { "data": "TextTown_1"},
                        { "data": "TextFlag"},
                        { "data": "Country"},
                        {
                            "data": "BitIsDeleted",
                            "render": function (data, type) {
                                if (type !== "display") { return data; }
                                return data ? "<span class='badge bg-label-danger'>Desactivada</span>" : "<span class='badge bg-label-success'>Activa</span>";
                            }
                        },
                        { "data": "emptyColumn" },
                        { "data": "SysObjectID" }
            ],
            "lengthMenu": [[10, 25, 50, 100], [10, 25, 50, 100]],
            /*   "iDisplayLength": parseInt(leerCookie("_rowsPerPage")),*/
            "fnRowCallback": function (nRow, data) {
                var actions = (data.buttonDisable || "") + "&nbsp;" + (data.buttonEdit || "");
                if (!data.HasDependencies) {
                    actions += "&nbsp;" + (data.buttonDelete || "");
                }
                $('td:eq(11)', nRow).html(actions);
                return nRow;
            },
            "aaSorting": [[1, 'desc']],
            "aoColumnDefs": [
                { "bSortable": false, "aTargets": [11] },
                { "bVisible": false, "aTargets": [12] },
                { "bSortable": false, "aTargets": [12] },
                { "width": "300px", "aTargets": [0] },
                { "width": "500px", "aTargets": [3] },
                { "width": "120px", "aTargets": [11] },
            ],
            drawCallback: function () {
                $('[data-toggle="tooltip"]').tooltip({
                    delay: { "show": 100, "hide": 100 },
                    placement: "auto right"
                }),
                    $('[title]').tooltip({
                        delay: { "show": 100, "hide": 100 },
                        placement: "auto"
                    })
            },

        });
                }
            }
            ListTSql_Company.init();
        });
    $('#sidebar').toggleClass('active');
        $(this).toggleClass('active');
        $('#sidebar').load('/Menu/Index');

        window.DeleteCompany = function (id) {
            if (!confirm("¿Quieres eliminar esta empresa?")) return;
            $.post('@Url.Action("DeleteCompany", "TSql_Company")', { id: id }, function (res) {
                alert(res.Message);
                if (res.IsOk) {
                    $('#ListTSql_Company').DataTable().ajax.reload(null, false);
                }
            });
        };

        window.ToggleCompany = function (id) {
            if (!confirm("¿Quieres desactivar/activar esta empresa?")) return;
            $.post('@Url.Action("ToggleCompany", "TSql_Company")', { id: id }, function (res) {
                alert(res.Message);
                if (res.IsOk) {
                    $('#ListTSql_Company').DataTable().ajax.reload(null, false);
                }
            });
        };
    </script>
}

