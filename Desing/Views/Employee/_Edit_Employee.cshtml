@model Desing.Models.EmployeeViewModel
@using Desing.Resources
@*
   Parcial heredado (no se enlaza actualmente desde el controlador refactorizado).
   Se mantiene para no romper posibles cargas dinámicas y se migra a las claves
   de `Desing.Resources.Employee`.
*@
@using (Html.BeginForm("Create_Employee", "Employee", FormMethod.Post, new { @class = "form-horizontal", role = "form", @id = "frm", enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <div class="well" style="padding-left:15px">
        <input type="hidden" name="AttPhoto" value="@Model.AttPhoto" />
        <input type="hidden" name="LinBusiness" value="@Model.LinBusiness" />
        <input type="hidden" name="LinAspNetUsert" value="@Model.LinAspNetUsert" />
        <input type="hidden" name="AttPassAspNetUsert" value="@Model.AttPassAspNetUsert" />
        <input type="hidden" name="userSystem" value="@Model.userSystem" />
        <input type="hidden" name="AttPhotoMenu" value="@Model.AttPhotoMenu" />
        <fieldset style="margin:10px;padding:10px">
            <legend>@Employee.Page_EditTitle: @Model.AttName</legend>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group" style="margin:15px;margin:15px">
                        <label class="control-label col-md-9">@Employee.Lbl_NameRequired</label>
                        <div class="col-md-12">
                            @Html.EditorFor(m => m.AttName, new { htmlAttributes = new { @class = "form-control-mandatory", @placeholder = Employee.Ph_NameRequired } })
                            @Html.ValidationMessageFor(m => m.AttName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="margin:15px;margin:15px">
                        <label class="control-label col-md-9">@Employee.Lbl_SurnameRequired</label>
                        <div class="col-md-12">
                            @Html.EditorFor(m => m.AttSurname, new { htmlAttributes = new { @class = "form-control-mandatory", @placeholder = Employee.Ph_SurnameRequired } })
                            @Html.ValidationMessageFor(m => m.AttSurname, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="margin:15px;margin:15px">
                        <label class="control-label col-md-9">@Employee.Lbl_Company</label>
                        <div class="col-md-12">
                            @Html.DropDownList("LinCompany", null, htmlAttributes: new { @class = "form-control-mandatory-Link" })
                            @Html.ValidationMessageFor(model => model.LinCompany, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div>
                        <div class="mb-4 d-flex justify-content-center">
                            <img style="height:300px;width:300px" id="output" src="@Model.AttPhotoMenu" />
                        </div>
                        <div class="form-group">
                            <div>
                                <input class="btn btn-warning" type="file" name="file1" id="file" onchange="loadFile(event)">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <hr style="background-color: gainsboro; height: 1px; margin: 1px; padding: 1px">
                <div class="row">
                    <div class="col-md-6">&nbsp;</div>
                    <div class="col-md-5" style="margin:10px;padding:10px">
                        <button type="button" id="btnSalirEditEmployee" class="btn btn-outline-secondary">@Employee.Btn_Exit</button>
                        <button type="submit" class="btn btn-primary">@Employee.Btn_SaveChanges</button>
                    </div>
                </div>
            </div>
        </fieldset>
    </div>
}
