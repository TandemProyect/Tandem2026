@model Desing.Models.EmployeeViewModel
<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light">
            <a href="@Url.Action("Index", "Home")">Inicio</a> /
            <a href="@Url.Action("Index", "Employee")">Empleados</a> /
        </span> @(Model.IsEdit ? "Editar Empleado" : "Crear Empleado")
        @if (!string.IsNullOrEmpty(Model.userSystem))
        {
            <small class="text-muted ms-2">@Model.userSystem</small>
        }
    </h4>
</div>

<div class="card mb-4">
    <div class="card-body">
        @using (Html.BeginForm(Model.IsEdit ? "Update_Employee" : "Create_Employee", "Employee", FormMethod.Post, new { @class = "row g-4", role = "form", @id = "frm", enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />
            <input type="hidden" name="IsEdit" value="@Model.IsEdit" />
            <input type="hidden" name="AttPhoto" value="@Model.AttPhoto" />
            <input type="hidden" name="LinBusiness" value="@Model.LinBusiness" />
            <input type="hidden" name="LinAspNetUsert" value="@Model.LinAspNetUsert" />
            <input type="hidden" name="AttPassAspNetUsert" value="@Model.AttPassAspNetUsert" />
            <input type="hidden" name="userSystem" value="@Model.userSystem" />

            <div class="col-12">
                <p class="text-muted mb-0">Alta de empleado para el usuario: <strong>@Model.userSystem</strong></p>
            </div>

            <div class="col-lg-7">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.AttName)</label>
                        @Html.EditorFor(m => m.AttName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Inserta nombre" } })
                        @Html.ValidationMessageFor(m => m.AttName, "", new { @id = "LabelField", @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.AttSurname)</label>
                        @Html.EditorFor(m => m.AttSurname, new { htmlAttributes = new { @class = "form-control", @placeholder = "Inserta apellido" } })
                        @Html.ValidationMessageFor(m => m.AttSurname, "", new { @id = "LabelField", @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(model => model.LinCompany)</label>
                        @Html.DropDownList("LinCompany", null, htmlAttributes: new { @class = "form-select" })
                        <small class="text-muted">La plantilla visual (colores, marca) la define la empresa en Empresas.</small>
                        @Html.ValidationMessageFor(model => model.LinCompany, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12 mt-2">
                        <h6 class="mb-2">Autorización de equipo para plugin</h6>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.DeviceName)</label>
                        @Html.EditorFor(m => m.DeviceName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ej: PC-OFICINA-01" } })
                        @Html.ValidationMessageFor(m => m.DeviceName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Html.DisplayNameFor(m => m.DeviceId)</label>
                        @Html.EditorFor(m => m.DeviceId, new { htmlAttributes = new { @class = "form-control", @placeholder = "Hash DeviceId del plugin" } })
                        @Html.ValidationMessageFor(m => m.DeviceId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12">
                        <div class="form-check form-switch">
                            @Html.CheckBoxFor(m => m.DeviceAllowed, new { @class = "form-check-input" })
                            <label class="form-check-label" for="DeviceAllowed">Autorizar plugin para este equipo</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="border rounded p-3 h-100">
                    <div class="mb-3 text-center">
                        <img id="output" src="~/Files/RRHH/User/AttPhotoMenu/User.png" class="img-fluid rounded" style="max-height:300px" />
                    </div>
                    <label for="file" class="form-label">Foto de perfil</label>
                    <input class="form-control" type="file" name="file1" id="file" onchange="loadFile(event)">
                </div>
            </div>

            <div class="col-12 border-top pt-3 mt-2 d-flex justify-content-end gap-2">
                <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary">Salir</a>
                <button type="submit" id="SubmitEditBtn" class="btn btn-primary">@(Model.IsEdit ? "Guardar cambios" : "Crear")</button>
            </div>
        }
    </div>
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript">
        $(document).ready(function ()
        {
            if ('@Model.AttPhotoMenu' == "") {
                output.src = "~/Files/RRHH/User/AttPhotoMenu/user.png";
            }
            else {
                output.src = '@Model.AttPhotoMenu';
            }
 
            $('#sidebar').toggleClass('active');
            $(this).toggleClass('active');
             //Load Toas
                $.ajax({
                type: 'POST',
                url: '@Url.Content("~/ToasHelp/DataToaster")',
                    data: {
                        Type: "info",
                        ToasConcept: "The User was create ok",
                        ToasMessage: "Create User",
                    },
                success: function (data) {
                    $('#PartialToas').html(data);
                    }
                });
                $('#PartialToas').fadeIn();
                //End Load Toas
        });

        var loadFile = function (event) {
            var image = document.getElementById('output');
            image.src = URL.createObjectURL(event.target.files[0]);
        };

</script>
}

