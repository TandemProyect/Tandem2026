@model Desing.Models.EmployeeViewModel
<div class="well" style="padding-left:15px">
    <div class="modal-body">
        <ul class="breadcrumb">
            <li><a style="color:black" id="sidebarCollapse" href="#" class=""><i class="fas fa-align-justify"></i></a></li>
            <li><a href="@Url.Action("Index", "Home")"><i class="fas fa-home"></i>&nbsp;Home</a></li>
            <li><a href="@Url.Action("Index", "Home")"><i class="fas fa-address-book"></i>&nbsp;Administración</a></li>
            <li style="color:black"><a><i class="fas fa-user"></i>&nbsp;@ViewBag.MessageHeat;&nbsp; @Model.userSystem</a></li>
            <li><i class="fas fa-user-friends"></i>&nbsp;Crear Empleado</li>
        </ul>
    </div>

    @using (Html.BeginForm(Model.IsEdit ? "Update_Employee" : "Create_Employee", "Employee", FormMethod.Post, new { @class = "form-horizontal", role = "form", @id = "frm", enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="EmployeeID" value="@Model.EmployeeID" />
        <input type="hidden" name="IsEdit" value="@Model.IsEdit" />
        <input type="hidden" name="AttPhoto" value="@Model.AttPhoto" />
        <input type="hidden" name="LinBusiness" value="@Model.LinBusiness" />
        <input type="hidden" name="LinAspNetUsert" value="@Model.LinAspNetUsert" />
        <input type="hidden" name="AttPassAspNetUsert" value="@Model.AttPassAspNetUsert" />
        <input type="hidden" name="userSystem" value="@Model.userSystem" />

        <fieldset style="margin:10px;padding:10px">
            <legend> Crear alta de empleado para el usuario: @Model.userSystem</legend>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group" style="margin:15px;margin:15px">
                        @Html.LabelFor(m => m.AttName, htmlAttributes: new { @class = "control-label col-md-9" })
                        <div class="col-md-12">
                            @Html.EditorFor(m => m.AttName, new { htmlAttributes = new { @class = "form-control-mandatory", @placeholder = "inserta Nombre" } })
                            @Html.ValidationMessageFor(m => m.AttName, "", new { @id = "LabelField", @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="margin:15px;margin:15px">
                        @Html.LabelFor(m => m.AttSurname, htmlAttributes: new { @class = "control-label col-md-9" })
                        <div class="col-md-12">
                            @Html.EditorFor(m => m.AttSurname, new { htmlAttributes = new { @class = "form-control-mandatory", @placeholder = "Inserta Apellido" } })
                            @Html.ValidationMessageFor(m => m.AttSurname, "", new { @id = "LabelField", @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="margin:15px;margin:15px">
                        @Html.LabelFor(model => model.LinCompany, htmlAttributes: new { @class = "control-label col-md-9" })
                        <div class="col-md-12">
                            @Html.DropDownList("LinCompany", null, htmlAttributes: new { @class = "form-control-mandatory-Link" })
                            @Html.ValidationMessageFor(model => model.LinCompany, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <hr />
                    <h5 style="margin-left:15px">Autorización de equipo para plugin</h5>
                    <div class="form-group" style="margin:15px;margin:15px">
                        @Html.LabelFor(m => m.DeviceName, htmlAttributes: new { @class = "control-label col-md-9" })
                        <div class="col-md-12">
                            @Html.EditorFor(m => m.DeviceName, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ej: PC-OFICINA-01" } })
                            @Html.ValidationMessageFor(m => m.DeviceName, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="margin:15px;margin:15px">
                        @Html.LabelFor(m => m.DeviceId, htmlAttributes: new { @class = "control-label col-md-9" })
                        <div class="col-md-12">
                            @Html.EditorFor(m => m.DeviceId, new { htmlAttributes = new { @class = "form-control", @placeholder = "Hash DeviceId del plugin" } })
                            @Html.ValidationMessageFor(m => m.DeviceId, "", new { @class = "text-danger" })
                        </div>
                    </div>
                    <div class="form-group" style="margin:15px;margin:15px">
                        <div class="col-md-12">
                            <label>
                                @Html.CheckBoxFor(m => m.DeviceAllowed)
                                Autorizar plugin para este equipo
                            </label>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div>
                        <div class="mb-4 d-flex justify-content-center">
                            <img style="height:300px" id="output" src="~/Files/RRHH/User/AttPhotoMenu/User.png" />

                        </div>
                        <div class="form-group">
                            <div>
                                <input class="btn btn-warning" type="file" name="file1" id="file" onchange="loadFile(event)">
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <div class="col-md-12">
                <hr style="background-color: gainsboro; height: 1px; margin: 1px; padding: 1px">
                <div class="row">
                    <div class="col-md-6"> &nbsp;&nbsp;&nbsp;&nbsp;</div>
                    <div class="col-md-5" style="margin:10px;padding:10px">
                        <button type="button" id="btnSalir" class="btn btn-danger">Salir</button>
                        <button type="submit" id="SubmitEditBtn" class="btn btn-warning">@(Model.IsEdit ? "Guardar cambios" : "Crear")</button>
                    </div>
                </div>
            </div>

        </fieldset>
    }
</div>
@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
<script type="text/javascript">
        $(document).ready(function ()
        {
            if ('@Model.AttPhotoMenu' == "") {
                output.src = "~/Files/RRHH/User/AttPhotoMenu/user.png";
            }
            else {
                output.src = '@Model.AttPhotoMenu';
            }
 
            $('#sidebar').toggleClass('active');
            $(this).toggleClass('active');
             //Load Toas
                $.ajax({
                type: 'POST',
                url: '@Url.Content("~/ToasHelp/DataToaster")',
                    data: {
                        Type: "info",
                        ToasConcept: "The User was create ok",
                        ToasMessage: "Create User",
                    },
                success: function (data) {
                    $('#PartialToas').html(data);
                    }
                });
                $('#PartialToas').fadeIn();
                //End Load Toas
        });

        var loadFile = function (event) {
            var image = document.getElementById('output');
            image.src = URL.createObjectURL(event.target.files[0]);
        };

</script>
}

