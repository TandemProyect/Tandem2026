@model Desing.Models.SecurityUserRolesViewModel
@using Desing.Resources
@{
    var selected = new HashSet<long>(Model.RoleIds ?? new List<long>());
}
@* Ventana «Asignar roles» (se carga por AJAX desde la lista de empleados). *@
<div class="modal-header">
    <h5 class="modal-title">@Security.Employee_AssignRoles_Title <small class="text-muted ms-2">@Model.DisplayName</small></h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Common.Btn_Cancel"></button>
</div>
@using (Html.BeginForm("AssignRoles", "Employee", FormMethod.Post, new { id = "assignRolesForm", role = "form" }))
{
    <div class="modal-body">
        @Html.AntiForgeryToken()
        <input type="hidden" name="userId" value="@Model.UserId" />
        <label class="form-label">@Security.Employee_Lbl_Roles</label>
        @if (Model.AvailableRoles == null || Model.AvailableRoles.Count == 0)
        {
            <div class="text-muted">@Security.Employee_Lbl_NoRoles</div>
        }
        else
        {
            foreach (var r in Model.AvailableRoles)
            {
                var rid = "assign_role_" + r.IdObject;
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" name="roleIds" value="@r.IdObject" id="@rid" @(selected.Contains(r.IdObject) ? "checked" : "") />
                    <label class="form-check-label" for="@rid">
                        @r.TextLabel
                        @if (!string.IsNullOrWhiteSpace(r.TextDescription))
                        {
                            <span class="text-muted ms-1">— @r.TextDescription</span>
                        }
                    </label>
                </div>
            }
        }
    </div>
    <div class="modal-footer tandem-form-actions">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Common.Btn_Cancel</button>
        <button type="submit" class="btn btn-primary">@Common.Btn_Save</button>
    </div>
}
