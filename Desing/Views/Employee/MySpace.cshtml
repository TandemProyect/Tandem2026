@model Desing.Models.EmployeeViewMySpaceModel
@using Desing.Resources

<h4 class="py-3 mb-4">
    <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">@Employee.Common_Home</a> /</span> @Employee.MySpace_Breadcrumb
</h4>
<h1 class="mt-1 text-center">@string.Format(Employee.MySpace_Welcome, Model.FullName)</h1>

<div class="container d-flex justify-content-center mt-5">
    <div class="card shadow-lg" style="max-width: 80%;">
        <div class="row g-0">
            <div class="col-md-4 d-flex align-items-center justify-content-center bg-light">
                <img src="@Model.AttPhoto" alt="" class="rounded-circle img-fluid m-3" style="width: 180px; height: 180px; object-fit: cover;">
            </div>
            <div class="col-md-8">
                <div class="card-body">
                    <h4 class="card-title text-center mb-4">@Employee.MySpace_SectionTitle</h4>
                    <ul class="list-unstyled">
                        <li class="mb-3 d-flex align-items-center">
                            <i class="fas fa-user fa-lg me-2 text-primary"></i>
                            <strong>@Employee.MySpace_Field_FullName</strong>
                            <span class="text-muted ms-2">@Model.FullName</span>
                        </li>
                        <li class="mb-4 d-flex align-items-center">
                            <i class="fas fa-user-circle fa-lg me-2 text-primary"></i>
                            <strong>@Employee.MySpace_Field_UserName</strong>
                            <span class="text-muted ms-2">@Model.UserName</span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="fas fa-calendar-alt fa-lg me-2 text-warning"></i>
                            <strong>@Employee.MySpace_Field_FirstLogin</strong>
                            <span class="text-muted ms-2">@Model.AccountCreationDate</span>
                        </li>
                        <li class="mb-3 d-flex align-items-center">
                            <i class="fas fa-university fa-lg me-2 text-primary"></i>
                            <strong>@Employee.MySpace_Field_TotalDesigns</strong>
                            <span class="text-muted ms-2">@Model.TotalDesigns</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script src="~/Scripts/jquery-ui.js.js"></script>
}
