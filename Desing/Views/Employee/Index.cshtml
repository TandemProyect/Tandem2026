<div id="HelpDesingEmployee" abindex="-1" style="z-index: 500; width: 1500px; height:650px; display: none; position: absolute; top: 90px; margin: 1px; padding: 1px;background-color:white;">
    <label>&nbsp;&nbsp;&nbsp;&nbsp;Tutorial</label> &nbsp;&nbsp;&nbsp;&nbsp;
    <button type="button" id="BtnCloseHelpEmployee" class="close" data-dismiss="modal" aria-label="Close" style="padding:5px;margin:5px"><i class="fas fa-home"></i>&nbsp;&nbsp;</button>
    <hr style="color: #F88402">
    <div class="col-md-12">
        <div class="row" style="margin:1px;padding:1px">
            <div id="Help_GeneralEmployee" style=" width:900px;height:600px; margin:10px;padding:10px">
                @Html.Action("Principal", "HelpDesing");
            </div>

            <div id="Help_MenuEmployee" style="width: 500px; height: 600px; margin:10px; padding: 10px">

            </div>
        </div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">Inicio</a> /</span> Empleados
    </h4>
    <a class="btn btn-primary text-white" href="@Url.Action("Register", "Account")">
        <i class="icon-base ri ri-add-line me-1"></i> Crear Nuevo Empleado
    </a>
</div>
<div id="Loading" style="z-index:5; position: absolute; background-color:   darkgrey; width: 100%; height: 100%; display: none; opacity: 0.8">
    &nbsp;&nbsp;&nbsp;&nbsp;
</div>
<div id="DivDesignPoupEmployee" style="position: absolute; z-index: 1200; background-color: ghostwhite; position: absolute; top: 70px; width: 750px; height:500px; display: none; border-radius: 0.9rem ">
    <div class="modal-header" style="background-color: #ffc107">
        <button type="button" id="BtnCloseDivDesignPoupEmployee" class="close" data-dismiss="modal" aria-label="Close" style="padding:5px;margin:5px;top:0px"><i class="fas fa-home"></i>&nbsp;&nbsp;</button>
        <h5 class="modal-title" id="myModalLabel" style="color:black"><label id="LabelPoupEmployee">Mesaje</label></h5>
    </div>
    <form>
        <fieldset>
            <div id="DivContentFormDesign" style="background-position: center;width:100%;height:100%">

            </div>
        </fieldset>
    </form>
</div>
<div class="card mb-4" style="width: 100%">
    <div class="card-body" style="padding:5px">
        <table id="TableEmployee" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th> Avatar</th>
                    <th>UserName</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th></th>
                    <th>Empresa</th>
                    <th>Contraseña</th>
                    <th>Act./des.</th>
                    <th>Fecha alta</th>
                    <th>Acciones</th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div id="ConfirmSendMailModal" style="display:none; position:fixed; top:25%; left:40%; width:400px; height:200px; background:white; border:1px solid #ccc; z-index:1000; padding:20px; box-shadow:0px 4px 6px rgba(0,0,0,0.1);">
    <h3>Confirmación</h3>
    <p>¿Estás seguro de que quieres enviar el mensaje?</p>
    <button class="btn btn-success align-center" id="ConfirmYes" style="margin-right:10px;">Sí</button>
    <button class="btn btn-danger align-center" id="ConfirmNo">No</button>
</div>

<!-- HTML para el mensaje de éxito/error -->
<div id="NotificationPopup" style="display:none; position:fixed; top:05%; left:40%; width:300px; background:#00aaff; color:white; padding:15px; border-radius:5px; text-align:center; z-index:1001;">
    <span id="NotificationText"></span>
</div>

@section scripts
    {
    <script src="~/Scripts/jquery-ui.js.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            //Toas
            var _Toas = @Html.Raw(Json.Encode(TempData["ToastType"]));
            if (_Toas === "Act") {
                var toastTitle = @Html.Raw(Json.Encode(TempData["ToastTitle"]));
                var toastMessage = @Html.Raw(Json.Encode(TempData["ToastMessage"]));
                var titleEl = document.getElementById("LableToasTileGeneral");
                var contentEl = document.getElementById("LableToasContentedeGeneral");
                if (titleEl) { titleEl.innerHTML = toastTitle || ""; }
                if (contentEl) { contentEl.innerHTML = toastMessage || ""; }
                if ($("#Toas_General").length) {
                    $("#Toas_General").show("slide", 400, callback);
                    function callback() {
                        setTimeout(function () {
                            $("#Toas_General").hide("slide", 400, callback);
                        }, 4000);
                    }
                }
            }
            var dtEmplRoot = '@Url.Content("~/")';
            var dtEmplAvatarDefault = '@Url.Content("~/Files/RRHH/User/AttPhotoMenu/User.png")';
            var Employee = {
                dt: null,
                init: function () {
                    dt = $('#TableEmployee').DataTable({
                        dom: '<"dataTables-length-position">Bfrt<"dataTables-length-position"i>p',
                        lengthMenu: [
                            [10, 25, 50, -1],
                            ['10 filas', '25 filas', '50 filas', 'Todas']
                        ],
                        buttons: [
                            {
                                extend: 'collection',
                                text: "<i class='fas fa-bars'></i>",
                                className: 'custom-html-collection',
                                buttons: [
                                    '<h5>Registros</h5>',
                                    'pageLength',
                                    '<h5>Exportar</h5>',
                                    'print',
                                    'copy',
                                    'pdf',
                                    'csv',
                                    'excel',
                                    '<h5 class="not-top-heading">Columnas visibles</h5>',
                                    'colvis'
                                ]
                            }
                        ],
                        "serverSide": true,
                        "processing": true,
                        "stateSave": true,
                        "colReorder": { "iFixedColumnsRight": 2 },

                        "ajax": {
                            "url": "@Url.Content("~/Employee/ListEmployee/" + 1)",
                            "type": "POST"
                        },
                        "columns": [
                            {
                                "data": "emptyColumn",
                                "orderable": false,
                                "render": function (data, type, row) {
                                    if (type !== "display" && type !== "filter") { return data || ""; }
                                    var avatarPath = (row.AttPhotoMenu || "").toString();
                                    avatarPath = avatarPath.replace(/^~\//, "");
                                    avatarPath = avatarPath.replace(/^(\.\.\/)+/, "");
                                    var avatarUrl = avatarPath ? (dtEmplRoot + avatarPath) : dtEmplAvatarDefault;
                                    return "<img style=\"height:35px;width:35px;object-fit:cover;border-radius:50%;\" src=\"" + avatarUrl + "\" alt=\"avatar\" onerror=\"this.onerror=null;this.src='" + dtEmplAvatarDefault + "';\" />";
                                }
                            },
                            { "data": "UserName" },
                            { "data": "AttName"},
                            { "data": "AttSurname"},
                            { "data": "AddLeter"},
                            { "data": "AddCompany"},
                            { "data": "AttPassAspNetUsert"},
                            {
                                "data": "emptyColumn",
                                "orderable": false,
                                "render": function (data, type, row) {
                                    if (type !== "display") { return ""; }
                                    return (row.buttonActive || "") + "&nbsp;";
                                }
                            },
                            { "data": "AttCreated"},
                            {
                                "data": "emptyColumn",
                                "orderable": false,
                                "render": function (data, type, row) {
                                    if (type !== "display") { return ""; }
                                    var html = (row.buttonSendMail || "") + "&nbsp;";
                                    if (row.allowEdit == true) {
                                        html += (row.buttonEdit || "") + "&nbsp;";
                                    }
                                    if (row.AttIsDeleted == false) {
                                        if ((row.Counter1 == 0) && (row.Counter2 == 0)) {
                                            if (row.TotalDesing === 0 && row.allowDelete == true) {
                                                html += (row.buttonDelete || "") + "&nbsp;";
                                            }
                                        }
                                    }
                                    return html;
                                }
                            },
                            { "data": "SysObjectID"}
                        ],
                     /*   "iDisplayLength": parseInt(leerCookie("_rowsPerPage")),*/
                        "fnRowCallback": function (nRow, data) {
                            if (data.EmailConfirmed == false) {
                                $("td", nRow).addClass("danger");
                            } else {
                                $("td", nRow).removeClass("danger");
                            }
                            return nRow;
                        },
                        "aaSorting": [[1, 'desc']],
                        "aoColumnDefs": [
                            { "bSortable": false, "aTargets": [0] },
                            { "bVisible": false, "aTargets": [10] },
                            { "bSortable": false, "aTargets": [9] },
                            { "bSortable": false, "aTargets": [10] },
                            { "bSortable": false, "aTargets": [7] },
                            { "width": "80px", "aTargets": [0] },
                            { "width": "80px", "aTargets": [9] },
                            { "width": "40px", "aTargets": [7] },
                        ],
                        drawCallback: function () {
                            if ($.fn.tooltip) {
                                $('[data-toggle="tooltip"]').tooltip({
                                    delay: { "show": 100, "hide": 100 },
                                    placement: "auto right"
                                });
                                $('[title]').tooltip({
                                    delay: { "show": 100, "hide": 100 },
                                    placement: "auto"
                                });
                            }
                        },
                    });
                }
            }
            Employee.init();
        });
