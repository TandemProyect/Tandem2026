</div>

<div id="ConfirmSendMailModal" style="display:none; position:fixed; top:25%; left:40%; width:400px; height:200px; background:white; border:1px solid #ccc; z-index:1000; padding:20px; box-shadow:0px 4px 6px rgba(0,0,0,0.1);">
