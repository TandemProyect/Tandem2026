            document.getElementById("DivDesignPoupEmployee").style.left = w;
            document.getElementById("DivDesignPoupEmployee").style.width = "750px";
            document.getElementById("DivDesignPoupEmployee").style.height = "300px";
            $("#DivDesignPoupEmployee").show("slide", { direction: "right" }, 1000);
            //$("#Loading").show();
            $.ajax({
            type: 'POST',
            url: '@Url.Content("~/Employee/_Delete")',
            data: {Id:id},
                success: function (data) {
                    if (data.IsOk == true) {
                        $('#DivContentFormDesign').load('/Employee/Delete');
                    }
                }, error: function () {
                    alert('Error occured');
                }
});
        };
        function ActiveDesactive(id)
        {
            $("#Loading").show();
            document.getElementById("LabelPoupEmployee").innerHTML =" Activa y descativar Empleado ";
            var w = (screen.width / 2) - 375 + "px";
            document.getElementById("DivDesignPoupEmployee").style.left = w;
            document.getElementById("DivDesignPoupEmployee").style.width = "750px";
            document.getElementById("DivDesignPoupEmployee").style.height = "300px";
            $("#DivDesignPoupEmployee").show("slide", { direction: "right" }, 1000);
            //$("#Loading").show();
            $.ajax({
            type: 'POST',
            url: '@Url.Content("~/Employee/_Active")',
            data: {Id:id},
                success: function (data) {
                    if (data.IsOk == true) {
                        $('#DivContentFormDesign').load('/Employee/Active');
                    }
                }, error: function () {
                    alert('Error occured');
                }
});
};
        function EditEmployee(id)
        {
        $.ajax({
        type: 'POST',
        url: '@Url.Content("~/Employee/Create_Employee")',
        data: {}
        });
        };
   // funcion para mandar el mensaje al usuario en concreto.
       function SendmailToEmployee(id) {
    $("#ConfirmSendMailModal").fadeIn();

    $("#ConfirmYes").off("click").on("click", function () {
        $("#ConfirmSendMailModal").fadeOut();

        $.ajax({
            type: 'POST',
            url: '@Url.Content("~/Employee/SendMailUser")',
            data: { Id: id },
            success: function (data) {
                console.log("respuesta del servidor:", data);
                if (data.startsWith("Success:")) {
                    showNotification(data.replace("Success:", "").trim(), "success");
                } else if (data.startsWith("Error:")) {
                    showNotification(data.replace("Error:", "").trim(), "error");
                } else {
                    showNotification("Respuesta inesperada del servidor.", "error");
                }
            },
            error: function () {
                showNotification("Ocurrió un error al enviar el mensaje.", "error");
            }
        });
    });

    $("#ConfirmNo").off("click").on("click", function () {
        $("#ConfirmSendMailModal").fadeOut();
    });
   };

// Función para mostrar una notificación con el estado del envio del correo exitoso o fallido 
function showNotification(message, type) {
    var $popup = $("#NotificationPopup");
    var backgroundColor = type === "success" ? "#28a745" : "#dc3545";
    $popup.css("background", backgroundColor);
    $("#NotificationText").text(message);
    $popup.fadeIn();

    // Ocultar el popup después de 5 segundos
    setTimeout(function () {
        $popup.fadeOut();
    }, 5000);
}


    </script>
}

