@using Newtonsoft.Json
@using Desing.Resources
@using System.Globalization
@{
    var ci = CultureInfo.CurrentUICulture?.TwoLetterISOLanguageName ?? "es";
    var employeeDt = JsonConvert.SerializeObject(new
    {
        culture = ci,
        rowsSuffix = Employee.Dt_Rows_N,
        allRows = Employee.Dt_Rows_All,
        sectionRecords = Employee.Dt_Section_Records,
        sectionExport = Employee.Dt_Section_Export,
        sectionCols = Employee.Dt_Section_ColumnsVisible,
        badgeActiveClass = Employee.State_AccountConfirmed,
        badgeInactiveClass = Employee.State_AccountUnconfirmed,
        confirmDeleteEmployee = Employee.Js_ConfirmDeleteEmployee,
        confirmToggleEmployee = Employee.Js_ConfirmToggleEmployee,
        confirmSendMail = Employee.Js_ConfirmSendMail,
        sendMailSuccessFallback = Employee.Js_SendMailSuccessFallback,
        sendMailErrorFallback = Employee.Js_SendMailErrorFallback,
        sendMailUnexpected = Employee.Js_SendMailUnexpected,
        sendMailNetworkError = Employee.Js_SendMailNetworkError,
        ariaMenu = Employee.Dt_MenuAria
    });
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <h4 class="py-3 mb-0">
        <span class="text-muted fw-light"><a href="@Url.Action("Index", "Home")">@Employee.Common_Home</a> /</span> @Employee.Index_Breadcrumb
    </h4>
    <a class="btn btn-primary text-white" href="@Url.Action("Register", "Account")">
        <i class="icon-base ri ri-add-line me-1"></i> @Employee.Index_CreateEmployee
    </a>
</div>

@if (!string.IsNullOrEmpty(TempData["ToastMessage"] as string))
{
    <div class="alert alert-success">@TempData["ToastMessage"]</div>
}

<div class="card mb-4">
    <div class="card-body" style="padding:5px">
        <table id="ListEmployee" class="table table-hover" cellspacing="0" style="width: 100%">
            <thead>
                <tr>
                    <th>@Employee.Col_Avatar</th>
                    <th>@Employee.Col_UserName</th>
                    <th>@Employee.Col_Name</th>
                    <th>@Employee.Col_CompanyLetter</th>
                    <th>@Employee.Col_Company</th>
                    <th class="text-end">@Employee.Col_TotalDesigns</th>
                    <th>@Employee.Col_Account</th>
                    <th>@Employee.Col_CreatedDate</th>
                    <th class="text-end text-nowrap" style="width:1%;"></th>
                    <th>ID</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<!-- Modal de confirmación de envío de correo -->
<div class="modal fade" id="EmployeeSendMailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@Employee.Btn_SendMail</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Employee.Btn_Cancel"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="EmployeeSendMailBody">@Employee.Js_ConfirmSendMail</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">@Employee.Btn_Cancel</button>
                <button type="button" class="btn btn-success" id="EmployeeSendMailConfirm">@Employee.Btn_SendMail</button>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script type="text/javascript">
        var employeeDt = @Html.Raw(employeeDt);
        var employeeExportOpts = TandemDataTablesList.exportOptsPlainVisible;

        $(document).ready(function () {
            $('#ListEmployee').DataTable(TandemDataTablesList.applyListDefaults({
                lengthMenu: [
                    [10, 25, 50, -1],
                    ['10 ' + employeeDt.rowsSuffix, '25 ' + employeeDt.rowsSuffix, '50 ' + employeeDt.rowsSuffix, employeeDt.allRows]
                ],
                buttons: [{
                    extend: 'collection',
                    text: "<i class='fas fa-bars'></i>",
                    attr: { 'aria-label': employeeDt.ariaMenu },
                    className: 'custom-html-collection',
                    buttons: [
                        '<h5>' + employeeDt.sectionRecords + '</h5>',
                        'pageLength',
                        '<h5>' + employeeDt.sectionExport + '</h5>',
                        'print',
                        'copy',
                        'pdf',
                        { extend: 'csv', exportOptions: employeeExportOpts },
                        { extend: 'excel', exportOptions: employeeExportOpts },
                        '<h5 class="not-top-heading">' + employeeDt.sectionCols + '</h5>',
                        'colvis'
                    ]
                }],
                serverSide: true,
                processing: true,
                colReorder: { iFixedColumnsRight: 2 },
                ajax: {
                    url: '@Url.Content("~/Employee/ListEmployee/")',
                    type: 'POST'
                },
                order: [[2, 'asc']],
                columns: [
                    {
                        data: 'Avatar',
                        name: 'Avatar',
                        orderable: false,
                        searchable: false,
                        className: 'text-center align-middle',
                        width: '60px'
                    },
                    { data: 'UserName', name: 'UserName' },
                    {
                        data: 'TextLabel',
                        name: 'TextLabel',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.TextLabelPlain || '';
                            }
                            return data;
                        }
                    },
                    { data: 'AddLeter', name: 'AddLeter' },
                    { data: 'AddCompany', name: 'AddCompany' },
                    {
                        data: 'TotalDesing',
                        name: 'TotalDesing',
                        className: 'text-end align-middle'
                    },
                    {
                        data: 'EmailConfirmed',
                        name: 'EmailConfirmed',
                        render: function (data, type, row) {
                            if (type === 'export') {
                                return row.StatusText || (data ? employeeDt.badgeActiveClass : employeeDt.badgeInactiveClass);
                            }
                            if (type !== 'display') {
                                return data;
                            }
                            return data
                                ? '<span class="badge bg-label-success">' + employeeDt.badgeActiveClass + '</span>'
                                : '<span class="badge bg-label-danger">' + employeeDt.badgeInactiveClass + '</span>';
                        }
                    },
                    { data: 'AttCreated', name: 'AttCreated' },
                    {
                        data: 'rowActions',
                        orderable: false,
                        searchable: false,
                        className: 'tandem-col-actions text-end align-middle text-nowrap'
                    },
                    { data: 'SysObjectID', visible: false }
                ],
                drawCallback: function () {
                    $('[data-toggle="tooltip"]').tooltip({
                        delay: { show: 100, hide: 100 },
                        placement: 'auto right'
                    });
                    $('[title]').tooltip({
                        delay: { show: 100, hide: 100 },
                        placement: 'auto'
                    });
                }
            }));
        });

        window.DeleteEmployee = function (id) {
            if (!confirm(employeeDt.confirmDeleteEmployee)) return;
            $.post('@Url.Action("DeleteEmployee", "Employee")', { id: id }, function (res) {
                if (res && res.Message) { alert(res.Message); }
                if (res && res.IsOk) {
                    $('#ListEmployee').DataTable().ajax.reload(null, false);
                }
            });
        };

        window.ToggleEmployee = function (id) {
            if (!confirm(employeeDt.confirmToggleEmployee)) return;
            $.post('@Url.Action("ToggleEmployee", "Employee")', { id: id }, function (res) {
                if (res && res.Message) { alert(res.Message); }
                if (res && res.IsOk) {
                    $('#ListEmployee').DataTable().ajax.reload(null, false);
                }
            });
        };

        window.SendmailToEmployee = function (id) {
            var $modal = $('#EmployeeSendMailModal');
            var hasBootstrap5 = typeof bootstrap !== 'undefined' && bootstrap.Modal;
            var modal = hasBootstrap5 ? bootstrap.Modal.getOrCreateInstance(document.getElementById('EmployeeSendMailModal')) : null;
            if (modal) { modal.show(); } else { $modal.fadeIn(); }

            $('#EmployeeSendMailConfirm').off('click').on('click', function () {
                if (modal) { modal.hide(); } else { $modal.fadeOut(); }
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("SendMailUser", "Employee")',
                    data: { Id: id },
                    success: function (data) {
                        var text = (data || '').toString();
                        if (text.indexOf('Success:') === 0) {
                            alert(text.replace('Success:', '').trim() || employeeDt.sendMailSuccessFallback);
                        } else if (text.indexOf('Error:') === 0) {
                            alert(text.replace('Error:', '').trim() || employeeDt.sendMailErrorFallback);
                        } else {
                            alert(employeeDt.sendMailUnexpected);
                        }
                    },
                    error: function () { alert(employeeDt.sendMailNetworkError); }
                });
            });
        };
    </script>
}
