@model DAL.TSql_Employee
@using Desing.Resources

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <fieldset style="margin:10px;padding:10px">
        <legend style="color:brown">
            <i class="fa fa-trash" aria-hidden="true"></i>
            &nbsp;&nbsp;@Employee.Modal_DeleteLegend
        </legend>
        <div class="row" style="margin:10px;padding:10px">
            <div class="form-horizontal">
                <div class="form-group">
                    <p class="text-muted mb-0">@Employee.Modal_DeleteConfirm</p>
                </div>
            </div>
        </div>
    </fieldset>
    <hr style="background-color: gainsboro; height: 1px; margin: 1px; padding: 1px">
    <div class="row">
        <div class="col-md-6"> &nbsp;&nbsp;&nbsp;&nbsp;</div>
        <div class="col-md-5" style="margin:10px;padding:10px">
            <input type="hidden" name="id" value='@Model.SysObjectID'>
            <button type="button" id="btnSalirDeleteEmployee" class="btn btn-outline-secondary">@Employee.Btn_Exit</button>
            <button type="submit" id="SubmitEditBtn" class="btn btn-danger">@Employee.Btn_Delete</button>
        </div>
    </div>
}
<script type="text/javascript">
    $('#btnSalirDeleteEmployee').on('click', function () {
        if (typeof $("#DivDesignPoupEmployee").hide === "function") {
            $("#DivDesignPoupEmployee").hide("slide", { direction: "right" }, 1000);
            $("#Loading").hide();
        }
    });
</script>
