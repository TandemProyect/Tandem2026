@model DAL.TSql_Employee
@using Desing.Resources

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <fieldset style="margin: 10px; padding: 10px">
        <legend style="color: dimgray">
            <i class="fas fa-sync" aria-hidden="true"></i>
            &nbsp;&nbsp;@ViewBag.ActiveNoActive
        </legend>
        <div class="row" style="margin:10px;padding:10px">
            <div class="form-horizontal">
                <div class="form-group">
                    <h5 style="color:blue">&nbsp;@ViewBag.Mesaje</h5>
                </div>
            </div>
        </div>
    </fieldset>
    <hr style="background-color: gainsboro; height: 1px; margin: 1px; padding: 1px">
    <div class="row">
        <div class="col-md-6"> &nbsp;&nbsp;&nbsp;&nbsp;</div>
        <div class="col-md-5" style="margin:10px;padding:10px">
            <input type="hidden" name="id" value='@Model.SysObjectID'>
            <button type="button" id="btnSalirActiveEmployee" class="btn btn-outline-secondary">@Employee.Btn_Exit</button>
            <button type="submit" id="SubmitEditBtn" class="btn btn-warning">&nbsp;@ViewBag.Button&nbsp;</button>
        </div>
    </div>
}
<script type="text/javascript">
    $('#btnSalirActiveEmployee').on('click', function () {
        if (typeof $("#DivDesignPoupEmployee").hide === "function") {
            $("#DivDesignPoupEmployee").hide("slide", { direction: "right" }, 1000);
            $("#Loading").hide();
        }
    });
</script>
