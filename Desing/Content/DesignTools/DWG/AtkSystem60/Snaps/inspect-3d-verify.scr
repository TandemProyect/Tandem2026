FILEDIA
0
(command "_.REGEN")
(princ (strcat "\nINSBASE=" (rtos (car (getvar "INSBASE")) 2 4) "," (rtos (cadr (getvar "INSBASE")) 2 4) "," (rtos (caddr (getvar "INSBASE")) 2 4)))
(setq types '())
(setq ss (ssget "_X"))
(if ss
  (progn
    (setq i 0 n (sslength ss))
    (while (< i n)
      (setq e (entget (ssname ss i)))
      (setq ty (cdr (assoc 0 e)))
      (setq pair (assoc ty types))
      (if pair
        (setq types (subst (cons ty (1+ (cdr pair))) pair types))
        (setq types (cons (cons ty 1) types))
      )
      (setq i (1+ i))
    )
  )
)
(princ "\nENTITIES:")
(foreach p types (princ (strcat "\n " (car p) "=" (itoa (cdr p)))))
(setq ss (ssget "_X" '((0 . "CIRCLE"))) i 0)
(if ss
  (progn
    (princ "\nCIRCLES:")
    (repeat (sslength ss)
      (setq e (entget (ssname ss i)))
      (setq c (cdr (assoc 10 e)))
      (setq el (cdr (assoc 38 e)))
      (if (not el) (setq el (caddr c)))
      (if (not el) (setq el 0.0))
      (princ (strcat "\n C=" (rtos (car c) 2 4) "," (rtos (cadr c) 2 4) ",z=" (rtos el 2 4)))
      (setq i (1+ i))
    )
  )
)
(setq ss (ssget "_X" '((0 . "ATTDEF,TEXT"))) i 0)
(if ss
  (repeat (sslength ss)
    (setq e (entget (ssname ss i)))
    (princ (strcat "\nTXT=" (cdr (assoc 1 e))))
    (setq i (1+ i))
  )
)
(command "_.ZOOM" "_E")
(setq a (getvar "EXTMIN") b (getvar "EXTMAX"))
(princ (strcat "\nEXTMIN=" (rtos (car a) 2 4) "," (rtos (cadr a) 2 4) "," (rtos (caddr a) 2 4)))
(princ (strcat "\nEXTMAX=" (rtos (car b) 2 4) "," (rtos (cadr b) 2 4) "," (rtos (caddr b) 2 4)))
(princ)
FILEDIA
1
_.QUIT
_Y
