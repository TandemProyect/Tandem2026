<Window x:Class="AutocadPlugin.UI.Views.TandemMiniPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="288"
        Height="248"
        KeyDown="OnKeyDown">
    <Border Background="#F5FFFFFF"
            BorderBrush="#D9DEE8"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar"
                    Background="#349d7d"
                    Padding="12,10"
                    CornerRadius="13,13,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,8,0">
                        <Viewbox x:Name="IconInfo" Stretch="Uniform">
                            <Canvas Width="24" Height="24">
                                <Ellipse x:Name="IconInfoRing" Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                         Stroke="#FFFFFF" StrokeThickness="1.8" Fill="Transparent" />
                                <Ellipse x:Name="IconInfoDot" Canvas.Left="10.6" Canvas.Top="6.2" Width="2.8" Height="2.8" Fill="#FFFFFF" />
                                <Rectangle x:Name="IconInfoStem" Canvas.Left="10.85" Canvas.Top="10.4" Width="2.3" Height="7.2"
                                           RadiusX="0.8" RadiusY="0.8" Fill="#FFFFFF" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="IconRun" Stretch="Uniform" Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Ellipse x:Name="IconRunRing" Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                                         Stroke="#FFFFFF" StrokeThickness="1.8" Fill="Transparent" />
                                <Path x:Name="IconRunPlay" Data="M10 8 L10 16 L16.5 12 Z" Fill="#FFFFFF" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <TextBlock x:Name="TitleText"
                               Grid.Column="1"
                               Text="Tandem"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Width="22"
                            Height="22"
                            Padding="0"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="OnCancel"
                            ToolTip="Cerrar">
                        <TextBlock x:Name="CloseGlyph" Text="×" FontSize="16" Foreground="#FFFFFF" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,12,14,14">
                <StackPanel x:Name="PromptPanel" Visibility="Visible">
                    <TextBlock x:Name="PromptText"
                               FontSize="12"
                               Foreground="#6E6B80"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ChoicePanel" Visibility="Collapsed">
                    <TextBlock x:Name="ChoiceText"
                               Margin="0,0,0,10"
                               FontSize="12"
                               Foreground="#6E6B80"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="ChoiceHost" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Image x:Name="BrandLogo"
                           MaxWidth="180"
                           Height="32"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="Collapsed" />
                    <Grid Width="36" Height="36" HorizontalAlignment="Center">
                        <Ellipse Stroke="#E8E6F4" StrokeThickness="3.2" />
                        <Ellipse x:Name="SpinArc"
                                 Stroke="#349d7d"
                                 StrokeThickness="3.2"
                                 StrokeDashArray="12 20"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="Spin" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="ProgressText"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#433C65"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Spin"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.75" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
