<Window x:Class="AutocadPlugin.UI.Views.TandemMiniPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="248"
        Height="196"
        KeyDown="OnKeyDown">
    <Border Background="#F5FFFFFF"
            BorderBrush="#407367F0"
            BorderThickness="1"
            CornerRadius="14"
            Padding="16,14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock x:Name="TitleText"
                           Text="Tandem"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#433C65"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Width="22"
                        Height="22"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="OnCancel"
                        ToolTip="Cerrar">
                    <TextBlock Text="×" FontSize="16" Foreground="#6E6B80" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <StackPanel x:Name="PromptPanel" Visibility="Visible">
                    <TextBlock x:Name="PromptText"
                               FontSize="12"
                               Foreground="#6E6B80"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="ChoicePanel" Visibility="Collapsed">
                    <TextBlock x:Name="ChoiceText"
                               Margin="0,0,0,10"
                               FontSize="12"
                               Foreground="#6E6B80"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="ChoiceHost" />
                </StackPanel>

                <StackPanel x:Name="ProgressPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Grid Width="36" Height="36" HorizontalAlignment="Center">
                        <Ellipse Stroke="#E8E6F4" StrokeThickness="3.2" />
                        <Ellipse Stroke="#7367F0"
                                 StrokeThickness="3.2"
                                 StrokeDashArray="12 20"
                                 StrokeStartLineCap="Round"
                                 StrokeEndLineCap="Round"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="Spin" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="ProgressText"
                               Margin="0,10,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#433C65"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Spin"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.75" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
