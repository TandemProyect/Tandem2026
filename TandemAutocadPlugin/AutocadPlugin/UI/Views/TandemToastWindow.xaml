<Window x:Class="AutocadPlugin.UI.Views.TandemToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        MaxWidth="360">
    <!-- Misma idea que Desing: toast bs-toast bg-success, arriba a la derecha -->
    <Border Background="#28C76F"
            CornerRadius="8"
            Padding="14,12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#000000" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20"
                             Stroke="#FFFFFF" StrokeThickness="1.8" Fill="Transparent" />
                    <Path Data="M7.5 12.2 L10.6 15.3 L16.6 8.8"
                          Stroke="#FFFFFF" StrokeThickness="2.1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Fill="Transparent" />
                </Canvas>
            </Viewbox>
            <TextBlock x:Name="MessageText"
                       Text="Diseño salvado"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       MaxWidth="280" />
        </StackPanel>
    </Border>
</Window>
