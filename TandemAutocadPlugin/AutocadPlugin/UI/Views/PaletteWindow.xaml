<Window x:Class="AutocadPlugin.UI.Views.PaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="Manual"
        Background="#F5F5F9"
        Width="320"
        Height="268">
    <Window.Resources>
        <LinearGradientBrush x:Key="SplashBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFF8F5" Offset="0" />
            <GradientStop Color="#F5F5F9" Offset="0.45" />
            <GradientStop Color="#EEF1F8" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#FFFBFA" Offset="1" />
        </LinearGradientBrush>
    </Window.Resources>
    <Border Background="{StaticResource SplashBg}"
            BorderBrush="#D9DEE8"
            BorderThickness="1"
            CornerRadius="10"
            Cursor="SizeAll"
            MouseLeftButtonDown="OnDrag">
        <Grid>
            <!-- WebView2 se crea en código y se aparca fuera hasta que la página esté lista -->
            <Canvas x:Name="WebPark"
                    Width="1"
                    Height="1"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />
            <Grid x:Name="WebHost"
                  Margin="7,6,7,6" />

            <Grid x:Name="SplashPanel" Visibility="Collapsed" VerticalAlignment="Top">
                <Border Margin="6"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource CardBg}"
                        BorderBrush="#ECE7E1"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="0,0,0,10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.10" Color="#2C3340" />
                    </Border.Effect>
                    <StackPanel VerticalAlignment="Top">
                        <Border Height="5"
                                CornerRadius="12,12,0,0"
                                Background="#F29100" />

                        <Image x:Name="SplashLogo"
                               Source="/AutocadPlugin;component/UI/Assets/tdesing-logo.png"
                               MaxWidth="200"
                               Height="36"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0" />

                        <Grid Width="52" Height="52" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Ellipse Stroke="#F0E6D8" StrokeThickness="4" />
                            <Ellipse Stroke="#F29100"
                                     StrokeThickness="4"
                                     StrokeDashArray="12 20"
                                     StrokeStartLineCap="Round"
                                     StrokeEndLineCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinArc" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Canvas Width="52" Height="52">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="SpinHands" CenterX="26" CenterY="26" />
                                </Canvas.RenderTransform>
                                <Line X1="26" Y1="26" X2="26" Y2="12"
                                      Stroke="#2C3340" StrokeThickness="2.2" StrokeStartLineCap="Round" />
                                <Line X1="26" Y1="26" X2="36" Y2="26"
                                      Stroke="#F29100" StrokeThickness="2.2" StrokeStartLineCap="Round" />
                                <Ellipse Canvas.Left="21" Canvas.Top="21" Width="10" Height="10" Fill="#F29100" />
                            </Canvas>
                        </Grid>

                        <TextBlock x:Name="StatusText"
                                   Margin="12,8,12,0"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#2C3340"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Text="Comprobando autorización en TDesing…" />
                        <TextBlock Margin="0,4,0,2"
                                   FontSize="11"
                                   Foreground="#8A93A3"
                                   TextAlignment="Center"
                                   Text="tdesing.net" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
