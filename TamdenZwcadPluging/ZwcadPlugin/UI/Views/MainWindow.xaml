<Window x:Class="ZwcadPlugin.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZwcadPlugin.UI.ViewModels"
        Title="Tandem 2026 — Plugin ZWCAD"
        Width="420" Height="320"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Tandem 2026"
                       FontSize="20" FontWeight="Bold"
                       Foreground="#1565C0" />
            <TextBlock Text="Plugin de Muros y Encofrado para ZWCAD"
                       FontSize="11" Foreground="#555" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Acciones principales -->
        <StackPanel Grid.Row="1">
            <Button Content="🔍  Detectar Muros"
                    Command="{Binding DetectarMurosCommand}" />
            <Button Content="🧱  Generar 3D"
                    Command="{Binding Generar3dCommand}" />
            <Button Content="⚙️  Configurar Encofrado"
                    Command="{Binding ConfigEncofradoCommand}" />
        </StackPanel>

        <!-- Barra de estado -->
        <Border Grid.Row="2"
                Background="#F0F4F8" CornerRadius="4"
                Padding="10,6" Margin="0,12,0,0">
            <TextBlock Text="{Binding MensajeEstado}"
                       FontSize="11" Foreground="#333"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
