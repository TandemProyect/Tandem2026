<Window x:Class="ZwcadPlugin.UI.Views.CreateDesignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crear diseño desde ZWCAD"
        Width="1200"
        Height="760"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="#F6F8FB" BorderBrush="#DCE3EE" BorderThickness="0,0,0,1" Padding="12">
            <TextBlock x:Name="TxtHeader"
                       FontSize="13"
                       Foreground="#334155"
                       Text="Cargando formulario MVC..." />
        </Border>

        <WebBrowser x:Name="BrowserHost" Grid.Row="1" />
    </Grid>
</Window>
