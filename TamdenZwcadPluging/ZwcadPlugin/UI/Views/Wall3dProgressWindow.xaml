<Window x:Class="ZwcadPlugin.UI.Views.Wall3dProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Width="280"
        Height="148">
    <!-- Misma tarjeta que Desing_2: .desing2-stl-render-overlay__card -->
    <Border Background="#F5FFFFFF"
            BorderBrush="#407367F0"
            BorderThickness="1"
            CornerRadius="14"
            Padding="24,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18" Color="#000000" />
        </Border.Effect>
        <StackPanel>
            <Grid Width="40" Height="40" HorizontalAlignment="Center">
                <Ellipse Stroke="#E8E6F4" StrokeThickness="3.5" />
                <Ellipse Stroke="#7367F0"
                         StrokeThickness="3.5"
                         StrokeDashArray="14 22"
                         StrokeStartLineCap="Round"
                         StrokeEndLineCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="Spin" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <TextBlock x:Name="MessageText"
                       Text="Generando modelo de muros…"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#433C65"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0" />
        </StackPanel>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Spin"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.75" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>

