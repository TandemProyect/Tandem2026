# Ignorar biblioteca completa de Bootstrap Icons (demasiado grande para Git)
Bootstrap-Icons/icons/*

# Mantener la estructura de carpetas
!Bootstrap-Icons/icons/.gitkeep

# Ignorar conversiones PNG temporales (se generan localmente)
png/16x16/*
png/32x32/*

# Mantener la estructura de carpetas PNG
!png/16x16/.gitkeep
!png/32x32/.gitkeep

# Mantener solo los iconos finales seleccionados para Tandem 2026
# (Descomentar cuando estén listos)
