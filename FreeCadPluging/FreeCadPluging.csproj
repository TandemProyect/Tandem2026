<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FreeCadPluging</RootNamespace>
    <AssemblyName>FreeCadPluging</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <FreeCadWorkbenchDir>$(APPDATA)\FreeCAD\v1-1\Mod\Tandem2026</FreeCadWorkbenchDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Workbench\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="InstallFreeCadWorkbench" AfterTargets="Build">
    <ItemGroup>
      <_WorkbenchFiles Include="$(MSBuildProjectDirectory)\Workbench\Tandem2026\**\*" />
      <_HostFiles Include="$(TargetDir)*.*" Exclude="$(TargetDir)*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(FreeCadWorkbenchDir)" Condition="Exists('$(FreeCadWorkbenchDir)')" />
    <MakeDir Directories="$(FreeCadWorkbenchDir)" />
    <MakeDir Directories="$(FreeCadWorkbenchDir)\Host" />
    <Copy SourceFiles="@(_WorkbenchFiles)"
          DestinationFiles="@(_WorkbenchFiles->'$(FreeCadWorkbenchDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_HostFiles)"
          DestinationFolder="$(FreeCadWorkbenchDir)\Host"
          SkipUnchangedFiles="true" />
  </Target>
</Project>