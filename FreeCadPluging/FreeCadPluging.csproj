<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>FreeCadPluging</RootNamespace>
    <AssemblyName>FreeCadPluging</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <FreeCadWorkbenchDir>$(APPDATA)\FreeCAD\v1-1\Mod\Tandem2026</FreeCadWorkbenchDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Workbench\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyWebView2LoaderToOutputRoot" AfterTargets="Build">
    <PropertyGroup>
      <_WebView2LoaderFromOutput>$(OutputPath)runtimes\win-x64\native\WebView2Loader.dll</_WebView2LoaderFromOutput>
      <_WebView2LoaderFromPkg>$(NuGetPackageRoot)microsoft.web.webview2\1.0.2849.39\runtimes\win-x64\native\WebView2Loader.dll</_WebView2LoaderFromPkg>
    </PropertyGroup>
    <Copy SourceFiles="$(_WebView2LoaderFromOutput)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_WebView2LoaderFromOutput)')" />
    <Copy SourceFiles="$(_WebView2LoaderFromPkg)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(_WebView2LoaderFromOutput)') and Exists('$(_WebView2LoaderFromPkg)')" />
  </Target>

  <Target Name="InstallFreeCadWorkbench" AfterTargets="CopyWebView2LoaderToOutputRoot">
    <ItemGroup>
      <_WorkbenchFiles Include="$(MSBuildProjectDirectory)\Workbench\Tandem2026\**\*" Exclude="$(MSBuildProjectDirectory)\Workbench\Tandem2026\**\__pycache__\**\*" />
      <_HostFiles Include="$(TargetDir)*.*" Exclude="$(TargetDir)*.pdb" />
    </ItemGroup>
    <RemoveDir Directories="$(FreeCadWorkbenchDir)" Condition="Exists('$(FreeCadWorkbenchDir)')" />
    <MakeDir Directories="$(FreeCadWorkbenchDir)" />
    <MakeDir Directories="$(FreeCadWorkbenchDir)\Host" />
    <Copy SourceFiles="@(_WorkbenchFiles)"
          DestinationFiles="@(_WorkbenchFiles->'$(FreeCadWorkbenchDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(_HostFiles)"
          DestinationFolder="$(FreeCadWorkbenchDir)\Host"
          SkipUnchangedFiles="true" />
  </Target>
</Project>